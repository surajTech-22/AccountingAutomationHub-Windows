<Window x:Class="AccountingAutomationHub.NetworkClient.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="AAH Network Client" Width="1000" Height="700" WindowStartupLocation="CenterScreen">
<Grid Margin="16"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<StackPanel><TextBlock Text="Accounting Automation Hub · Network Client" FontSize="24" FontWeight="SemiBold"/><TextBlock Text="Phase 1: read-only accounting · controlled upload · basic export. All authority remains on the AAH Main Server." Margin="0,4,0,12"/></StackPanel>
<Grid Grid.Row="1"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition Width="100"/><ColumnDefinition Width="220"/><ColumnDefinition Width="80"/><ColumnDefinition Width="150"/><ColumnDefinition Width="80"/><ColumnDefinition Width="150"/><ColumnDefinition Width="80"/><ColumnDefinition Width="120"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="Server" VerticalAlignment="Center"/><TextBox Grid.Column="1" x:Name="ServerBox" Text="https://127.0.0.1:47831"/><TextBlock Grid.Column="2" Text="User" Margin="8,0,0,0" VerticalAlignment="Center"/><TextBox Grid.Column="3" x:Name="UserBox"/><TextBlock Grid.Column="4" Text="Password" Margin="8,0,0,0" VerticalAlignment="Center"/><PasswordBox Grid.Column="5" x:Name="PasswordBox"/><TextBlock Grid.Column="6" Text="MFA" Margin="8,0,0,0" VerticalAlignment="Center"/><TextBox Grid.Column="7" x:Name="TotpBox" MaxLength="6"/><Button Grid.Column="8" Content="Login" Click="Login_Click" Padding="8,5" Margin="8,0,0,0" HorizontalAlignment="Left"/><TextBlock Grid.Row="1" Text="Enrollment code" VerticalAlignment="Center" Margin="0,8,0,0"/><TextBox Grid.Row="1" Grid.Column="1" x:Name="EnrollmentCodeBox" MaxLength="8" Margin="0,8,0,0"/><Button Grid.Row="1" Grid.Column="2" Grid.ColumnSpan="2" Content="Enroll This PC" Click="Enroll_Click" Padding="8,5" Margin="8,8,0,0" HorizontalAlignment="Left"/></Grid>
<Grid Grid.Row="2" Margin="0,14,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="330"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Allowed Clients / FY" FontWeight="SemiBold"/><ListBox x:Name="ClientList" Height="440" SelectionChanged="ClientList_SelectionChanged"/><WrapPanel Margin="0,8,0,0"><Button Content="Refresh" Click="Refresh_Click" Padding="8,5"/><Button Content="Upload File" Click="Upload_Click" Padding="8,5" Margin="6,0,0,0"/><Button Content="Link Drop Folder" Click="LinkFolder_Click" Padding="8,5" Margin="6,0,0,0"/></WrapPanel></StackPanel><StackPanel Grid.Column="1" Margin="16,0,0,0"><TextBlock Text="Read-only Summary" FontWeight="SemiBold"/><TextBox x:Name="SummaryBox" IsReadOnly="True" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" Height="420" FontFamily="Consolas"/><WrapPanel Margin="0,8,0,0"><TextBlock Text="Export:" VerticalAlignment="Center"/><ComboBox x:Name="ExportKind" Width="120" SelectedIndex="0"><ComboBoxItem Content="bank"/><ComboBoxItem Content="purchase"/><ComboBoxItem Content="sales"/><ComboBoxItem Content="journal"/></ComboBox><Button Content="Export CSV" Click="Export_Click" Padding="8,5" Margin="8,0,0,0"/><Button Content="Get Server Update" Click="Update_Click" Padding="8,5" Margin="8,0,0,0"/></WrapPanel></StackPanel></Grid>
<TextBlock Grid.Row="3" x:Name="StatusText" Text="Not signed in." TextWrapping="Wrap" Margin="0,12,0,0"/>
</Grid></Window>
