<UserControl x:Class="AccountingAutomationHub.Desktop.Views.PurchaseImportView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:AccountingAutomationHub.Desktop.Views">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />

        <Style x:Key="FieldLabelStyle"
               TargetType="TextBlock">
            <Setter Property="FontSize" Value="10" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>

        <Style x:Key="InputTextBoxStyle"
               TargetType="TextBox">
            <Setter Property="MinHeight" Value="31" />
            <Setter Property="Padding" Value="8,5" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Background" Value="White" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <Style x:Key="SecondaryButtonStyle"
               TargetType="Button">
            <Setter Property="Background" Value="#F8FAFC" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>

        <Style x:Key="SummaryValueStyle"
               TargetType="TextBlock">
            <Setter Property="FontSize" Value="20" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style x:Key="SummaryLabelStyle"
               TargetType="TextBlock">
            <Setter Property="FontSize" Value="9" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="Margin" Value="0,2,0,0" />
        </Style>
    </UserControl.Resources>

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Style="{StaticResource CardBorderStyle}"
                Padding="0"
                Margin="0,0,0,8">
            <Expander IsExpanded="{Binding IsImportPanelExpanded, Mode=TwoWay}"
                      HorizontalContentAlignment="Stretch">
                <Expander.Header>
                    <Grid Height="48"
                          Margin="14,0,14,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Import setup"
                                       FontSize="14"
                                       FontWeight="SemiBold" />
                            <TextBlock Text="Automatic import runs in the background. Expand only to change the root or use manual import."
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       FontSize="10"
                                       Margin="0,2,0,0" />
                        </StackPanel>

                        <StackPanel Grid.Column="1"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center">
                            <Border Background="{DynamicResource AccentSoftBrush}"
                                    CornerRadius="12"
                                    Padding="9,4"
                                    Margin="0,0,8,0">
                                <TextBlock Text="Automatic"
                                           Foreground="{DynamicResource AccentBrush}"
                                           FontSize="10"
                                           FontWeight="SemiBold" />
                            </Border>
                            <TextBlock Text="{Binding FinancialYear, Mode=OneWay, StringFormat={}FY {0}}"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       FontSize="10"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Grid>
                </Expander.Header>

                <TabControl Margin="12,0,12,12">
                    <TabItem Header="Automatic JSON / ZIP">
                        <Grid Margin="10">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2.3*" />
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="1.1*" />
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="0.8*" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Application E-returns root"
                                               Style="{StaticResource FieldLabelStyle}" />
                                    <DockPanel>
                                        <Button DockPanel.Dock="Right"
                                                Content="Change Root"
                                                Command="{Binding BrowseEReturnsRootCommand}"
                                                Style="{StaticResource SecondaryButtonStyle}"
                                                Margin="7,0,0,0" />
                                        <TextBox Text="{Binding EReturnsRootPath, Mode=OneWay}"
                                                 Style="{StaticResource InputTextBoxStyle}"
                                                 IsReadOnly="True" />
                                    </DockPanel>
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Active client GSTIN"
                                               Style="{StaticResource FieldLabelStyle}" />
                                    <TextBox Text="{Binding ClientGstin, Mode=OneWay}"
                                             Style="{StaticResource InputTextBoxStyle}"
                                             IsReadOnly="True" />
                                </StackPanel>

                                <StackPanel Grid.Column="4">
                                    <TextBlock Text="Financial year"
                                               Style="{StaticResource FieldLabelStyle}" />
                                    <TextBox Text="{Binding FinancialYear, Mode=OneWay}"
                                             Style="{StaticResource InputTextBoxStyle}"
                                             IsReadOnly="True" />
                                </StackPanel>
                            </Grid>

                            <Grid Grid.Row="1"
                                  Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel>
                                    <CheckBox Content="Save source files (reserved for the future storage plan)"
                                              IsChecked="{Binding SaveSourceFiles}"
                                              IsEnabled="False"
                                              FontSize="10"
                                              Foreground="{DynamicResource TextSecondaryBrush}" />
                                    <TextBlock Text="All JSON and ZIP sources remain read-only. Nothing is moved, copied, renamed, deleted or extracted."
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               FontSize="9"
                                               Margin="0,3,0,0"
                                               TextWrapping="Wrap" />
                                </StackPanel>

                                <Button Grid.Column="1"
                                        Content="Cancel current check"
                                        Command="{Binding CancelCommand}"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Visibility="{Binding IsBusy, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            </Grid>
                        </Grid>
                    </TabItem>

                    <TabItem Header="Manual Winman Workbook">
                        <Grid Margin="10">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="GSTR-2A workbook"
                                               Style="{StaticResource FieldLabelStyle}" />
                                    <DockPanel>
                                        <Button DockPanel.Dock="Right"
                                                Content="Browse"
                                                Command="{Binding Browse2ACommand}"
                                                Style="{StaticResource SecondaryButtonStyle}"
                                                Margin="7,0,0,0" />
                                        <TextBox Text="{Binding Gstr2AFilePath, UpdateSourceTrigger=PropertyChanged}"
                                                 Style="{StaticResource InputTextBoxStyle}"
                                                 IsReadOnly="True" />
                                    </DockPanel>
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Matching GSTR-2B workbook (optional)"
                                               Style="{StaticResource FieldLabelStyle}" />
                                    <DockPanel>
                                        <Button DockPanel.Dock="Right"
                                                Content="Browse"
                                                Command="{Binding Browse2BCommand}"
                                                Style="{StaticResource SecondaryButtonStyle}"
                                                Margin="7,0,0,0" />
                                        <TextBox Text="{Binding Gstr2BFilePath, UpdateSourceTrigger=PropertyChanged}"
                                                 Style="{StaticResource InputTextBoxStyle}"
                                                 IsReadOnly="True" />
                                    </DockPanel>
                                </StackPanel>
                            </Grid>

                            <Grid Grid.Row="1"
                                  Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1.7*" />
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="1.2*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Company name"
                                               Style="{StaticResource FieldLabelStyle}" />
                                    <TextBox Text="{Binding CompanyName, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource InputTextBoxStyle}" />
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Client GSTIN"
                                               Style="{StaticResource FieldLabelStyle}" />
                                    <TextBox Text="{Binding ClientGstin, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource InputTextBoxStyle}" />
                                </StackPanel>

                                <StackPanel Grid.Column="3"
                                            Orientation="Horizontal"
                                            VerticalAlignment="Bottom"
                                            Margin="12,0,0,0">
                                    <Button Content="Run Manual Import"
                                            Command="{Binding RunImportCommand}"
                                            Style="{StaticResource PrimaryButtonStyle}"
                                            MinWidth="130" />
                                    <Button Content="Cancel"
                                            Command="{Binding CancelCommand}"
                                            Style="{StaticResource SecondaryButtonStyle}"
                                            Margin="7,0,0,0" />
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </TabItem>
                </TabControl>
            </Expander>
        </Border>

        <Border Grid.Row="1"
                Style="{StaticResource CardBorderStyle}"
                Padding="11"
                Margin="0,0,0,8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding StatusText, Mode=OneWay}"
                               FontSize="11"
                               FontWeight="SemiBold" />
                    <TextBlock Grid.Column="1"
                               Text="{Binding ProgressPercent, Mode=OneWay, StringFormat={}{0}%}"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               FontSize="10" />
                </Grid>

                <ProgressBar Grid.Row="1"
                             Value="{Binding ProgressPercent, Mode=OneWay}"
                             Maximum="100"
                             Height="5"
                             Margin="0,7,0,0"
                             BorderThickness="0"
                             Foreground="{DynamicResource AccentBrush}" />

                <TextBlock Grid.Row="2"
                           Text="{Binding SourceVerificationText, Mode=OneWay}"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           FontSize="9"
                           Margin="0,6,0,0"
                           TextWrapping="Wrap" />
            </Grid>
        </Border>

        <Grid Grid.Row="2"
              Margin="0,0,0,8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <UniformGrid Columns="9">
                <Border Style="{StaticResource CardBorderStyle}" Padding="10" Margin="0,0,6,0" Cursor="Hand" Tag="Purchase" MouseLeftButtonUp="SummaryTile_MouseLeftButtonUp" ToolTip="Open Purchase rows">
                    <StackPanel><TextBlock Text="{Binding Summary.PurchaseRows, Mode=OneWay}" Style="{StaticResource SummaryValueStyle}" /><TextBlock Text="PURCHASE" Style="{StaticResource SummaryLabelStyle}" /></StackPanel>
                </Border>
                <Border Style="{StaticResource CardBorderStyle}" Padding="10" Margin="0,0,6,0" Cursor="Hand" Tag="RCM" MouseLeftButtonUp="SummaryTile_MouseLeftButtonUp" ToolTip="Open RCM rows">
                    <StackPanel><TextBlock Text="{Binding Summary.RcmRows, Mode=OneWay}" Style="{StaticResource SummaryValueStyle}" /><TextBlock Text="RCM" Style="{StaticResource SummaryLabelStyle}" /></StackPanel>
                </Border>
                <Border Style="{StaticResource CardBorderStyle}" Padding="10" Margin="0,0,6,0" Cursor="Hand" Tag="Debit Notes" MouseLeftButtonUp="SummaryTile_MouseLeftButtonUp" ToolTip="Open Debit Note rows">
                    <StackPanel><TextBlock Text="{Binding Summary.DebitNoteRows, Mode=OneWay}" Style="{StaticResource SummaryValueStyle}" /><TextBlock Text="DEBIT NOTES" Style="{StaticResource SummaryLabelStyle}" /></StackPanel>
                </Border>
                <Border Style="{StaticResource CardBorderStyle}" Padding="10" Margin="0,0,6,0" Cursor="Hand" Tag="Debit Note Reverse" MouseLeftButtonUp="SummaryTile_MouseLeftButtonUp" ToolTip="Open supplier debit notes that increase Purchase/Input GST">
                    <StackPanel><TextBlock Text="{Binding Summary.DebitNoteReverseRows, Mode=OneWay}" Style="{StaticResource SummaryValueStyle}" /><TextBlock Text="DN REVERSE" Style="{StaticResource SummaryLabelStyle}" /></StackPanel>
                </Border>
                <Border Style="{StaticResource CardBorderStyle}" Padding="10" Margin="0,0,6,0" Cursor="Hand" Tag="Matched" MouseLeftButtonUp="SummaryTile_MouseLeftButtonUp" ToolTip="Open matched reconciliation rows">
                    <StackPanel><TextBlock Text="{Binding Summary.MatchedRows, Mode=OneWay}" Style="{StaticResource SummaryValueStyle}" /><TextBlock Text="MATCHED" Style="{StaticResource SummaryLabelStyle}" /></StackPanel>
                </Border>
                <Border Style="{StaticResource CardBorderStyle}" Padding="10" Margin="0,0,6,0" Cursor="Hand" Tag="2A Only" MouseLeftButtonUp="SummaryTile_MouseLeftButtonUp" ToolTip="Open 2A-only rows in reconciliation">
                    <StackPanel><TextBlock Text="{Binding Summary.TwoAOnlyRows, Mode=OneWay}" Style="{StaticResource SummaryValueStyle}" /><TextBlock Text="2A ONLY" Style="{StaticResource SummaryLabelStyle}" /></StackPanel>
                </Border>
                <Border Style="{StaticResource CardBorderStyle}" Padding="10" Margin="0,0,6,0" Cursor="Hand" Tag="2B Only" MouseLeftButtonUp="SummaryTile_MouseLeftButtonUp" ToolTip="Open 2B-only rows in reconciliation">
                    <StackPanel><TextBlock Text="{Binding Summary.TwoBOnlyRows, Mode=OneWay}" Style="{StaticResource SummaryValueStyle}" /><TextBlock Text="2B ONLY" Style="{StaticResource SummaryLabelStyle}" /></StackPanel>
                </Border>
                <Border Style="{StaticResource CardBorderStyle}" Padding="10" Margin="0,0,6,0" Cursor="Hand" Tag="Differences" MouseLeftButtonUp="SummaryTile_MouseLeftButtonUp" ToolTip="Open difference rows in reconciliation">
                    <StackPanel><TextBlock Text="{Binding Summary.DifferenceRows, Mode=OneWay}" Style="{StaticResource SummaryValueStyle}" /><TextBlock Text="DIFFERENCES" Style="{StaticResource SummaryLabelStyle}" /></StackPanel>
                </Border>
                <Border Style="{StaticResource CardBorderStyle}" Padding="10" Cursor="Hand" Tag="Issues" MouseLeftButtonUp="SummaryTile_MouseLeftButtonUp" ToolTip="Open Purchase import issues">
                    <StackPanel><TextBlock Text="{Binding Summary.InvalidRowsSkipped, Mode=OneWay}" Style="{StaticResource SummaryValueStyle}" /><TextBlock Text="INVALID" Style="{StaticResource SummaryLabelStyle}" /></StackPanel>
                </Border>
            </UniformGrid>

            <StackPanel Grid.Row="1"
                        Margin="0,6,0,0">
                <WrapPanel HorizontalAlignment="Right" Margin="0,0,0,6">
                    <Button Content="Open Journal" Click="OpenJournal_Click" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,6,0" ToolTip="Open the linked Journal Center (Ctrl+6)" />
                    <Button Content="Open GSTR-3B" Click="OpenGstr3b_Click" Style="{StaticResource SecondaryButtonStyle}" ToolTip="Open GSTR-3B Reconciliation (Ctrl+7)" />
                </WrapPanel>
                <Border Background="#FEF3C7"
                        BorderBrush="#FCD34D"
                        BorderThickness="1"
                        CornerRadius="7"
                        Padding="8"
                        Visibility="{Binding HasWarning, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <TextBlock Text="{Binding WarningText, Mode=OneWay}"
                               Foreground="#92400E"
                               FontSize="9"
                               TextWrapping="Wrap" />
                </Border>

                <Border Background="#FEE2E2"
                        BorderBrush="#FCA5A5"
                        BorderThickness="1"
                        CornerRadius="7"
                        Padding="8"
                        Margin="0,5,0,0"
                        Visibility="{Binding HasError, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <TextBlock Text="{Binding ErrorText, Mode=OneWay}"
                               Foreground="#991B1B"
                               FontSize="10"
                               FontWeight="SemiBold"
                               TextWrapping="Wrap" />
                </Border>
            </StackPanel>
        </Grid>

        <Border Grid.Row="3"
                Style="{StaticResource CardBorderStyle}"
                Padding="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0"
                        Background="#F8FAFC"
                        Padding="9"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="0,0,0,1">
                    <DockPanel LastChildFill="True">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Content="Reimport Purchase"
                                    Command="{Binding ReimportCommand}"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    ToolTip="Choose GSTINs to reimport for multiple registrations using the existing Purchase source importer." />
                            <Button x:Name="ReimportPurchaseMonthButton"
                                    Content="▼"
                                    Click="ReimportPurchaseMonthButton_Click"
                                    IsEnabled="{Binding CanReimportPurchase}"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Margin="2,0,0,0"
                                    MinWidth="30"
                                    Padding="7,4"
                                    ToolTip="Choose the Purchase month and registered GSTINs to reimport; other months and GSTINs stay intact.">
                                <Button.ContextMenu>
                                    <ContextMenu Placement="Bottom">
                                        <MenuItem Header="April" Tag="4" Click="ReimportPurchaseMonthMenuItem_Click" />
                                        <MenuItem Header="May" Tag="5" Click="ReimportPurchaseMonthMenuItem_Click" />
                                        <MenuItem Header="June" Tag="6" Click="ReimportPurchaseMonthMenuItem_Click" />
                                        <MenuItem Header="July" Tag="7" Click="ReimportPurchaseMonthMenuItem_Click" />
                                        <MenuItem Header="August" Tag="8" Click="ReimportPurchaseMonthMenuItem_Click" />
                                        <MenuItem Header="September" Tag="9" Click="ReimportPurchaseMonthMenuItem_Click" />
                                        <MenuItem Header="October" Tag="10" Click="ReimportPurchaseMonthMenuItem_Click" />
                                        <MenuItem Header="November" Tag="11" Click="ReimportPurchaseMonthMenuItem_Click" />
                                        <MenuItem Header="December" Tag="12" Click="ReimportPurchaseMonthMenuItem_Click" />
                                        <MenuItem Header="January" Tag="1" Click="ReimportPurchaseMonthMenuItem_Click" />
                                        <MenuItem Header="February" Tag="2" Click="ReimportPurchaseMonthMenuItem_Click" />
                                        <MenuItem Header="March" Tag="3" Click="ReimportPurchaseMonthMenuItem_Click" />
                                    </ContextMenu>
                                </Button.ContextMenu>
                            </Button>
                            <Button Content="Import Purchase Sheet"
                                    Command="{Binding ManualPurchaseSheetImportCommand}"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Margin="6,0,0,0"
                                    ToolTip="Manually import an Excel/CSV Purchase Register into this Client + FY using the shared Purchase profile, duplicate, stock, Journal and GST refresh pipeline."/>
                            <Button Content="Remap"
                                    Command="{Binding RemapPurchaseSheetCommand}"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Margin="2,0,0,0" Padding="8,4" MinWidth="54"
                                    ToolTip="Open and replace the saved mapping profile for a Purchase workbook format without importing rows."/>
                            <Button Content="Item Names" Command="{Binding ItemNameMappingCommand}" Style="{StaticResource SecondaryButtonStyle}" Margin="6,0,0,0" ToolTip="Enter/select an Item Name and apply it to all inventory-eligible Purchase entries or only selected entries. Blank Item Name rows are included."/>
                            <Button Content="Units" Command="{Binding UnitMappingCommand}" Style="{StaticResource SecondaryButtonStyle}" Margin="6,0,0,0" ToolTip="Map Purchase item units to the controlled AAH Unit catalogue. Deterministic physical/count conversions automatically adjust quantity and rate; package contents require an explicit factor."/>
                            <Button Content="Quantity Conversion" Command="{Binding QuantityConversionCommand}" Style="{StaticResource SecondaryButtonStyle}" Margin="6,0,0,0" ToolTip="Convert Purchase quantity/rate from original imported values and optionally remember the item-specific rule."/>
                            <Button Content="Clear Module" Command="{Binding ClearModuleCommand}" Style="{StaticResource SecondaryButtonStyle}" Margin="6,0,0,0" ToolTip="Clear Purchase/RCM/Debit Note transactions for the selected Client + FY. Masters, mappings, source links and Tally vouchers are preserved."/>
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="Invoice rows are editable"
                                       FontSize="11"
                                       FontWeight="SemiBold" />
                            <TextBlock Text="Purchase/RCM/Debit Note rows share Stock Item, Unit and Quantity Conversion rules with Sales. Import Purchase Sheet uses the normal Purchase header-mapping and duplicate-safe Books pipeline. Inventory-enabled rows export through Tally item-invoice XML; changes save automatically and rebuild linked Journal/GST."
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       FontSize="9"
                                       Margin="0,2,0,0" />
                            <TextBlock Text="{Binding EditStatusText, Mode=OneWay}"
                                       Foreground="{DynamicResource AccentBrush}"
                                       FontSize="9"
                                       FontWeight="SemiBold"
                                       Margin="0,2,0,0" />
                        </StackPanel>
                    </DockPanel>
                </Border>

                <TabControl x:Name="RecordsTabs" Grid.Row="1">
                    <TabItem Header="Purchase">
                        <views:PurchaseRecordsGrid ItemsSource="{Binding PurchaseRows, Mode=OneWay}" FinancialYearStart="{Binding FinancialYearStart}" FinancialYearEnd="{Binding FinancialYearEnd}" />
                    </TabItem>
                    <TabItem Header="RCM">
                        <views:PurchaseRecordsGrid ItemsSource="{Binding RcmRows, Mode=OneWay}" FinancialYearStart="{Binding FinancialYearStart}" FinancialYearEnd="{Binding FinancialYearEnd}" />
                    </TabItem>
                    <TabItem Header="Debit Notes">
                        <views:PurchaseRecordsGrid ItemsSource="{Binding DebitNoteRows, Mode=OneWay}" FinancialYearStart="{Binding FinancialYearStart}" FinancialYearEnd="{Binding FinancialYearEnd}" />
                    </TabItem>
                    <TabItem Header="Debit Note Reverse" ToolTip="Supplier-issued debit notes: add to Purchase/Input GST; Tally export uses Credit Note with Purchase/Input GST debit and Supplier credit.">
                        <views:PurchaseRecordsGrid ItemsSource="{Binding DebitNoteReverseRows, Mode=OneWay}" FinancialYearStart="{Binding FinancialYearStart}" FinancialYearEnd="{Binding FinancialYearEnd}" />
                    </TabItem>
                    <TabItem Header="All / Recon">
                        <views:PurchaseRecordsGrid ItemsSource="{Binding ReconciliationRows, Mode=OneWay}" FinancialYearStart="{Binding FinancialYearStart}" FinancialYearEnd="{Binding FinancialYearEnd}" ShowTwoBOnlyAction="True" />
                    </TabItem>
                    <TabItem Header="Issues">
                        <DataGrid ItemsSource="{Binding Issues, Mode=OneWay}"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  CanUserAddRows="False"
                                  HeadersVisibility="Column"
                                  GridLinesVisibility="Horizontal"
                                  AlternatingRowBackground="#F8FAFC"
                                  BorderThickness="0"
                                  RowHeaderWidth="0">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Source File" Binding="{Binding SourceFile}" Width="220" />
                                <DataGridTextColumn Header="Sheet" Binding="{Binding SheetName}" Width="140" />
                                <DataGridTextColumn Header="Row" Binding="{Binding RowNumber}" Width="70" />
                                <DataGridTextColumn Header="Issue" Binding="{Binding Message}" Width="*" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </TabItem>
                </TabControl>
            </Grid>
        </Border>
    </Grid>
</UserControl>
