<Window x:Class="AccountingAutomationHub.Desktop.Views.RemoteAssistViewerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AAH Remote Assist Viewer"
        Width="1280" Height="820" MinWidth="900" MinHeight="600"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource AppBackgroundBrush}">
    <Grid Margin="10">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,8" Padding="10">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Live AAH Remote Assist" FontSize="18" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding RemoteTargetSummary, Mode=OneWay}" TextWrapping="Wrap" Margin="0,3,0,0"/>
                    <TextBlock Text="{Binding RemoteAssistAccessSummary, Mode=OneWay}" TextWrapping="Wrap" FontWeight="SemiBold" Margin="0,3,0,0"/>
                    <TextBlock Text="{Binding RemoteAssistTransportSummary, Mode=OneWay}" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,3,0,0"/>
                </StackPanel>
                <WrapPanel Grid.Column="1" VerticalAlignment="Center">
                    <Button Content="End Access" Command="{Binding EndRemoteAssistCommand}" Padding="10,6" Margin="0,0,8,0"/>
                    <Button Content="Force Open AAH" Command="{Binding ForceOpenAahCommand}" Padding="10,6"/>
                </WrapPanel>
            </Grid>
        </Border>
        <Border Grid.Row="1" Background="#111827" BorderBrush="#374151" BorderThickness="1" CornerRadius="6" Focusable="True"
                x:Name="Viewer" PreviewMouseDown="Viewer_PreviewMouseDown" PreviewMouseUp="Viewer_PreviewMouseUp"
                MouseMove="Viewer_MouseMove" MouseWheel="Viewer_MouseWheel"
                PreviewKeyDown="Viewer_PreviewKeyDown" PreviewKeyUp="Viewer_PreviewKeyUp" PreviewTextInput="Viewer_PreviewTextInput">
            <Grid>
                <Image x:Name="FrameImage" Source="{Binding RemoteAssistRemoteFrame, Mode=OneWay}" Stretch="Uniform"/>
                <Border VerticalAlignment="Top" HorizontalAlignment="Left" Background="#99111827" CornerRadius="4" Padding="8,5" Margin="8" IsHitTestVisible="False">
                    <TextBlock Text="REMOTE AAH · click inside to control when allowed" Foreground="White" FontSize="12"/>
                </Border>
            </Grid>
        </Border>
        <Grid Grid.Row="2" Margin="0,8,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock Text="{Binding RemoteAssistStreamStatus, Mode=OneWay}" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
            <WrapPanel Grid.Column="1" Margin="10,0,0,0">
                <CheckBox Content="Share my Main Server AAH" IsChecked="{Binding ShareAdministratorAah}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <CheckBox Content="Allow LAN control of Main Server AAH" IsChecked="{Binding AllowRemoteControlOfAdministrator}" IsEnabled="{Binding IsPrimaryAdministrator}" VerticalAlignment="Center"/>
            </WrapPanel>
        </Grid>
    </Grid>
</Window>
