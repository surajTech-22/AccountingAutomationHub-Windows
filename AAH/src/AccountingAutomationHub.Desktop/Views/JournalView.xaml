<UserControl x:Class="AccountingAutomationHub.Desktop.Views.JournalView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:AccountingAutomationHub.Desktop.Controls">
    <UserControl.Resources>
        <DataTemplate x:Key="JournalLedgerPickerItemTemplate">
            <Grid MinWidth="500" Margin="6,4" ToolTip="{Binding HoverText}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="{Binding Name, Mode=OneWay}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding GroupText, Mode=OneWay}" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}"/>
                </StackPanel>
                <StackPanel Grid.Column="1" HorizontalAlignment="Right" Margin="16,0,0,0">
                    <TextBlock Text="{Binding BalanceText, Mode=OneWay}" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                    <TextBlock Text="{Binding ActivityText, Mode=OneWay}" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Right"/>
                </StackPanel>
            </Grid>
        </DataTemplate>
    </UserControl.Resources>
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Style="{StaticResource CardBorderStyle}"
                Padding="12"
                Margin="0,0,0,8">
            <StackPanel>
                <DockPanel LastChildFill="True">
                    <StackPanel DockPanel.Dock="Left" Margin="0,0,18,6">
                        <TextBlock Text="Journal Center" FontSize="17" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding FilingFrequencySource}"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   FontSize="10"
                                   TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding FilingFrequencySource}" />
                        <TextBlock Text="{Binding JournalPermissionSummary}"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   FontSize="10"
                                   Margin="0,2,0,0" />
                    </StackPanel>
                    <WrapPanel HorizontalAlignment="Right">
                        <Button Content="Generate GST Journal" Command="{Binding GenerateCommand}" Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,8,6" />
                        <Button Content="Open GSTR-3B" Click="OpenGstr3b_Click" Padding="12,7" Margin="0,0,8,6" ToolTip="Open GSTR-3B Reconciliation (Ctrl+7)" />
                        <Button Content="New Manual Voucher" Command="{Binding AddManualCommand}" Padding="12,7" Margin="0,0,8,6" />
                        <Button Content="Save Voucher" Command="{Binding SaveVoucherCommand}" Padding="12,7" Margin="0,0,8,6" />
                        <Button Content="Delete Voucher" Command="{Binding DeleteVoucherCommand}" Padding="12,7" Margin="0,0,8,6" />
                        <Button Content="Refresh" Command="{Binding RefreshCommand}" Padding="12,7" Margin="0,0,0,6" />
                    </WrapPanel>
                </DockPanel>

                <WrapPanel Margin="0,5,0,0">
                    <StackPanel Margin="0,0,16,8">
                        <TextBlock Text="Filing Frequency" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4" />
                        <StackPanel Orientation="Horizontal" IsEnabled="{Binding CanEditFilingFrequency}">
                            <RadioButton Content="Monthly" GroupName="JournalFilingFrequency" Style="{StaticResource SegmentedRadioButtonStyle}" IsChecked="{Binding IsMonthlyFiling, Mode=TwoWay}" />
                            <RadioButton Content="Quarterly" GroupName="JournalFilingFrequency" Style="{StaticResource SegmentedRadioButtonStyle}" IsChecked="{Binding IsQuarterlyFiling, Mode=TwoWay}" />
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Margin="0,0,16,8">
                        <TextBlock Text="Settlement Mode" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4" />
                        <StackPanel Orientation="Horizontal" IsEnabled="{Binding CanEditJournal}">
                            <RadioButton Content="Single Ledger" GroupName="JournalSettlementMode" Style="{StaticResource SegmentedRadioButtonStyle}" IsChecked="{Binding IsSingleSettlementMode, Mode=TwoWay}" />
                            <RadioButton Content="Separate Ledgers" GroupName="JournalSettlementMode" Style="{StaticResource SegmentedRadioButtonStyle}" IsChecked="{Binding IsSeparateSettlementMode, Mode=TwoWay}" />
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Margin="0,0,16,8">
                        <TextBlock Text="Balance Type" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4" />
                        <StackPanel Orientation="Horizontal" IsEnabled="{Binding CanEditJournal}">
                            <RadioButton Content="Payable" GroupName="JournalBalanceType" Style="{StaticResource SegmentedRadioButtonStyle}" IsChecked="{Binding IsPayableBalance, Mode=TwoWay}" />
                            <RadioButton Content="Receivable" GroupName="JournalBalanceType" Style="{StaticResource SegmentedRadioButtonStyle}" IsChecked="{Binding IsReceivableBalance, Mode=TwoWay}" />
                        </StackPanel>
                    </StackPanel>
                    <Button Content="Save Settings" Command="{Binding SaveSettingsCommand}" Padding="12,7" VerticalAlignment="Bottom" Margin="0,0,0,8" />
                </WrapPanel>

                <Expander Header="Settlement and RCM ledger names" IsExpanded="False" Margin="0,4,0,0" IsEnabled="{Binding CanEditJournal}">
                    <StackPanel Margin="0,8,0,0">
                        <Border Background="{DynamicResource SurfaceAltBrush}" CornerRadius="8" Padding="10">
                            <StackPanel>
                                <StackPanel Visibility="{Binding IsSingleSettlementMode, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <TextBlock Text="Single Settlement Ledger" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" />
                                    <controls:SearchableComboBox OpenOnFocus="True" SourceItems="{Binding MasterLedgerOptions}"
                                                                      Text="{Binding SingleSettlementLedger, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                      AllowCustomText="True"
                                                                      EnableMouseWheelSelection="False"
                                                                      MinWidth="290"
                                              HorizontalAlignment="Left"
                                              Margin="0,4,0,0" />
                                </StackPanel>

                                <WrapPanel Visibility="{Binding IsSeparateSettlementMode, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <StackPanel Width="270" Margin="0,0,12,0">
                                        <TextBlock Text="IGST Settlement Ledger" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" />
                                        <controls:SearchableComboBox OpenOnFocus="True" SourceItems="{Binding MasterLedgerOptions}" Text="{Binding IgstSettlementLedger, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AllowCustomText="True" EnableMouseWheelSelection="False" Margin="0,4,0,0" />
                                    </StackPanel>
                                    <StackPanel Width="270" Margin="0,0,12,0">
                                        <TextBlock Text="CGST Settlement Ledger" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" />
                                        <controls:SearchableComboBox OpenOnFocus="True" SourceItems="{Binding MasterLedgerOptions}" Text="{Binding CgstSettlementLedger, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AllowCustomText="True" EnableMouseWheelSelection="False" Margin="0,4,0,0" />
                                    </StackPanel>
                                    <StackPanel Width="270">
                                        <TextBlock Text="SGST Settlement Ledger" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" />
                                        <controls:SearchableComboBox OpenOnFocus="True" SourceItems="{Binding MasterLedgerOptions}" Text="{Binding SgstSettlementLedger, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AllowCustomText="True" EnableMouseWheelSelection="False" Margin="0,4,0,0" />
                                    </StackPanel>
                                </WrapPanel>

                                <Grid Margin="0,10,0,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="12" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Opening Books Balance" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" />
                                        <TextBox Text="{Binding OpeningBooksBalance, Mode=OneWay, StringFormat=N2}" IsReadOnly="True" Width="170" Padding="8,5" Margin="0,4,0,0" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" Text="{Binding OpeningBalanceStatus}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="10" TextWrapping="Wrap" VerticalAlignment="Center" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="RCM Ledger Names" FontWeight="SemiBold" Margin="0,12,0,5" />
                        <DataGrid ItemsSource="{Binding RcmLedgerRenames}"
                                  IsReadOnly="{Binding IsJournalReadOnly}"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  CanUserDeleteRows="False"
                                  HeadersVisibility="Column"
                                  RowHeaderWidth="0"
                                  MaxHeight="250">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Existing automatic name" Binding="{Binding ExistingName}" IsReadOnly="True" Width="*" MinWidth="250" />
                                <DataGridTextColumn Header="Rename value" Binding="{Binding RenameValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="*" MinWidth="250" />
                            </DataGrid.Columns>
                        </DataGrid>
                        <WrapPanel Margin="0,9,0,0">
                            <Button Content="Save Names" Command="{Binding SaveRcmNamesCommand}" Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,8,0" />
                            <Button Content="Restore Automatic Names" Command="{Binding RestoreAutomaticRcmNamesCommand}" Padding="12,7" />
                        </WrapPanel>
                    </StackPanel>
                </Expander>
            </StackPanel>
        </Border>


        <controls:MultiSearchFilterBar x:Name="JournalSearchFilterBar" Grid.Row="1" Margin="0,0,0,8" />

        <TabControl x:Name="JournalTabs" Grid.Row="2">
            <TabItem Header="Summary">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="Workbook Journal summary (H:M): Input GST − Output GST, cumulative Closing Balance and Difference. Double-click a period, press Enter, or use Open to jump to its voucher."
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               TextWrapping="Wrap"
                               Margin="4,2,4,8" />
                    <DataGrid x:Name="SummaryGrid"
                              Grid.Row="1"
                              ItemsSource="{Binding SummaryRows}"
                              MouseDoubleClick="SummaryGrid_MouseDoubleClick"
                              PreviewKeyDown="SummaryGrid_PreviewKeyDown"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              IsReadOnly="True"
                              RowHeaderWidth="0">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Particulars" Binding="{Binding Particulars}" Width="2*" />
                            <DataGridTextColumn Header="Output GST" Binding="{Binding OutputGst, StringFormat=N2}" Width="*" />
                            <DataGridTextColumn Header="Input GST" Binding="{Binding InputGst, StringFormat=N2}" Width="*" />
                            <DataGridTextColumn Header="RCM GST" Binding="{Binding RcmGst, StringFormat=N2}" Width="*" />
                            <DataGridTextColumn Header="RCM Claimed" Binding="{Binding RcmClaimed, StringFormat=N2}" Width="*" />
                            <DataGridTextColumn Header="RCM Reversed" Binding="{Binding RcmReversed, StringFormat=N2}" Width="*" />
                            <DataGridTextColumn Header="Net GST" Binding="{Binding NetGst, StringFormat=N2}" Width="*" />
                            <DataGridTextColumn Header="Closing Balance" Binding="{Binding ClosingBalance, StringFormat=N2}" Width="*" />
                            <DataGridTextColumn Header="Difference" Binding="{Binding Difference, StringFormat=N2}" Width="*" />
                            <DataGridTextColumn Header="Evidence" Binding="{Binding EvidenceStatus}" Width="2*" />
                            <DataGridTemplateColumn Header="" Width="74">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="Open" Click="SummaryOpen_Click" Padding="9,3" ToolTip="Open this period in Vouchers" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <TabItem Header="Vouchers">
                <Grid Margin="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="390" MinWidth="330" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="*" MinWidth="420" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource CardBorderStyle}" Padding="0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0" Margin="12,10,12,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Vouchers" FontWeight="SemiBold" FontSize="14" />
                                    <TextBlock Text="Manual adjustments coexist with automatic period vouchers"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               FontSize="10" TextWrapping="Wrap" />
                                </StackPanel>
                                <TextBlock Grid.Column="1" Text="{Binding Vouchers.Count}" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center" />
                            </Grid>
                            <DataGrid x:Name="VoucherGrid"
                                      Grid.Row="1"
                                      ItemsSource="{Binding Vouchers}"
                                      SelectedItem="{Binding SelectedVoucher}"
                                      AutoGenerateColumns="False"
                                      CanUserAddRows="False"
                                      CanUserDeleteRows="False"
                                      IsReadOnly="True"
                                      SelectionMode="Single"
                                      SelectionUnit="FullRow"
                                      RowHeaderWidth="0"
                                      BorderThickness="0"
                                      PreviewKeyDown="VoucherGrid_PreviewKeyDown">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Period" Binding="{Binding PeriodLabel}" Width="100" />
                                    <DataGridTextColumn Header="Voucher" Binding="{Binding VoucherNumber}" Width="145" />
                                    <DataGridTextColumn Header="Mode" Binding="{Binding GenerationMode}" Width="75" />
                                    <DataGridTextColumn Header="Workflow" Binding="{Binding WorkflowStatus}" Width="80" />
                                </DataGrid.Columns>
                            </DataGrid>
                            <Border Grid.Row="2" Padding="12,8" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource BorderBrush}">
                                <StackPanel>
                                    <TextBlock Text="{Binding ManualVoucherCount, StringFormat={}{0:N0} manual adjustment(s)}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="10" />
                                    <TextBlock Text="{Binding ProtectedVoucherCount, StringFormat={}{0:N0} edited automatic voucher(s)}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="10" />
                                    <TextBlock Text="{Binding TotalNetTax, StringFormat=Reconciliation net GST: {0:N2}}" FontWeight="SemiBold" Margin="0,2,0,0" />
                                    <TextBlock FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0">
                                        <Run Text="Draft: "/><Run Text="{Binding DraftJournalCount, Mode=OneWay}"/><Run Text=" · Ready: "/><Run Text="{Binding ReadyJournalCount, Mode=OneWay}"/><Run Text=" · Approved: "/><Run Text="{Binding ApprovedJournalCount, Mode=OneWay}"/><Run Text=" · Recurring-created: "/><Run Text="{Binding RecurringJournalCount, Mode=OneWay}"/><Run Text=" · Reversals: "/><Run Text="{Binding ReversedJournalCount, Mode=OneWay}"/>
                                    </TextBlock>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>

                    <GridSplitter Grid.Column="1" Width="8" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="Transparent" />

                    <Border Grid.Column="2" Style="{StaticResource CardBorderStyle}" Padding="0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0" Margin="12,10,12,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{Binding SelectedVoucherHeading}" FontWeight="SemiBold" FontSize="14" />
                                    <TextBlock Text="Ctrl+V previews a multi-cell Excel block. Delete removes the selected line. Ctrl+S saves. Insert adds a line."
                                               Foreground="{DynamicResource TextSecondaryBrush}" FontSize="10" TextWrapping="Wrap" />
                                </StackPanel>
                                <WrapPanel Grid.Column="1" HorizontalAlignment="Right">
                                    <Button Content="Clone" Click="AdvancedCloneJournal_Click" IsEnabled="{Binding CanEditJournal}" Padding="10,6" Margin="0,0,8,0" ToolTip="Specific Amount Clone or Bulk Amount Divide with working-day scheduling" />
                                    <Button Content="Reverse" Command="{Binding ReverseJournalCommand}" Padding="10,6" Margin="0,0,8,0" />
                                    <Button Content="Recurring" Click="RecurringJournal_Click" IsEnabled="{Binding CanEditJournal}" Padding="10,6" Margin="0,0,8,0" />
                                    <Button Content="Approve" Command="{Binding ApproveJournalCommand}" Padding="10,6" Margin="0,0,8,0" />
                                    <Button Content="Add Line" Command="{Binding AddLineCommand}" Padding="10,6" Margin="0,0,8,0" />
                                    <Button Content="Preview Lines" Command="{Binding PasteLinesCommand}" Padding="10,6" Margin="0,0,8,0" />
                                    <Button Content="Delete Line" Command="{Binding DeleteLineCommand}" Padding="10,6" />
                                </WrapPanel>
                            </Grid>

                            <Border Grid.Row="1" Margin="12,0,12,8" Padding="10" Background="{DynamicResource SurfaceAltBrush}" CornerRadius="6">
                                <StackPanel IsEnabled="{Binding CanEditJournal}">
                                    <WrapPanel>
                                        <StackPanel Width="145" Margin="0,0,12,8">
                                            <TextBlock Text="Date" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" />
                                            <DatePicker SelectedDate="{Binding SelectedVoucher.VoucherDate, UpdateSourceTrigger=PropertyChanged}" SelectedDateChanged="VoucherDate_SelectedDateChanged" Margin="0,4,0,0" />
                                        </StackPanel>
                                        <StackPanel Width="205" Margin="0,0,12,8">
                                            <TextBlock Text="Voucher Number" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" />
                                            <TextBox Text="{Binding SelectedVoucher.VoucherNumber, UpdateSourceTrigger=PropertyChanged}" Padding="8,5" Margin="0,4,0,0" />
                                        </StackPanel>
                                        <StackPanel Width="155" Margin="0,0,12,8">
                                            <TextBlock Text="Voucher Type" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" />
                                            <controls:SearchableComboBox OpenOnFocus="True" SourceItems="{Binding VoucherTypeOptions}"
                                                                              Text="{Binding SelectedVoucher.VoucherType, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                              AllowCustomText="True"
                                                                              EnableMouseWheelSelection="False"
                                                                              Margin="0,4,0,0" />
                                        </StackPanel>
                                        <StackPanel Width="180" Margin="0,0,12,8">
                                            <TextBlock Text="Reference" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" />
                                            <TextBox Text="{Binding SelectedVoucher.ReferenceNumber, UpdateSourceTrigger=PropertyChanged}" Padding="8,5" Margin="0,4,0,0"/>
                                        </StackPanel>
                                        <StackPanel Width="180" Margin="0,0,0,8">
                                            <TextBlock Text="Mode / Workflow" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" />
                                            <TextBlock Margin="0,8,0,0">
                                                <Run Text="{Binding SelectedVoucher.GenerationMode, Mode=OneWay}" />
                                                <Run Text=" · " />
                                                <Run Text="{Binding SelectedVoucher.WorkflowStatus, Mode=OneWay}" />
                                            </TextBlock>
                                        </StackPanel>
                                    </WrapPanel>
                                    <StackPanel>
                                        <TextBlock Text="Narration" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" />
                                        <TextBox Text="{Binding SelectedVoucher.Narration, UpdateSourceTrigger=PropertyChanged}" Padding="8,5" Margin="0,4,0,0" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <DataGrid x:Name="LineGrid"
                                      Grid.Row="2"
                                      ItemsSource="{Binding Lines}"
                                      SelectedItem="{Binding SelectedLine}"
                                      AutoGenerateColumns="False"
                                      CanUserAddRows="False"
                                      CanUserDeleteRows="False"
                                      IsReadOnly="{Binding IsJournalReadOnly}"
                                      RowHeaderWidth="0"
                                      BorderThickness="0"
                                      SelectionUnit="CellOrRowHeader"
                                      PreviewKeyDown="LineGrid_PreviewKeyDown"
                                      PreviewTextInput="LineGrid_PreviewTextInput">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="#" Binding="{Binding LineNumber}" Width="45" IsReadOnly="True" />
                                                                        <DataGridTemplateColumn Header="Ledger" Width="2*">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <controls:SearchableComboBox IsEnabled="{Binding DataContext.CanEditJournal, RelativeSource={RelativeSource AncestorType=DataGrid}}" OpenOnFocus="True" SourceItems="{Binding DataContext.LedgerPickerOptions, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                                                 Text="{Binding LedgerName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                                 ItemTemplate="{StaticResource JournalLedgerPickerItemTemplate}"
                                                                                 HorizontalContentAlignment="Stretch"
                                                                                 AllowCustomText="True"
                                                                                 HandleEnterKey="False"
                                                                                 EnableMouseWheelSelection="False"
                                                                                 BorderThickness="0"
                                                                                 Background="Transparent"
                                                                                 ToolTip="Type to search by Ledger, Group or balance. Unknown manual Ledgers remain allowed and go to Ledger Mapping." />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="Debit" Binding="{Binding DebitAmount, UpdateSourceTrigger=PropertyChanged, StringFormat=N2}" Width="115" />
                                    <DataGridTextColumn Header="Credit" Binding="{Binding CreditAmount, UpdateSourceTrigger=PropertyChanged, StringFormat=N2}" Width="115" />
                                    <DataGridTemplateColumn Header="Tax Head" Width="105">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <controls:SearchableComboBox IsEnabled="{Binding DataContext.CanEditJournal, RelativeSource={RelativeSource AncestorType=DataGrid}}" OpenOnFocus="True" SourceItems="{Binding DataContext.TaxHeadOptions, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                                                 Text="{Binding TaxHead, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                                 AllowCustomText="True"
                                                                                 HandleEnterKey="False"
                                                                                 EnableMouseWheelSelection="False"
                                                                                 BorderThickness="0" Background="Transparent" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="Role" Width="180">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <controls:SearchableComboBox IsEnabled="{Binding DataContext.CanEditJournal, RelativeSource={RelativeSource AncestorType=DataGrid}}" OpenOnFocus="True" SourceItems="{Binding DataContext.LineRoleOptions, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                                                 Text="{Binding LineRole, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                                 AllowCustomText="True"
                                                                                 HandleEnterKey="False"
                                                                                 EnableMouseWheelSelection="False"
                                                                                 BorderThickness="0" Background="Transparent" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>

                            <Border Grid.Row="3" Padding="12,9" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource BorderBrush}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,0,24,0">
                                        <TextBlock Text="Selected Ledger Total" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,2,0,2">
                                            <TextBlock Text="{Binding SelectedJournalLedgerName, Mode=OneWay}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="  •  " Foreground="{DynamicResource TextSecondaryBrush}"/>
                                            <TextBlock Text="{Binding SelectedJournalLedgerGroup, Mode=OneWay}" Foreground="{DynamicResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                        <WrapPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,18,2">
                                                <TextBlock Text="Opening " Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                <TextBlock Text="{Binding SelectedJournalLedgerOpeningText, Mode=OneWay}" FontWeight="SemiBold"/>
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,18,2">
                                                <TextBlock Text="{Binding SelectedJournalLedgerAsOnLabel, Mode=OneWay}" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                <TextBlock Text="  "/><TextBlock Text="{Binding SelectedJournalLedgerAsOnText, Mode=OneWay}" FontWeight="SemiBold"/>
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,18,2">
                                                <TextBlock Text="FY Closing " Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                <TextBlock Text="{Binding SelectedJournalLedgerClosingText, Mode=OneWay}" FontWeight="SemiBold"/>
                                            </StackPanel>
                                        </WrapPanel>
                                        <TextBlock Text="{Binding SelectedJournalLedgerMovementText, Mode=OneWay}" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                                        <TextBlock Text="{Binding SelectedJournalLedgerTotalStatus, Mode=OneWay}" FontSize="9" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding BalanceStatusText}" FontWeight="SemiBold" HorizontalAlignment="Right" Margin="0,0,0,4"/>
                                        <WrapPanel HorizontalAlignment="Right">
                                            <StackPanel Orientation="Horizontal" Margin="0,0,18,4">
                                                <TextBlock Text="Debit " Foreground="{DynamicResource TextSecondaryBrush}" />
                                                <TextBlock Text="{Binding SelectedDebitTotal, StringFormat=N2}" FontWeight="SemiBold" />
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,18,4">
                                                <TextBlock Text="Credit " Foreground="{DynamicResource TextSecondaryBrush}" />
                                                <TextBlock Text="{Binding SelectedCreditTotal, StringFormat=N2}" FontWeight="SemiBold" />
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                                <TextBlock Text="Difference " Foreground="{DynamicResource TextSecondaryBrush}" />
                                                <TextBlock Text="{Binding SelectedDifference, StringFormat=N2}" FontWeight="SemiBold" />
                                            </StackPanel>
                                        </WrapPanel>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem Header="Paste / Import Preview">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="2*" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <WrapPanel>
                        <Button Content="Preview Workbook / CSV" Command="{Binding ImportManualExcelCommand}" Padding="12,7" Margin="0,0,8,6" />
                        <Button Content="Smart Preview Clipboard" Command="{Binding PasteManualCommand}" Padding="12,7" Margin="0,0,8,6" />
                        <Button Content="Preview Lines Only" Command="{Binding PasteLinesCommand}" Padding="12,7" Margin="0,0,8,6" />
                        <Button Content="Export Excel Format" Command="{Binding ExportExcelFormatCommand}" Padding="12,7" Margin="0,0,8,6" ToolTip="Export the Journal .xlsx format. Completed files placed in the Automation Folder are auto-imported as Journal." />
                        <Button Content="Copy Full Template" Command="{Binding CopyPasteTemplateCommand}" Padding="12,7" Margin="0,0,8,6" />
                        <Button Content="Copy Line Template" Command="{Binding CopyLineTemplateCommand}" Padding="12,7" Margin="0,0,8,6" />
                        <CheckBox Content="Replace selected voucher lines when applying line preview"
                                  IsChecked="{Binding ReplaceSelectedVoucherLines}"
                                  VerticalAlignment="Center"
                                  Margin="8,0,8,6" />
                        <Button Content="Apply Preview" Command="{Binding ApplyPastePreviewCommand}" Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,8,6" />
                        <Button Content="Clear Preview" Command="{Binding ClearPastePreviewCommand}" Padding="12,7" Margin="0,0,0,6" />
                    </WrapPanel>

                    <Border Grid.Row="1" Padding="10" Margin="0,2,0,8" Background="{DynamicResource SurfaceAltBrush}" CornerRadius="6">
                        <StackPanel>
                            <TextBlock FontWeight="SemiBold">
                                <Run Text="{Binding PastePreviewMode, Mode=OneWay}" />
                                <Run Text=" · " />
                                <Run Text="{Binding PastePreviewSource, Mode=OneWay}" />
                            </TextBlock>
                            <TextBlock Text="{Binding PastePreviewSummary, Mode=OneWay}" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,3,0,0" />
                        </StackPanel>
                    </Border>

                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <GroupBox Header="Full-voucher preview" Padding="4">
                            <DataGrid ItemsSource="{Binding PastePreviewVouchers}"
                                      AutoGenerateColumns="False"
                                      CanUserAddRows="False"
                                      IsReadOnly="True"
                                      RowHeaderWidth="0">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Voucher" Binding="{Binding VoucherNumber}" Width="*" />
                                    <DataGridTextColumn Header="Date" Binding="{Binding VoucherDate, StringFormat=dd.MM.yyyy}" Width="100" />
                                    <DataGridTextColumn Header="Period" Binding="{Binding PeriodLabel}" Width="130" />
                                    <DataGridTextColumn Header="Lines" Binding="{Binding Lines.Count}" Width="60" />
                                    <DataGridTextColumn Header="Narration" Binding="{Binding Narration}" Width="2*" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </GroupBox>
                        <GridSplitter Grid.Column="1" Width="8" HorizontalAlignment="Stretch" Background="Transparent" />
                        <GroupBox Grid.Column="2" Header="Selected-voucher line preview" Padding="4">
                            <DataGrid ItemsSource="{Binding PastePreviewLines}"
                                      AutoGenerateColumns="False"
                                      CanUserAddRows="False"
                                      IsReadOnly="True"
                                      RowHeaderWidth="0">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Ledger" Binding="{Binding LedgerName}" Width="2*" />
                                    <DataGridTextColumn Header="Debit" Binding="{Binding DebitAmount, StringFormat=N2}" Width="100" />
                                    <DataGridTextColumn Header="Credit" Binding="{Binding CreditAmount, StringFormat=N2}" Width="100" />
                                    <DataGridTextColumn Header="Tax" Binding="{Binding TaxHead}" Width="80" />
                                    <DataGridTextColumn Header="Role" Binding="{Binding LineRole}" Width="150" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </GroupBox>
                    </Grid>

                    <GroupBox Grid.Row="3" Header="Warnings / rejected source rows" Padding="4" Margin="0,8,0,0">
                        <ListBox ItemsSource="{Binding PasteWarnings}" />
                    </GroupBox>
                </Grid>
            </TabItem>

            <TabItem Header="Ledger Mapping">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <DockPanel Margin="0,0,0,8">
                        <Button DockPanel.Dock="Right" Content="Refresh Mapping Queue" Command="{Binding RefreshLedgerMappingsCommand}" Padding="12,7" Margin="8,0,0,0" />
                        <Button DockPanel.Dock="Right" Content="Apply Selected Mapping" Command="{Binding ApplyLedgerMappingCommand}" Style="{StaticResource PrimaryButtonStyle}" Margin="8,0,0,0" Visibility="{Binding CanEditJournal, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        <TextBlock Text="Unknown manual Journal ledgers are not silently added to Master. Choose the same Master Group used in Tally/Excel, then apply."
                                   Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" VerticalAlignment="Center" />
                    </DockPanel>
                    <DataGrid Grid.Row="1"
                              ItemsSource="{Binding LedgerMappings}"
                              SelectedItem="{Binding SelectedLedgerMapping}"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              IsReadOnly="{Binding IsJournalReadOnly}"
                              RowHeaderWidth="0">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Ledger Name" Binding="{Binding LedgerName}" Width="2*" IsReadOnly="True" />
                            <DataGridTemplateColumn Header="Master Group" Width="2*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <controls:SearchableComboBox IsEnabled="{Binding DataContext.CanEditJournal, RelativeSource={RelativeSource AncestorType=DataGrid}}" OpenOnFocus="True" SourceItems="{Binding DataContext.MasterGroupOptions, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                                         Text="{Binding MasterGroup, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                         AllowCustomText="True"
                                                                         HandleEnterKey="False"
                                                                         EnableMouseWheelSelection="False" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="100" IsReadOnly="True" />
                            <DataGridTextColumn Header="Source" Binding="{Binding Source}" Width="150" IsReadOnly="True" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <TabItem Header="Balance Review">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <DockPanel Margin="0,0,0,8">
                        <Button DockPanel.Dock="Right" Content="Apply Balancing Line" Command="{Binding ApplyReconciliationCommand}" Style="{StaticResource PrimaryButtonStyle}" Margin="8,0,0,0" Visibility="{Binding CanEditJournal, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        <TextBlock Text="Legacy or imported unbalanced vouchers appear here. Enter the opposite ledger and apply the exact balancing amount. Normal saves continue to reject unbalanced vouchers."
                                   Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" VerticalAlignment="Center" />
                    </DockPanel>
                    <DataGrid Grid.Row="1"
                              ItemsSource="{Binding ReconciliationIssues}"
                              SelectedItem="{Binding SelectedReconciliationIssue}"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              IsReadOnly="{Binding IsJournalReadOnly}"
                              RowHeaderWidth="0">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Voucher" Binding="{Binding VoucherNumber}" Width="*" IsReadOnly="True" />
                            <DataGridTextColumn Header="Date" Binding="{Binding VoucherDate, StringFormat=dd.MM.yyyy}" Width="100" IsReadOnly="True" />
                            <DataGridTextColumn Header="Debit" Binding="{Binding DebitTotal, StringFormat=N2}" Width="100" IsReadOnly="True" />
                            <DataGridTextColumn Header="Credit" Binding="{Binding CreditTotal, StringFormat=N2}" Width="100" IsReadOnly="True" />
                            <DataGridTextColumn Header="Required Side" Binding="{Binding RequiredSide}" Width="95" IsReadOnly="True" />
                            <DataGridTextColumn Header="Required Amount" Binding="{Binding RequiredAmount, StringFormat=N2}" Width="115" IsReadOnly="True" />
                            <DataGridTextColumn Header="Matching Ledger" Binding="{Binding MatchingLedger, UpdateSourceTrigger=PropertyChanged}" Width="2*" />
                            <DataGridTextColumn Header="Narration" Binding="{Binding Narration}" Width="2*" IsReadOnly="True" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>
        </TabControl>

        <TextBlock Grid.Row="3"
                   Text="{Binding StatusText}"
                   Foreground="{DynamicResource TextSecondaryBrush}"
                   Margin="4,8,4,0"
                   TextWrapping="Wrap" />
    </Grid>
</UserControl>
