<Window x:Class="AccountingAutomationHub.Desktop.Views.AccountingReportsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="clr-namespace:AccountingAutomationHub.Desktop.Converters"
        Title="Reports &amp; Accounts" Width="1380" Height="820" MinWidth="1040" MinHeight="620"
        WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <converters:ZeroBlankDecimalConverter x:Key="ZeroBlankDecimalConverter"/>
    </Window.Resources>
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Reports &amp; Accounts" FontSize="22" FontWeight="SemiBold"/>
                <TextBlock x:Name="CompanyText" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,3,0,0"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                <Button Content="Export Excel" Click="ExportExcel_Click" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,6,0"/>
                <Button Content="Export PDF" Click="ExportPdf_Click" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,6,0"/>
                <Button Content="Export CSV" Click="ExportCsv_Click" Style="{StaticResource SecondaryButtonStyle}"/>
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" Style="{StaticResource CardBorderStyle}" Margin="0,12,0,8" Padding="10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="160"/><ColumnDefinition Width="260"/><ColumnDefinition Width="130"/><ColumnDefinition Width="130"/>
                    <ColumnDefinition Width="220"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,8,0"><TextBlock Text="Source" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}"/><ComboBox x:Name="SourceCombo" SelectionChanged="SourceCombo_SelectionChanged"/></StackPanel>
                <StackPanel Grid.Column="1" Margin="0,0,8,0"><TextBlock Text="Report" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}"/><ComboBox x:Name="ReportCombo" SelectionChanged="ReportCombo_SelectionChanged"/></StackPanel>
                <StackPanel Grid.Column="2" Margin="0,0,8,0"><TextBlock Text="From" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}"/><DatePicker x:Name="FromDatePicker"/></StackPanel>
                <StackPanel Grid.Column="3" Margin="0,0,8,0"><TextBlock Text="To" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}"/><DatePicker x:Name="ToDatePicker"/></StackPanel>
                <StackPanel Grid.Column="4" Margin="0,0,8,0"><TextBlock Text="Ledger (Ledger Vouchers)" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}"/><ComboBox x:Name="LedgerCombo" IsEditable="True" IsTextSearchEnabled="True"/></StackPanel>
                <StackPanel Grid.Column="5" Margin="0,0,8,0"><TextBlock Text="Search displayed report" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}"/><TextBox x:Name="SearchBox" TextChanged="SearchBox_TextChanged"/></StackPanel>
                <Button Grid.Column="6" Content="Refresh" Click="Refresh_Click" Style="{StaticResource PrimaryButtonStyle}" VerticalAlignment="Bottom" Padding="18,6"/>
            </Grid>
        </Border>

        <Grid Grid.Row="2" Margin="2,0,2,7">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock x:Name="ReportCaptionText" FontWeight="SemiBold"/>
            <TextBlock x:Name="RowCountText" Grid.Column="1" Foreground="{DynamicResource TextSecondaryBrush}"/>
        </Grid>

        <DataGrid x:Name="ReportGrid" Grid.Row="3" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False"
                  SelectionMode="Extended" SelectionUnit="FullRow" GridLinesVisibility="Horizontal" RowHeaderWidth="0">
            <DataGrid.Columns>
                <DataGridTextColumn x:Name="DateColumn" Header="Date" Binding="{Binding Date, StringFormat={}{0:dd.MM.yyyy}}" SortMemberPath="Date" Width="100"/>
                <DataGridTextColumn x:Name="VoucherTypeColumn" Header="Voucher Type" Binding="{Binding VoucherType}" Width="115"/>
                <DataGridTextColumn x:Name="VoucherNumberColumn" Header="Voucher / Ref" Binding="{Binding VoucherNumber}" Width="130"/>
                <DataGridTextColumn x:Name="ParticularsColumn" Header="Particulars" Binding="{Binding Particulars}" Width="2*"/>
                <DataGridTextColumn x:Name="GroupColumn" Header="Group" Binding="{Binding Group}" Width="180"/>
                <DataGridTextColumn x:Name="DetailColumn" Header="Detail / Narration" Binding="{Binding Detail}" Width="2*"/>
                <DataGridTextColumn x:Name="OpeningColumn" Header="Opening" Binding="{Binding Opening, Converter={StaticResource ZeroBlankDecimalConverter}}" SortMemberPath="Opening" Width="110"/>
                <DataGridTextColumn x:Name="DebitColumn" Header="Debit" Binding="{Binding Debit, Converter={StaticResource ZeroBlankDecimalConverter}}" SortMemberPath="Debit" Width="110"/>
                <DataGridTextColumn x:Name="CreditColumn" Header="Credit" Binding="{Binding Credit, Converter={StaticResource ZeroBlankDecimalConverter}}" SortMemberPath="Credit" Width="110"/>
                <DataGridTextColumn x:Name="AmountColumn" Header="Amount / Net" Binding="{Binding Amount, Converter={StaticResource ZeroBlankDecimalConverter}}" SortMemberPath="Amount" Width="115"/>
                <DataGridTextColumn x:Name="ClosingColumn" Header="Closing / Balance" Binding="{Binding Closing, Converter={StaticResource ZeroBlankDecimalConverter}}" SortMemberPath="Closing" Width="120"/>
                <DataGridTextColumn x:Name="QuantityColumn" Header="Quantity" Binding="{Binding Quantity, Converter={StaticResource ZeroBlankDecimalConverter}}" SortMemberPath="Quantity" Width="95"/>
                <DataGridTextColumn x:Name="CountColumn" Header="Count" Binding="{Binding Count}" SortMemberPath="Count" Width="75"/>
            </DataGrid.Columns>
        </DataGrid>

        <TextBlock x:Name="StatusText" Grid.Row="4" Margin="2,8,2,0" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>
    </Grid>
</Window>
