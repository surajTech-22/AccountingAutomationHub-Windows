<UserControl x:Class="AccountingAutomationHub.Desktop.Views.ClientManagementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             PreviewKeyDown="ClientManagementView_PreviewKeyDown">
    <Grid Background="{DynamicResource AppBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Margin="20,20,20,0"
                Style="{StaticResource CardBorderStyle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock Text="Client Directory"
                               FontSize="25"
                               FontWeight="SemiBold"
                               Cursor="Hand"
                               ToolTip="In Group Wise view: click to go back one Group; double-click to return to the top directory"
                               PreviewMouseLeftButtonDown="ClientDirectoryTitle_PreviewMouseLeftButtonDown" />
                    <TextBlock x:Name="ClientDirectorySubtitle" Text="Open a client workspace, maintain profiles, and control client-wise remote availability and AAH user access."
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               Margin="0,6,0,0" />
                </StackPanel>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <Button Content="Open Selected"
                            Command="{Binding SetCurrentCommand}"
                            Padding="16,9"
                            Margin="0,0,8,0" />
                    <StackPanel x:Name="ClientMaintenanceActions" Orientation="Horizontal">
                        <Button Content="Client Groups"
                                Command="{Binding OpenGroupManagerCommand}"
                                Padding="16,9"
                                Margin="0,0,8,0"
                                ToolTip="Organise Clients with Firm, Company, CA, Auditor and Company Group hierarchy"/>
                        <Button Content="Edit Selected"
                                Command="{Binding EditSelectedCommand}"
                                Padding="16,9"
                                Margin="0,0,8,0" />
                        <Button Content="＋ Add New Client"
                                Command="{Binding NewCommand}"
                                Style="{StaticResource PrimaryButtonStyle}" />
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1"
              Margin="20,14,20,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource CardBorderStyle}" Padding="16">
                <StackPanel>
                    <TextBlock Text="TOTAL CLIENTS"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               FontSize="10"
                               FontWeight="SemiBold" />
                    <TextBlock Text="{Binding TotalCount}"
                               FontSize="24"
                               FontWeight="SemiBold"
                               Margin="0,5,0,0" />
                </StackPanel>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource CardBorderStyle}" Padding="16">
                <StackPanel>
                    <TextBlock Text="ACTIVE"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               FontSize="10"
                               FontWeight="SemiBold" />
                    <TextBlock Text="{Binding ActiveCount}"
                               FontSize="24"
                               FontWeight="SemiBold"
                               Margin="0,5,0,0" />
                </StackPanel>
            </Border>

            <Border Grid.Column="4" Style="{StaticResource CardBorderStyle}" Padding="16">
                <StackPanel>
                    <TextBlock Text="GSTIN AVAILABLE"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               FontSize="10"
                               FontWeight="SemiBold" />
                    <TextBlock Text="{Binding GstinCount}"
                               FontSize="24"
                               FontWeight="SemiBold"
                               Margin="0,5,0,0" />
                </StackPanel>
            </Border>

            <Border Grid.Column="6" Style="{StaticResource CardBorderStyle}" Padding="16">
                <StackPanel>
                    <TextBlock Text="PROFILE REVIEW"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               FontSize="10"
                               FontWeight="SemiBold" />
                    <TextBlock Text="{Binding NeedsProfileCount}"
                               FontSize="24"
                               FontWeight="SemiBold"
                               Margin="0,5,0,0" />
                </StackPanel>
            </Border>
        </Grid>

        <Border Grid.Row="2"
                Margin="20,14,20,0"
                Style="{StaticResource CardBorderStyle}"
                Padding="14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2.2*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="1.2*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBox x:Name="ClientSearchBox"
                         Grid.Column="0"
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                         Padding="11,8"
                         ToolTip="Search Client Code, Client Name, Trade Name, Legal Name, GSTIN, PAN or State" />

                <ComboBox Grid.Column="2"
                          ItemsSource="{Binding FinancialYearFilters}"
                          SelectedItem="{Binding SelectedFinancialYearFilter}"
                          Padding="8,6" />

                <CheckBox Grid.Column="4"
                          Content="Show archived"
                          IsChecked="{Binding IncludeArchived}"
                          VerticalAlignment="Center" />

                <StackPanel Grid.Column="5" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="Client Wise" VerticalAlignment="Center" Margin="0,0,7,0" FontSize="11">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="#0F766E"/>
                                <Setter Property="Opacity" Value="0.45"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsClientWiseDirectory}" Value="True">
                                        <Setter Property="Opacity" Value="1"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <ToggleButton Width="46" Height="24" Margin="0,0,7,0"
                                  IsChecked="{Binding IsGroupWiseDirectory, Mode=OneWay}"
                                  Command="{Binding ToggleClientDirectoryViewCommand}"
                                  ToolTip="Switch between Client Wise and Group Wise">
                        <ToggleButton.Template>
                            <ControlTemplate TargetType="{x:Type ToggleButton}">
                                <Border x:Name="SwitchTrack" Background="{DynamicResource SurfaceAltBrush}"
                                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12">
                                    <Ellipse x:Name="SwitchThumb" Width="18" Height="18" Margin="2"
                                             HorizontalAlignment="Left" VerticalAlignment="Center"
                                             Fill="#0F766E"
                                             Stroke="{DynamicResource SurfaceBrush}" StrokeThickness="1"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsChecked" Value="True">
                                        <Setter TargetName="SwitchThumb" Property="HorizontalAlignment" Value="Right"/>
                                        <Setter TargetName="SwitchThumb" Property="Fill" Value="#2563EB"/>
                                    </Trigger>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="SwitchTrack" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </ToggleButton.Template>
                    </ToggleButton>
                    <TextBlock Text="Group Wise" VerticalAlignment="Center" FontSize="11">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="#2563EB"/>
                                <Setter Property="Opacity" Value="0.45"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsGroupWiseDirectory}" Value="True">
                                        <Setter Property="Opacity" Value="1"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>

                <Button Grid.Column="6"
                        Content="Refresh"
                        Command="{Binding ReloadCommand}"
                        Padding="14,8" />
            </Grid>
        </Border>

        <Border Grid.Row="3"
                Margin="20,14,20,0"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="12">
            <Grid>
            <DataGrid x:Name="ClientGrid"
                      ItemsSource="{Binding ClientDirectoryItems}"
                      SelectedItem="{Binding SelectedDirectoryItem, Mode=TwoWay}"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      CanUserReorderColumns="True"
                      CanUserResizeColumns="True"
                      CanUserSortColumns="False"
                      IsReadOnly="True"
                      SelectionMode="Single"
                      SelectionUnit="FullRow"
                      HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal"
                      BorderThickness="0"
                      RowHeaderWidth="0"
                      HorizontalScrollBarVisibility="Auto"
                      EnableRowVirtualization="True"
                      EnableColumnVirtualization="True"
                      VirtualizingPanel.IsVirtualizing="True"
                      VirtualizingPanel.VirtualizationMode="Recycling"
                      FrozenColumnCount="2"
                      MinColumnWidth="70"
                      PreviewMouseLeftButtonDown="ClientGrid_PreviewMouseLeftButtonDown"
                      MouseDoubleClick="ClientGrid_MouseDoubleClick">
                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow">
                        <Setter Property="MinHeight" Value="34"/>
                        <Setter Property="ToolTip" Value="{Binding DirectoryToolTip}"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsGroup}" Value="True">
                                <Setter Property="MinHeight" Value="46"/>
                                <Setter Property="Background" Value="#FAFCFF"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.RowStyle>
                <DataGrid.Columns>
                    <DataGridTemplateColumn Width="115" MinWidth="105">
                        <DataGridTemplateColumn.Header>
                            <Button Command="{Binding DataContext.ToggleSortCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                    CommandParameter="ClientCode"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Padding="2,1"
                                    ToolTip="Click to sort; click again to reverse">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Client Code" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding DataContext.ClientCodeSortIndicator, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                               VerticalAlignment="Center"
                                               Foreground="{DynamicResource AccentBrush}"
                                               FontWeight="Bold" />
                                </StackPanel>
                            </Button>
                        </DataGridTemplateColumn.Header>
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding ClientCode}"
                                           FontWeight="SemiBold"
                                           VerticalAlignment="Center" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Width="250" MinWidth="210">
                        <DataGridTemplateColumn.Header>
                            <StackPanel Orientation="Horizontal">
                                <Button Content="{Binding DataContext.NameHeaderText, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                        Command="{Binding DataContext.CycleDisplayNameModeCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                        ToolTip="Click to cycle Client Name, Trade Name and Legal Name"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Padding="2,1" />
                                <Button Command="{Binding DataContext.ToggleSortCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                        CommandParameter="Name"
                                        ToolTip="Sort the displayed name; click again to reverse"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Padding="2,1">
                                    <TextBlock Text="{Binding DataContext.NameSortIndicator, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                               Foreground="{DynamicResource AccentBrush}"
                                               FontWeight="Bold" />
                                </Button>
                            </StackPanel>
                        </DataGridTemplateColumn.Header>
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Grid Margin="0,4" ToolTip="{Binding DirectoryToolTip}">
                                    <StackPanel x:Name="ClientDirectoryNamePanel">
                                        <TextBlock FontWeight="SemiBold" TextTrimming="CharacterEllipsis">
                                            <TextBlock.Text>
                                                <MultiBinding Converter="{StaticResource ClientDisplayNameConverter}">
                                                    <Binding Path="ClientName" />
                                                    <Binding Path="TradeName" />
                                                    <Binding Path="LegalName" />
                                                    <Binding Path="DataContext.DisplayNameMode" RelativeSource="{RelativeSource AncestorType=DataGrid}" />
                                                </MultiBinding>
                                            </TextBlock.Text>
                                        </TextBlock>
                                        <TextBlock Text="{Binding DirectorySecondaryText}"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   FontSize="10" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <StackPanel x:Name="GroupDirectoryNamePanel" Visibility="Collapsed">
                                        <TextBlock Text="{Binding ClientName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding DirectorySecondaryText}" Foreground="{DynamicResource TextSecondaryBrush}"
                                                   FontSize="11" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </Grid>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsGroup}" Value="True">
                                        <Setter TargetName="ClientDirectoryNamePanel" Property="Visibility" Value="Collapsed"/>
                                        <Setter TargetName="GroupDirectoryNamePanel" Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Width="160" MinWidth="145">
                        <DataGridTemplateColumn.Header>
                            <Button Command="{Binding DataContext.ToggleSortCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                    CommandParameter="Gstin"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Padding="2,1"
                                    ToolTip="Click to sort; click again to reverse">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="GSTIN" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding DataContext.GstinSortIndicator, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                               VerticalAlignment="Center"
                                               Foreground="{DynamicResource AccentBrush}"
                                               FontWeight="Bold" />
                                </StackPanel>
                            </Button>
                        </DataGridTemplateColumn.Header>
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Gstin}"
                                           VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis"
                                           ToolTip="{Binding Gstin}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Width="120" MinWidth="105">
                        <DataGridTemplateColumn.Header>
                            <Button Command="{Binding DataContext.ToggleSortCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                    CommandParameter="State"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Padding="2,1"
                                    ToolTip="Click to sort; click again to reverse">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="State" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding DataContext.StateSortIndicator, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                               VerticalAlignment="Center"
                                               Foreground="{DynamicResource AccentBrush}"
                                               FontWeight="Bold" />
                                </StackPanel>
                            </Button>
                        </DataGridTemplateColumn.Header>
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding State}"
                                           VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis"
                                           ToolTip="{Binding State}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Width="100" MinWidth="90">
                        <DataGridTemplateColumn.Header>
                            <Button Command="{Binding DataContext.ToggleSortCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                    CommandParameter="FinancialYear"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Padding="2,1"
                                    ToolTip="Click to sort; click again to reverse">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="FY" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding DataContext.FinancialYearSortIndicator, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                               VerticalAlignment="Center"
                                               Foreground="{DynamicResource AccentBrush}"
                                               FontWeight="Bold" />
                                </StackPanel>
                            </Button>
                        </DataGridTemplateColumn.Header>
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding FinancialYear}"
                                           VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis"
                                           ToolTip="{Binding FinancialYear}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn x:Name="LanAdministrationColumn" Header="Remote Access" Width="1.45*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Grid>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Visibility="{Binding ClientOnlyVisibility}">
                                        <ToggleButton Content="Remote Available"
                                                      IsChecked="{Binding DirectoryLanAvailable, Mode=OneWay}"
                                                      Command="{Binding DataContext.ToggleClientLanAvailabilityCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                      CommandParameter="{Binding Client}"
                                                      Padding="7,3"
                                                      MinWidth="92"
                                                      ToolTip="Turn remote access on or off for this client. User permissions apply equally on trusted PCs and phones." />
                                        <Button Content="Access"
                                                Command="{Binding DataContext.OpenClientLanAccessCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding Client}"
                                                Padding="7,3"
                                                Margin="5,0,0,0"
                                                ToolTip="Choose which AAH users may access this client from any trusted device" />
                                    </StackPanel>
                                    <TextBlock Text="{Binding DirectoryRemoteSummary}" Visibility="{Binding GroupOnlyVisibility}" VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11"/>
                                </Grid>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Header="Available Data" Width="180" MinWidth="160">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding DirectoryDataSummary}"
                                           VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis"
                                           ToolTip="{Binding DirectoryDataSummary}"
                                           FontSize="11" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Header="GST Profile" Width="135" MinWidth="120">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,4">
                                    <TextBlock Text="{Binding LatestGstr3bPeriod}"
                                               FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding GstProfileSourceType}"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               FontSize="10" />
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Width="175" MinWidth="155">
                        <DataGridTemplateColumn.Header>
                            <Button Command="{Binding DataContext.ToggleSortCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                    CommandParameter="Updated"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Padding="2,1"
                                    ToolTip="Click to sort; click again to reverse">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Updated" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding DataContext.UpdatedSortIndicator, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                               VerticalAlignment="Center"
                                               Foreground="{DynamicResource AccentBrush}"
                                               FontWeight="Bold" />
                                </StackPanel>
                            </Button>
                        </DataGridTemplateColumn.Header>
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding DirectoryLastActivityText}"
                                           VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis"
                                           ToolTip="{Binding DirectoryLastActivityText}"
                                           FontSize="10" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Header="Status" Width="110" MinWidth="100">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border x:Name="StatusBadge"
                                        Background="#DCFCE7"
                                        CornerRadius="9"
                                        Padding="8,3"
                                        HorizontalAlignment="Left">
                                    <TextBlock x:Name="StatusText"
                                               Text="Active"
                                               Foreground="#166534"
                                               FontSize="10"
                                               FontWeight="SemiBold" />
                                </Border>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsArchived}" Value="True">
                                        <Setter TargetName="StatusBadge" Property="Background" Value="#F1F5F9" />
                                        <Setter TargetName="StatusText" Property="Text" Value="Archived" />
                                        <Setter TargetName="StatusText" Property="Foreground" Value="#64748B" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsGroup}" Value="True">
                                        <Setter TargetName="StatusBadge" Property="Background" Value="#EFF6FF" />
                                        <Setter TargetName="StatusText" Property="Text" Value="Group" />
                                        <Setter TargetName="StatusText" Property="Foreground" Value="#1D4ED8" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsNavigation}" Value="True">
                                        <Setter TargetName="StatusBadge" Property="Background" Value="#F8FAFC" />
                                        <Setter TargetName="StatusText" Property="Text" Value="Back" />
                                        <Setter TargetName="StatusText" Property="Foreground" Value="#475569" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>


            </Grid>
        </Border>

        <Grid Grid.Row="4" Margin="20,10,20,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="{Binding StatusText}"
                       Foreground="{DynamicResource TextSecondaryBrush}" />
            <TextBlock Grid.Column="1"
                       Text="{Binding VisibleCount, StringFormat={}{0} visible}"
                       Foreground="{DynamicResource TextSecondaryBrush}" />
        </Grid>

        <Border x:Name="LanAdministrationPanel" Grid.RowSpan="5"
                HorizontalAlignment="Right"
                Width="500"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1,0,0,0"
                Visibility="{Binding IsEditorOpen, Converter={StaticResource BooleanToVisibilityConverter}}"
                Panel.ZIndex="10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border Padding="22,18"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="0,0,0,1">
                    <Grid>
                        <StackPanel>
                            <TextBlock Text="{Binding EditorModeText}"
                                       FontSize="21"
                                       FontWeight="SemiBold" />
                            <TextBlock Text="{Binding EditorStatusText}"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       Margin="0,4,0,0" />
                        </StackPanel>
                        <Button Content="✕"
                                Command="{Binding CloseEditorCommand}"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Top"
                                Padding="10,5" />
                    </Grid>
                </Border>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="22,18">
                        <Border Background="{DynamicResource AccentSoftBrush}" CornerRadius="8" Padding="12" Margin="0,0,0,14" IsEnabled="{Binding CanImportPreviousFy}">
                            <StackPanel>
                                <CheckBox Content="Import from PY (Previous FY)" IsChecked="{Binding ImportFromPreviousFy, Mode=TwoWay}" FontWeight="SemiBold" />
                                <TextBlock Text="Choose the earlier Client/FY here. AAH fills the new-client profile and advances the FY; prior-year vouchers are never copied into the new year." TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="10" Margin="0,4,0,7" />
                                <ComboBox ItemsSource="{Binding PreviousFyClientOptions}" SelectedItem="{Binding SelectedPreviousFyClient, Mode=TwoWay}" IsEnabled="{Binding ImportFromPreviousFy}" Padding="8,6">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock><Run Text="{Binding ClientCode}"/><Run Text=" · "/><Run Text="{Binding ClientName}"/><Run Text=" · FY "/><Run Text="{Binding FinancialYear}"/></TextBlock>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                                <TextBlock Text="{Binding PreviousFyImportStatus}" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="10" Margin="0,5,0,0" />
                            </StackPanel>
                        </Border>

                        <TextBlock Text="Client Code" FontWeight="SemiBold" />
                        <TextBox x:Name="ClientCodeBox"
                                 Text="{Binding ClientCode, UpdateSourceTrigger=PropertyChanged}"
                                 Padding="10,7"
                                 Margin="0,5,0,13" />

                        <TextBlock Text="Client Name (or GSTIN)" FontWeight="SemiBold" />
                        <TextBox Text="{Binding ClientName, UpdateSourceTrigger=PropertyChanged}"
                                 Padding="10,7"
                                 Margin="0,5,0,13" />

                        <TextBlock Text="GSTIN (or Client Name)" FontWeight="SemiBold" />
                        <TextBox Text="{Binding Gstin, UpdateSourceTrigger=PropertyChanged}"
                                 MaxLength="15"
                                 Padding="10,7"
                                 Margin="0,5,0,5" />
                        <TextBlock Text="Only Client Name or GSTIN is required. With GSTIN, AAH reads available GST JSON/profile sources and fills the name automatically when found."
                                   Foreground="{DynamicResource TextSecondaryBrush}" FontSize="10" TextWrapping="Wrap" Margin="0,0,0,9" />
                        <TextBlock Text="Additional GSTIN registrations (optional)" FontWeight="SemiBold" />
                        <TextBox Text="{Binding AdditionalGstinsText, UpdateSourceTrigger=PropertyChanged}"
                                 AcceptsReturn="True" Height="73" TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto" Padding="10,7" Margin="0,5,0,5"
                                 ToolTip="Enter one extra GSTIN per line. All registrations must belong to the same client PAN." />
                        <TextBlock Text="One extra GSTIN per line. Same PAN, different State registrations allowed. Existing GST imports, Tally, accounting and portal credentials continue using the primary GSTIN until per-registration GST workflows are enabled."
                                   Foreground="{DynamicResource TextSecondaryBrush}" FontSize="10" TextWrapping="Wrap" Margin="0,0,0,13" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="PAN" FontWeight="SemiBold" />
                                <TextBox Text="{Binding Pan, UpdateSourceTrigger=PropertyChanged}"
                                         Padding="10,7"
                                         Margin="0,5,0,13" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="State" FontWeight="SemiBold" />
                                <TextBox Text="{Binding State, UpdateSourceTrigger=PropertyChanged}"
                                         Padding="10,7"
                                         Margin="0,5,0,13" />
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="Financial Year" FontWeight="SemiBold" />
                        <ComboBox ItemsSource="{Binding FinancialYearOptions}"
                                  Text="{Binding FinancialYear, UpdateSourceTrigger=PropertyChanged}"
                                  IsEditable="True"
                                  Padding="8,6"
                                  Margin="0,5,0,13" />

                        <TextBlock Text="Group Selection" FontWeight="SemiBold" />
                        <Button x:Name="ClientEditorGroupButton" Click="ClientEditorGroupButton_Click" HorizontalContentAlignment="Left" Padding="10,8" Margin="0,5,0,5">
                            <DockPanel LastChildFill="True">
                                <TextBlock DockPanel.Dock="Right" Text="▶" Foreground="{DynamicResource TextSecondaryBrush}" Margin="10,0,0,0"/>
                                <TextBlock Text="{Binding ClientEditorGroupPath}" TextTrimming="CharacterEllipsis"/>
                            </DockPanel>
                        </Button>
                        <TextBlock Text="Choose an existing Group from the cascading Windows-style menu, select an upper Group directly, drill into child Groups, or create a new Group at the current menu level."
                                   Foreground="{DynamicResource TextSecondaryBrush}" FontSize="10" TextWrapping="Wrap" Margin="0,0,0,13" />

                        <TextBlock Text="Trade Name" FontWeight="SemiBold" />
                        <TextBox Text="{Binding TradeName, UpdateSourceTrigger=PropertyChanged}"
                                 Padding="10,7"
                                 Margin="0,5,0,13" />

                        <TextBlock Text="Legal Name" FontWeight="SemiBold" />
                        <TextBox Text="{Binding LegalName, UpdateSourceTrigger=PropertyChanged}"
                                 Padding="10,7"
                                 Margin="0,5,0,13" />

                        <TextBlock Text="Address" FontWeight="SemiBold" />
                        <TextBox Text="{Binding Address, UpdateSourceTrigger=PropertyChanged}"
                                 AcceptsReturn="True"
                                 Height="72"
                                 TextWrapping="Wrap"
                                 Padding="10,7"
                                 Margin="0,5,0,13" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Phone" FontWeight="SemiBold" />
                                <TextBox Text="{Binding Phone, UpdateSourceTrigger=PropertyChanged}"
                                         Padding="10,7"
                                         Margin="0,5,0,13" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Email" FontWeight="SemiBold" />
                                <TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}"
                                         Padding="10,7"
                                         Margin="0,5,0,13" />
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="Notes" FontWeight="SemiBold" />
                        <TextBox Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}"
                                 AcceptsReturn="True"
                                 Height="80"
                                 TextWrapping="Wrap"
                                 Padding="10,7"
                                 Margin="0,5,0,13" />

                        <Border Background="{DynamicResource AccentSoftBrush}"
                                CornerRadius="8"
                                Padding="12"
                                Margin="0,4,0,10">
                            <StackPanel>
                                <TextBlock Text="{Binding Gstr3bProfileText}"
                                           FontWeight="SemiBold"
                                           TextWrapping="Wrap" />
                                <TextBlock Text="{Binding GstProfileSourceText}"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           FontSize="10"
                                           TextWrapping="Wrap"
                                           Margin="0,4,0,0" />
                                <Button Content="Refresh GST Profile"
                                        Command="{Binding RefreshProfileCommand}"
                                        HorizontalAlignment="Left"
                                        Padding="12,6"
                                        Margin="0,9,0,0" />
                            </StackPanel>
                        </Border>

                        <TextBlock Text="{Binding LookupStatusText}"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   TextWrapping="Wrap" />
                        <TextBlock Text="{Binding ValidationText}"
                                   Foreground="#B91C1C"
                                   FontWeight="SemiBold"
                                   TextWrapping="Wrap"
                                   Margin="0,6,0,0" />
                    </StackPanel>
                </ScrollViewer>

                <Border Grid.Row="2"
                        Padding="18,14"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="0,1,0,0">
                    <Grid>
                        <StackPanel Orientation="Horizontal">
                            <Button Content="Archive"
                                    Command="{Binding ArchiveCommand}"
                                    Padding="12,7"
                                    Margin="0,0,8,0" />
                            <Button Content="Restore"
                                    Command="{Binding RestoreCommand}"
                                    Padding="12,7" Margin="0,0,8,0" />
                            <Button Content="Delete Permanently"
                                    Command="{Binding DeleteClientCommand}"
                                    Padding="12,7" ToolTip="Available only after Archive. Deletes this local Client/FY; Tally is never altered." />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Right">
                            <Button Content="Cancel"
                                    Command="{Binding CloseEditorCommand}"
                                    Padding="14,8"
                                    Margin="0,0,8,0" />
                            <Button Content="Save Client"
                                    Command="{Binding SaveCommand}"
                                    Style="{StaticResource PrimaryButtonStyle}" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <Border Grid.RowSpan="5"
                Margin="12"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="10"
                Visibility="{Binding IsGroupManagerOpen, Converter={StaticResource BooleanToVisibilityConverter}}"
                Panel.ZIndex="18">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Padding="18,14" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
                    <Grid>
                        <StackPanel>
                            <TextBlock Text="Client Groups" FontSize="21" FontWeight="SemiBold"/>
                            <TextBlock Text="Left: ungrouped Clients and top-level Groups. Right: the complete Group hierarchy. Drag a top-level Group or Client onto another Group when required."
                                       Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,0"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="+ Make Group" Command="{Binding BeginAddGroupFolderCommand}" Padding="13,7" Margin="0,0,8,0"
                                    ToolTip="Creates a new top-level Firm, Company, CA, Auditor or Company Group. Drag it into another Group only when nesting is required."/>
                            <Button Content="Close" Command="{Binding CloseGroupManagerCommand}" Padding="14,7"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <Grid Grid.Row="1" Margin="14,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.05*"/>
                        <ColumnDefinition Width="14"/>
                        <ColumnDefinition Width="1.35*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Border Padding="11,9" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Background="#FAFBFC">
                                <StackPanel>
                                    <TextBlock Text="Existing Clients / Groups" FontSize="15" FontWeight="SemiBold"/>
                                    <TextBlock Text="Select or drag any ungrouped Client or top-level Group." Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Border>
                            <ListBox x:Name="GroupSourceList" Grid.Row="1" ItemsSource="{Binding GroupSourceItems}"
                                     SelectedItem="{Binding SelectedGroupSourceItem, Mode=TwoWay}"
                                     BorderThickness="0" PreviewMouseLeftButtonDown="GroupSourceList_PreviewMouseLeftButtonDown"
                                     PreviewMouseMove="GroupSourceList_PreviewMouseMove">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="8,7">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="{Binding PrimaryText, Mode=OneWay}" FontWeight="SemiBold"/>
                                                <TextBlock Text="{Binding SecondaryText, Mode=OneWay}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="10" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                            <TextBlock Grid.Column="1" Text="{Binding KindText, Mode=OneWay}" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="12,0,4,0"/>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </Border>

                    <Border Grid.Column="2" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Border Padding="11,9" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Background="#FAFBFC">
                                <StackPanel>
                                    <TextBlock Text="Existing Group Structure" FontSize="15" FontWeight="SemiBold"/>
                                    <TextBlock Text="All created Groups appear here. Expand only what you need; Clients already inside a Group can be dragged directly to another Group."
                                               Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" Margin="0,2,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>
                            <TreeView x:Name="GroupDestinationTree" Grid.Row="1" ItemsSource="{Binding GroupFolderRoots}"
                                      SelectedItemChanged="GroupFolderTree_SelectedItemChanged" AllowDrop="True"
                                      PreviewMouseWheel="GroupDestinationTree_PreviewMouseWheel"
                                      ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                      PreviewMouseLeftButtonDown="GroupDestinationTree_PreviewMouseLeftButtonDown"
                                      PreviewMouseMove="GroupDestinationTree_PreviewMouseMove"
                                      DragOver="GroupDestinationTree_DragOver" Drop="GroupDestinationTree_Drop" BorderThickness="0" Padding="8">
                                <TreeView.ItemContainerStyle>
                                    <Style TargetType="TreeViewItem">
                                        <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
                                        <Setter Property="Padding" Value="2"/>
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                    </Style>
                                </TreeView.ItemContainerStyle>
                                <TreeView.ItemTemplate>
                                    <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                                        <Grid Margin="2,1,2,1">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Margin="2,2" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding DisplayText, Mode=OneWay}" VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding SecondaryText, Mode=OneWay}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="10"/>
                                            </StackPanel>
                                            <Button Grid.Column="1" Width="26" Height="24" Padding="0" Margin="8,0,2,0"
                                                    VerticalAlignment="Center" Focusable="False" ToolTip="Delete Group"
                                                    Command="{Binding DataContext.DeleteGroupFolderCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}">
                                                <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE74D;" FontSize="14"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                <Button.Style>
                                                    <Style TargetType="Button">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <MultiDataTrigger>
                                                                <MultiDataTrigger.Conditions>
                                                                    <Condition Binding="{Binding RelativeSource={RelativeSource AncestorType={x:Type TreeViewItem}}, Path=IsSelected}" Value="True"/>
                                                                    <Condition Binding="{Binding IsRoot}" Value="False"/>
                                                                    <Condition Binding="{Binding IsClient}" Value="False"/>
                                                                </MultiDataTrigger.Conditions>
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </MultiDataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                        </Grid>
                                    </HierarchicalDataTemplate>
                                </TreeView.ItemTemplate>
                            </TreeView>
                            <Border Grid.Row="2" Padding="10,8" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Background="#FAFBFC">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{Binding SelectedGroupPath, StringFormat=Destination: {0}}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,5,0,0" Visibility="{Binding IsSelectedGroupCaFolder, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <TextBlock Text="Linked CA" VerticalAlignment="Center" Margin="0,0,7,0" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                            <ComboBox ItemsSource="{Binding GroupCaProfiles}" SelectedItem="{Binding SelectedGroupCaProfile, Mode=TwoWay}"
                                                      DisplayMemberPath="CaName" MinWidth="190" Padding="5,3"/>
                                            <Button Content="Save" Command="{Binding SaveGroupCaLinkCommand}" Padding="8,3" Margin="6,0,0,0"/>
                                        </StackPanel>
                                    </StackPanel>
                                    <Button Grid.Column="1" Content="Move Selected Into →" Command="{Binding MoveSelectedGroupSourceCommand}" Padding="12,6" Margin="10,0,0,0" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                        </Grid>
                    </Border>
                </Grid>

                <Border Grid.Row="2" Padding="14,9" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Background="#FAFBFC">
                    <TextBlock Text="{Binding GroupManagerStatus}" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                </Border>

                <Grid Grid.RowSpan="3" Panel.ZIndex="30" Visibility="{Binding IsGroupFolderEditorOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Border Background="#1A000000"/>
                    <Border Width="500" Padding="18" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1" CornerRadius="9" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <StackPanel>
                            <TextBlock Text="{Binding GroupFolderEditorTitle}" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,10"/>
                            <TextBlock Text="Group Type" Margin="0,0,0,4"/>
                            <ComboBox ItemsSource="{Binding GroupFolderTypes}" SelectedItem="{Binding GroupFolderType, Mode=TwoWay}" IsEnabled="{Binding IsGroupFolderCreateMode}" Padding="7,5"/>
                            <StackPanel Margin="0,12,0,0">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding GroupFolderType}" Value="CA">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <TextBlock Text="Linked CA" Margin="0,0,0,4"/>
                                <ComboBox ItemsSource="{Binding GroupCaProfiles}" SelectedItem="{Binding GroupFolderCaProfile, Mode=TwoWay}" DisplayMemberPath="CaName" Padding="7,5"
                                          ToolTip="The CA Group name is always the linked saved CA name."/>
                            </StackPanel>
                            <TextBlock Text="{Binding GroupFolderNameLabel}" Margin="0,12,0,4"/>
                            <TextBox Text="{Binding GroupFolderName, UpdateSourceTrigger=PropertyChanged}" Padding="8,6" IsEnabled="{Binding CanEditGroupFolderName}"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                                <Button Content="Cancel" Command="{Binding CancelGroupFolderEditorCommand}" Padding="12,6" Margin="0,0,8,0"/>
                                <Button Content="Create" Command="{Binding SaveGroupFolderEditorCommand}" Padding="12,6"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>
        </Border>

        <Border Grid.RowSpan="5"
                HorizontalAlignment="Right"
                Width="720"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1,0,0,0"
                Visibility="{Binding IsLanAccessOpen, Converter={StaticResource BooleanToVisibilityConverter}}"
                Panel.ZIndex="20">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border Padding="22,18" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
                    <Grid>
                        <StackPanel>
                            <TextBlock Text="User Access" FontSize="21" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding LanAccessClientCaption}" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,0" />
                        </StackPanel>
                        <Button Content="✕" Command="{Binding CloseClientLanAccessCommand}" HorizontalAlignment="Right" VerticalAlignment="Top" Padding="10,5" />
                    </Grid>
                </Border>

                <Border Grid.Row="1" Margin="18,14,18,8" Padding="12" Background="{DynamicResource AccentSoftBrush}" CornerRadius="8">
                    <StackPanel>
                        <TextBlock Text="Client Directory is the Client/FY user-access authority." FontWeight="SemiBold" />
                        <TextBlock Text="Administrator is always authorised for every active Client/FY on every trusted LAN/Android device. Remote Available and the Allow checkboxes apply only to non-admin users. Select a user below to maintain access and view the Main Server-owned live mobile code. QR enrollment/sign-in is available from Workspace Selection."
                                   TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,5,0,0" />
                    </StackPanel>
                </Border>

                <DataGrid Grid.Row="2" Margin="18,6,18,10"
                          ItemsSource="{Binding LanAccessUsers}" SelectedItem="{Binding SelectedLanAccessUser, Mode=TwoWay}"
                          AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                          HeadersVisibility="Column" GridLinesVisibility="Horizontal" RowHeaderWidth="0">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="Allow" Width="66">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <CheckBox IsChecked="{Binding IsAllowed, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanChangeAccess}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="User ID" Binding="{Binding UserName}" Width="1.05*" IsReadOnly="True" />
                        <DataGridTextColumn Header="Display Name" Binding="{Binding DisplayName}" Width="1.25*" IsReadOnly="True" />
                        <DataGridTextColumn Header="Role" Binding="{Binding RoleName}" Width="0.9*" IsReadOnly="True" />
                        <DataGridTemplateColumn Header="Mobile Verify (Days)" Width="115">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBox Text="{Binding MobileVerificationIntervalDays, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanChangeMobileVerification}" HorizontalContentAlignment="Center" Padding="4,2" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Live Mobile Code" Binding="{Binding MobileAccessCode}" Width="105" IsReadOnly="True" />
                        <DataGridTextColumn Header="Refresh" Binding="{Binding MobileCodeExpiryText}" Width="80" IsReadOnly="True" />
                    </DataGrid.Columns>
                </DataGrid>

                <Border Grid.Row="3" Margin="18,0,18,10" Padding="12" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8">
                    <StackPanel>
                        <TextBlock Text="Mobile QR moved to Workspace Selection" FontSize="14" FontWeight="SemiBold"/>
                        <TextBlock Text="Client Directory remains the Client/FY access authority. Live user codes stay visible above for administration, but QR enrollment/sign-in is now shown only on the Workspace Selection screen." TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,5,0,0"/>
                    </StackPanel>
                </Border>

                <Border Grid.Row="4" Padding="18,14" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0">
                    <Grid>
                        <TextBlock Text="{Binding LanAccessStatusText}" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,180,0" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="Close" Command="{Binding CloseClientLanAccessCommand}" Padding="14,8" Margin="0,0,8,0" />
                            <Button Content="Save Access" Command="{Binding SaveClientLanAccessCommand}" Style="{StaticResource PrimaryButtonStyle}" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
