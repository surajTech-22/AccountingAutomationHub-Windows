    <!-- Compact GSTIN-only management panel: never navigates to the full client editor. -->
    <Border x:Name="GstinManagementPanel" Grid.ZIndex="20" HorizontalAlignment="Right"
            Width="455" MaxWidth="455" Visibility="Collapsed" Background="{DynamicResource SurfaceBrush}"
            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1,0,0,0">
