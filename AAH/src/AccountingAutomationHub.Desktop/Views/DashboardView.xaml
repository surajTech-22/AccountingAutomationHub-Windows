                        </StackPanel>
                    </Border>
                    <Grid Margin="0,12,0,0" Visibility="{Binding AreSupportingTallyReportsEnabled, Converter={StaticResource BooleanToVisibilityConverter}}">
 <Grid.ColumnDefinitions><ColumnDefinition Width="1.45*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="0.9*"/></Grid.ColumnDefinitions>
<Border Style="{StaticResource InnerCardStyle}" Margin="0" Grid.Column="0">
