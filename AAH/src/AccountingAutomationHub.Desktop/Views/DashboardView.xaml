                    <Border Margin="0,12,0,0" Padding="12" CornerRadius="9" BorderBrush="#F59E0B" BorderThickness="1" Background="#FFF7ED" Visibility="{Binding IsErp9CoreLiveMode, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <StackPanel>
                            <TextBlock Text="Tally.ERP 9 Legacy Live Link" FontWeight="SemiBold" Foreground="#92400E"/>
