                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                    <TextBlock x:Name="GstinPanelStatusText" TextWrapping="Wrap"
                               Margin="0,14,0,0" Foreground="{DynamicResource TextSecondaryBrush}"/>
