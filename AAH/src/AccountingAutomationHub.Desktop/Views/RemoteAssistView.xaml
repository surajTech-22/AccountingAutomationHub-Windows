<UserControl x:Class="AccountingAutomationHub.Desktop.Views.RemoteAssistView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource AppBackgroundBrush}">
    <Grid Margin="16">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,10"><StackPanel><TextBlock Text="AAH Remote Assist" Style="{StaticResource SectionTitleStyle}"/><TextBlock Text="Only the Accounting Automation Hub window is shared. You can pause your screen, make administrator control view-only, view the Main Server AAH when the administrator shares it, and end the session at any time." TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,7,0,0"/><TextBlock Text="{Binding ActiveTitle, Mode=OneWay}" FontWeight="Bold" Foreground="#B42318" Margin="0,8,0,0"/><TextBlock Text="{Binding ActiveSummary, Mode=OneWay}" FontWeight="SemiBold" Margin="0,4,0,0" TextWrapping="Wrap"/><TextBlock Text="{Binding StreamSummary, Mode=OneWay}" FontWeight="SemiBold" Margin="0,4,0,0" TextWrapping="Wrap"/><TextBlock Text="{Binding TransportSummary, Mode=OneWay}" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,0" TextWrapping="Wrap"/></StackPanel></Border>
        <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="1.6*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="1*"/></Grid.ColumnDefinitions>
            <Border Grid.Column="0" Background="#111827" BorderBrush="#374151" BorderThickness="1" CornerRadius="6" Focusable="True" x:Name="AdministratorViewer" PreviewMouseDown="AdministratorViewer_PreviewMouseDown" PreviewMouseUp="AdministratorViewer_PreviewMouseUp" MouseMove="AdministratorViewer_MouseMove" MouseWheel="AdministratorViewer_MouseWheel" PreviewKeyDown="AdministratorViewer_PreviewKeyDown" PreviewKeyUp="AdministratorViewer_PreviewKeyUp" PreviewTextInput="AdministratorViewer_PreviewTextInput"><Grid><Image x:Name="AdministratorFrameImage" Source="{Binding AdministratorFrame, Mode=OneWay}" Stretch="Uniform"/><Border VerticalAlignment="Top" HorizontalAlignment="Left" Background="#99111827" CornerRadius="4" Padding="7,4" Margin="8" IsHitTestVisible="False"><TextBlock Text="MAIN SERVER AAH · view/control only when administrator allows" Foreground="White" FontSize="11"/></Border></Grid></Border>
            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto"><StackPanel>
                <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,8" Visibility="{Binding HasPendingRequest, Converter={StaticResource BooleanToVisibilityConverter}}"><StackPanel><TextBlock Text="{Binding PendingTitle, Mode=OneWay}" FontSize="16" FontWeight="SemiBold"/><TextBlock Text="{Binding PendingHelper, Mode=OneWay}" Margin="0,7,0,0" TextWrapping="Wrap"/><TextBlock Text="{Binding PendingMode, Mode=OneWay}" Margin="0,4,0,0"/><TextBlock Text="{Binding PendingScope, Mode=OneWay}" Margin="0,4,0,0" TextWrapping="Wrap"/><TextBlock Text="{Binding PendingReason, Mode=OneWay}" Margin="0,4,0,0" TextWrapping="Wrap"/><TextBlock Text="{Binding PendingExpiry, Mode=OneWay}" Margin="0,4,0,0" Foreground="{DynamicResource TextSecondaryBrush}"/><WrapPanel Margin="0,9,0,0"><Button Content="Accept" Command="{Binding AcceptCommand}" Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,7,0"/><Button Content="Decline" Command="{Binding DeclineCommand}"/></WrapPanel></StackPanel></Border>
                <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,8" Visibility="{Binding HasActiveSession, Converter={StaticResource BooleanToVisibilityConverter}}"><StackPanel><TextBlock Text="{Binding ActiveTitle, Mode=OneWay}" FontSize="16" FontWeight="SemiBold"/><TextBlock Text="{Binding ActiveSummary, Mode=OneWay}" Margin="0,7,0,0" TextWrapping="Wrap"/><CheckBox Content="Share my AAH window" IsChecked="{Binding ShareMyAah}" Margin="0,9,0,0" ToolTip="When on, the administrator can see this AAH window."/><CheckBox Content="Allow administrator to control my AAH" IsChecked="{Binding AllowAdministratorControl}" Margin="0,7,0,0" ToolTip="Turn this off to keep the administrator view-only while the screen remains shared."/><Button Content="End Remote Assist Now" Command="{Binding EndCommand}" HorizontalAlignment="Left" Margin="0,10,0,0"/></StackPanel></Border>
                <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,8" Visibility="{Binding HasNoRequest, Converter={StaticResource BooleanToVisibilityConverter}}"><StackPanel><TextBlock Text="No Remote Assist session" FontSize="16" FontWeight="SemiBold"/><TextBlock Text="There is no pending request and no active access on this PC." TextWrapping="Wrap" Margin="0,7,0,0" Foreground="{DynamicResource TextSecondaryBrush}"/></StackPanel></Border>
                <Border Style="{StaticResource CardBorderStyle}"><StackPanel><TextBlock Text="Status" FontSize="16" FontWeight="SemiBold"/><TextBlock Text="{Binding Status, Mode=OneWay}" TextWrapping="Wrap" Margin="0,7,0,0"/><Button Content="Refresh" Command="{Binding RefreshCommand}" HorizontalAlignment="Left" Margin="0,9,0,0"/></StackPanel></Border>
            </StackPanel></ScrollViewer>
        </Grid>
        <TextBlock Grid.Row="2" Text="If Main Server AAH control is not explicitly allowed, the shared administrator screen remains view-only." Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,8,0,0" TextWrapping="Wrap"/>
    </Grid>
</UserControl>
