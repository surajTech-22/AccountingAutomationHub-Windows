                                <TextBlock Text="Snapshot Diagnostics" FontWeight="SemiBold" FontSize="14" Margin="0,16,0,0"/>
                                <TextBlock Text="Run Snapshot Diagnostic uses the most recently active enrolled system and follows the same client-access calculation and snapshot builder used by Open AAH. The stage list identifies whether failure occurs in zero-client bootstrap, database discovery/open, SQLite backup, trigger cleanup, filtering, security scrub, VACUUM or payload read." Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,4,0,6"/>
                                <TextBox Text="{Binding SnapshotDiagnosticText, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" MinHeight="220" MaxHeight="360" Padding="9"/>

                                <TextBlock Text="Recent Security Activity" FontWeight="SemiBold" FontSize="14" Margin="0,16,0,0"/>
                                <DataGrid ItemsSource="{Binding LanSecurityActivity}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False" Height="280" ScrollViewer.HorizontalScrollBarVisibility="Auto">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Time" Binding="{Binding Time}" Width="145"/>
                                        <DataGridTextColumn Header="User ID" Binding="{Binding UserId}" Width="100"/>
                                        <DataGridTextColumn Header="System" Binding="{Binding System}" Width="155"/>
                                        <DataGridTextColumn Header="Operation" Binding="{Binding Operation}" Width="170"/>
                                        <DataGridTextColumn Header="Result" Binding="{Binding Result}" Width="70"/>
                                        <DataGridTextColumn Header="Details" Binding="{Binding Details}" Width="*" MinWidth="420"/>
                                    </DataGrid.Columns>
                                </DataGrid>

                                <Expander Header="Network Policy Diagnostics" Margin="0,14,0,0">
                                    <StackPanel Margin="0,8,0,0">
                                        <TextBlock Text="{Binding SecurityDiagnosticsText}" TextWrapping="Wrap"/>
                                        <TextBlock Text="Enforced Windows-node boundary: same AAH desktop interface · Administrator-created credentials · Registration OTP trust for enrolled PCs · Client/FY access · permission-driven local accounting/import actions · controlled source upload/export · synchronized device-scoped working data instead of shared SQLite · no public/wildcard bind · no browser/PWA accounting UI · no remote Tally port exposure · Tally execution stays on the validated Main Server/Tally host." Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,10,0,0"/>
                                    </StackPanel>
                                </Expander>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Shortcuts">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="12">
                        <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="Configurable shortcuts" Style="{StaticResource SectionTitleStyle}" />
                                <TextBlock Text="Use forms such as Ctrl+H, Ctrl+Shift+R or Alt+S. Invalid values fall back to the built-in shortcut."
                                           Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,8,0,10" />
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="200"/><ColumnDefinition Width="180"/></Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                    <TextBlock Text="Shortcut Help" VerticalAlignment="Center" Margin="0,5"/><TextBox Grid.Column="1" Text="{Binding ShortcutHelp}" Padding="8,5" Margin="0,3"/>
                                    <TextBlock Grid.Row="1" Text="Refresh current page" VerticalAlignment="Center" Margin="0,5"/><TextBox Grid.Row="1" Grid.Column="1" Text="{Binding ShortcutRefresh}" Padding="8,5" Margin="0,3"/>
                                    <TextBlock Grid.Row="2" Text="Save current edits" VerticalAlignment="Center" Margin="0,5"/><TextBox Grid.Row="2" Grid.Column="1" Text="{Binding ShortcutSave}" Padding="8,5" Margin="0,3"/>
                                    <TextBlock Grid.Row="3" Text="Client search" VerticalAlignment="Center" Margin="0,5"/><TextBox Grid.Row="3" Grid.Column="1" Text="{Binding ShortcutClientSearch}" Padding="8,5" Margin="0,3"/>
                                    <TextBlock Grid.Row="4" Text="New client" VerticalAlignment="Center" Margin="0,5"/><TextBox Grid.Row="4" Grid.Column="1" Text="{Binding ShortcutNewClient}" Padding="8,5" Margin="0,3"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource CardBorderStyle}">
                            <StackPanel>
                                <TextBlock Text="Fixed accounting shortcuts" Style="{StaticResource SectionTitleStyle}" />
                                <TextBlock Margin="0,10,0,0" Text="F1–F12 = April–March Tally export periods" />
                                <TextBlock Margin="0,6,0,0" Text="Hold B / P / S + F1–F12 = Bank / Purchase / Sales only" />
                                <TextBlock Margin="0,6,0,0" Text="Shift + function key = range selection/deselection" />
                                <TextBlock Margin="0,6,0,0" Text="Ctrl+Shift+B/P/S/J/C/G on Dashboard = open accounting activity" />
                                <TextBlock Margin="0,6,0,0" Text="Esc = cancel active import operation" />
                                <TextBlock Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,10,0,0" TextWrapping="Wrap"
                                           Text="The F-key/month combinations remain fixed because they are accounting workflow shortcuts and should not collide with user-defined global commands." />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Appearance">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="12">
                        <Border Style="{StaticResource CardBorderStyle}">
                            <StackPanel>
                                <TextBlock Text="Appearance &amp; Colour" Style="{StaticResource SectionTitleStyle}" />
                                <Grid Margin="0,12,0,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="180"/><ColumnDefinition Width="220"/></Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                    <TextBlock Text="Theme" VerticalAlignment="Center" Margin="0,5"/><ComboBox Grid.Column="1" ItemsSource="{Binding ThemeOptions}" SelectedItem="{Binding Theme}" Margin="0,3"/>
                                    <TextBlock Grid.Row="1" Text="Accent colour" VerticalAlignment="Center" Margin="0,5"/><TextBox Grid.Row="1" Grid.Column="1" Text="{Binding AccentColor}" Padding="8,5" Margin="0,3" ToolTip="Hex colour, e.g. #2563EB"/>
                                    <TextBlock Grid.Row="2" Text="Action Required colour" VerticalAlignment="Center" Margin="0,5"/><TextBox Grid.Row="2" Grid.Column="1" Text="{Binding ActionRequiredColor}" Padding="8,5" Margin="0,3" ToolTip="Hex colour, e.g. #EF4444"/>
                                    <TextBlock Grid.Row="3" Text="Tally selected-period colour" VerticalAlignment="Center" Margin="0,5"/><TextBox Grid.Row="3" Grid.Column="1" Text="{Binding TallySelectedPeriodColor}" Padding="8,5" Margin="0,3" ToolTip="Hex colour, e.g. #16A34A"/>
                                    <TextBlock Grid.Row="4" Text="Grid density" VerticalAlignment="Center" Margin="0,5"/><ComboBox Grid.Row="4" Grid.Column="1" ItemsSource="{Binding GridDensityOptions}" SelectedItem="{Binding GridDensity}" Margin="0,3"/>
                                </Grid>
                                <CheckBox Content="Remember main window size and placement" IsChecked="{Binding RememberWindowPlacement}" Margin="0,10,0,0" />
                                <TextBlock Text="Action Required remains a distinct status even when its shade is customized. Tally selected-period colour remains semantically separate from warning/action states."
                                           Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,10,0,0" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Data &amp; Updates">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="12">
                        <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="Locations" Style="{StaticResource SectionTitleStyle}" />
                                <TextBlock Text="Installation" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,10,0,2"/><TextBox Text="{Binding InstallationFolder, Mode=OneWay}" IsReadOnly="True" />
                                <TextBlock Text="Persistent data" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,8,0,2"/><TextBox Text="{Binding DataFolder, Mode=OneWay}" IsReadOnly="True" />
                                <TextBlock Text="SQLite database" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,8,0,2"/><TextBox Text="{Binding DatabasePath, Mode=OneWay}" IsReadOnly="True" />
                                <TextBlock Text="Logs" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,8,0,2"/><TextBox Text="{Binding LogsFolder, Mode=OneWay}" IsReadOnly="True" />
                                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                    <Button Content="Open Data Folder" Command="{Binding OpenDataFolderCommand}" Padding="10,6" Margin="0,0,8,0" />
                                    <Button Content="Open Logs Folder" Command="{Binding OpenLogsFolderCommand}" Padding="10,6" Margin="0,0,8,0" />
                                    <Button Content="Open Import / Refresh Diagnostic" Command="{Binding OpenPipelineDiagnosticsCommand}" Padding="10,6" ToolTip="Shows waiting/half-completed imports, repeated/coalesced refresh calls and repeated live update notifications."/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="Client Review Export" Style="{StaticResource SectionTitleStyle}" />
                                <CheckBox Content="Overwrite the existing auto-saved client review export when Generate Excel / CSV is used again"
                                          IsChecked="{Binding ReviewExportOverwriteExisting}" Margin="0,10,0,0" />
                                <TextBlock Text="Off keeps a timestamped copy of every export. On reuses the same client/FY file name. Client review exports are reserved files and are never treated as normal Auto Import source files."
                                           Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,8,0,0" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource CardBorderStyle}">
                            <StackPanel>
                                <TextBlock Text="Update policy" Style="{StaticResource SectionTitleStyle}" />
                                <TextBlock Text="v3.8.0 and later are update-installer releases. Current release: v4.0.0.485 Fix 94 - Purchase inventory/unit parity, Purchase Tally item-invoice XML, Sales/Purchase Item Name Apply Selected/All and safe Clear Module. The main tab system is reserved for the Parts detected in the 26AS source; Source, Client Matching, TDS Receivable and Entry Matching open as separate panels. Search/client selection lives inside each Part tab, Part data is restricted to one selected client/deductor, and one-to-many/many-to-one/many-to-many is passively inferred from multi-selection rather than chosen from a dropdown. Final automatch rules, Accounting Rules and Final Reconciliation remain pending. Fix89 R3 TDS safety, Fix89 R2 binding safety/Winman foundation and Fix88-Fix85 safety remain retained. Android Mobile35/external Python unchanged."
                                           TextWrapping="Wrap" Margin="0,10,0,0" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <Border Grid.Row="2" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="10,7" Margin="0,10,0,0">
            <TextBlock Text="{Binding StatusText}" TextWrapping="Wrap" />
        </Border>
    </Grid>

    <Grid Margin="18" Visibility="{Binding IsNetworkClient, Converter={StaticResource BooleanToVisibilityConverter}}">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <DockPanel Grid.Row="0" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="LAN Settings" FontSize="22" FontWeight="SemiBold"/>
                <TextBlock Text="Full LAN workstation settings. Main Server policy remains authoritative for identity, role, Client/FY access, Remote Assist and approved updates; only safe workstation preferences are editable here." Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,4,0,0"/>
            </StackPanel>
            <Button DockPanel.Dock="Right" Content="Save LAN Settings" Command="{Binding SaveLanLocalSettingsCommand}" Style="{StaticResource PrimaryButtonStyle}" Padding="12,7"/>
        </DockPanel>
        <TabControl Grid.Row="1">
            <TabItem Header="General">
                <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="12">
                    <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,12"><StackPanel>
                        <TextBlock Text="Startup &amp; Local Behaviour" Style="{StaticResource SectionTitleStyle}"/>
                        <CheckBox Content="Start AAH LAN with Windows" IsChecked="{Binding StartWithWindows}" Margin="0,12,0,0"/>
                        <CheckBox Content="Closing the main window keeps AAH LAN running in the system tray" IsChecked="{Binding CloseToTray}" Margin="0,8,0,0"/>
                        <CheckBox Content="Remember window size and position" IsChecked="{Binding RememberWindowPlacement}" Margin="0,8,0,0"/>
                        <TextBlock Text="Client Directory is always the safe startup workspace. The last accounting client is never reopened automatically." Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,9,0,0"/>
                    </StackPanel></Border>
                    <Border Style="{StaticResource CardBorderStyle}"><StackPanel>
                        <TextBlock Text="LAN Workstation" Style="{StaticResource SectionTitleStyle}"/>
                        <TextBlock Text="{Binding NetworkInstallPath, Mode=OneWay}" Margin="0,10,0,0" TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding NetworkDataRoot, Mode=OneWay}" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,6,0,0" TextWrapping="Wrap"/>
                        <TextBlock Text="The accounting snapshot is disposable and read-only. User preferences, registration credentials and logs are stored separately under LocalAppData." Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,8,0,0"/>
                    </StackPanel></Border>
                </StackPanel></ScrollViewer>
            </TabItem>

            <TabItem Header="Account &amp; Server">
                <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="12">
                    <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,12"><StackPanel>
                        <TextBlock Text="Signed-in User" Style="{StaticResource SectionTitleStyle}"/>
                        <TextBlock Text="{Binding NetworkUserSummary, Mode=OneWay}" FontWeight="SemiBold" Margin="0,10,0,0" TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding NetworkSessionSummary, Mode=OneWay}" Margin="0,7,0,0" TextWrapping="Wrap"/>
                        <Button Content="Sign Out" Command="{Binding SignOutNetworkSessionCommand}" HorizontalAlignment="Left" Padding="10,6" Margin="0,10,0,0"/>
                    </StackPanel></Border>
                    <Border Style="{StaticResource CardBorderStyle}"><StackPanel>
                        <TextBlock Text="Main Server Connection" Style="{StaticResource SectionTitleStyle}"/>
                        <TextBlock Text="{Binding NetworkServerSummary, Mode=OneWay}" Margin="0,10,0,0" TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding NetworkConnectionStatusText, Mode=OneWay}" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,7,0,0" TextWrapping="Wrap"/>
                        <WrapPanel Margin="0,10,0,0"><Button Content="Test Connection" Command="{Binding TestNetworkConnectionCommand}" Padding="10,6" Margin="0,0,8,0"/><Button Content="Refresh Identity &amp; Permissions" Command="{Binding RefreshNetworkIdentityCommand}" Padding="10,6"/></WrapPanel>
                        <TextBlock Text="The LAN app self-heals the HTTPS endpoint from the current package marker, enrolled-device credential or saved session. Office LAN and private WireGuard routes use the same Main Server authority; public/unknown direct routes remain blocked." Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,9,0,0"/>
                    </StackPanel></Border>
                </StackPanel></ScrollViewer>
            </TabItem>

            <TabItem Header="Access &amp; Permissions">
                <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="12">
                    <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,12"><StackPanel>
                        <TextBlock Text="Effective Access" Style="{StaticResource SectionTitleStyle}"/>
                        <TextBlock Text="{Binding NetworkAccessSummary, Mode=OneWay}" FontWeight="SemiBold" Margin="0,10,0,0" TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding NetworkWorkspaceSummary, Mode=OneWay}" Margin="0,7,0,0" TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding NetworkPolicySummary, Mode=OneWay}" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,7,0,0" TextWrapping="Wrap"/>
                        <TextBlock Text="For non-admin users, Client/FY access is assigned on the Main Server and Client Directory shows only authorised clients. Administrator bypasses Remote Available and per-Client/FY grants on trusted devices. LAN accounting mutations remain blocked by the workstation safety model." Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,8,0,0"/>
                        <Button Content="Refresh Authorised Client/FY Data" Command="{Binding RefreshNetworkDataCommand}" HorizontalAlignment="Left" Padding="10,6" Margin="0,10,0,0"/>
                    </StackPanel></Border>
                    <Border Style="{StaticResource CardBorderStyle}"><StackPanel>
                        <TextBlock Text="Effective Permission Snapshot" Style="{StaticResource SectionTitleStyle}"/>
                        <TextBox Text="{Binding NetworkPermissionSummary, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True" MinHeight="120" Margin="0,10,0,0" VerticalScrollBarVisibility="Auto"/>
                        <TextBlock Text="These permissions come from the authenticated Main Server session. Buttons are not treated as security boundaries; every server operation is checked again on the Main Server." Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,8,0,0"/>
                    </StackPanel></Border>
                </StackPanel></ScrollViewer>
            </TabItem>

            <TabItem Header="Team &amp; Notifications">
                <Grid Margin="12"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,10"><StackPanel>
                        <TextBlock Text="Notifications" Style="{StaticResource SectionTitleStyle}"/>
                        <CheckBox Content="Enable Windows / tray notifications" IsChecked="{Binding NotificationsEnabled}" Margin="0,10,0,0"/>
                        <CheckBox Content="Notify for Private, Global, Client/FY and Announcement messages" IsChecked="{Binding NetworkMessageNotificationsEnabled}" Margin="0,8,0,0"/>
                        <CheckBox Content="Notify for assigned Tasks, Access Requests and Approvals" IsChecked="{Binding NetworkWorkNotificationsEnabled}" Margin="0,8,0,0"/>
                        <TextBlock Text="Team, Work and Notifications are global LAN workspaces and remain visible even when no accounting client is open. Send/share/manage actions still follow the effective Main Server role." Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,8,0,0"/>
                        <WrapPanel Margin="0,10,0,0"><Button Content="Open Team" Command="{Binding OpenNetworkWorkspaceCommand}" CommandParameter="Team" Padding="9,5" Margin="0,0,8,0"/><Button Content="Open Work" Command="{Binding OpenNetworkWorkspaceCommand}" CommandParameter="Work" Padding="9,5" Margin="0,0,8,0"/><Button Content="Open Notifications" Command="{Binding OpenNetworkWorkspaceCommand}" CommandParameter="Notifications" Padding="9,5"/></WrapPanel>
                    </StackPanel></Border>
                    <Border Grid.Row="1" Style="{StaticResource CardBorderStyle}"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Notification History" Style="{StaticResource SectionTitleStyle}"/><TextBlock Text="Messages, Work, Remote Assist, security, import and update events remain reviewable here." Foreground="{DynamicResource TextSecondaryBrush}"/></StackPanel><WrapPanel Grid.Column="1"><Button Content="Refresh" Command="{Binding RefreshNotificationHistoryCommand}" Padding="9,5" Margin="0,0,8,0"/><Button Content="Clear" Command="{Binding ClearNotificationHistoryCommand}" Padding="9,5"/></WrapPanel></Grid>
                        <DataGrid Grid.Row="1" ItemsSource="{Binding NotificationHistory}" SelectedItem="{Binding SelectedNotificationHistory}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" RowHeaderWidth="0" Margin="0,10,0,0"><DataGrid.Columns><DataGridTextColumn Header="Time" Binding="{Binding Timestamp, StringFormat={}{0:g}}" Width="135"/><DataGridTextColumn Header="Module" Binding="{Binding Module}" Width="120"/><DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="105"/><DataGridTextColumn Header="Title" Binding="{Binding Title}" Width="190"/><DataGridTextColumn Header="Message" Binding="{Binding Message}" Width="*"/></DataGrid.Columns></DataGrid>
                    </Grid></Border>
                </Grid>
            </TabItem>

            <TabItem Header="Remote Assist">
                <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="12">
                    <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,12"><StackPanel>
                        <TextBlock Text="Remote Assist Consent" Style="{StaticResource SectionTitleStyle}"/>
                        <TextBlock Text="{Binding NetworkRemoteAssistSummary, Mode=OneWay}" FontWeight="SemiBold" Margin="0,10,0,0" TextWrapping="Wrap"/>
                        <TextBlock Text="Remote Assist requests are persistent in the Remote Assist workspace. You can Accept, Decline or end an active session there; you no longer have to catch a temporary popup." Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,8,0,0"/>
                        <Button Content="Open Remote Assist Workspace" Command="{Binding OpenRemoteAssistWorkspaceCommand}" Style="{StaticResource PrimaryButtonStyle}" HorizontalAlignment="Left" Padding="11,7" Margin="0,10,0,0"/>
                    </StackPanel></Border>
                    <Border Style="{StaticResource CardBorderStyle}"><StackPanel>
                        <TextBlock Text="Security Boundary" Style="{StaticResource SectionTitleStyle}"/>
                        <TextBlock Text="Remote AAH remains allow-listed. It does not expose a terminal, arbitrary process execution, Windows desktop control or other applications. Remote User Permissions is the default; helper elevation is explicit, scoped and audited." TextWrapping="Wrap" Margin="0,8,0,0"/>
                    </StackPanel></Border>
                </StackPanel></ScrollViewer>
            </TabItem>

            <TabItem Header="Appearance &amp; Shortcuts">
                <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="12">
                    <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,12"><StackPanel><TextBlock Text="Appearance" Style="{StaticResource SectionTitleStyle}"/>
                        <Grid Margin="0,10,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="Theme" VerticalAlignment="Center"/><ComboBox Grid.Column="1" ItemsSource="{Binding ThemeOptions}" SelectedItem="{Binding Theme}"/></Grid>
                        <Grid Margin="0,8,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="Accent colour" VerticalAlignment="Center"/><TextBox Grid.Column="1" Text="{Binding AccentColor}"/></Grid>
                        <Grid Margin="0,8,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="Grid density" VerticalAlignment="Center"/><ComboBox Grid.Column="1" ItemsSource="{Binding GridDensityOptions}" SelectedItem="{Binding GridDensity}"/></Grid>
                    </StackPanel></Border>
                    <Border Style="{StaticResource CardBorderStyle}"><StackPanel><TextBlock Text="Keyboard Shortcuts" Style="{StaticResource SectionTitleStyle}"/>
                        <Grid Margin="0,10,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="Help"/><TextBox Grid.Column="1" Text="{Binding ShortcutHelp}"/></Grid>
                        <Grid Margin="0,6,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="Refresh"/><TextBox Grid.Column="1" Text="{Binding ShortcutRefresh}"/></Grid>
                        <Grid Margin="0,6,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="Save"/><TextBox Grid.Column="1" Text="{Binding ShortcutSave}"/></Grid>
                        <Grid Margin="0,6,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="Global search"/><TextBox Grid.Column="1" Text="{Binding ShortcutClientSearch}"/></Grid>
                    </StackPanel></Border>
                </StackPanel></ScrollViewer>
            </TabItem>

            <TabItem Header="Data &amp; Diagnostics">
                <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="12">
                    <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,12"><StackPanel>
                        <TextBlock Text="Disposable LAN Data" Style="{StaticResource SectionTitleStyle}"/>
                        <TextBlock Text="The local accounting database is a filtered read-only snapshot. Refreshing it never writes accounting data back to the Main Server." TextWrapping="Wrap" Margin="0,8,0,0"/>
                        <Button Content="Refresh from Main Server" Command="{Binding RefreshNetworkDataCommand}" HorizontalAlignment="Left" Padding="10,6" Margin="0,10,0,0"/>
                    </StackPanel></Border>
                    <Border Style="{StaticResource CardBorderStyle}"><StackPanel>
                        <TextBlock Text="Local Diagnostics" Style="{StaticResource SectionTitleStyle}"/>
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0"><TextBlock Text="Install: "/><TextBlock Text="{Binding NetworkInstallPath, Mode=OneWay}" TextWrapping="Wrap"/></StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,5,0,0"><TextBlock Text="Data root: "/><TextBlock Text="{Binding NetworkDataRoot, Mode=OneWay}" TextWrapping="Wrap"/></StackPanel>
                        <WrapPanel Margin="0,10,0,0"><Button Content="Open LAN Install Folder" Command="{Binding OpenNetworkInstallFolderCommand}" Padding="10,6" Margin="0,0,8,0"/><Button Content="Open LAN Logs" Command="{Binding OpenNetworkLogsFolderCommand}" Padding="10,6"/></WrapPanel>
                    </StackPanel></Border>
                    <Border Style="{StaticResource CardBorderStyle}" Margin="0,12,0,0"><StackPanel>
                        <TextBlock Text="Intentionally Main Server-only" Style="{StaticResource SectionTitleStyle}"/>
                        <TextBlock Text="These are not missing LAN settings: user/role/device/client-access administration, Main Server bind/TLS, Tally host/control, OCR/Python configuration, backup/restore, package publishing, server audit-chain administration and permanent device deletion. Keeping them off the LAN workstation is part of the security boundary." TextWrapping="Wrap" Margin="0,8,0,0" Foreground="{DynamicResource TextSecondaryBrush}"/>
                    </StackPanel></Border>
                </StackPanel></ScrollViewer>
            </TabItem>

            <TabItem Header="Updates">
                <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="12"><Border Style="{StaticResource CardBorderStyle}"><StackPanel>
                    <TextBlock Text="LAN Application Update" Style="{StaticResource SectionTitleStyle}"/>
                    <TextBlock Text="{Binding NetworkUpdateStatusText, Mode=OneWay}" Margin="0,10,0,0" TextWrapping="Wrap"/>
                    <TextBlock Text="Approved updates come only from the enrolled Main Server and are SHA-256 verified before replacement. The canonical LAN application is per-user under LocalAppData and routine updates do not require UAC elevation." Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,7,0,0"/>
                    <WrapPanel Margin="0,10,0,0"><Button Content="Check for Update" Command="{Binding CheckNetworkUpdateCommand}" Padding="10,6" Margin="0,0,8,0"/><Button Content="Install Update" Command="{Binding InstallNetworkUpdateCommand}" Style="{StaticResource PrimaryButtonStyle}" Padding="10,6"/></WrapPanel>
                </StackPanel></Border></StackPanel></ScrollViewer>
            </TabItem>
        </TabControl>
        <Border Grid.Row="2" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="10,7" Margin="0,10,0,0"><TextBlock Text="{Binding StatusText}" TextWrapping="Wrap"/></Border>
    </Grid>
    </Grid>
</UserControl>
