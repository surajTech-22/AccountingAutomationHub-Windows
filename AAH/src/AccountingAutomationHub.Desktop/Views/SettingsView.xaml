<UserControl x:Class="AccountingAutomationHub.Desktop.Views.SettingsView" x:Name="SettingsRoot"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:behaviors="clr-namespace:AccountingAutomationHub.Desktop.Behaviors"
             behaviors:OverflowToolTipManager.SuppressAutoToolTip="True"
             Background="{DynamicResource AppBackgroundBrush}">
    <UserControl.Resources>
        <!-- Settings is deliberately excluded from the application-wide automatic full-text hover feature.
             Explicit help ToolTips on specific buttons/fields remain available. -->
        <Style TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="ToolTipService.IsEnabled" Value="False" />
        </Style>
    </UserControl.Resources>
    <Grid>
    <Grid Margin="18" Visibility="{Binding IsMainApplicationSettings, Converter={StaticResource BooleanToVisibilityConverter}}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <StackPanel>
                <TextBlock Text="Application Settings" FontSize="22" FontWeight="SemiBold" />
                <TextBlock Text="Global configuration is stored outside the installation folder and is preserved by update installers."
                           Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,0" TextWrapping="Wrap" />
            </StackPanel>
            <WrapPanel Grid.Row="1" HorizontalAlignment="Right" Margin="0,9,0,0">
                <Button Content="Import Settings" Command="{Binding ImportSettingsCommand}" Margin="0,0,8,6" Padding="12,7" />
                <Button Content="Export Settings" Command="{Binding ExportSettingsCommand}" Margin="0,0,8,6" Padding="12,7" />
                <Button Content="Restore Defaults" Command="{Binding RestoreDefaultsCommand}" Margin="0,0,8,6" Padding="12,7" />
                <Button Content="Save Settings" Command="{Binding SaveCommand}" Style="{StaticResource PrimaryButtonStyle}" Padding="14,7" Margin="0,0,0,6" />
            </WrapPanel>
        </Grid>

        <TabControl Grid.Row="1">
            <TabItem Header="General">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="12">
                        <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="Startup &amp; Tray" Style="{StaticResource SectionTitleStyle}" />
                                <CheckBox Content="Start Accounting Automation Hub with Windows" IsChecked="{Binding StartWithWindows}" Margin="0,12,0,0" />
                                <CheckBox Content="Closing the main window keeps the Hub running in the system tray" IsChecked="{Binding CloseToTray}" Margin="0,8,0,0" />
                                <TextBlock Text="Startup always opens Client Directory (safer for multi-client work)." Margin="0,8,0,0" Foreground="#667085" />
                                <CheckBox Content="Enable Windows notifications" IsChecked="{Binding NotificationsEnabled}" Margin="0,8,0,0" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource CardBorderStyle}">
                            <StackPanel>
                                <TextBlock Text="Notifications" Style="{StaticResource SectionTitleStyle}" />
                                <CheckBox Content="Successful automatic imports" IsChecked="{Binding NotifyImportComplete}" Margin="0,12,0,0" />
                                <CheckBox Content="Failed imports" IsChecked="{Binding NotifyImportFailed}" Margin="0,8,0,0" />
                                <CheckBox Content="Action Required for failed/blocked automatic imports" IsChecked="{Binding NotifyActionRequired}" Margin="0,8,0,0" />
                                <CheckBox Content="First-time Automation Folder registration" IsChecked="{Binding NotifyFolderRegistration}" Margin="0,8,0,0" />
                                <CheckBox Content="Tally disconnected" IsChecked="{Binding NotifyTallyDisconnected}" Margin="0,8,0,0" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Notifications &amp; Holidays">
                <Grid Margin="12">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="Client Holiday Calendar" Style="{StaticResource SectionTitleStyle}"/>
                            <TextBlock Text="{Binding HolidayClientCaption}" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,3,0,8"/>
                            <TextBlock Text="26 January, 15 August and 2 October are excluded automatically. Add any additional client-specific holiday dates below; Cash/Journal scheduling moves affected dates to the next working day." TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}"/>
                            <WrapPanel Margin="0,10,0,8"><DatePicker SelectedDate="{Binding NewManualHoliday}" Width="150"/><Button Content="Add Holiday" Command="{Binding AddManualHolidayCommand}" Padding="10,6" Margin="8,0,0,0"/><Button Content="Remove Selected" Command="{Binding RemoveManualHolidayCommand}" Padding="10,6" Margin="8,0,0,0"/></WrapPanel>
                            <DataGrid ItemsSource="{Binding ManualHolidays}" SelectedItem="{Binding SelectedManualHoliday}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" Height="135" RowHeaderWidth="0"><DataGrid.Columns><DataGridTextColumn Header="Manual Holiday" Binding="{Binding StringFormat={}{0:dd-MMM-yyyy}}" Width="*"/></DataGrid.Columns></DataGrid>
                        </StackPanel>
                    </Border>
                    <Border Grid.Row="1" Style="{StaticResource CardBorderStyle}">
                        <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Notification History" Style="{StaticResource SectionTitleStyle}"/><TextBlock Text="Review previous AAH notifications even if Windows notifications were disabled." Foreground="{DynamicResource TextSecondaryBrush}"/></StackPanel><WrapPanel Grid.Column="1"><Button Content="Refresh" Command="{Binding RefreshNotificationHistoryCommand}" Padding="10,6" Margin="0,0,8,0"/><Button Content="Clear History" Command="{Binding ClearNotificationHistoryCommand}" Padding="10,6"/></WrapPanel></Grid>
                            <DataGrid Grid.Row="1" ItemsSource="{Binding NotificationHistory}" SelectedItem="{Binding SelectedNotificationHistory}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" RowHeaderWidth="0" Margin="0,10,0,0"><DataGrid.Columns><DataGridTextColumn Header="Date / Time" Binding="{Binding Timestamp, StringFormat={}{0:dd-MM-yyyy HH:mm:ss}}" Width="145"/><DataGridTextColumn Header="Client" Binding="{Binding Client}" Width="170"/><DataGridTextColumn Header="Module" Binding="{Binding Module}" Width="110"/><DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="110"/><DataGridTextColumn Header="Title" Binding="{Binding Title}" Width="180"/><DataGridTextColumn Header="Message" Binding="{Binding Message}" Width="*"/></DataGrid.Columns></DataGrid>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem Header="Auto Import &amp; Folders">
                <TabControl Margin="8">
                    <TabItem Header="Setup &amp; Discovery">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="12">
                                <Border Style="{StaticResource CardBorderStyle}">
                                    <StackPanel>
                                        <TextBlock Text="Unattended XYZ Auto Import" Style="{StaticResource SectionTitleStyle}" />
                                        <TextBlock Text="Each Client + Financial Year owns one linked XYZ/Automation folder. New supported files are detected automatically, opened once for recognition, cached, and routed to the normal target module without opening AAH or pressing Import." Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,6,0,10" />
                                        <CheckBox Content="Enable background Automation Folder detection and auto import" IsChecked="{Binding AutomationEnabled}" Margin="0,4,0,10" />
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="170"/><ColumnDefinition Width="260"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                            <TextBlock Text="Automation Folder Name" VerticalAlignment="Center" />
                                            <TextBox Grid.Column="1" Text="{Binding AutomationFolderName, UpdateSourceTrigger=PropertyChanged}" Padding="8,6" />
                                            <TextBlock Grid.Column="2" Text="Default is XYZ. Use Linked Folders for exact Client/FY ownership; automatic folder discovery remains available." Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="10,0,0,0" />
                                        </Grid>
                                        <WrapPanel Margin="170,8,0,0">
                                            <Button Content="Link Existing Folder..." Command="{Binding LinkExistingFolderCommand}" Padding="12,6" Margin="0,0,8,6" />
                                            <Button Content="{Binding CreateFolderHereText}" Command="{Binding CreateFolderHereCommand}" Padding="10,6" Margin="0,0,8,6" />
                                            <Button Content="Rename Linked Folders" Command="{Binding RenameLinkedFoldersCommand}" Padding="10,6" Margin="0,0,8,6" />
                                        </WrapPanel>
                                        <Grid Margin="0,10,0,0">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="170"/><ColumnDefinition Width="180"/><ColumnDefinition Width="*"/><ColumnDefinition Width="90"/></Grid.ColumnDefinitions>
                                            <TextBlock Text="Auto Import Root" VerticalAlignment="Center" />
                                            <ComboBox Grid.Column="1" ItemsSource="{Binding RootModeOptions}" SelectedItem="{Binding AutomationRootMode}" Padding="6" />
                                            <TextBox Grid.Column="2" Text="{Binding AutomationRootFolder}" Margin="8,0" Padding="8,6" />
                                            <Button Grid.Column="3" Content="Browse" Command="{Binding BrowseRootFolderCommand}" Padding="10,6" />
                                        </Grid>
                                        <TextBlock Text="Anywhere = matching XYZ folders may be discovered anywhere. Selected Root = discovery is limited below the selected root. Exact links shown in Linked Folders always remain Client/FY-specific." Foreground="{DynamicResource TextSecondaryBrush}" Margin="170,5,0,0" TextWrapping="Wrap" />
                                        <WrapPanel Margin="0,12,0,0">
                                            <CheckBox Content="Scan files already present after linking" IsChecked="{Binding ScanExistingFiles}" Margin="0,0,18,6" />
                                            <CheckBox Content="Monitor Excel / CSV / TXT / MT940 / GST data" IsChecked="{Binding MonitorExcelCsv}" Margin="0,0,18,6" />
                                            <CheckBox Content="Monitor PDF / Bank Images" IsChecked="{Binding MonitorPdf}" Margin="0,0,18,6" />
                                            <CheckBox Content="Auto-import known/saved formats" IsChecked="{Binding AutoImportKnownFormats}" Margin="0,0,18,6" />
                                        </WrapPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                            <TextBlock Text="File stable/unlocked wait:" VerticalAlignment="Center" />
                                            <TextBox Text="{Binding FileStableSeconds}" Width="55" Margin="8,0" Padding="6,4" />
                                            <TextBlock Text="second(s). Successful Auto Import file history is the first duplicate gate." VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <TabItem Header="Linked Folders">
                        <Grid Margin="12">
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,10">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Client / Financial Year Folder Ownership" Style="{StaticResource SectionTitleStyle}" />
                                        <TextBlock Text="All Client/FY records are shown, including those with no linked Auto Import folder. Link or relink manually here; AAH never guesses ownership between clients. One Client + one FY = one live linked folder." Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,5,12,0" />
                                    </StackPanel>
                                    <Button Grid.Column="1" Content="Refresh" Command="{Binding RefreshFoldersCommand}" Padding="12,6" VerticalAlignment="Top" />
                                </Grid>
                            </Border>
                            <DataGrid Grid.Row="1" ItemsSource="{Binding LinkedFolderRows}" SelectedItem="{Binding SelectedLinkedFolderRow}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" RowHeaderWidth="0" SelectionMode="Single" EnableRowVirtualization="True" EnableColumnVirtualization="True">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Code" Binding="{Binding ClientCode}" Width="90"/>
                                    <DataGridTextColumn Header="Client" Binding="{Binding ClientName}" Width="1.3*"/>
                                    <DataGridTextColumn Header="GSTIN" Binding="{Binding Gstin}" Width="150"/>
                                    <DataGridTextColumn Header="FY" Binding="{Binding FinancialYear}" Width="90"/>
                                    <DataGridTextColumn Header="Link" Binding="{Binding LinkStatus}" Width="135"/>
                                    <DataGridTextColumn Header="XYZ / Auto Import Folder" Binding="{Binding FolderPath}" Width="2*"/>
                                    <DataGridCheckBoxColumn Header="Paused" Binding="{Binding IsPaused, Mode=OneWay}" Width="65"/>
                                    <DataGridTextColumn Header="Last Status" Binding="{Binding LastStatus}" Width="150"/>
                                    <DataGridTextColumn Header="Last Import" Binding="{Binding LastImportUtc, StringFormat={}{0:dd-MMM-yyyy HH:mm}}" Width="150"/>
                                </DataGrid.Columns>
                            </DataGrid>
                            <WrapPanel Grid.Row="2" Margin="0,10,0,0">
                                <Button Content="Link / Relink Folder..." Command="{Binding LinkRelinkSelectedFolderCommand}" Padding="12,6" Margin="0,0,8,6"/>
                                <Button Content="Change FY..." Command="{Binding ChangeSelectedFolderFyCommand}" Padding="12,6" Margin="0,0,8,6" ToolTip="Reassigns this folder through the existing Client/FY chooser. Accounting data and the physical folder are not deleted."/>
                                <Button Content="Open Folder" Command="{Binding OpenFolderCommand}" Padding="10,6" Margin="0,0,8,6"/>
                                <Button Content="{Binding PauseResumeText}" Command="{Binding PauseResumeFolderCommand}" Padding="10,6" Margin="0,0,8,6"/>
                                <Button Content="Force Scan" Command="{Binding ScanFolderCommand}" Padding="10,6" Margin="0,0,8,6" ToolTip="Force Scan only rescans this linked folder now; it uses exactly the same unattended watcher/classification/import route."/>
                                <Button Content="Unlink" Command="{Binding UnlinkFolderCommand}" Padding="10,6" Margin="0,0,8,6"/>
                                <TextBlock Text="Unlink/relink changes link metadata only; it never deletes the folder or accounting data." Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="6,0,0,6"/>
                            </WrapPanel>
                        </Grid>
                    </TabItem>

                    <TabItem Header="Health &amp; Recovery">
                        <Grid Margin="12">
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                            <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,10">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Auto Import Health &amp; Recovery" Style="{StaticResource SectionTitleStyle}" />
                                        <TextBlock Text="{Binding AutomationHealthText}" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,5,12,0" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <WrapPanel Grid.Column="1" HorizontalAlignment="Right">
                                        <Button Content="Health Check" Command="{Binding RunAutoImportHealthCheckCommand}" Padding="10,6" Margin="8,0,0,0"/>
                                        <Button Content="Repair Watchers" Command="{Binding RepairAutoImportCommand}" Padding="10,6" Margin="8,0,0,0" ToolTip="Re-enables watcher settings and rebuilds watcher registrations. It does not delete accounting data."/>
                                        <Button Content="Force Scan All" Command="{Binding ForceScanAllFoldersCommand}" Padding="10,6" Margin="8,0,0,0" ToolTip="Recovery-only force scan across linked folders. Successful Auto Import file history remains protected."/>
                                    </WrapPanel>
                                </Grid>
                            </Border>
                            <DataGrid Grid.Row="1" ItemsSource="{Binding AutomationHealth}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" RowHeaderWidth="0">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Client" Binding="{Binding ClientName}" Width="150"/>
                                    <DataGridTextColumn Header="FY" Binding="{Binding FinancialYear}" Width="85"/>
                                    <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="150"/>
                                    <DataGridCheckBoxColumn Header="Folder" Binding="{Binding FolderAvailable, Mode=OneWay}" Width="65"/>
                                    <DataGridCheckBoxColumn Header="Watcher" Binding="{Binding WatcherActive, Mode=OneWay}" Width="70"/>
                                    <DataGridTextColumn Header="Active" Binding="{Binding ActiveFileCount}" Width="60"/>
                                    <DataGridTextColumn Header="Queued" Binding="{Binding QueuedFileCount}" Width="60"/>
                                    <DataGridTextColumn Header="Current Stage" Binding="{Binding CurrentStage}" Width="190"/>
                                    <DataGridTextColumn Header="Current File" Binding="{Binding CurrentFileName}" Width="190"/>
                                    <DataGridTextColumn Header="Path" Binding="{Binding FolderPath}" Width="*"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </TabItem>
                </TabControl>
            </TabItem>

            <TabItem Header="Auto Tally Import">
                <Grid Margin="12">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,10">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Auto Tally Import by Client" Style="{StaticResource SectionTitleStyle}"/>
                                <TextBlock Text="Auto Tally Import controls only the inbound 5-second Tally-to-AAH Master/Voucher authority routine. Auto Open and Auto Close are dependent on outbound Automatic Tally Sync and are configured under the Dashboard cog. The exact numeric company directory is retained here as verified launch authority." Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,5,12,0"/>
                            </StackPanel>
                            <Button Grid.Column="1" Content="Refresh" Command="{Binding RefreshAutoTallyImportClientsCommand}" Padding="10,6" VerticalAlignment="Top"/>
                        </Grid>
                    </Border>
                    <DataGrid Grid.Row="1" ItemsSource="{Binding AutoTallyImportClients}" AutoGenerateColumns="False" CanUserAddRows="False" RowHeaderWidth="0" SelectionMode="Single">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Code" Binding="{Binding ClientCode}" IsReadOnly="True" Width="100"/>
                            <DataGridTextColumn Header="Client" Binding="{Binding ClientName}" IsReadOnly="True" Width="1.6*"/>
                            <DataGridTextColumn Header="FY" Binding="{Binding FinancialYear}" IsReadOnly="True" Width="110"/>
                            <DataGridCheckBoxColumn Header="Auto Tally Import" Binding="{Binding IsEnabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="135"/>
                            <DataGridTextColumn Header="Exact company folder (ends in number)" Binding="{Binding ExactCompanyFolder, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Width="2.7*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <Grid Grid.Row="2" Margin="0,10,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBlock Text="No company switching in an existing Tally process. Only a verified linked-company folder authorizes outbound Auto Open. Inbound Tally synchronization and manual Tally opening remain independent." Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" TextWrapping="Wrap"/>
                        <Button Grid.Column="1" Content="Save Auto Tally Import" Command="{Binding SaveAutoTallyImportClientsCommand}" Style="{StaticResource PrimaryButtonStyle}" Padding="12,7" Margin="12,0,0,0"/>
                    </Grid>
                </Grid>
            </TabItem>

            <TabItem Header="Mapping">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="Global Import Header Mapping" Style="{StaticResource SectionTitleStyle}"/>
                            <TextBlock Text="Select AAH canonical headers on the left, stage new external header names on the right, then add them globally. Existing built-in or previously learned aliases are intentionally not shown, edited or deleted." Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,5,0,0"/>
                        </StackPanel>
                    </Border>
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Border Style="{StaticResource CardBorderStyle}" Grid.Column="0">
                            <Grid>
                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                <Grid Grid.Row="0" Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="110"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="Module" VerticalAlignment="Center"/>
                                    <ComboBox Grid.Column="1" ItemsSource="{Binding MappingModuleOptions}" SelectedItem="{Binding SelectedMappingModule}" Padding="6,4"/>
                                </Grid>
                                <TextBox Grid.Row="1" Text="{Binding MappingHeaderSearch, UpdateSourceTrigger=PropertyChanged}" Padding="8,6" Margin="0,0,0,8" ToolTip="Search AAH canonical headers"/>
                                <DataGrid x:Name="MappingHeaderFieldsGrid" Grid.Row="2" ItemsSource="{Binding MappingHeaderFields}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" RowHeaderWidth="0" SelectionMode="Extended" SelectionUnit="FullRow" SelectionChanged="MappingHeaderFields_SelectionChanged">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="AAH Original Header" Binding="{Binding DisplayName}" Width="*"/>
                                        <DataGridTextColumn Header="Need" Binding="{Binding Requirement}" Width="90"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                                <Button Grid.Row="3" Content="Add Selected →" Command="{Binding AddSelectedMappingHeadersCommand}" Padding="12,7" HorizontalAlignment="Right" Margin="0,8,0,0"/>
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource CardBorderStyle}" Grid.Column="2">
                            <Grid>
                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                <TextBlock Text="New Global Header Mappings" Style="{StaticResource SectionTitleStyle}" Margin="0,0,0,8"/>
                                <DataGrid Grid.Row="1" ItemsSource="{Binding PendingHeaderMappings}" AutoGenerateColumns="False" CanUserAddRows="False" RowHeaderWidth="0" SelectionMode="Extended">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="AAH Header" Binding="{Binding CanonicalDisplay, Mode=OneWay}" IsReadOnly="True" Width="1.2*"/>
                                        <DataGridTextColumn Header="New Excel / Source Header" Binding="{Binding SourceHeader, UpdateSourceTrigger=PropertyChanged}" Width="1.3*"/>
                                        <DataGridTextColumn Header="Status" Binding="{Binding Status, Mode=OneWay}" IsReadOnly="True" Width="1.2*"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                                <Button Grid.Row="2" Content="Add Mappings Globally" Command="{Binding SaveGlobalHeaderMappingsCommand}" Padding="12,7" HorizontalAlignment="Right" Margin="0,8,0,0"/>
                            </Grid>
                        </Border>
                    </Grid>
                    <TextBlock Grid.Row="2" Text="{Binding MappingStatus}" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,10,0,0"/>
                </Grid>
            </TabItem>

            <TabItem Header="PDF / Banking / Sales">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="12">
                        <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="PDF Bank Statement Engine" Style="{StaticResource SectionTitleStyle}" />
                                <TextBlock Text="External Python runtime: CALL ONLY. Accounting Automation Hub executes the configured live Python script directly and never copies, replaces, backs up, restores, deletes, or packages Python runtime files."
                                           Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,8,0,10" TextWrapping="Wrap" />
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="170"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="Python executable" VerticalAlignment="Center" />
                                    <TextBox Grid.Column="1" Text="{Binding PdfPythonExecutable}" Padding="8,6" ToolTip="Leave blank to auto-detect py/python/python3." />
                                </Grid>
                                <Grid Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="170"/><ColumnDefinition Width="100"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="Timeout" VerticalAlignment="Center" />
                                    <TextBox Grid.Column="1" Text="{Binding PdfTimeoutMinutes}" Padding="8,6" />
                                    <TextBlock Grid.Column="2" Text="minutes" Margin="8,0,0,0" VerticalAlignment="Center" />
                                </Grid>
                                <CheckBox Content="Delete generated temporary workbook after successful PDF import" IsChecked="{Binding PdfDeleteGeneratedWorkbook}" Margin="0,10,0,0" />
                                <TextBlock Text="External Python folder (read/call only):" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,10,0,0" />
                                <TextBox Text="{Binding PdfManagedPythonFolder, Mode=OneWay}" IsReadOnly="True" />
                                <TextBlock Text="Exact runtime script:" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,6,0,0" />
                                <TextBox Text="{Binding PdfPipelineScriptPath, Mode=OneWay}" IsReadOnly="True" />
                                <Button Content="Open External Python Folder" Command="{Binding OpenPdfPipelineFolderCommand}" Padding="10,6" Margin="0,8,0,0" HorizontalAlignment="Left" />
                                <TextBlock Text="External Python Registry path:" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,8,0,0" />
                                <TextBox Text="{Binding PdfRegistryFolder, Mode=OneWay}" IsReadOnly="True" />

                                <Separator Margin="0,14,0,12" />
                                <TextBlock Text="Advanced Bank Scan OCR" Style="{StaticResource SectionTitleStyle}" />
                                <TextBlock Text="AAH calls the existing external Python runtime, PaddleOCR-VL 1.6 package, llama.cpp and model files directly for raw recognition only. No external OCR worker or verification script is executed. After recognition, AAH itself groups/orders the pages, verifies cross-page balances and the printed statement summary, applies only proven corrections, then passes a normal Bank Statement workbook to the existing importer."
                                           Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,8,0,10" TextWrapping="Wrap" />
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="170"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="OCR engine folder" VerticalAlignment="Center" />
                                    <TextBox Grid.Column="1" Text="{Binding BankOcrExternalRoot, UpdateSourceTrigger=PropertyChanged}" Padding="8,6" ToolTip="External OCR runtime folder containing _runtime\Python313\python.exe, _llama_runtime\llama-server.exe and the PaddleOCR-VL 1.6 GGUF model files. No OCR worker/verifier .py file is required." />
                                    <Button Grid.Column="2" Content="Browse" Command="{Binding BrowseBankOcrFolderCommand}" Padding="10,6" Margin="8,0,0,0" />
                                </Grid>
                                <Grid Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="170"/><ColumnDefinition Width="100"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="OCR timeout" VerticalAlignment="Center" />
                                    <TextBox Grid.Column="1" Text="{Binding BankOcrTimeoutMinutes}" Padding="8,6" />
                                    <TextBlock Grid.Column="2" Text="minutes per selected batch" Margin="8,0,0,0" VerticalAlignment="Center" />
                                </Grid>
                                <TextBlock Text="{Binding BankOcrRuntimeStatus, Mode=OneWay}" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,8,0,0" TextWrapping="Wrap" />
                                <Button Content="Open Advanced OCR Folder" Command="{Binding OpenBankOcrFolderCommand}" Padding="10,6" Margin="0,8,0,0" HorizontalAlignment="Left" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="Banking Defaults" Style="{StaticResource SectionTitleStyle}" />
                                <CheckBox Content="Show mapped Ledger Mapping rows by default" IsChecked="{Binding BankingShowMappedDefault}" Margin="0,10,0,0" />
                                <TextBlock Text="Ledger parser rules, reconciliation math and master-safety rules are protected accounting rules and are not exposed as casual toggles."
                                           Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,8,0,0" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource CardBorderStyle}">
                            <StackPanel>
                                <TextBlock Text="Sales / Purchase Automation" Style="{StaticResource SectionTitleStyle}" />
                                <CheckBox Content="Use saved Sales header mappings automatically" IsChecked="{Binding SalesUseSavedMappings}" Margin="0,10,0,0" />
                                <CheckBox Content="Save confirmed manual Sales mappings for future automatic import" IsChecked="{Binding SalesSaveConfirmedMappings}" Margin="0,8,0,0" />
                                <CheckBox Content="Use saved Purchase header mappings automatically" IsChecked="{Binding PurchaseUseSavedMappings}" Margin="0,8,0,0" />
                                <CheckBox Content="Save confirmed manual Purchase mappings for future automatic import" IsChecked="{Binding PurchaseSaveConfirmedMappings}" Margin="0,8,0,0" />
                                <CheckBox Content="Automatically process supported Purchase sources where the existing pairing/reconciliation requirements are satisfied" IsChecked="{Binding PurchaseAutoImportKnown}" Margin="0,8,0,0" />
                                <TextBlock Text="Stock Item aliases, item-specific Unit mappings and remembered Quantity Conversion rules continue to come from Stock Master and are applied after automatic Sales/Credit Note and Purchase Register imports."
                                           Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,10,0,0" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Firm Details">
                <Grid Margin="12">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="300"/><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <StackPanel Grid.ColumnSpan="3" Margin="0,0,0,10">
                        <TextBlock Text="Firm Details" FontSize="19" FontWeight="SemiBold"/>
                        <TextBlock Text="Save reusable CA/audit firm information once. CA profiles can be linked to a firm and inherit its firm name, FRN, place and contact details." Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                    </StackPanel>
                    <ListBox Grid.Row="1" Grid.Column="0" ItemsSource="{Binding FirmProfiles}" SelectedItem="{Binding SelectedFirmProfile}" DisplayMemberPath="FirmName"/>
                    <Grid Grid.Row="1" Grid.Column="2" DataContext="{Binding SelectedFirmProfile}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="190"/><ColumnDefinition Width="360"/></Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="Firm Name" Margin="0,6"/><TextBox Grid.Row="0" Grid.Column="1" Text="{Binding FirmName, UpdateSourceTrigger=PropertyChanged}" Background="#FFF2CC" Padding="6,4"/>
                        <TextBlock Grid.Row="1" Text="Firm Registration Number" Margin="0,6"/><TextBox Grid.Row="1" Grid.Column="1" Text="{Binding FirmRegistrationNumber, UpdateSourceTrigger=PropertyChanged}" Background="#FFF2CC" Padding="6,4"/>
                        <TextBlock Grid.Row="2" Text="Place" Margin="0,6"/><TextBox Grid.Row="2" Grid.Column="1" Text="{Binding Place, UpdateSourceTrigger=PropertyChanged}" Background="#FFF2CC" Padding="6,4"/>
                        <TextBlock Grid.Row="3" Text="Address" Margin="0,6"/><TextBox Grid.Row="3" Grid.Column="1" Text="{Binding Address, UpdateSourceTrigger=PropertyChanged}" Background="#FFF2CC" Padding="6,4"/>
                        <TextBlock Grid.Row="4" Text="Phone" Margin="0,6"/><TextBox Grid.Row="4" Grid.Column="1" Text="{Binding Phone, UpdateSourceTrigger=PropertyChanged}" Background="#FFF2CC" Padding="6,4"/>
                        <TextBlock Grid.Row="5" Text="Email" Margin="0,6"/><TextBox Grid.Row="5" Grid.Column="1" Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" Background="#FFF2CC" Padding="6,4"/>
                    </Grid>
                    <StackPanel Grid.Row="2" Grid.ColumnSpan="3" Orientation="Horizontal" Margin="0,10,0,0">
                        <Button Content="Add Firm" Command="{Binding AddFirmProfileCommand}" Padding="12,6" Margin="0,0,8,0"/>
                        <Button Content="Delete Selected" Command="{Binding DeleteFirmProfileCommand}" Padding="12,6" Margin="0,0,8,0"/>
                        <Button Content="Save Firm Details" Command="{Binding SaveFirmProfilesCommand}" Padding="12,6"/>
                    </StackPanel>
                </Grid>
            </TabItem>

            <TabItem Header="CA Details">
                <Grid Margin="12">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="300"/><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <StackPanel Grid.ColumnSpan="3" Margin="0,0,0,10">
                        <TextBlock Text="CA / Audit Firm Details" FontSize="19" FontWeight="SemiBold"/>
                        <TextBlock Text="Save reusable signing-auditor profiles under saved Firm Details. Financial Statements and CA client folders can link the CA profile and populate firm/signing details automatically." Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                    </StackPanel>
                    <ListBox Grid.Row="1" Grid.Column="0" ItemsSource="{Binding CaProfiles}" SelectedItem="{Binding SelectedCaProfile}">
                        <ListBox.ItemTemplate><DataTemplate><StackPanel Margin="2"><TextBlock Text="{Binding FirmName}" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}"/><TextBlock Text="{Binding CaName}" FontWeight="SemiBold"/></StackPanel></DataTemplate></ListBox.ItemTemplate>
                    </ListBox>
                    <Grid Grid.Row="1" Grid.Column="2" DataContext="{Binding SelectedCaProfile}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="190"/><ColumnDefinition Width="360"/></Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="Firm" Margin="0,6"/>
                        <ComboBox Grid.Row="0" Grid.Column="1" ItemsSource="{Binding DataContext.FirmProfiles, ElementName=SettingsRoot}" DisplayMemberPath="FirmName" SelectedValuePath="FirmId" SelectedValue="{Binding FirmProfileId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Background="#FFF2CC"/>
                        <TextBlock Grid.Row="1" Text="CA / Signing Auditor Name" Margin="0,6"/><TextBox Grid.Row="1" Grid.Column="1" Text="{Binding CaName, UpdateSourceTrigger=PropertyChanged}" Background="#FFF2CC" Padding="6,4"/>
                        <TextBlock Grid.Row="2" Text="Designation" Margin="0,6"/><TextBox Grid.Row="2" Grid.Column="1" Text="{Binding Designation, UpdateSourceTrigger=PropertyChanged}" Background="#FFF2CC" Padding="6,4"/>
                        <TextBlock Grid.Row="3" Text="Membership Number" Margin="0,6"/><TextBox Grid.Row="3" Grid.Column="1" Text="{Binding MembershipNumber, UpdateSourceTrigger=PropertyChanged}" Background="#FFF2CC" Padding="6,4"/>
                        <TextBlock Grid.Row="4" Text="Audit Firm Name" Margin="0,6"/><TextBox Grid.Row="4" Grid.Column="1" Text="{Binding FirmName}" IsReadOnly="True" Background="#E8F2FC" Padding="6,4"/>
                        <TextBlock Grid.Row="5" Text="Firm Registration Number" Margin="0,6"/><TextBox Grid.Row="5" Grid.Column="1" Text="{Binding FirmRegistrationNumber}" IsReadOnly="True" Background="#E8F2FC" Padding="6,4"/>
                        <TextBlock Grid.Row="6" Text="Place" Margin="0,6"/><TextBox Grid.Row="6" Grid.Column="1" Text="{Binding Place}" IsReadOnly="True" Background="#E8F2FC" Padding="6,4"/>
                        <TextBlock Grid.Row="7" Text="Address" Margin="0,6"/><TextBox Grid.Row="7" Grid.Column="1" Text="{Binding Address}" IsReadOnly="True" Background="#E8F2FC" Padding="6,4"/>
                        <TextBlock Grid.Row="8" Text="Phone" Margin="0,6"/><TextBox Grid.Row="8" Grid.Column="1" Text="{Binding Phone}" IsReadOnly="True" Background="#E8F2FC" Padding="6,4"/>
                        <TextBlock Grid.Row="9" Text="Email" Margin="0,6"/><TextBox Grid.Row="9" Grid.Column="1" Text="{Binding Email}" IsReadOnly="True" Background="#E8F2FC" Padding="6,4"/>
                    </Grid>
                    <StackPanel Grid.Row="2" Grid.ColumnSpan="3" Orientation="Horizontal" Margin="0,10,0,0">
                        <Button Content="Add CA" Command="{Binding AddCaProfileCommand}" Padding="12,6" Margin="0,0,8,0"/>
                        <Button Content="Delete Selected" Command="{Binding DeleteCaProfileCommand}" Padding="12,6" Margin="0,0,8,0"/>
                        <Button Content="Save CA Details" Command="{Binding SaveCaProfilesCommand}" Padding="12,6"/>
                    </StackPanel>
                </Grid>
            </TabItem>

            <TabItem Header="Tally">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="12">
                        <Border Style="{StaticResource CardBorderStyle}">
                            <StackPanel>
                                <TextBlock Text="Tally Connection &amp; Export Defaults" Style="{StaticResource SectionTitleStyle}" />
                                <Grid Margin="0,12,0,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition Width="260"/><ColumnDefinition Width="120"/><ColumnDefinition Width="100"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="Host" VerticalAlignment="Center" />
                                    <TextBox Grid.Column="1" Text="{Binding TallyHost}" Padding="8,6" />
                                    <TextBlock Grid.Column="2" Text="Port" Margin="20,0,0,0" VerticalAlignment="Center" />
                                    <TextBox Grid.Column="3" Text="{Binding TallyPort}" Padding="8,6" />
                                </Grid>
                                <CheckBox Content="Auto-connect to Tally when the Hub starts" IsChecked="{Binding TallyAutoConnect}" Margin="0,10,0,0" />
                                <CheckBox Content="Tally Export Select All is ON by default" IsChecked="{Binding TallySelectAllDefault}" Margin="0,8,0,0" />
                                <TextBlock Text="Changing Host/Port is persisted immediately when Settings are saved and becomes the live connection endpoint on the next application start."
                                           Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,10,0,0" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Security &amp; LAN">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="12">
                        <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="AAH Main Server" Style="{StaticResource SectionTitleStyle}"/>
                                <TextBlock Text="One Windows PC is the Main Server authority. It retains independent Client/FY copies, receives network/Android uploads, saves generated exports, distributes approved client packages, expires inactive devices/folder links, and keeps Tally/SQLite/OCR/Python private." Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,8,0,0"/>
                                <CheckBox Content="Enable Main Server mode" IsChecked="{Binding ServerMode}" Margin="0,12,0,0"/>
                                <CheckBox Content="Enable HTTPS access for LAN / WireGuard native clients" IsChecked="{Binding SecureLanEnabled}" Margin="0,8,0,0"/>
                                <Grid Margin="0,10,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="250"/><ColumnDefinition Width="100"/><ColumnDefinition Width="100"/></Grid.ColumnDefinitions><TextBlock Text="Private bind address" VerticalAlignment="Center"/><ComboBox Grid.Column="1" ItemsSource="{Binding LanBindAddressOptions}" SelectedItem="{Binding SecureLanBindAddress}" IsEditable="True"/><TextBlock Grid.Column="2" Text="HTTPS port" Margin="16,0,0,0" VerticalAlignment="Center"/><TextBox Grid.Column="3" Text="{Binding SecureLanPort}" Padding="8,6"/></Grid>
                                <Grid Margin="0,10,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Server root" VerticalAlignment="Center"/><TextBox Grid.Column="1" Text="{Binding ServerRootFolder}" Padding="8,6"/><Button Grid.Column="2" Content="Browse" Command="{Binding BrowseServerRootFolderCommand}" Padding="9,6" Margin="8,0,0,0"/></Grid>
                                <TextBlock Text="Core Main Server settings are configured automatically on this PC. Server data uses C:\Accounting Automation Hub Server; AAH selects the active private LAN address, HTTPS port 47831 and secure expiry defaults. You only need to choose the Second backup folder below. The retained server copy is append/version-safe: deleting a local file does not delete its server-retained copy." Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,10,0,0"/>
                                <TextBlock Text="{Binding RemoteAssistInternetRouteText, Mode=OneWay}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,8,0,0"/>
                                <TextBlock Text="Remote Assist prefers a detected private VPN/overlay interface for Internet support. AAH still refuses public/wildcard binds; if no private overlay is present, the normal private Main Server route is used." Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="LAN Systems, Registration &amp; Expiry" Style="{StaticResource SectionTitleStyle}"/>
                                <TextBlock Text="Create the AAH User once, then enroll each trusted Windows/Android device for that user with a one-use enrollment credential. For a Windows LAN PC, OTP is used once to verify registration; routine login does not use OTP. Registration OTP is required again only after 30 days without opening AAH or when an Administrator resets that PC's registration trust. Network route is still derived by the Main Server from the incoming IP/interface, and Client/FY access remains controlled by the AAH User from Client Directory." Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,8,0,0"/>
                                <Grid Margin="0,10,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="145"/><ColumnDefinition Width="80"/><ColumnDefinition Width="145"/><ColumnDefinition Width="80"/><ColumnDefinition Width="155"/><ColumnDefinition Width="80"/></Grid.ColumnDefinitions><TextBlock Text="Windows expiry days" VerticalAlignment="Center"/><TextBox Grid.Column="1" Text="{Binding PcExpiryDays}" Padding="6,4"/><TextBlock Grid.Column="2" Text="Android expiry days" Margin="14,0,0,0" VerticalAlignment="Center"/><TextBox Grid.Column="3" Text="{Binding AndroidExpiryDays}" Padding="6,4"/><TextBlock Grid.Column="4" Text="Folder-link expiry days" Margin="14,0,0,0" VerticalAlignment="Center"/><TextBox Grid.Column="5" Text="{Binding FolderLinkExpiryDays}" Padding="6,4"/></Grid>
                                <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,12,0,0">
                                    <StackPanel>
                                        <TextBlock Text="LAN Application" FontWeight="SemiBold" FontSize="14"/>
                                        <TextBlock Text="The Windows node package is the full Accounting Automation Hub desktop interface in server-controlled processing-node mode. Share it from here before enrolling a LAN or routed private/WireGuard PC. The Share button creates a one-use 30-minute Main Server download link and copies it to the clipboard. On a PC that already has AAH, the shared package updates the registered application in place instead of creating another working copy." Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,5,0,0"/>
                                        <Grid Margin="0,8,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="Approved package" VerticalAlignment="Center"/><TextBox Grid.Column="1" Text="{Binding NetworkClientPackagePath}" IsReadOnly="True" Padding="8,6"/></Grid>
                                        <WrapPanel Margin="0,10,0,0">
                                            <Button Content="Share LAN Application" Command="{Binding CreateWindowsDownloadTicketCommand}" Style="{StaticResource PrimaryButtonStyle}" Padding="10,7"/>
                                            <Button Content="Open LAN App Folder" Command="{Binding OpenNetworkClientPackageFolderCommand}" Margin="8,0,0,0" Padding="10,7"/>
                                            <Button Content="Publish LAN Update" Command="{Binding PublishLanUpdateCommand}" Margin="8,0,0,0" Padding="10,7"/>
                                            <Button Content="Force Update All LAN Apps" Command="{Binding ForceLanUpdateCommand}" Margin="8,0,0,0" Padding="10,7"/>
                                        </WrapPanel>
                                        <TextBlock Text="Publish LAN Update makes the current Main Server package available normally. Force Update All LAN Apps blocks outdated enrolled Windows LAN copies on their next launch/10-minute heartbeat until the Main Server package is downloaded and SHA-256 verified." Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,8,0,0"/>
                                        <TextBlock Text="{Binding LanUpdatePolicyText}" TextWrapping="Wrap" FontWeight="SemiBold" Margin="0,7,0,0"/>
                                        <TextBlock Text="{Binding ServerDistributionText}" TextWrapping="Wrap" Margin="0,8,0,0"/>
                                    </StackPanel>
                                </Border>
                                <WrapPanel Margin="0,12,0,0"><Button Content="Create / Reset AAH User" Command="{Binding CreateLanUserCommand}" Style="{StaticResource PrimaryButtonStyle}" Padding="10,7"/><Button Content="Add / Enroll LAN System" Command="{Binding GenerateLanPairingCodeCommand}" Margin="8,0,0,0" Padding="10,7"/></WrapPanel>
                                <TextBlock Text="{Binding LanPairingCodeText}" TextWrapping="Wrap" FontWeight="SemiBold" Margin="0,10,0,0"/>
                                <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,10,0,0">
                                    <StackPanel>
                                        <TextBlock Text="Mobile user codes moved to Client Directory" FontWeight="SemiBold"/>
                                        <TextBlock Text="Main Server Settings no longer creates separate Enrollment/Login QR grants. Open Client Directory → User Access, select the AAH user, and use that user's continuously rotating live code. The one code chooses Enrollment or Login automatically from the phone's trusted-device state." TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,5,0,0"/>
                                    </StackPanel>
                                </Border>
                                <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,10,0,0"><StackPanel><TextBlock Text="Pending Network OTP" FontWeight="SemiBold"/><TextBlock Text="{Binding PendingMfaText}" TextWrapping="Wrap" Margin="0,5,0,0"/><Button Content="Refresh OTP List" Command="{Binding RefreshSecurityDiagnosticsCommand}" HorizontalAlignment="Left" Margin="0,8,0,0" Padding="8,5"/></StackPanel></Border>
                                <TextBlock Text="Create/reset each AAH User ID/password here in Settings → Security &amp; LAN. Password can be saved securely on the network PC if the user chooses. The Main Server classifies every OTP request automatically: same-subnet devices receive LAN OTP; routed private/WireGuard devices receive Private Network OTP. After enrollment, grant Client/FY access to the AAH User only from Client Directory → User Access. The same assignment applies to every trusted PC and phone for that user." Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,8,0,0"/>
                                <TextBlock Text="{Binding SecureLanEndpoint, StringFormat='Native API endpoint: {0}'}" Margin="0,8,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="Server-controlled Application Distribution" Style="{StaticResource SectionTitleStyle}"/>
                                <TextBlock Text="LAN/WireGuard PCs receive the full AAH desktop application package approved by the Main Server; Android receives the approved native Android package. Windows sharing is install-or-update: one canonical LAN application is retained per Windows user. One-use download tickets expire after 30 minutes. Network devices must enroll after installation and continue periodic lease validation." Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,8,0,0"/>
                                <TextBlock Text="Windows LAN application sharing is available above under LAN Systems → Share LAN Application. The bundled Windows package is registered automatically and does not require manual browsing." Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,10,0,0"/>
                                <Grid Margin="0,8,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="160"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Android APK" VerticalAlignment="Center"/><TextBox Grid.Column="1" Text="{Binding AndroidPackagePath}" Padding="8,6"/><Button Grid.Column="2" Content="Browse" Command="{Binding BrowseAndroidPackageCommand}" Margin="8,0,0,0" Padding="8,5"/><Button Grid.Column="3" Content="Create Download Ticket" Command="{Binding CreateAndroidDownloadTicketCommand}" Margin="8,0,0,0" Padding="8,5"/></Grid>
                                <TextBlock Text="Desktop releases now carry the matching Android Studio source and synchronize controlled project files to C:\AAH MOBILE. Android Studio remains the build/install authority. Enrolled phones compare their installed mobile version with the Main Server required version on heartbeat and show a clear VERSION MISMATCH until the matching app is built and installed." Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,6,0,0"/>
                                <TextBlock Text="{Binding ServerDistributionText}" TextWrapping="Wrap" Margin="0,10,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="Replication &amp; Verified Backup" Style="{StaticResource SectionTitleStyle}"/>
                                <TextBlock Text="Main Server replication retains uploaded/source evidence and a verified accounting-data backup. A second configurable destination receives a hash-verified copy. The updater/backup contract still excludes the external Python/OCR runtime." Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,8,0,0"/>
                                <Grid Margin="0,10,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="160"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Second backup folder" VerticalAlignment="Center"/><TextBox Grid.Column="1" Text="{Binding ExternalBackupFolder}" Padding="8,6"/><Button Grid.Column="2" Content="Browse" Command="{Binding BrowseExternalBackupFolderCommand}" Margin="8,0,0,0" Padding="8,5"/></Grid>
                                <WrapPanel Margin="0,12,0,0"><Button Content="Run Server Replication Now" Command="{Binding RunServerReplicationCommand}" Style="{StaticResource PrimaryButtonStyle}" Padding="9,6"/><Button Content="Open Server Root" Command="{Binding OpenServerRootFolderCommand}" Margin="8,0,0,0" Padding="9,6"/><Button Content="Open Server CA Folder" Command="{Binding OpenLanCertificateFolderCommand}" Margin="8,0,0,0" Padding="9,6"/></WrapPanel>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardBorderStyle}">
                            <StackPanel>
                                <TextBlock Text="Main Server Control Panel" Style="{StaticResource SectionTitleStyle}"/>
                                <TextBlock Text="Use this panel to verify the exact Main Server process, existing AAH User IDs, enrolled devices, active sessions, user Client/FY assignments, snapshot stage and recent security activity. Snapshot failures are recorded here with the real failing stage and exception instead of only SNAPSHOT_BUILD_FAILED." Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                                <WrapPanel Margin="0,12,0,0">
                                    <Button Content="Refresh Control Panel" Command="{Binding RefreshLanControlPanelCommand}" Style="{StaticResource PrimaryButtonStyle}" Padding="10,7"/>
                                    <Button Content="Run Snapshot Diagnostic" Command="{Binding RunSnapshotDiagnosticCommand}" Padding="10,7" Margin="8,0,0,0"/>
                                    <Button Content="Refresh Network Policy" Command="{Binding RefreshSecurityDiagnosticsCommand}" Padding="10,7" Margin="8,0,0,0"/>
                                </WrapPanel>
                                <TextBlock Text="{Binding LanControlPanelStatus}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,9,0,0"/>

                                <TextBlock Text="Actual Main Server Runtime" FontWeight="SemiBold" FontSize="14" Margin="0,16,0,0"/>
                                <TextBox Text="{Binding MainServerRuntimeText, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" MinHeight="145" MaxHeight="220" Margin="0,7,0,0" Padding="9"/>

                                <TextBlock Text="Existing AAH Users &amp; Activity" FontWeight="SemiBold" FontSize="14" Margin="0,16,0,0"/>
                                <TextBlock Text="Passwords are never displayed. Password Status only confirms whether a secure password hash is configured. Last login/failure/activity are Main Server records." Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,4,0,6"/>
                                <DataGrid ItemsSource="{Binding LanUsers}" SelectedItem="{Binding SelectedLanUser}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False" Height="230" ScrollViewer.HorizontalScrollBarVisibility="Auto">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="User ID" Binding="{Binding UserId}" Width="120"/>
                                        <DataGridTextColumn Header="Display Name" Binding="{Binding DisplayName}" Width="130"/>
                                        <DataGridTextColumn Header="Role" Binding="{Binding Role}" Width="100"/>
                                        <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="80"/>
                                        <DataGridTextColumn Header="Password" Binding="{Binding PasswordStatus}" Width="110"/>
                                        <DataGridTextColumn Header="Failed" Binding="{Binding FailedAttempts}" Width="65"/>
                                        <DataGridTextColumn Header="Lockout Until" Binding="{Binding LockoutUntil}" Width="145"/>
                                        <DataGridTextColumn Header="Last Login" Binding="{Binding LastLogin}" Width="145"/>
                                        <DataGridTextColumn Header="Last Failed Login" Binding="{Binding LastFailedLogin}" Width="145"/>
                                        <DataGridTextColumn Header="Last Activity" Binding="{Binding LastActivity}" Width="145"/>
                                        <DataGridTextColumn Header="Sessions" Binding="{Binding ActiveSessions}" Width="70"/>
                                        <DataGridTextColumn Header="Systems" Binding="{Binding EnrolledSystems}" Width="70"/>
                                        <DataGridTextColumn Header="MFA" Binding="{Binding Mfa}" Width="120"/>
                                    </DataGrid.Columns>
                                </DataGrid>

                                <TextBlock Text="Trusted Devices" FontWeight="SemiBold" FontSize="14" Margin="0,16,0,0"/>
                                <TextBlock Text="Assigned Clients shows what Client Directory has granted to the enrolled system. Effective Client Count includes only assignments whose client LAN Available toggle is currently ON. Snapshot Branch shows exactly which snapshot path the server should use." Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,4,0,6"/>
                                <DataGrid ItemsSource="{Binding LanSystems}" SelectedItem="{Binding SelectedLanSystem}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False" Height="265" ScrollViewer.HorizontalScrollBarVisibility="Auto">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="System" Binding="{Binding DeviceName}" Width="150"/>
                                        <DataGridTextColumn Header="Type" Binding="{Binding DeviceType}" Width="75"/>
                                        <DataGridTextColumn Header="User ID" Binding="{Binding UserId}" Width="100"/>
                                        <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="110"/>
                                        <DataGridTextColumn Header="Registration OTP" Binding="{Binding RegistrationTrust}" Width="170"/>
                                        <DataGridTextColumn Header="App Version" Binding="{Binding AppVersion}" Width="95"/>
                                        <DataGridTextColumn Header="Last Seen" Binding="{Binding LastSeen}" Width="145"/>
                                        <DataGridTextColumn Header="Last Validated" Binding="{Binding LastValidated}" Width="145"/>
                                        <DataGridTextColumn Header="Expires" Binding="{Binding Expires}" Width="145"/>
                                        <DataGridTextColumn Header="Sessions" Binding="{Binding ActiveSessions}" Width="70"/>
                                        <DataGridTextColumn Header="Effective Clients" Binding="{Binding EffectiveClientCount}" Width="100"/>
