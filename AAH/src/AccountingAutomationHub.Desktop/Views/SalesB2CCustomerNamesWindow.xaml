<Window x:Class="AccountingAutomationHub.Desktop.Views.SalesB2CCustomerNamesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="B2C Customer Rename"
        Width="980" Height="650"
        WindowStartupLocation="CenterOwner"
        Background="#F1F5F9">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Background="White" Padding="14" CornerRadius="10" Margin="0,0,0,10">
            <StackPanel>
                <TextBlock Text="B2C Customer Rename" FontSize="20" FontWeight="SemiBold"/>
                <TextBlock Text="Each unique B2C source name appears once. Choose an existing Sundry Debtors ledger from the dropdown, or type a new customer name. New names are created only under Sundry Debtors."
                           Foreground="#64748B" TextWrapping="Wrap" Margin="0,4,0,0"/>
            </StackPanel>
        </Border>

        <TextBox Grid.Row="1"
                 Text="{Binding B2CSearchText,UpdateSourceTrigger=PropertyChanged}"
                 MinHeight="32" Padding="9,5" Margin="0,0,0,10"
                 ToolTip="Search B2C source name or target debtor ledger"/>

        <DataGrid Grid.Row="2"
                  ItemsSource="{Binding B2CVisibleCustomers}"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  IsReadOnly="False"
                  SelectionUnit="FullRow"
                  HeadersVisibility="Column">
            <DataGrid.Columns>
                <DataGridTextColumn Header="B2C Source Name"
                                    Binding="{Binding SourceName}"
                                    IsReadOnly="True"
                                    Width="2*"/>
                <DataGridTemplateColumn Header="Rename To / Sundry Debtors Ledger" Width="3*">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <ComboBox IsEditable="True"
                                      IsTextSearchEnabled="True"
                                      StaysOpenOnEdit="True"
                                      ItemsSource="{Binding DataContext.B2CDebtorLedgerOptions, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                      Text="{Binding CustomerName, Mode=OneWay}"
                                      Tag="{Binding}"
                                      KeyDown="Name_KeyDown"
                                      LostKeyboardFocus="Name_LostKeyboardFocus"
                                      DropDownClosed="Name_DropDownClosed"
                                      MinHeight="28"
                                      Padding="6,2"
                                      ToolTip="Select an existing Sundry Debtors ledger, or type a new name to create it under Sundry Debtors."/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Transactions"
                                    Binding="{Binding TransactionCount, StringFormat=N0}"
                                    IsReadOnly="True"
                                    Width="140"/>
            </DataGrid.Columns>
        </DataGrid>

        <Grid Grid.Row="3" Margin="0,10,0,0">
            <TextBlock Text="{Binding B2CPanelStatusText}" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,110,0"/>
            <Button Content="Close" Width="90" HorizontalAlignment="Right" IsCancel="True"/>
        </Grid>
    </Grid>
</Window>
