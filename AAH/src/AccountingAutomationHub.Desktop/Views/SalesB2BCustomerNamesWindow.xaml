<Window x:Class="AccountingAutomationHub.Desktop.Views.SalesB2BCustomerNamesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="B2B Customer Names"
        Width="1440"
        Height="760"
        MinWidth="1080"
        MinHeight="580"
        WindowStartupLocation="CenterOwner"
        Background="#F1F5F9">
    <Window.Resources>
        <Style x:Key="InlineNameEditor" TargetType="TextBox">
            <Setter Property="MinHeight" Value="30" />
            <Setter Property="Padding" Value="7,4" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="BorderBrush" Value="#CBD5E1" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Background" Value="White" />
        </Style>
        <Style x:Key="B2BGridStyle" TargetType="DataGrid">
            <Setter Property="AutoGenerateColumns" Value="False" />
            <Setter Property="CanUserAddRows" Value="False" />
            <Setter Property="CanUserDeleteRows" Value="False" />
            <Setter Property="HeadersVisibility" Value="Column" />
            <Setter Property="GridLinesVisibility" Value="Horizontal" />
            <Setter Property="RowHeaderWidth" Value="0" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="AlternatingRowBackground" Value="#F8FAFC" />
            <Setter Property="RowHeight" Value="38" />
            <Setter Property="ColumnHeaderHeight" Value="34" />
            <Setter Property="HorizontalGridLinesBrush" Value="#E2E8F0" />
        </Style>
    </Window.Resources>

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="White" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="B2B Customer Names" FontSize="20" FontWeight="SemiBold" />
                    <TextBlock Text="Matched and Not Matched are separate sheets. Search covers GSTIN, Customer Name, Recipient Name and Trade Name. Names save automatically on Enter or when focus leaves the field. Original Recipient/Trade names remain authoritative over conflicting manual entries."
                               Foreground="#64748B" FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap" />
                </StackPanel>
                <Border Grid.Column="1" CornerRadius="14" Padding="12,6" VerticalAlignment="Center">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="#FEF3C7" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding AreAllB2BCustomersMatched}" Value="True">
                                    <Setter Property="Background" Value="#DCFCE7" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock Text="{Binding B2BCompletionText}" FontSize="11" FontWeight="SemiBold">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="#92400E" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding AreAllB2BCustomersMatched}" Value="True">
                                        <Setter Property="Foreground" Value="#166534" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Border>
            </Grid>
        </Border>

        <Border Grid.Row="1" Background="White" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="10" Padding="12" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Search" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,8,0" />
                <TextBox Grid.Column="1"
                         Text="{Binding B2BSearchText, UpdateSourceTrigger=PropertyChanged}"
                         MinHeight="32"
                         Padding="9,5"
                         VerticalContentAlignment="Center"
                         ToolTip="Search GSTIN, Customer Name, Recipient Name or Trade Name" />
                <Button Grid.Column="2" Content="Clear" Width="72" Margin="8,0,0,0" Click="ClearSearch_Click" />
                <Button Grid.Column="3"
                        Content="Delete All Manual Names"
                        MinWidth="170"
                        Margin="8,0,0,0"
                        Padding="12,5"
                        IsEnabled="{Binding CanEditSales}"
                        ToolTip="Delete only names entered manually in this B2B panel. Original Recipient/Trade names and Customer Master data are retained."
                        Click="DeleteAllManualNames_Click" />
            </Grid>
        </Border>

        <Border Grid.Row="2" Background="White" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="10" Padding="0">
            <TabControl>
                <TabItem>
                    <TabItem.Header>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Matched" FontWeight="SemiBold" />
                            <TextBlock Text=" (" Foreground="#166534" FontWeight="SemiBold" /><TextBlock Text="{Binding B2BMatchedCount}" Foreground="#166534" FontWeight="SemiBold" /><TextBlock Text=")" Foreground="#166534" FontWeight="SemiBold" />
                        </StackPanel>
                    </TabItem.Header>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Border Background="#F0FDF4" BorderBrush="#BBF7D0" BorderThickness="0,0,0,1" Padding="10">
                            <TextBlock Text="Matched GSTINs. Edit Customer Name to rename; the change is duplicate-checked and saves automatically." Foreground="#166534" FontSize="10" />
                        </Border>
                        <DataGrid Grid.Row="1" ItemsSource="{Binding B2BMatchedCustomers}" Style="{StaticResource B2BGridStyle}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="GSTIN" Binding="{Binding Gstin}" Width="180" IsReadOnly="True" />
                                <DataGridTemplateColumn Header="Customer Name / Rename" Width="2*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBox Text="{Binding CustomerName, Mode=OneWay}"
                                                     Style="{StaticResource InlineNameEditor}"
                                                     IsEnabled="{Binding DataContext.CanEditSales, RelativeSource={RelativeSource AncestorType=Window}}"
                                                     ToolTip="Rename customer. Saves automatically on Enter or when focus leaves the field."
                                                     LostKeyboardFocus="CustomerNameEditor_LostKeyboardFocus"
                                                     KeyDown="CustomerNameEditor_KeyDown" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Recipient Name" Binding="{Binding RecipientName}" Width="1.45*" IsReadOnly="True" />
                                <DataGridTextColumn Header="Trade Name" Binding="{Binding TradeName}" Width="1.45*" IsReadOnly="True" />
                                <DataGridTextColumn Header="Source" Binding="{Binding NameSource}" Width="145" IsReadOnly="True" />
                                <DataGridTextColumn Header="Duplicate" Binding="{Binding DuplicateStatus}" Width="1.35*" IsReadOnly="True" />
                                <DataGridTextColumn Header="Rows" Binding="{Binding TransactionCount}" Width="70" IsReadOnly="True" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </TabItem>

                <TabItem>
                    <TabItem.Header>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Not Matched" FontWeight="SemiBold" />
                            <TextBlock Text=" (" Foreground="#92400E" FontWeight="SemiBold" /><TextBlock Text="{Binding B2BUnmatchedCount}" Foreground="#92400E" FontWeight="SemiBold" /><TextBlock Text=")" Foreground="#92400E" FontWeight="SemiBold" />
                        </StackPanel>
                    </TabItem.Header>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Border Padding="10" BorderBrush="#FDE68A" BorderThickness="0,0,0,1">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="#FFFBEB" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding AreAllB2BCustomersMatched}" Value="True">
                                            <Setter Property="Background" Value="#F0FDF4" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock Text="Enter a customer name. Press Enter or leave the field; it saves automatically and the GSTIN moves to Matched."
                                       Foreground="#92400E" FontSize="10" />
                        </Border>
                        <DataGrid Grid.Row="1" ItemsSource="{Binding B2BUnmatchedCustomers}" Style="{StaticResource B2BGridStyle}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="GSTIN" Binding="{Binding Gstin}" Width="180" IsReadOnly="True" />
                                <DataGridTemplateColumn Header="Enter Customer Name" Width="2*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBox Style="{StaticResource InlineNameEditor}"
                                                     IsEnabled="{Binding DataContext.CanEditSales, RelativeSource={RelativeSource AncestorType=Window}}"
                                                     ToolTip="Enter customer name. Saves automatically on Enter or when focus leaves the field. Duplicate Customer/Recipient/Trade names are blocked."
                                                     LostKeyboardFocus="CustomerNameEditor_LostKeyboardFocus"
                                                     KeyDown="CustomerNameEditor_KeyDown" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Recipient Name" Binding="{Binding RecipientName}" Width="1.6*" IsReadOnly="True" />
                                <DataGridTextColumn Header="Trade Name" Binding="{Binding TradeName}" Width="1.6*" IsReadOnly="True" />
                                <DataGridTextColumn Header="Duplicate" Binding="{Binding DuplicateStatus}" Width="1.45*" IsReadOnly="True" />
                                <DataGridTextColumn Header="Rows" Binding="{Binding TransactionCount}" Width="70" IsReadOnly="True" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </TabItem>
            </TabControl>
        </Border>

        <Grid Grid.Row="3" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="{Binding B2BPanelStatusText}" Foreground="#475569" FontSize="10" VerticalAlignment="Center" TextWrapping="Wrap" Margin="2,0,12,0" />
            <Button Grid.Column="1" Content="Close" Width="90" Height="32" IsCancel="True" Click="Close_Click" />
        </Grid>
    </Grid>
</Window>
