<UserControl x:Class="AccountingAutomationHub.Desktop.Views.FixedAssetsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:AccountingAutomationHub.Desktop.Controls">
    <UserControl.Resources>
        <Style x:Key="SegmentRadioStyle" TargetType="RadioButton">
            <Setter Property="Margin" Value="0"/>
            <Setter Property="Padding" Value="9,5"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="SegmentBorder" BorderBrush="#AFC2D8" BorderThickness="1" Background="Transparent" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="SegmentBorder" Property="Background" Value="#DDEBFF"/>
                                <Setter TargetName="SegmentBorder" Property="BorderBrush" Value="#4F86E8"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.55"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,10">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="Generate Voucher" Command="{Binding GenerateVoucherCommand}" Style="{StaticResource PrimaryButtonStyle}" Padding="12,7" Margin="0,0,8,0"/>
                <Button Content="Refresh" Command="{Binding RefreshCommand}" Padding="12,7"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal">
                <Border Width="44" Height="44" CornerRadius="12" Background="{DynamicResource AccentSoftBrush}" Margin="0,0,11,0">
                    <TextBlock Text="FA" Foreground="{DynamicResource AccentBrush}" FontWeight="Bold" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Fixed Assets" FontSize="24" FontWeight="SemiBold"/>
                    <TextBlock Text="Register • Depreciation • Tally-matched adjustment" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" Margin="0,1,0,0"/>
                </StackPanel>
            </StackPanel>
        </DockPanel>

        <!-- Main movement totals. Current Book Value marker is retained for inherited Fixed Assets validation. -->
        <Grid Grid.Row="1" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,7,0" Padding="10">
                <StackPanel><TextBlock Text="Opening Balance" Foreground="{DynamicResource TextSecondaryBrush}"/><TextBlock Text="{Binding TotalOpeningBalance, StringFormat={}{0:N2}}" FontSize="19" FontWeight="SemiBold"/></StackPanel>
            </Border>
            <Border Grid.Column="1" Style="{StaticResource CardBorderStyle}" Margin="0,0,7,0" Padding="10">
                <StackPanel><TextBlock Text="Additions" Foreground="{DynamicResource TextSecondaryBrush}"/><TextBlock Text="{Binding TotalAdditions, StringFormat={}{0:N2}}" FontSize="19" FontWeight="SemiBold"/></StackPanel>
            </Border>
            <Border Grid.Column="2" Style="{StaticResource CardBorderStyle}" Margin="0,0,7,0" Padding="10">
                <StackPanel><TextBlock Text="Deletions" Foreground="{DynamicResource TextSecondaryBrush}"/><TextBlock Text="{Binding TotalDeletions, StringFormat={}{0:N2}}" FontSize="19" FontWeight="SemiBold"/></StackPanel>
            </Border>
            <Border Grid.Column="3" Style="{StaticResource CardBorderStyle}" Margin="0,0,7,0" Padding="10">
                <StackPanel><TextBlock Text="Depreciation" Foreground="{DynamicResource TextSecondaryBrush}"/><TextBlock Text="{Binding TotalDepreciation, StringFormat={}{0:N2}}" FontSize="19" FontWeight="SemiBold"/></StackPanel>
            </Border>
            <Border Grid.Column="4" Style="{StaticResource CardBorderStyle}" Margin="0,0,7,0" Padding="10" ToolTip="Current Book Value">
                <StackPanel><TextBlock Text="Closing Balance" Foreground="{DynamicResource TextSecondaryBrush}"/><TextBlock Text="{Binding TotalBookValue, StringFormat={}{0:N2}}" FontSize="19" FontWeight="SemiBold"/></StackPanel>
            </Border>
            <Border Grid.Column="5" Style="{StaticResource CardBorderStyle}" Padding="10">
                <StackPanel><TextBlock Text="Tally Source Candidates" Foreground="{DynamicResource TextSecondaryBrush}"/><TextBlock Text="{Binding DiscoveryCandidateCount, StringFormat={}{0:N0}}" FontSize="19" FontWeight="SemiBold"/></StackPanel>
            </Border>
        </Grid>

        <!-- Unified depreciation setup: segmented/toggle selectors, one calculation rule, explicit voucher round-off. -->
        <Border Grid.Row="2" Style="{StaticResource CardBorderStyle}" Padding="10" Margin="0,0,0,8">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.05*"/><ColumnDefinition Width="1.25*"/><ColumnDefinition Width="1.55*"/>
                        <ColumnDefinition Width="1.05*"/><ColumnDefinition Width="1.75*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Margin="0,0,12,0">
                        <TextBlock Text="Depreciation Policy" FontWeight="SemiBold"/>
                        <UniformGrid Columns="2" Margin="0,5,0,0">
                            <RadioButton Content="Fixed/Common" GroupName="DepPolicy" Style="{StaticResource SegmentRadioStyle}" IsChecked="{Binding IsFixedCommonPolicy, Mode=TwoWay}"/>
                            <RadioButton Content="Per Asset" GroupName="DepPolicy" Style="{StaticResource SegmentRadioStyle}" IsChecked="{Binding IsPerAssetPolicy, Mode=TwoWay}"/>
                        </UniformGrid>
                        <TextBlock Text="Common rule or asset-wise; proved rates may differ by block." Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" Margin="0,3,0,0" TextWrapping="Wrap"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Margin="0,0,12,0">
                        <TextBlock Text="Depreciation Method" FontWeight="SemiBold"/>
                        <UniformGrid Columns="3" Margin="0,5,0,0" IsEnabled="{Binding IsFixedCommonPolicy}">
                            <RadioButton Content="SLM" GroupName="DepMethod" Style="{StaticResource SegmentRadioStyle}" IsChecked="{Binding IsMethodSlm, Mode=TwoWay}"/>
                            <RadioButton Content="WDV" GroupName="DepMethod" Style="{StaticResource SegmentRadioStyle}" IsChecked="{Binding IsMethodWdv, Mode=TwoWay}"/>
                            <RadioButton Content="Other" GroupName="DepMethod" Style="{StaticResource SegmentRadioStyle}" IsChecked="{Binding IsMethodOther, Mode=TwoWay}"/>
                        </UniformGrid>
                        <DockPanel Margin="0,5,0,0" IsEnabled="{Binding IsFixedCommonPolicy}">
                            <TextBlock Text="Default Rate %" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBox Text="{Binding CommonDepreciationRate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" MinWidth="65"/>
                        </DockPanel>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Margin="0,0,12,0">
                        <TextBlock Text="Depreciation Calculation" FontWeight="SemiBold"/>
                        <UniformGrid Columns="3" Margin="0,5,0,0">
                            <RadioButton Content="Yearly" GroupName="DepCalc" Style="{StaticResource SegmentRadioStyle}" IsChecked="{Binding IsCalculationYearly, Mode=TwoWay}"/>
                            <RadioButton Content="Day-wise" GroupName="DepCalc" Style="{StaticResource SegmentRadioStyle}" IsChecked="{Binding IsCalculationDayWise, Mode=TwoWay}"/>
                            <RadioButton Content="Income Tax 180-Day" GroupName="DepCalc" Style="{StaticResource SegmentRadioStyle}" IsChecked="{Binding IsCalculationIncomeTax180, Mode=TwoWay}"/>
                        </UniformGrid>
                        <TextBlock Text="One rule applies to opening/existing assets and current-year additions." Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" Margin="0,3,0,0" TextWrapping="Wrap"/>
                    </StackPanel>

                    <StackPanel Grid.Column="3" Margin="0,0,12,0">
                        <TextBlock Text="Additional Depreciation" FontWeight="SemiBold"/>
                        <CheckBox Content="Applicable" IsChecked="{Binding AdditionalDepreciationEnabled, Mode=TwoWay}" Margin="0,7,0,5"/>
                        <DockPanel>
                            <TextBlock Text="Rate %" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBox Text="{Binding AdditionalDepreciationRate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding IsAdditionalDepreciationEnabled}" MinWidth="65"/>
                        </DockPanel>
                    </StackPanel>

                    <StackPanel Grid.Column="4">
                        <TextBlock Text="Depreciation Posting" FontWeight="SemiBold"/>
                        <UniformGrid Columns="2" Margin="0,5,0,4">
                            <RadioButton Content="Direct to Asset" GroupName="DepPosting" Style="{StaticResource SegmentRadioStyle}" IsChecked="{Binding IsDirectDepreciationPosting, Mode=TwoWay}"/>
                            <RadioButton Content="Accumulated Dep." GroupName="DepPosting" Style="{StaticResource SegmentRadioStyle}" IsChecked="{Binding IsAccumulatedDepreciationPosting, Mode=TwoWay}"/>
                        </UniformGrid>
                        <Grid Margin="0,4,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <TextBlock Text="Expense Ledger" VerticalAlignment="Center" Margin="0,0,7,0"/>
                            <ComboBox Grid.Column="1" ItemsSource="{Binding ExpenseLedgerNames}" SelectedItem="{Binding ExpenseLedgerName, Mode=TwoWay}" IsEditable="False" ToolTip="Only ledgers under Indirect Expenses are shown."/>
                        </Grid>
                        <Grid Margin="0,5,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock Text="Create" VerticalAlignment="Center" Margin="0,0,7,0"/>
                            <TextBox Grid.Column="1" Text="{Binding NewExpenseLedgerName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" ToolTip="New ledger will be created only under Indirect Expenses."/>
                            <Button Grid.Column="2" Content="+" Command="{Binding CreateExpenseLedgerCommand}" Padding="8,3" Margin="5,0,0,0" ToolTip="Create/select under Indirect Expenses"/>
                        </Grid>
                        <Grid Margin="0,5,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Voucher Round Off" VerticalAlignment="Center"/>
                                <TextBlock Text="Nearest rupee when enabled" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}"/>
                            </StackPanel>
                            <TextBlock Grid.Column="1" Text="Off" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="8,0,5,0"/>
                            <ToggleButton Grid.Column="2" Style="{StaticResource PillToggleStyle}" IsChecked="{Binding VoucherRoundOffEnabled, Mode=TwoWay}" VerticalAlignment="Center" ToolTip="Off keeps paise; On rounds the new depreciation adjustment to the nearest rupee."/>
                            <TextBlock Grid.Column="3" Text="On" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="5,0,0,0"/>
                        </Grid>
                    </StackPanel>
                </Grid>

                <Separator Margin="0,9,0,7"/>
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding SettingsStatusText}" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" VerticalAlignment="Center"/>
                    <Button Grid.Column="1" Content="Save Depreciation Settings" Command="{Binding SaveDepreciationSettingsCommand}" Padding="10,5" Margin="10,0,0,0"/>
                </Grid>
                <Expander Header="Accumulated Depreciation Ledger Mapping" IsExpanded="False" Visibility="{Binding IsAccumulatedDepreciationPosting, Converter={StaticResource BooleanToVisibilityConverter}}" Margin="0,7,0,0">
                    <StackPanel Margin="0,7,0,0">
                        <TextBlock Text="Map each Fixed Asset Tally ledger to an existing accumulated-depreciation ledger, or create one. Depreciation amount does not change; only the credit ledger changes." Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,6"/>
                        <DataGrid ItemsSource="{Binding PostingMappings}" SelectedItem="{Binding SelectedPostingMapping}" AutoGenerateColumns="False" IsReadOnly="False" MaxHeight="180">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Fixed Asset Ledger" Binding="{Binding AssetLedgerName}" IsReadOnly="True" Width="1.3*"/>
                                <DataGridTextColumn Header="Ledger MASTERID" Binding="{Binding AssetLedgerMasterId}" IsReadOnly="True" Width="110"/>
                                <DataGridTemplateColumn Header="Accumulated Depreciation Ledger" Width="1.5*">
                                    <DataGridTemplateColumn.CellTemplate><DataTemplate><ComboBox ItemsSource="{Binding DataContext.AvailableLedgerNames, RelativeSource={RelativeSource AncestorType={x:Type DataGrid}}}" Text="{Binding AccumulatedLedgerName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsEditable="True"/></DataTemplate></DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="MASTERID" Binding="{Binding AccumulatedLedgerMasterId}" IsReadOnly="True" Width="110"/>
                            </DataGrid.Columns>
                        </DataGrid>
                        <Grid Margin="0,6,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="210"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock Text="New accumulated ledger" VerticalAlignment="Center"/>
                            <TextBox Grid.Column="1" Text="{Binding NewAccumulatedLedgerName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="6,0"/>
                            <Button Grid.Column="2" Content="Create / Select" Command="{Binding CreateAccumulatedLedgerCommand}" Padding="9,4"/>
                        </Grid>
                    </StackPanel>
                </Expander>
            </StackPanel>
        </Border>

        <DockPanel Grid.Row="3" Margin="0,0,0,8">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="New Asset" Command="{Binding NewAssetCommand}" Padding="10,6" Margin="0,0,7,0"/>
                <Button Content="Edit Selected" Command="{Binding EditAssetCommand}" Padding="10,6" Margin="0,0,7,0"/>
                <Button Content="Delete" Command="{Binding DeleteAssetCommand}" Padding="10,6"/>
            </StackPanel>
            <Expander Header="Columns / Optional Details" IsExpanded="False" VerticalAlignment="Center">
                <WrapPanel Margin="0,5,20,0">
                    <CheckBox Content="Code" Tag="Code" Checked="OptionalColumn_Changed" Unchecked="OptionalColumn_Changed" Margin="0,0,12,0"/>
                    <CheckBox Content="Purchase Date" Tag="Purchase Date" Checked="OptionalColumn_Changed" Unchecked="OptionalColumn_Changed" Margin="0,0,12,0"/>
                    <CheckBox Content="Supplier" Tag="Supplier" Checked="OptionalColumn_Changed" Unchecked="OptionalColumn_Changed" Margin="0,0,12,0"/>
                    <CheckBox Content="Location" Tag="Location" Checked="OptionalColumn_Changed" Unchecked="OptionalColumn_Changed" Margin="0,0,12,0"/>
                    <CheckBox Content="Method" Tag="Method" Checked="OptionalColumn_Changed" Unchecked="OptionalColumn_Changed" Margin="0,0,12,0"/>
                    <CheckBox Content="Opening Source" Tag="Opening Source" Checked="OptionalColumn_Changed" Unchecked="OptionalColumn_Changed" Margin="0,0,12,0"/>
                    <CheckBox Content="Tally Ledger" Tag="Tally Ledger" Checked="OptionalColumn_Changed" Unchecked="OptionalColumn_Changed" Margin="0,0,12,0"/>
                    <CheckBox Content="MASTERID" Tag="MASTERID" Checked="OptionalColumn_Changed" Unchecked="OptionalColumn_Changed"/>
                </WrapPanel>
            </Expander>
        </DockPanel>

        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>

            <Border Style="{StaticResource CardBorderStyle}" Padding="12" Margin="0,0,8,0">
                <TabControl>
                    <TabItem Header="Asset Register">
                        <Grid Margin="0,8,0,0">
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                            <DockPanel Margin="0,0,0,8">
                                <TextBlock Text="Asset Register" FontSize="16" FontWeight="SemiBold"/>
                                <TextBlock DockPanel.Dock="Right" Text="{Binding StatusText}" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" TextAlignment="Right" MaxWidth="660"/>
                            </DockPanel>
                            <controls:MultiSearchFilterBar x:Name="FixedAssetSearchFilterBar" Grid.Row="1" Margin="0,0,0,8"/>
                            <DataGrid x:Name="FixedAssetRegisterGrid" Grid.Row="2" ItemsSource="{Binding FixedAssets}" SelectedItem="{Binding SelectedAsset}"
                                      AutoGenerateColumns="False" IsReadOnly="True" MouseDoubleClick="FixedAssetRegisterGrid_MouseDoubleClick">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Fixed Asset" Binding="{Binding AssetName}" Width="1.6*"/>
                                    <DataGridTextColumn Header="Opening Balance" Binding="{Binding OpeningBalance, StringFormat=N2}" Width="115"/>
                                    <DataGridTextColumn Header="Additions" Binding="{Binding CurrentAdditions, StringFormat=N2}" Width="100"/>
                                    <DataGridTextColumn Header="Deletions" Binding="{Binding CurrentDeletions, StringFormat=N2}" Width="100"/>
                                    <DataGridTextColumn Header="Rate %" Binding="{Binding DepreciationRate, StringFormat=0.####}" Width="75"/>
                                    <DataGridTemplateColumn Header="Depreciation" Width="110">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Button Content="{Binding CurrentDepreciation, StringFormat={}{0:N2}}" Click="DepreciationCell_Click"
                                                        Padding="4,2" HorizontalContentAlignment="Right" ToolTip="Click for depreciation calculation details"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="Closing Balance" Binding="{Binding CurrentBookValue, StringFormat=N2}" Width="115"/>

                                    <DataGridTextColumn Header="Code" Binding="{Binding AssetCode}" Width="95" Visibility="Collapsed"/>
                                    <DataGridTextColumn Header="Purchase Date" Binding="{Binding PurchaseDate, StringFormat={}{0:dd-MMM-yyyy}}" Width="105" Visibility="Collapsed"/>
                                    <DataGridTextColumn Header="Supplier" Binding="{Binding SupplierName}" Width="150" Visibility="Collapsed"/>
                                    <DataGridTextColumn Header="Location" Binding="{Binding Location}" Width="130" Visibility="Collapsed"/>
                                    <DataGridTextColumn Header="Method" Binding="{Binding DepreciationMethod}" Width="80" Visibility="Collapsed"/>
                                    <DataGridTextColumn Header="Opening Source" Binding="{Binding OpeningSource}" Width="120" Visibility="Collapsed"/>
                                    <DataGridTextColumn Header="Tally Ledger" Binding="{Binding TallyLedgerName}" Width="150" Visibility="Collapsed"/>
                                    <DataGridTextColumn Header="MASTERID" Binding="{Binding TallyLedgerMasterId}" Width="100" Visibility="Collapsed"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </TabItem>

                    <TabItem Header="Source Discovery">
                        <Grid Margin="0,8,0,0">
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                            <StackPanel>
                                <TextBlock Text="Read-only Tally source discovery" FontSize="16" FontWeight="SemiBold"/>
                                <TextBlock Text="Uses the existing Client/FY Tally link, MASTERID-bound Masters, cached Voucher index and cached full Voucher XML. It does not query Tally and does not create or alter an asset."
                                           Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,3,0,0"/>
                            </StackPanel>
                            <DockPanel Grid.Row="1" Margin="0,9,0,8">
                                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                                    <TextBlock Text="Fixed Asset Ledgers: " Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    <TextBlock Text="{Binding FixedAssetLedgerCount, StringFormat={}{0:N0}}" FontWeight="SemiBold"/>
                                    <TextBlock Text="   Complete Voucher XML: " Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    <TextBlock Text="{Binding CompleteAuthorityCount, StringFormat={}{0:N0}}" FontWeight="SemiBold"/>
                                </StackPanel>
                                <TextBlock DockPanel.Dock="Right" Text="{Binding DiscoveryStatusText}" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" TextAlignment="Right" MaxWidth="620"/>
                            </DockPanel>
                            <DataGrid Grid.Row="2" ItemsSource="{Binding DiscoveryCandidates}" SelectedItem="{Binding SelectedDiscoveryCandidate}" AutoGenerateColumns="False" IsReadOnly="True">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Type" Binding="{Binding CandidateType}" Width="125"/>
                                    <DataGridTextColumn Header="Date" Binding="{Binding VoucherDate, StringFormat={}{0:dd-MMM-yyyy}}" Width="105"/>
                                    <DataGridTextColumn Header="Voucher" Binding="{Binding VoucherDisplay}" Width="135"/>
                                    <DataGridTextColumn Header="Asset Ledger" Binding="{Binding AssetLedgerName}" Width="1.45*"/>
                                    <DataGridTextColumn Header="Ledger MASTERID" Binding="{Binding AssetLedgerMasterId}" Width="105"/>
                                    <DataGridTextColumn Header="Dr/Cr" Binding="{Binding Direction}" Width="55"/>
                                    <DataGridTextColumn Header="Exact Amount" Binding="{Binding AssetPostingAmount, StringFormat={}{0:N2}}" Width="105"/>
                                    <DataGridTextColumn Header="Party" Binding="{Binding PartyLedger}" Width="1.15*"/>
                                    <DataGridTextColumn Header="Counter Ledgers" Binding="{Binding CounterLedgers}" Width="1.6*"/>
                                    <DataGridTextColumn Header="Voucher MASTERID" Binding="{Binding VoucherMasterId}" Width="110"/>
                                    <DataGridTextColumn Header="Authority" Binding="{Binding AuthorityStatus}" Width="1.6*"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </TabItem>
                </TabControl>
            </Border>

            <!-- Optional right panels. Both are collapsed by default so the register owns the full width. -->
            <ScrollViewer Grid.Column="1" Width="430" VerticalScrollBarVisibility="Auto"
                          Visibility="{Binding IsEditorOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Border Style="{StaticResource CardBorderStyle}" Padding="14">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,10">
                            <Button DockPanel.Dock="Right" Content="Close" Command="{Binding CloseEditorCommand}" Padding="8,4"/>
                            <TextBlock Text="Asset Editor" FontSize="16" FontWeight="SemiBold"/>
                        </DockPanel>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="Code" VerticalAlignment="Center"/><TextBox Grid.Row="0" Grid.Column="1" Text="{Binding EditingAsset.AssetCode, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,6"/>
                            <TextBlock Grid.Row="1" Text="Asset Name" VerticalAlignment="Center"/><TextBox Grid.Row="1" Grid.Column="1" Text="{Binding EditingAsset.AssetName, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,6"/>
                            <TextBlock Grid.Row="2" Text="Group / Type" VerticalAlignment="Center"/><TextBox Grid.Row="2" Grid.Column="1" Text="{Binding EditingAsset.AssetGroup, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,6"/>
                            <TextBlock Grid.Row="3" Text="Tally Asset Ledger" VerticalAlignment="Center"/><ComboBox Grid.Row="3" Grid.Column="1" ItemsSource="{Binding AvailableLedgerNames}" Text="{Binding EditingAsset.TallyLedgerName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsEditable="True" Margin="0,0,0,6"/>
                            <TextBlock Grid.Row="4" Text="Opening Source" VerticalAlignment="Center"/><ComboBox Grid.Row="4" Grid.Column="1" ItemsSource="{Binding OpeningSources}" SelectedItem="{Binding EditingAsset.OpeningSource, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,6"/>
                            <TextBlock Grid.Row="5" Text="Opening Balance" VerticalAlignment="Center"/><TextBox Grid.Row="5" Grid.Column="1" Text="{Binding EditingAsset.OpeningBalance, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,6"/>
                            <TextBlock Grid.Row="6" Text="Purchase Date" VerticalAlignment="Center"/><DatePicker Grid.Row="6" Grid.Column="1" SelectedDate="{Binding EditingAsset.PurchaseDate, Mode=TwoWay}" Margin="0,0,0,6"/>
                            <TextBlock Grid.Row="7" Text="Put To Use" VerticalAlignment="Center"/><DatePicker Grid.Row="7" Grid.Column="1" SelectedDate="{Binding EditingAsset.PutToUseDate, Mode=TwoWay}" Margin="0,0,0,6"/>
                            <TextBlock Grid.Row="8" Text="Supplier" VerticalAlignment="Center"/><TextBox Grid.Row="8" Grid.Column="1" Text="{Binding EditingAsset.SupplierName, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,6"/>
                            <TextBlock Grid.Row="9" Text="Purchase Cost" VerticalAlignment="Center"/><TextBox Grid.Row="9" Grid.Column="1" Text="{Binding EditingAsset.PurchaseCost, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,6"/>
                            <TextBlock Grid.Row="10" Text="Residual Value" VerticalAlignment="Center"/><TextBox Grid.Row="10" Grid.Column="1" Text="{Binding EditingAsset.ResidualValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,6"/>
                            <TextBlock Grid.Row="11" Text="Depreciation Method" VerticalAlignment="Center"/><ComboBox Grid.Row="11" Grid.Column="1" ItemsSource="{Binding DepreciationMethods}" SelectedItem="{Binding EditingAsset.DepreciationMethod, Mode=TwoWay}" IsEnabled="{Binding IsPerAssetPolicy}" Margin="0,0,0,6"/>
                            <TextBlock Grid.Row="12" Text="Depreciation Rate %" VerticalAlignment="Center"/><TextBox Grid.Row="12" Grid.Column="1" Text="{Binding EditingAsset.DepreciationRate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding IsPerAssetPolicy}" Margin="0,0,0,6"/>
                            <TextBlock Grid.Row="13" Text="Location" VerticalAlignment="Center"/><TextBox Grid.Row="13" Grid.Column="1" Text="{Binding EditingAsset.Location, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,6"/>
                            <TextBlock Grid.Row="14" Text="Serial Number" VerticalAlignment="Center"/><TextBox Grid.Row="14" Grid.Column="1" Text="{Binding EditingAsset.SerialNumber, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,6"/>
                            <TextBlock Grid.Row="15" Text="Disposal Date" VerticalAlignment="Center"/><DatePicker Grid.Row="15" Grid.Column="1" SelectedDate="{Binding EditingAsset.DisposalDate, Mode=TwoWay}"/>
                        </Grid>
                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Border Style="{StaticResource CardBorderStyle}" Padding="8" Margin="0,0,5,0">
                                <StackPanel><TextBlock Text="Live Depreciation" Foreground="{DynamicResource TextSecondaryBrush}"/><TextBlock Text="{Binding EditingPreviewDepreciation, StringFormat={}{0:N2}}" FontWeight="SemiBold" FontSize="16"/></StackPanel>
                            </Border>
                            <Border Grid.Column="1" Style="{StaticResource CardBorderStyle}" Padding="8" Margin="5,0,0,0">
                                <StackPanel><TextBlock Text="Live Closing" Foreground="{DynamicResource TextSecondaryBrush}"/><TextBlock Text="{Binding EditingPreviewClosing, StringFormat={}{0:N2}}" FontWeight="SemiBold" FontSize="16"/></StackPanel>
                            </Border>
                        </Grid>
                        <TextBlock Text="Notes" Margin="0,10,0,3"/>
                        <TextBox Text="{Binding EditingAsset.Notes, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" MinHeight="60" TextWrapping="Wrap"/>
                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                            <Button Content="Save Asset" Command="{Binding SaveAssetCommand}" Style="{StaticResource PrimaryButtonStyle}" Padding="12,7"/>
                            <Button Content="Cancel" Command="{Binding CloseEditorCommand}" Padding="12,7" Margin="8,0,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </ScrollViewer>

            <ScrollViewer Grid.Column="1" Width="430" VerticalScrollBarVisibility="Auto"
                          Visibility="{Binding IsDepreciationDetailOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Border Style="{StaticResource CardBorderStyle}" Padding="14">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,10">
                            <Button DockPanel.Dock="Right" Content="Close" Command="{Binding CloseDepreciationDetailsCommand}" Padding="8,4"/>
                            <TextBlock Text="Depreciation Details" FontSize="16" FontWeight="SemiBold"/>
                        </DockPanel>
                        <TextBlock Text="{Binding DepreciationDetailText}" TextWrapping="Wrap" LineHeight="22"/>
                    </StackPanel>
                </Border>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
