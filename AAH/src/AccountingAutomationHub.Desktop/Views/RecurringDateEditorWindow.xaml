<Window x:Class="AccountingAutomationHub.Desktop.Views.RecurringDateEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Recurring Dates" Height="520" Width="430" WindowStartupLocation="CenterOwner"
        Background="{DynamicResource AppBackgroundBrush}">
    <Grid Margin="16">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <TextBlock Text="Selected recurring dates" FontSize="18" FontWeight="SemiBold"/>
        <WrapPanel Grid.Row="1" Margin="0,12,0,10">
            <DatePicker x:Name="AddDatePicker" Width="150"/>
            <Button Content="Add Date" Click="AddDate_Click" Padding="10,6" Margin="8,0,0,0"/>
            <Button Content="Delete Selected" Click="DeleteDate_Click" Padding="10,6" Margin="8,0,0,0"/>
        </WrapPanel>
        <DataGrid x:Name="DatesGrid" Grid.Row="2" ItemsSource="{Binding Dates}" SelectedItem="{Binding SelectedDate, Mode=TwoWay}"
                  AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" RowHeaderWidth="0">
            <DataGrid.Columns><DataGridTextColumn Header="Date" Binding="{Binding StringFormat={}{0:dd-MMM-yyyy}}" Width="*"/></DataGrid.Columns>
        </DataGrid>
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Cancel" IsCancel="True" MinWidth="85" Margin="0,0,8,0"/>
            <Button Content="Use Dates" Click="UseDates_Click" IsDefault="True" MinWidth="100"/>
        </StackPanel>
    </Grid>
</Window>
