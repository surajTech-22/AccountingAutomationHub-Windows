<Window x:Class="AccountingAutomationHub.Desktop.Views.EmptyLedgerExportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Empty Ledger Export"
        Width="800" Height="610"
        MinWidth="700" MinHeight="540"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        ShowInTaskbar="False"
        PreviewKeyDown="Window_PreviewKeyDown"
        Background="{DynamicResource AppBackgroundBrush}">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <DockPanel LastChildFill="True">
            <StackPanel>
                <TextBlock Text="Empty Ledger Export" FontSize="22" FontWeight="SemiBold"/>
                <TextBlock Text="Choose the Ledger used only when a Bank Statement Final Ledger is empty. Existing mapped Ledgers are never overwritten."
                           Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,0" TextWrapping="Wrap"/>
            </StackPanel>
            <Button DockPanel.Dock="Right" Content="Close" Click="Close_Click" Padding="14,7" Margin="16,0,0,0"/>
        </DockPanel>

        <UniformGrid Grid.Row="1" Columns="2" Margin="0,14,0,12">
            <Border Margin="0,0,6,0" Padding="12" Background="#F8FAFC" BorderBrush="#D8E0EB" BorderThickness="1" CornerRadius="7">
                <StackPanel>
                    <TextBlock Text="Full Statement Empty Ledgers" Foreground="{DynamicResource TextSecondaryBrush}"/>
                    <TextBlock Text="{Binding EmptyLedgerFullStatementCount, Mode=OneWay, StringFormat={}{0:N0}}" FontSize="24" FontWeight="SemiBold" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>
            <Border Margin="6,0,0,0" Padding="12" Background="#F8FAFC" BorderBrush="#D8E0EB" BorderThickness="1" CornerRadius="7">
                <StackPanel>
                    <TextBlock Text="Selected Tally Export Period Empty Ledgers" Foreground="{DynamicResource TextSecondaryBrush}"/>
                    <TextBlock Text="{Binding EmptyLedgerExportPeriodCount, Mode=OneWay, StringFormat={}{0:N0}}" FontSize="24" FontWeight="SemiBold" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>
        </UniformGrid>

        <Border Grid.Row="2" Padding="16" Background="White" BorderBrush="#D8E0EB" BorderThickness="1" CornerRadius="8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="165"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Text="Current Export Default" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" Text="{Binding DefaultEmptyLedger, Mode=OneWay}" FontWeight="SemiBold" VerticalAlignment="Center"/>

                <!-- Three-layer Master hierarchy: Ledger -> Ledger Group -> Parent Group. -->
                <TextBlock Grid.Row="1" Text="Ledger Name" VerticalAlignment="Center" Margin="0,12,0,0"/>
                <ComboBox Grid.Row="1" Grid.Column="1" Margin="0,12,0,0" MinHeight="32"
                          ItemsSource="{Binding MasterLedgerNames}" IsEditable="True" IsTextSearchEnabled="True"
                          Text="{Binding EmptyLedgerDraftName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                <TextBlock Grid.Row="2" Text="Ledger Group" VerticalAlignment="Center" Margin="0,10,0,0"/>
                <ComboBox Grid.Row="2" Grid.Column="1" Margin="0,10,0,0" MinHeight="32"
                          ItemsSource="{Binding MasterGroupNames}" IsEditable="True" IsTextSearchEnabled="True"
                          Text="{Binding EmptyLedgerDraftGroup, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                <TextBlock Grid.Row="3" Text="Parent Group" VerticalAlignment="Center" Margin="0,10,0,0"/>
                <StackPanel Grid.Row="3" Grid.Column="1" Margin="0,10,0,0">
                    <TextBlock Text="{Binding EmptyLedgerResolvedParentGroup, Mode=OneWay}" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding EmptyLedgerParentGroupStatusText, Mode=OneWay}"
                               Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" Margin="0,2,0,0" TextWrapping="Wrap"/>
                </StackPanel>

                <TextBlock Grid.Row="4" Text="3-Layer Hierarchy" VerticalAlignment="Center" Margin="0,12,0,0"/>
                <Border Grid.Row="4" Grid.Column="1" Margin="0,12,0,0" Padding="9,6" Background="#F0FDF4" CornerRadius="5">
                    <TextBlock Text="{Binding EmptyLedgerHierarchyText, Mode=OneWay}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                </Border>

                <TextBlock Grid.Row="5" Text="Existing Master" VerticalAlignment="Top" Margin="0,12,0,0"/>
                <StackPanel Grid.Row="5" Grid.Column="1" Margin="0,12,0,0">
                    <TextBlock Text="{Binding EmptyLedgerResolvedName, Mode=OneWay}" FontWeight="SemiBold"/>
                    <TextBlock Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0"><Run Text="Group: "/><Run Text="{Binding EmptyLedgerResolvedGroup, Mode=OneWay}"/></TextBlock>
                    <TextBlock Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0"><Run Text="Parent: "/><Run Text="{Binding EmptyLedgerResolvedParentGroup, Mode=OneWay}"/></TextBlock>
                    <TextBlock Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0"><Run Text="Source: "/><Run Text="{Binding EmptyLedgerMasterSourceText, Mode=OneWay}"/></TextBlock>
                </StackPanel>

                <TextBlock Grid.Row="6" Text="Master / Group Status" VerticalAlignment="Top" Margin="0,12,0,0"/>
                <Border Grid.Row="6" Grid.Column="1" Margin="0,12,0,0" Padding="10" Background="#F5F8FC" CornerRadius="5">
                    <StackPanel>
                        <TextBlock Text="{Binding EmptyLedgerMasterStatusText, Mode=OneWay}" TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding EmptyLedgerGroupStatusText, Mode=OneWay}" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,5,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <StackPanel Grid.Row="7" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                    <Button Content="Create Manual Master" Command="{Binding CreateEmptyLedgerManualMasterCommand}" Padding="14,7" Margin="0,0,8,0"
                            ToolTip="Creates a local Manual Ledger only when no equivalent active Ledger Master already exists and the selected Ledger Group is valid."/>
                    <Button Content="Use as Empty Ledger Default" Command="{Binding UseEmptyLedgerMasterCommand}" Padding="14,7"
                            ToolTip="Uses the exact existing Master name/group. A missing Master must be created manually first."/>
                </StackPanel>
            </Grid>
        </Border>

        <TextBlock Grid.Row="3" Margin="0,12,0,0" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"
                   Text="Master safety: the panel resolves all three layers (Ledger, Ledger Group and Parent Group). An equivalent existing Tally/Purchase/Sales/Manual Ledger is reused. Only a genuinely missing local Manual Master can later be CREATEd in Tally; Tally-authoritative Masters are never regenerated."/>
    </Grid>
</Window>
