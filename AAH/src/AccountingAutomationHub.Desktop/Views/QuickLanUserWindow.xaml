<Window x:Class="AccountingAutomationHub.Desktop.Views.QuickLanUserWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Create AAH User" Width="610" Height="500" ResizeMode="NoResize" WindowStartupLocation="CenterOwner" Background="{DynamicResource AppBackgroundBrush}">
    <Grid Margin="22">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <TextBlock x:Name="HeaderBlock" Text="Create / Reset AAH User" FontSize="22" FontWeight="SemiBold"/>
        <TextBlock x:Name="HelpBlock" Grid.Row="1" Margin="0,7,0,14" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" Text="Create the User ID and password on the Main Server. Client access is still granted only from Client Directory → LAN."/>
        <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="User ID" VerticalAlignment="Center"/><TextBox Grid.Column="1" x:Name="UserBox" Padding="8,6"/></Grid>
        <Grid Grid.Row="3" Margin="0,9,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="Display name" VerticalAlignment="Center"/><TextBox Grid.Column="1" x:Name="DisplayBox" Padding="8,6"/></Grid>
        <Grid Grid.Row="4" Margin="0,9,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="Role" VerticalAlignment="Center"/><ComboBox Grid.Column="1" x:Name="RoleBox" ItemsSource="{Binding Roles}" SelectedIndex="0" Padding="6"/></Grid>
        <Grid Grid.Row="5" Margin="0,9,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="Password" VerticalAlignment="Center"/><PasswordBox Grid.Column="1" x:Name="PasswordBox" Padding="8,6"/></Grid>
        <StackPanel Grid.Row="6" Margin="0,9,0,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="Confirm password" VerticalAlignment="Center"/><PasswordBox Grid.Column="1" x:Name="ConfirmBox" Padding="8,6"/></Grid><CheckBox x:Name="ActiveBox" Content="Account active" Margin="140,10,0,0"/><TextBlock x:Name="PasswordHint" Text="Password must be at least 12 characters and contain a letter and number." TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,12,0,0"/><TextBlock x:Name="StatusBlock" TextWrapping="Wrap" Margin="0,10,0,0"/></StackPanel>
        <WrapPanel Grid.Row="7" HorizontalAlignment="Right" Margin="0,15,0,0"><Button Content="Cancel" IsCancel="True" Padding="12,7"/><Button x:Name="SaveButton" Content="Save AAH User" Click="Save_Click" IsDefault="True" Style="{StaticResource PrimaryButtonStyle}" Padding="12,7" Margin="8,0,0,0"/></WrapPanel>
    </Grid>
</Window>
