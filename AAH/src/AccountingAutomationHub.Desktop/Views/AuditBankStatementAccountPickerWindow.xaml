<Window x:Class="AccountingAutomationHub.Desktop.Views.AuditBankStatementAccountPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Assign Audit Bank Statement" Width="610" Height="365"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{DynamicResource BackgroundBrush}">
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Text="Assign statement evidence" FontSize="21" FontWeight="SemiBold"/>
        <TextBlock Grid.Row="1" x:Name="SourceText" Margin="0,6,0,14" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}"/>
        <Border Grid.Row="2" Padding="12" Margin="0,0,0,14" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8">
            <TextBlock x:Name="EvidenceText" TextWrapping="Wrap"/>
        </Border>
        <TextBlock Grid.Row="3" Text="Tally Bank / OD account" FontWeight="SemiBold" Margin="0,0,0,5"/>
        <ComboBox Grid.Row="4" x:Name="AccountBox" Height="34" VerticalAlignment="Top" DisplayMemberPath="DisplayText"/>
        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Content="Cancel" Width="92" Margin="0,0,8,0" Click="Cancel_Click"/>
            <Button Content="Import Evidence" Width="125" Click="Import_Click"/>
        </StackPanel>
    </Grid>
</Window>
