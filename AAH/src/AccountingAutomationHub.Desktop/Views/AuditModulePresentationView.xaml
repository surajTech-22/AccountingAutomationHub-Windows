<UserControl x:Class="AccountingAutomationHub.Desktop.Views.AuditModulePresentationView"
             x:Name="Root"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
             xmlns:controls="clr-namespace:AccountingAutomationHub.Desktop.Controls"
             Language="en-IN"
             Background="Transparent"
             PreviewMouseWheel="AuditModulePresentationView_PreviewMouseWheel">
    <UserControl.Resources>
        <!-- Fix104: finance group graphs live inside the Payment/Receipt tables.
             SharePercent is the amount share of the full Payment/Receipt total, so one compact bar
             in each row replaces the old separate chart panel without losing visual comparison. -->
        <Style x:Key="InlineGroupAmountBarStyle" TargetType="ProgressBar">
            <Setter Property="Height" Value="13"/>
            <Setter Property="Minimum" Value="0"/>
            <Setter Property="Maximum" Value="100"/>
            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="Background" Value="#E5EAF1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Border Background="{TemplateBinding Background}" CornerRadius="5" SnapsToDevicePixels="True">
                            <Grid x:Name="PART_Track" ClipToBounds="True">
                                <Border x:Name="PART_Indicator" HorizontalAlignment="Left" Background="{TemplateBinding Foreground}" CornerRadius="5"/>
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="MetricCardTemplate">
            <Border MinWidth="155" MaxWidth="230" MinHeight="86" Margin="0,0,10,10" Padding="13,11"
                    Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10">
                <StackPanel>
                    <TextBlock Text="{Binding Title}" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}"/>
                    <TextBlock Text="{Binding Value}" FontSize="20" FontWeight="Bold" Margin="0,5,0,2" TextTrimming="CharacterEllipsis">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsAlert}" Value="True"><Setter Property="Foreground" Value="#B42318"/></DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <TextBlock Text="{Binding Detail}" FontSize="9" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="FinanceAccountCardTemplate">
            <Button Command="{Binding DataContext.OpenFinanceAccountCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                    CommandParameter="{Binding}" Background="Transparent" BorderThickness="0" Padding="0" Margin="0,0,12,12" Cursor="Hand">
                <Border Width="330" MinHeight="198" Padding="15" Background="{DynamicResource SurfaceBrush}" CornerRadius="11">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
                            <Setter Property="BorderThickness" Value="1"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                    <Setter Property="BorderThickness" Value="2"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="{Binding Account}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding Detail}" Margin="0,3,0,0" FontSize="9" Foreground="{DynamicResource TextSecondaryBrush}"/>
                            </StackPanel>
                            <Border Grid.Column="1" Padding="8,3" CornerRadius="10" Background="{DynamicResource AppBackgroundBrush}" VerticalAlignment="Top">
                                <TextBlock Text="{Binding Category}" FontSize="9" FontWeight="SemiBold"/>
                            </Border>
                        </Grid>
                        <Grid Grid.Row="1" Margin="0,13,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <StackPanel><TextBlock Text="Books Opening" FontSize="9" Foreground="{DynamicResource TextSecondaryBrush}"/><TextBlock Text="{Binding BooksOpeningDisplay}" FontWeight="SemiBold"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/><Style.Triggers><DataTrigger Binding="{Binding IsOpeningNatureAlert}" Value="True"><Setter Property="Foreground" Value="#B42318"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></StackPanel>
                            <StackPanel Grid.Column="1"><TextBlock Text="Books Closing" FontSize="9" Foreground="{DynamicResource TextSecondaryBrush}"/><TextBlock Text="{Binding BooksClosingDisplay}" FontWeight="SemiBold"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/><Style.Triggers><DataTrigger Binding="{Binding IsClosingNatureAlert}" Value="True"><Setter Property="Foreground" Value="#B42318"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></StackPanel>
                        </Grid>
                        <Grid Grid.Row="2" Margin="0,10,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <StackPanel><TextBlock Text="Books Debit" FontSize="9" Foreground="{DynamicResource TextSecondaryBrush}"/><TextBlock Text="{Binding BooksDebit, StringFormat=N2}" FontWeight="SemiBold"/></StackPanel>
                            <StackPanel Grid.Column="1"><TextBlock Text="Books Credit" FontSize="9" Foreground="{DynamicResource TextSecondaryBrush}"/><TextBlock Text="{Binding BooksCredit, StringFormat=N2}" FontWeight="SemiBold"/></StackPanel>
                        </Grid>
                        <Grid Grid.Row="3" Margin="0,10,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <StackPanel><TextBlock Text="Cash Withdrawn" FontSize="9" Foreground="{DynamicResource TextSecondaryBrush}"/><TextBlock Text="{Binding CashWithdrawn, StringFormat=N2}" FontWeight="SemiBold"/></StackPanel>
                            <StackPanel Grid.Column="1"><TextBlock Text="Cash Deposited" FontSize="9" Foreground="{DynamicResource TextSecondaryBrush}"/><TextBlock Text="{Binding CashDeposited, StringFormat=N2}" FontWeight="SemiBold"/></StackPanel>
                        </Grid>
                        <Grid Grid.Row="4" Margin="0,11,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding StatementStatus}" FontSize="9" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="{Binding VerificationStatus}" FontSize="9" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" MaxWidth="150"/>
                        </Grid>
                    </Grid>
                </Border>
            </Button>
        </DataTemplate>

        <DataTemplate x:Key="FinanceAccountSelectorTileTemplate">
            <Button Command="{Binding DataContext.OpenFinanceAccountCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                    CommandParameter="{Binding}" Background="Transparent" BorderThickness="0" Padding="0" Margin="0,0,10,0" Cursor="Hand">
                <Border MinWidth="245" Padding="12,10" Background="{DynamicResource SurfaceBrush}" CornerRadius="10">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/><Setter Property="BorderThickness" Value="1"/>
                            <Style.Triggers><DataTrigger Binding="{Binding IsSelected}" Value="True"><Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/><Setter Property="BorderThickness" Value="2"/></DataTrigger></Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel>
                        <TextBlock Text="{Binding Account}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding Detail}" FontSize="9" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,7"/>
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <StackPanel><TextBlock Text="Opening" FontSize="8" Foreground="{DynamicResource TextSecondaryBrush}"/><TextBlock Text="{Binding BooksOpeningDisplay}" FontWeight="SemiBold"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/><Style.Triggers><DataTrigger Binding="{Binding IsOpeningNatureAlert}" Value="True"><Setter Property="Foreground" Value="#B42318"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></StackPanel>
                            <StackPanel Grid.Column="1"><TextBlock Text="Closing" FontSize="8" Foreground="{DynamicResource TextSecondaryBrush}"/><TextBlock Text="{Binding BooksClosingDisplay}" FontWeight="SemiBold"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/><Style.Triggers><DataTrigger Binding="{Binding IsClosingNatureAlert}" Value="True"><Setter Property="Foreground" Value="#B42318"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>
            </Button>
        </DataTemplate>

        <DataTemplate x:Key="BankVerificationCardTemplate">
            <Border Width="330" MinHeight="150" Padding="14" Margin="0,0,12,12" Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10">
                <StackPanel>
                    <TextBlock Text="{Binding Account}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding Period}" FontSize="9" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,3,0,10"/>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <StackPanel><TextBlock Text="Books Dr" FontSize="9" Foreground="{DynamicResource TextSecondaryBrush}"/><TextBlock Text="{Binding BooksDebit, StringFormat=N2}" FontWeight="SemiBold"/></StackPanel>
                        <StackPanel Grid.Column="1"><TextBlock Text="Books Cr" FontSize="9" Foreground="{DynamicResource TextSecondaryBrush}"/><TextBlock Text="{Binding BooksCredit, StringFormat=N2}" FontWeight="SemiBold"/></StackPanel>
                        <StackPanel Grid.Column="2"><TextBlock Text="Difference" FontSize="9" Foreground="{DynamicResource TextSecondaryBrush}"/><TextBlock Text="{Binding Difference, StringFormat=N2}" FontWeight="SemiBold"/></StackPanel>
                    </Grid>
                    <TextBlock Text="{Binding Status}" FontSize="9" FontWeight="SemiBold" Margin="0,10,0,0" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- KPI-first presentation. Bank/OD/Loans/Cash use their selected-account KPI strip inside the dashboard instead. -->
        <ScrollViewer Grid.Row="0" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Margin="0,0,0,10"
                      Visibility="{Binding ShowModuleMetricStrip, Converter={StaticResource BooleanToVisibilityConverter}}">
            <ItemsControl ItemsSource="{Binding MetricTiles}" ItemTemplate="{StaticResource MetricCardTemplate}">
                <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
            </ItemsControl>
        </ScrollViewer>

        <Grid Grid.Row="1" Margin="0,0,0,10">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <ScrollViewer Grid.Column="0" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                <ItemsControl ItemsSource="{Binding ModuleTabs}">
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Command="{Binding DataContext.SelectModuleTabCommand, ElementName=Root}" CommandParameter="{Binding Key}"
                                    Margin="0,0,7,0" Padding="11,6" BorderThickness="1" Cursor="Hand">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
                                        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
                                        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
                                                <Setter Property="Foreground" Value="White"/>
                                                <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Title}" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                    <Border Margin="7,0,0,0" Padding="5,1" CornerRadius="8" Background="#20FFFFFF"
                                            Visibility="{Binding ShowCount, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <TextBlock Text="{Binding CountText}" FontSize="9" VerticalAlignment="Center"/>
                                    </Border>
                                </StackPanel>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="10,0,0,0">
                <Button Content="Import Statement" Margin="0,0,7,0" Padding="11,6" Command="{Binding ImportAuditBankStatementsCommand}"
                        Visibility="{Binding IsBankOrOd, Converter={StaticResource BooleanToVisibilityConverter}}"
                        ToolTip="Import Audit-owned Excel/CSV/native-text PDF Bank or OD statement evidence."/>
                <Button Content="Open in Accounting" Margin="7,0,0,0" Padding="10,5" Command="{Binding ModifyEntryCommand}"
                        Visibility="{Binding IsAccountingWorkbenchAvailable, Converter={StaticResource BooleanToVisibilityConverter}}"
                        ToolTip="Open the independent Accounting workbench for this Audit module. Current group/voucher type/party/GST/item/month/finance drill-down filters are carried across; linked Accounting client data is never loaded."/>
                <Button Content="Lookup" Margin="7,0,0,0" Padding="10,5" Command="{Binding OpenRecordLookupCommand}"
                        Visibility="{Binding IsTransactionToolsVisible, Converter={StaticResource BooleanToVisibilityConverter}}"/>
            </StackPanel>
        </Grid>

        <!-- Fix104: the same Accounting multi-option search/filter control is now the Audit standard.
             Comma = AND, field/operator searches and sort commands use the common DataGrid behavior.
             One bar is intentionally retained while navigating dashboard -> group -> party -> vouchers. -->
        <controls:MultiSearchFilterBar x:Name="AuditSearchFilterBar" Grid.Row="2" Margin="0,0,0,10">
            <controls:MultiSearchFilterBar.Style>
                <Style TargetType="controls:MultiSearchFilterBar">
                    <Setter Property="Visibility" Value="Visible"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsBankingFinanceParent}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                        <DataTrigger Binding="{Binding IsDebtorsCreditorsParent}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                    </Style.Triggers>
                </Style>
            </controls:MultiSearchFilterBar.Style>
        </controls:MultiSearchFilterBar>

        <Grid Grid.Row="3">
            <!-- Banking & Finance is a true control dashboard. This parent page intentionally contains no raw transaction rows. -->
            <ScrollViewer x:Name="BankingFinancePageScroll" Visibility="{Binding IsBankingFinanceParent, Converter={StaticResource BooleanToVisibilityConverter}}" VerticalScrollBarVisibility="Auto" CanContentScroll="False">
                <StackPanel>
                    <Border Padding="15" Margin="0,0,0,12" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="11">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Banking &amp; Finance" FontSize="18" FontWeight="SemiBold"/>
                                <TextBlock Text="Finance control centre · KPI summary, account status, statement verification, transfers, position and alerts." FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,3,0,0"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Padding="10,5" CornerRadius="12" Background="{DynamicResource AppBackgroundBrush}" Margin="0,0,8,0"><TextBlock Text="No raw voucher rows" FontSize="9" FontWeight="SemiBold"/></Border>
                                <TextBlock Text="Open Bank / OD / Loans for account-level work" FontSize="9" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Overview -->
                    <StackPanel Visibility="{Binding IsBankingOverviewTab, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Border Padding="14" Margin="0,0,0,12" Background="{DynamicResource AppBackgroundBrush}" CornerRadius="11">
                            <StackPanel>
                                <TextBlock Text="Account status" FontSize="15" FontWeight="SemiBold"/>
                                <TextBlock Text="Open an account card for its dashboard, group summaries, cash movement and explicit transaction drill-down." FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,3,0,11"/>
                                <ItemsControl ItemsSource="{Binding FinanceAccounts}" ItemTemplate="{StaticResource FinanceAccountCardTemplate}">
                                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Padding="14" Margin="0,0,6,0" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="11">
                                <StackPanel>
                                    <TextBlock Text="Statement Status" FontSize="15" FontWeight="SemiBold"/>
                                    <TextBlock Text="Coverage and statement evidence readiness" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,3,0,10"/>
                                    <ItemsControl ItemsSource="{Binding BankingStatementTiles}" ItemTemplate="{StaticResource MetricCardTemplate}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel></ItemsControl>
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="1" Padding="14" Margin="6,0,0,0" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="11">
                                <StackPanel>
                                    <TextBlock Text="Transfers" FontSize="15" FontWeight="SemiBold"/>
                                    <TextBlock Text="Contra / inter-bank confirmation status" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,3,0,10"/>
                                    <ItemsControl ItemsSource="{Binding BankingTransferTiles}" ItemTemplate="{StaticResource MetricCardTemplate}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel></ItemsControl>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Padding="14" Margin="0,0,6,0" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="11">
                                <StackPanel>
                                    <TextBlock Text="Books vs Statement" FontSize="15" FontWeight="SemiBold"/>
                                    <TextBlock Text="Opening, movement and closing verification status" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,3,0,10"/>
                                    <ItemsControl ItemsSource="{Binding BankingVerificationTiles}" ItemTemplate="{StaticResource MetricCardTemplate}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel></ItemsControl>
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="1" Padding="14" Margin="6,0,0,0" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="11">
                                <StackPanel>
                                    <TextBlock Text="Alerts" FontSize="15" FontWeight="SemiBold"/>
                                    <TextBlock Text="Items that require audit attention" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,3,0,10"/>
                                    <ItemsControl ItemsSource="{Binding BankingAlertTiles}" ItemTemplate="{StaticResource MetricCardTemplate}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel></ItemsControl>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <Border Padding="14" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="11">
                            <StackPanel>
                                <TextBlock Text="Position" FontSize="15" FontWeight="SemiBold"/>
                                <TextBlock Text="Bank / OD / Loan movement and Bank ↔ Cash position" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,3,0,10"/>
                                <ItemsControl ItemsSource="{Binding BankingPositionTiles}" ItemTemplate="{StaticResource MetricCardTemplate}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel></ItemsControl>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Statement Status tab -->
                    <Border Visibility="{Binding IsBankingStatementStatusTab, Converter={StaticResource BooleanToVisibilityConverter}}" Padding="15" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="11">
                        <StackPanel>
                            <TextBlock Text="Statement Status" FontSize="16" FontWeight="SemiBold"/>
                            <TextBlock Text="Received, pending, movement-verified and closing-evidence status for Bank / OD accounts." FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,3,0,12"/>
                            <ItemsControl ItemsSource="{Binding BankingStatementTiles}" ItemTemplate="{StaticResource MetricCardTemplate}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel></ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- Books vs Statement tab -->
                    <StackPanel Visibility="{Binding IsBankingBooksVsStatementTab, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Border Padding="15" Margin="0,0,0,12" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="11">
                            <StackPanel>
                                <TextBlock Text="Books vs Statement" FontSize="16" FontWeight="SemiBold"/>
                                <TextBlock Text="Verification summary; no transaction rows are shown here." FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,3,0,12"/>
                                <ItemsControl ItemsSource="{Binding BankingVerificationTiles}" ItemTemplate="{StaticResource MetricCardTemplate}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel></ItemsControl>
                            </StackPanel>
                        </Border>
                        <ItemsControl ItemsSource="{Binding BankSummaries}" ItemTemplate="{StaticResource BankVerificationCardTemplate}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel></ItemsControl>
                    </StackPanel>

                    <!-- Transfers tab -->
                    <Border Visibility="{Binding IsBankingTransfersTab, Converter={StaticResource BooleanToVisibilityConverter}}" Padding="15" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="11">
                        <StackPanel>
                            <TextBlock Text="Transfers" FontSize="16" FontWeight="SemiBold"/>
                            <TextBlock Text="Books pairs, statement-side confirmation and transfer alerts." FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,3,0,12"/>
                            <ItemsControl ItemsSource="{Binding BankingTransferTiles}" ItemTemplate="{StaticResource MetricCardTemplate}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel></ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- Position tab -->
                    <Border Visibility="{Binding IsBankingPositionTab, Converter={StaticResource BooleanToVisibilityConverter}}" Padding="15" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="11">
                        <StackPanel>
                            <TextBlock Text="Position" FontSize="16" FontWeight="SemiBold"/>
                            <TextBlock Text="Finance movement by Bank / OD / Loans plus cash withdrawn and deposited." FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,3,0,12"/>
                            <ItemsControl ItemsSource="{Binding BankingPositionTiles}" ItemTemplate="{StaticResource MetricCardTemplate}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel></ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- Alerts tab -->
                    <Border Visibility="{Binding IsBankingAlertsTab, Converter={StaticResource BooleanToVisibilityConverter}}" Padding="15" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="11">
                        <StackPanel>
                            <TextBlock Text="Alerts" FontSize="16" FontWeight="SemiBold"/>
                            <TextBlock Text="Missing evidence, books-vs-statement differences, pending transfers, classification and Statutory Rule review candidates." FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,3,0,12"/>
                            <ItemsControl ItemsSource="{Binding BankingAlertTiles}" ItemTemplate="{StaticResource MetricCardTemplate}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel></ItemsControl>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- Bank / OD / Loans / Cash always open dashboard-first. -->
            <ScrollViewer x:Name="FinanceDashboardPageScroll" Visibility="{Binding IsFinanceDashboardVisible, Converter={StaticResource BooleanToVisibilityConverter}}" VerticalScrollBarVisibility="Auto" CanContentScroll="False">
                <StackPanel>
                    <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="11" Padding="14" Margin="0,0,0,12">
                        <StackPanel>
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Accounts" FontSize="15" FontWeight="SemiBold"/>
                                    <TextBlock Text="Select an account tile. The dashboard below stays account-first; transactions remain explicit." FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0"/>
                                </StackPanel>
                                <Button Grid.Column="1" Content="Show Transactions" Command="{Binding ShowTransactionsCommand}" Padding="13,7" ToolTip="Explicitly open voucher rows only for the selected account."/>
                            </Grid>
                            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                                <ItemsControl ItemsSource="{Binding FinanceAccounts}" ItemTemplate="{StaticResource FinanceAccountSelectorTileTemplate}">
                                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                </ItemsControl>
                            </ScrollViewer>
                            <TextBlock Text="{Binding SelectedFinanceAccount.VerificationStatus}" FontWeight="SemiBold" FontSize="10" Margin="0,8,0,0"/>
                        </StackPanel>
                    </Border>

                    <ItemsControl ItemsSource="{Binding FinancialDetailTiles}" ItemTemplate="{StaticResource MetricCardTemplate}" Margin="0,0,0,2">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    </ItemsControl>

                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Visibility="{Binding IsBankOrOdAccountModule, Converter={StaticResource BooleanToVisibilityConverter}}"
                                Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="11" Padding="15" Margin="0,0,6,0">
                            <StackPanel>
                                <TextBlock Text="Books vs Statement" FontSize="15" FontWeight="SemiBold"/>
                                <TextBlock Text="Selected account · opening, movement and closing verification" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="10" Margin="0,3,0,11"/>
                                <UniformGrid Columns="4">
                                    <StackPanel Margin="0,0,12,9"><TextBlock Text="Books Opening" FontSize="9" Foreground="{DynamicResource TextSecondaryBrush}"/><TextBlock Text="{Binding SelectedFinanceAccount.BooksOpeningDisplay}" FontWeight="SemiBold"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/><Style.Triggers><DataTrigger Binding="{Binding SelectedFinanceAccount.IsOpeningNatureAlert}" Value="True"><Setter Property="Foreground" Value="#B42318"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></StackPanel>
                                    <StackPanel Margin="0,0,12,9"><TextBlock Text="Books Debit" FontSize="9" Foreground="{DynamicResource TextSecondaryBrush}"/><TextBlock Text="{Binding SelectedFinanceAccount.BooksDebit, StringFormat=N2}" FontWeight="SemiBold"/></StackPanel>
                                    <StackPanel Margin="0,0,12,9"><TextBlock Text="Books Credit" FontSize="9" Foreground="{DynamicResource TextSecondaryBrush}"/><TextBlock Text="{Binding SelectedFinanceAccount.BooksCredit, StringFormat=N2}" FontWeight="SemiBold"/></StackPanel>
                                    <StackPanel Margin="0,0,12,9"><TextBlock Text="Books Closing" FontSize="9" Foreground="{DynamicResource TextSecondaryBrush}"/><TextBlock Text="{Binding SelectedFinanceAccount.BooksClosingDisplay}" FontWeight="SemiBold"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/><Style.Triggers><DataTrigger Binding="{Binding SelectedFinanceAccount.IsClosingNatureAlert}" Value="True"><Setter Property="Foreground" Value="#B42318"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></StackPanel>
                                    <StackPanel Margin="0,0,12,9"><TextBlock Text="Statement Opening" FontSize="9" Foreground="{DynamicResource TextSecondaryBrush}"/><TextBlock Text="{Binding SelectedFinanceAccount.OpeningDisplay}" FontWeight="SemiBold"/></StackPanel>
                                    <StackPanel Margin="0,0,12,9"><TextBlock Text="Statement Debit" FontSize="9" Foreground="{DynamicResource TextSecondaryBrush}"/><TextBlock Text="{Binding SelectedFinanceAccount.StatementDebit, StringFormat=N2}" FontWeight="SemiBold"/></StackPanel>
                                    <StackPanel Margin="0,0,12,9"><TextBlock Text="Statement Credit" FontSize="9" Foreground="{DynamicResource TextSecondaryBrush}"/><TextBlock Text="{Binding SelectedFinanceAccount.StatementCredit, StringFormat=N2}" FontWeight="SemiBold"/></StackPanel>
                                    <StackPanel Margin="0,0,12,9"><TextBlock Text="Statement Closing" FontSize="9" Foreground="{DynamicResource TextSecondaryBrush}"/><TextBlock Text="{Binding SelectedFinanceAccount.StatementClosingDisplay}" FontWeight="SemiBold"/></StackPanel>
                                </UniformGrid>
                                <StackPanel Orientation="Horizontal" Margin="0,1,0,0">
                                    <TextBlock Text="Difference: " FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    <TextBlock Text="{Binding SelectedFinanceAccount.DifferenceDisplay}" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                </StackPanel>
                                <TextBlock Text="{Binding SelectedFinanceAccount.VerificationStatus}" TextWrapping="Wrap" FontWeight="SemiBold" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="0" Visibility="{Binding IsCash, Converter={StaticResource BooleanToVisibilityConverter}}"
                                Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="11" Padding="15" Margin="0,0,6,0">
                            <StackPanel>
                                <TextBlock Text="Cash Position" FontSize="15" FontWeight="SemiBold"/>
                                <TextBlock Text="Cash-in-Hand books authority and movement summary" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="10" Margin="0,3,0,11"/>
                                <UniformGrid Columns="2">
                                    <StackPanel Margin="0,0,12,9"><TextBlock Text="Books Opening" FontSize="9" Foreground="{DynamicResource TextSecondaryBrush}"/><TextBlock Text="{Binding SelectedFinanceAccount.BooksOpeningDisplay}" FontWeight="SemiBold"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/><Style.Triggers><DataTrigger Binding="{Binding SelectedFinanceAccount.IsOpeningNatureAlert}" Value="True"><Setter Property="Foreground" Value="#B42318"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></StackPanel>
                                    <StackPanel Margin="0,0,12,9"><TextBlock Text="Books Closing" FontSize="9" Foreground="{DynamicResource TextSecondaryBrush}"/><TextBlock Text="{Binding SelectedFinanceAccount.BooksClosingDisplay}" FontWeight="SemiBold"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/><Style.Triggers><DataTrigger Binding="{Binding SelectedFinanceAccount.IsClosingNatureAlert}" Value="True"><Setter Property="Foreground" Value="#B42318"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></StackPanel>
                                    <StackPanel Margin="0,0,12,9"><TextBlock Text="Books Debit" FontSize="9" Foreground="{DynamicResource TextSecondaryBrush}"/><TextBlock Text="{Binding SelectedFinanceAccount.BooksDebit, StringFormat=N2}" FontWeight="SemiBold"/></StackPanel>
                                    <StackPanel Margin="0,0,12,9"><TextBlock Text="Books Credit" FontSize="9" Foreground="{DynamicResource TextSecondaryBrush}"/><TextBlock Text="{Binding SelectedFinanceAccount.BooksCredit, StringFormat=N2}" FontWeight="SemiBold"/></StackPanel>
                                    <StackPanel Margin="0,0,12,9"><TextBlock Text="Bank Withdrawals" FontSize="9" Foreground="{DynamicResource TextSecondaryBrush}"/><TextBlock Text="{Binding SelectedFinanceAccount.CashWithdrawn, StringFormat=N2}" FontWeight="SemiBold"/></StackPanel>
                                    <StackPanel Margin="0,0,12,9"><TextBlock Text="Bank Deposits" FontSize="9" Foreground="{DynamicResource TextSecondaryBrush}"/><TextBlock Text="{Binding SelectedFinanceAccount.CashDeposited, StringFormat=N2}" FontWeight="SemiBold"/></StackPanel>
                                </UniformGrid>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="0" Visibility="{Binding IsLoans, Converter={StaticResource BooleanToVisibilityConverter}}"
                                Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="11" Padding="15" Margin="0,0,6,0">
                            <StackPanel>
                                <TextBlock Text="Loan Position" FontSize="15" FontWeight="SemiBold"/>
                                <TextBlock Text="Secured-loan books movement; Bank statement verification is not applied to loan accounts." Foreground="{DynamicResource TextSecondaryBrush}" FontSize="10" Margin="0,3,0,11" TextWrapping="Wrap"/>
                                <UniformGrid Columns="2">
                                    <StackPanel Margin="0,0,12,9"><TextBlock Text="Books Opening" FontSize="9" Foreground="{DynamicResource TextSecondaryBrush}"/><TextBlock Text="{Binding SelectedFinanceAccount.BooksOpeningDisplay}" FontWeight="SemiBold"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/><Style.Triggers><DataTrigger Binding="{Binding SelectedFinanceAccount.IsOpeningNatureAlert}" Value="True"><Setter Property="Foreground" Value="#B42318"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></StackPanel>
                                    <StackPanel Margin="0,0,12,9"><TextBlock Text="Books Closing" FontSize="9" Foreground="{DynamicResource TextSecondaryBrush}"/><TextBlock Text="{Binding SelectedFinanceAccount.BooksClosingDisplay}" FontWeight="SemiBold"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/><Style.Triggers><DataTrigger Binding="{Binding SelectedFinanceAccount.IsClosingNatureAlert}" Value="True"><Setter Property="Foreground" Value="#B42318"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></StackPanel>
                                    <StackPanel Margin="0,0,12,9"><TextBlock Text="Repayment / Debit Side" FontSize="9" Foreground="{DynamicResource TextSecondaryBrush}"/><TextBlock Text="{Binding SelectedFinanceAccount.BooksDebit, StringFormat=N2}" FontWeight="SemiBold"/></StackPanel>
                                    <StackPanel Margin="0,0,12,9"><TextBlock Text="Receipt / Credit Side" FontSize="9" Foreground="{DynamicResource TextSecondaryBrush}"/><TextBlock Text="{Binding SelectedFinanceAccount.BooksCredit, StringFormat=N2}" FontWeight="SemiBold"/></StackPanel>
                                </UniformGrid>
                                <TextBlock Text="{Binding SelectedFinanceAccount.VerificationStatus}" FontWeight="SemiBold" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="1" Visibility="{Binding IsLoans, Converter={StaticResource BooleanToVisibilityConverter}}"
                                Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="11" Padding="15" Margin="6,0,0,0">
                            <StackPanel>
                                <TextBlock Text="Secured Loan Review Rules" FontSize="15" FontWeight="SemiBold"/>
                                <TextBlock Text="Secured Loans group authority · Bank statement verification does not apply." Foreground="{DynamicResource TextSecondaryBrush}" FontSize="10" TextWrapping="Wrap" Margin="0,3,0,11"/>
                                <TextBlock Text="Normal nature: Credit. Debit opening/closing is highlighted for review." FontSize="10" Margin="0,0,0,5"/>
                                <TextBlock Text="Borrowing/additions, repayments and interest/charges are presented separately; voucher rows remain explicit drill-down only." FontSize="10" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="1" Visibility="{Binding IsCashMovementPanelVisible, Converter={StaticResource BooleanToVisibilityConverter}}" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="11" Padding="15" Margin="6,0,0,0">
                            <StackPanel>
                                <TextBlock Text="Cash Movement" FontSize="15" FontWeight="SemiBold"/>
                                <TextBlock Text="Direct Bank ↔ Cash movement from Tally ledger/group authority." Foreground="{DynamicResource TextSecondaryBrush}" FontSize="10" TextWrapping="Wrap" Margin="0,3,0,11"/>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Padding="14,12" Background="{DynamicResource AppBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="9" Cursor="Hand" ToolTip="Open only cash-withdrawal transactions for this account.">
                                        <Border.InputBindings><MouseBinding MouseAction="LeftClick" Command="{Binding OpenCashMovementCommand}" CommandParameter="Withdrawal"/></Border.InputBindings>
                                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <StackPanel><TextBlock Text="Cash Withdrawn" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}"/><TextBlock Text="{Binding SelectedFinanceAccount.CashWithdrawn, StringFormat=N2}" FontSize="20" FontWeight="Bold" Margin="0,4,0,0"/></StackPanel>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0,0,0"><TextBlock Text="Open" FontSize="9" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Right"/><TextBlock Text="→" FontSize="18" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Right"/></StackPanel>
                                        </Grid>
                                    </Border>
                                    <Border Grid.Column="2" Padding="14,12" Background="{DynamicResource AppBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="9" Cursor="Hand" ToolTip="Open only cash-deposit transactions for this account.">
                                        <Border.InputBindings><MouseBinding MouseAction="LeftClick" Command="{Binding OpenCashMovementCommand}" CommandParameter="Deposit"/></Border.InputBindings>
                                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <StackPanel><TextBlock Text="Cash Deposited" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}"/><TextBlock Text="{Binding SelectedFinanceAccount.CashDeposited, StringFormat=N2}" FontSize="20" FontWeight="Bold" Margin="0,4,0,0"/></StackPanel>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0,0,0"><TextBlock Text="Open" FontSize="9" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Right"/><TextBlock Text="→" FontSize="18" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Right"/></StackPanel>
                                        </Grid>
                                    </Border>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Border Visibility="{Binding IsOD, Converter={StaticResource BooleanToVisibilityConverter}}"
                            Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="11" Padding="14" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="OD Review Rules" FontSize="15" FontWeight="SemiBold"/>
                            <TextBlock Text="Bank OD A/c authority · statement verification applies · Credit closing is normal." Foreground="{DynamicResource TextSecondaryBrush}" FontSize="10" Margin="0,3,0,10"/>
                            <UniformGrid Columns="4">
                                <StackPanel Margin="0,0,12,0"><TextBlock Text="Group Rule" FontSize="9" Foreground="{DynamicResource TextSecondaryBrush}"/><TextBlock Text="Bank OD A/c" FontWeight="SemiBold"/></StackPanel>
                                <StackPanel Margin="0,0,12,0"><TextBlock Text="Normal Nature" FontSize="9" Foreground="{DynamicResource TextSecondaryBrush}"/><TextBlock Text="Credit" FontWeight="SemiBold"/></StackPanel>
                                <StackPanel Margin="0,0,12,0"><TextBlock Text="Closing Nature" FontSize="9" Foreground="{DynamicResource TextSecondaryBrush}"/><TextBlock Text="{Binding SelectedFinanceAccount.ClosingNatureStatus}" FontWeight="SemiBold"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/><Style.Triggers><DataTrigger Binding="{Binding SelectedFinanceAccount.IsClosingNatureAlert}" Value="True"><Setter Property="Foreground" Value="#B42318"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></StackPanel>
                                <StackPanel><TextBlock Text="Evidence Rule" FontSize="9" Foreground="{DynamicResource TextSecondaryBrush}"/><TextBlock Text="Books vs Statement" FontWeight="SemiBold"/></StackPanel>
                            </UniformGrid>
                            <TextBlock Text="Debit opening/closing is flagged for review. Interest/charges are separated in the KPI strip; Cash ↔ OD and inter-bank movements remain drillable." FontSize="10" Margin="0,10,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <!-- Payments and Receipts remain separate and stacked. Fix104 puts each amount/share bar in the same table row; no separate chart panel and no Net column. -->

                    <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="11" Padding="14" Margin="0,0,0,12">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Content="View All Payments" Command="{Binding OpenAllPaymentsCommand}" Padding="10,4" Margin="8,0,0,0"/>
                                <StackPanel><TextBlock Text="Payments" FontSize="16" FontWeight="SemiBold"/><TextBlock Text="Amount by group · double-click a group for party/ledger totals" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="10"/></StackPanel>
                            </DockPanel>
                            <DataGrid x:Name="PaymentGroupGrid" Grid.Row="1" Margin="0,12,0,0" ItemsSource="{Binding PaymentGroupSummaries}"
                                      IsReadOnly="True" AutoGenerateColumns="False" MinHeight="190" HeadersVisibility="Column" SelectionMode="Single" SelectionUnit="FullRow"
                                      MouseDoubleClick="PaymentGroupGrid_MouseDoubleClick" ScrollViewer.VerticalScrollBarVisibility="Disabled">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Group" Binding="{Binding Group}" Width="1.8*"/>
                                    <DataGridTextColumn Header="Count" Binding="{Binding Count, StringFormat=N0}" Width="0.65*"/>
                                    <DataGridTextColumn Header="Amount" Binding="{Binding Amount, StringFormat=N2}" Width="1.15*"/>
                                    <DataGridTemplateColumn Header="Amount Graph" Width="1.65*">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Grid Margin="5,3">
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="58"/></Grid.ColumnDefinitions>
                                                    <ProgressBar Style="{StaticResource InlineGroupAmountBarStyle}" Value="{Binding SharePercent}"
                                                                 ToolTip="{Binding AmountDisplay}" VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding ShareDisplay}" Margin="8,0,0,0" VerticalAlignment="Center" HorizontalAlignment="Right" FontSize="10"/>
                                                </Grid>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="Payment Type" Binding="{Binding MovementType}" Width="1.35*"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>

                    <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="11" Padding="14" Margin="0,0,0,12">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Content="View All Receipts" Command="{Binding OpenAllReceiptsCommand}" Padding="10,4" Margin="8,0,0,0"/>
                                <StackPanel><TextBlock Text="Receipts" FontSize="16" FontWeight="SemiBold"/><TextBlock Text="Amount by group · double-click a group for party/ledger totals" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="10"/></StackPanel>
                            </DockPanel>
                            <DataGrid x:Name="ReceiptGroupGrid" Grid.Row="1" Margin="0,12,0,0" ItemsSource="{Binding ReceiptGroupSummaries}"
                                      IsReadOnly="True" AutoGenerateColumns="False" MinHeight="190" HeadersVisibility="Column" SelectionMode="Single" SelectionUnit="FullRow"
                                      MouseDoubleClick="ReceiptGroupGrid_MouseDoubleClick" ScrollViewer.VerticalScrollBarVisibility="Disabled">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Group" Binding="{Binding Group}" Width="1.8*"/>
                                    <DataGridTextColumn Header="Count" Binding="{Binding Count, StringFormat=N0}" Width="0.65*"/>
                                    <DataGridTextColumn Header="Amount" Binding="{Binding Amount, StringFormat=N2}" Width="1.15*"/>
                                    <DataGridTemplateColumn Header="Amount Graph" Width="1.65*">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Grid Margin="5,3">
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="58"/></Grid.ColumnDefinitions>
                                                    <ProgressBar Style="{StaticResource InlineGroupAmountBarStyle}" Value="{Binding SharePercent}"
                                                                 ToolTip="{Binding AmountDisplay}" VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding ShareDisplay}" Margin="8,0,0,0" VerticalAlignment="Center" HorizontalAlignment="Right" FontSize="10"/>
                                                </Grid>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="Receipt Type" Binding="{Binding MovementType}" Width="1.35*"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>

                    <Border Visibility="{Binding IsCash, Converter={StaticResource BooleanToVisibilityConverter}}" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="11" Padding="12" Margin="0,0,0,12">
                        <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <StackPanel><TextBlock Text="Bank Movement" FontSize="15" FontWeight="SemiBold"/><TextBlock Text="Bank-wise cash withdrawals and deposits" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="10"/></StackPanel>
                            <DataGrid x:Name="CashBankMovementGrid" Grid.Row="1" ItemsSource="{Binding CashBankMovements}" IsReadOnly="True" AutoGenerateColumns="False" SelectionMode="Single" SelectionUnit="FullRow" MouseDoubleClick="CashBankMovementGrid_MouseDoubleClick" Margin="0,10,0,0" ScrollViewer.VerticalScrollBarVisibility="Disabled">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Bank" Binding="{Binding Bank}" Width="2*"/>
                                    <DataGridTextColumn Header="Withdrawals" Binding="{Binding WithdrawalsCount, StringFormat=N0}" Width="*"/>
                                    <DataGridTextColumn Header="Withdrawal Amount" Binding="{Binding WithdrawalAmount, StringFormat=N2}" Width="1.4*"/>
                                    <DataGridTextColumn Header="Deposits" Binding="{Binding DepositsCount, StringFormat=N0}" Width="*"/>
                                    <DataGridTextColumn Header="Deposit Amount" Binding="{Binding DepositAmount, StringFormat=N2}" Width="1.4*"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>

                    <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="11" Padding="14">
                        <StackPanel>
                            <TextBlock Text="Alerts" FontSize="15" FontWeight="SemiBold"/>
                            <TextBlock Text="Selected-account evidence, transfer, classification and statutory review status" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="10" Margin="0,3,0,10"/>
                            <ItemsControl ItemsSource="{Binding SelectedAccountAlertTiles}" ItemTemplate="{StaticResource MetricCardTemplate}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel></ItemsControl>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- Group Open is one analytical level: selected group -> party/ledger totals -> explicit voucher rows. -->
            <Grid Visibility="{Binding IsFinanceGroupSummaryVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <DockPanel Grid.Row="0" Margin="0,0,0,10">
                    <Button DockPanel.Dock="Right" Content="Back to Account Dashboard" Command="{Binding CloseGroupSummaryCommand}" Padding="13,7"/>
                    <StackPanel>
                        <TextBlock Text="{Binding SelectedFinanceAccount.Account}" FontSize="16" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding FinanceGroupSummaryTitle}" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,3,0,0"/>
                    </StackPanel>
                </DockPanel>
                <Border Grid.Row="1" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="12">
                    <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <StackPanel>
                            <TextBlock Text="Party / Ledger summary" FontSize="15" FontWeight="SemiBold"/>
                            <TextBlock Text="This is the selected Tally group only. Double-click a party / ledger to open only that party's voucher rows." Foreground="{DynamicResource TextSecondaryBrush}" FontSize="10" Margin="0,3,0,10"/>
                        </StackPanel>
                        <DataGrid x:Name="FinanceGroupPartyGrid" Grid.Row="1" ItemsSource="{Binding FinanceGroupPartySummaries}" IsReadOnly="True" AutoGenerateColumns="False" HeadersVisibility="Column" SelectionMode="Single" SelectionUnit="FullRow" MouseDoubleClick="FinanceGroupPartyGrid_MouseDoubleClick">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Party / Ledger" Binding="{Binding Counterparty}" Width="2.4*"/>
                                <DataGridTextColumn Header="Count" Binding="{Binding Count, StringFormat=N0}" Width="*"/>
                                <DataGridTextColumn Header="Amount" Binding="{Binding Amount, StringFormat=N2}" Width="1.35*"/>
                                <DataGridTextColumn Header="Type" Binding="{Binding MovementType}" Width="1.7*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>
            </Grid>

            <!-- Transactions appear only after explicit Show Transactions or after selecting one party/ledger inside a group. -->
            <Grid Visibility="{Binding IsFinanceTransactionsVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <DockPanel Grid.Row="0" Margin="0,0,0,9">
                    <Button DockPanel.Dock="Right" Content="{Binding FinanceTransactionsCloseText}" Command="{Binding CloseTransactionsCommand}" Padding="13,7"/>
                    <TextBlock Text="{Binding SelectedFinanceAccount.Account}" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <TextBlock Text="  ·  " Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding FinanceTransactionDrilldownTitle}" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                </DockPanel>
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="315"/></Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="2" Margin="0,0,9,0">
                        <DataGrid x:Name="RecordsGrid" ItemsSource="{Binding VisibleRows}" SelectedItem="{Binding SelectedRecord, Mode=TwoWay}" IsReadOnly="True" AutoGenerateColumns="False" CanUserSortColumns="True" SelectionMode="Extended" SelectionUnit="FullRow" MouseDoubleClick="RecordsGrid_MouseDoubleClick">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Date" Binding="{Binding DateText}" Width="92"/>
                                <DataGridTextColumn Header="Group" Binding="{Binding CounterpartyGroup}" Width="140"/>
                                <DataGridTextColumn Header="Type" Binding="{Binding PaymentReceiptType}" Width="155"/>
                                <DataGridTextColumn Header="Account" Binding="{Binding PartyOrLedger}" Width="170"/>
                                <DataGridTextColumn Header="Counterparty" Binding="{Binding Counterparty}" Width="180"/>
                                <DataGridTextColumn Header="Reference" Binding="{Binding Reference}" Width="120"/>
                                <DataGridTextColumn Header="Voucher" Binding="{Binding VoucherType}" Width="95"/>
                                <DataGridTextColumn Header="Narration / Details" Binding="{Binding Details}" Width="2*"/>
                                <DataGridTextColumn Header="Debit" Binding="{Binding Debit, StringFormat=N2}" Width="105"/>
                                <DataGridTextColumn Header="Credit" Binding="{Binding Credit, StringFormat=N2}" Width="105"/>
                                <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="150"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                    <Border Grid.Column="1" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="14">
                        <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
                            <TextBlock Text="Audit Lookup" FontSize="15" FontWeight="SemiBold"/>
                            <TextBlock Text="Selected transaction evidence" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="10" Margin="0,3,0,12"/>
                            <TextBlock Text="Group" FontSize="9" Foreground="{DynamicResource TextSecondaryBrush}"/><TextBlock Text="{Binding SelectedRecord.CounterpartyGroup}" FontWeight="SemiBold" Margin="0,2,0,8"/>
                            <TextBlock Text="Payment / Receipt Type" FontSize="9" Foreground="{DynamicResource TextSecondaryBrush}"/><TextBlock Text="{Binding SelectedRecord.PaymentReceiptType}" Margin="0,2,0,8"/>
                            <TextBlock Text="Counterparty" FontSize="9" Foreground="{DynamicResource TextSecondaryBrush}"/><TextBlock Text="{Binding SelectedRecord.Counterparty}" TextWrapping="Wrap" Margin="0,2,0,8"/>
                            <TextBlock Text="Original Narration" FontSize="9" Foreground="{DynamicResource TextSecondaryBrush}"/><TextBlock Text="{Binding SelectedRecord.OriginalNarration}" TextWrapping="Wrap" Margin="0,2,0,8"/>
                            <TextBlock Text="Evidence" FontSize="9" Foreground="{DynamicResource TextSecondaryBrush}"/><TextBlock Text="{Binding SelectedRecord.EvidenceStatus}" TextWrapping="Wrap" Margin="0,2,0,8"/>
