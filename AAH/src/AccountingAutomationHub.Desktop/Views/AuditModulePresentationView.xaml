                            <Grid.ColumnDefinitions><ColumnDefinition Width="290"/><ColumnDefinition Width="18"/><ColumnDefinition Width="240"/></Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="Show Opening Balance" Margin="0,6"/><TextBlock Grid.Row="0" Grid.Column="1" Text=":" Margin="0,6"/><ToggleButton Grid.Row="0" Grid.Column="2" Style="{StaticResource YesNoToggleStyle}" IsChecked="{Binding DebtorCreditorShowOpeningBalance, Mode=TwoWay}" HorizontalAlignment="Left"/>
                            <TextBlock Grid.Row="1" Text="Show Transactions" Margin="0,6"/><TextBlock Grid.Row="1" Grid.Column="1" Text=":" Margin="0,6"/><ToggleButton Grid.Row="1" Grid.Column="2" Style="{StaticResource YesNoToggleStyle}" IsChecked="{Binding DebtorCreditorShowTransactions, Mode=TwoWay}" HorizontalAlignment="Left"/>
                            <TextBlock Grid.Row="2" Text="Nett Transactions only" Margin="18,6,0,6" Foreground="{DynamicResource TextSecondaryBrush}"/><TextBlock Grid.Row="2" Grid.Column="1" Text=":" Margin="0,6"/><ToggleButton Grid.Row="2" Grid.Column="2" Style="{StaticResource YesNoToggleStyle}" IsChecked="{Binding DebtorCreditorNetTransactionsOnly, Mode=TwoWay}" IsEnabled="{Binding DebtorCreditorCanNetTransactions}" HorizontalAlignment="Left"/>
                            <TextBlock Grid.Row="3" Text="Show Closing Balance" Margin="0,6"/><TextBlock Grid.Row="3" Grid.Column="1" Text=":" Margin="0,6"/><ToggleButton Grid.Row="3" Grid.Column="2" Style="{StaticResource YesNoToggleStyle}" IsChecked="{Binding DebtorCreditorShowClosingBalance, Mode=TwoWay}" HorizontalAlignment="Left"/>
                            <TextBlock Grid.Row="4" Text="Show Percentages" Margin="0,12,0,6"/><TextBlock Grid.Row="4" Grid.Column="1" Text=":" Margin="0,12,0,6"/><ToggleButton Grid.Row="4" Grid.Column="2" Style="{StaticResource YesNoToggleStyle}" IsChecked="{Binding DebtorCreditorShowPercentages, Mode=TwoWay}" HorizontalAlignment="Left" Margin="0,6,0,0"/>
                            <TextBlock Grid.Row="5" Text="Type of Percentages" Margin="18,6,0,6" Foreground="{DynamicResource TextSecondaryBrush}"/><TextBlock Grid.Row="5" Grid.Column="1" Text=":" Margin="0,6"/><ComboBox Grid.Row="5" Grid.Column="2" ItemsSource="{Binding DebtorCreditorPercentageTypes}" SelectedItem="{Binding DebtorCreditorPercentageType, Mode=TwoWay}" IsEnabled="{Binding DebtorCreditorCanChoosePercentageType}" MinWidth="180"/>
                            <TextBlock Grid.Row="6" Text="Type of Grouping" Margin="0,12,0,6"/><TextBlock Grid.Row="6" Grid.Column="1" Text=":" Margin="0,12,0,6"/><ComboBox Grid.Row="6" Grid.Column="2" ItemsSource="{Binding DebtorCreditorGroupingTypes}" SelectedItem="{Binding DebtorCreditorGroupingType, Mode=TwoWay}" MinWidth="180" Margin="0,6,0,0"/>
                            <TextBlock Grid.Row="7" Text="Format of Report" Margin="0,6"/><TextBlock Grid.Row="7" Grid.Column="1" Text=":" Margin="0,6"/><ComboBox Grid.Row="7" Grid.Column="2" ItemsSource="{Binding DebtorCreditorReportFormats}" SelectedItem="{Binding DebtorCreditorReportFormat, Mode=TwoWay}" MinWidth="180"/>
                            <TextBlock Grid.Row="8" Text="Expand all levels in Detailed format" Margin="18,6,0,6" Foreground="{DynamicResource TextSecondaryBrush}"/><TextBlock Grid.Row="8" Grid.Column="1" Text=":" Margin="0,6"/><ToggleButton Grid.Row="8" Grid.Column="2" Style="{StaticResource YesNoToggleStyle}" IsChecked="{Binding DebtorCreditorExpandDetailed, Mode=TwoWay}" IsEnabled="{Binding DebtorCreditorCanExpandDetailed}" HorizontalAlignment="Left"/>
                            <TextBlock Grid.Row="9" Text="Display name for Ledgers" Margin="0,12,0,6"/><TextBlock Grid.Row="9" Grid.Column="1" Text=":" Margin="0,12,0,6"/><ComboBox Grid.Row="9" Grid.Column="2" ItemsSource="{Binding DebtorCreditorDisplayNameModes}" SelectedItem="{Binding DebtorCreditorDisplayNameMode, Mode=TwoWay}" MinWidth="180" Margin="0,6,0,0"/>
                            <TextBlock Grid.Row="10" Text="Show Base Currency" Margin="0,12,0,6"/><TextBlock Grid.Row="10" Grid.Column="1" Text=":" Margin="0,12,0,6"/><ToggleButton Grid.Row="10" Grid.Column="2" Style="{StaticResource YesNoToggleStyle}" IsChecked="{Binding DebtorCreditorShowBaseCurrency, Mode=TwoWay}" HorizontalAlignment="Left" Margin="0,6,0,0"/>
                            <TextBlock Grid.Row="11" Text="Enable Stripe View" Margin="0,12,0,6"/><TextBlock Grid.Row="11" Grid.Column="1" Text=":" Margin="0,12,0,6"/><ToggleButton Grid.Row="11" Grid.Column="2" Style="{StaticResource YesNoToggleStyle}" IsChecked="{Binding DebtorCreditorStripeView, Mode=TwoWay}" HorizontalAlignment="Left" Margin="0,6,0,0"/>
                        </Grid>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
