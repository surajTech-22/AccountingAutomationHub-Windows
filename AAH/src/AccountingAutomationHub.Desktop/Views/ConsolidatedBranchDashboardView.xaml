<UserControl x:Class="AccountingAutomationHub.Desktop.Views.ConsolidatedBranchDashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:AccountingAutomationHub.Desktop.Views">
    <!-- Reuse the established AAH Dashboard's visual sections, cards and spacing.
         The Consolidated scope is read-only: do not expose the parent legacy
         Clear/Import/Tally buttons or mislabel parent rows as branch accounts. -->
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                  Background="{DynamicResource AppBackgroundBrush}">
        <StackPanel Margin="20,20,20,28">
            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel>
                    <TextBlock Text="Client Identity" Style="{StaticResource SectionTitleStyle}"/>
                    <Grid Margin="0,13,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="110"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="Client Name" Foreground="{DynamicResource TextSecondaryBrush}"/>
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding ClientName}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                        <TextBlock Grid.Row="0" Grid.Column="3" Text="Primary GSTIN" Foreground="{DynamicResource TextSecondaryBrush}"/>
                        <TextBlock Grid.Row="0" Grid.Column="4" Text="{Binding PrimaryGstin}" FontWeight="SemiBold"/>
                        <TextBlock Grid.Row="1" Margin="0,10,0,0" Text="Branch books" Foreground="{DynamicResource TextSecondaryBrush}"/>
                        <TextBlock Grid.Row="1" Grid.Column="1" Margin="0,10,0,0" Text="{Binding BranchSummary}"/>
                        <TextBlock Grid.Row="1" Grid.Column="3" Margin="0,10,0,0" Text="PAN" Foreground="{DynamicResource TextSecondaryBrush}"/>
                        <TextBlock Grid.Row="1" Grid.Column="4" Margin="0,10,0,0" Text="{Binding Pan}"/>
                    </Grid>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardBorderStyle}" Margin="0,14,0,0">
                <Grid MinHeight="86">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="64"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Border Width="54" Height="54" CornerRadius="12" Background="{DynamicResource AccentSoftBrush}"
                            VerticalAlignment="Center">
                        <TextBlock Text="⇩" FontSize="29" Foreground="{DynamicResource AccentBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="UNIVERSAL DUMP" FontSize="16" FontWeight="SemiBold"/>
                        <TextBlock Margin="0,4,0,0" Text="Select Karnataka or Gujarat to import under that branch's own accounting records."
                                   Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                        <TextBlock Margin="0,3,0,0" FontSize="10"
                                   Text="Consolidated is a reporting view; it does not post unassigned files to the parent."
                                   Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Margin="0,14,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource CardBorderStyle}" Grid.Column="0">
                    <StackPanel>
                        <TextBlock Text="Accounting Activity" Style="{StaticResource SectionTitleStyle}"/>
                        <UniformGrid Columns="2" Margin="0,10,0,0">
                            <Border Padding="10" Margin="3" CornerRadius="8" BorderBrush="{DynamicResource BorderBrush}"
                                    Background="{DynamicResource AppBackgroundBrush}" BorderThickness="1">
                                <StackPanel>
                                    <TextBlock Text="Bank Statement" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11"/>
                                    <TextBlock Text="{Binding VerifiedBankingCount}" FontSize="22" FontWeight="SemiBold" Margin="0,5,0,0"/>
                                    <TextBlock Text="Branch-owned transactions" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                </StackPanel>
                            </Border>
                            <Border Padding="10" Margin="3" CornerRadius="8" BorderBrush="{DynamicResource BorderBrush}"
                                    Background="{DynamicResource AppBackgroundBrush}" BorderThickness="1">
                                <StackPanel>
                                    <TextBlock Text="Purchase" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11"/>
                                    <TextBlock Text="{Binding VerifiedPurchaseCount}" FontSize="22" FontWeight="SemiBold" Margin="0,5,0,0"/>
                                    <TextBlock Text="Branch-owned records" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                </StackPanel>
                            </Border>
                            <Border Padding="10" Margin="3" CornerRadius="8" BorderBrush="{DynamicResource BorderBrush}"
                                    Background="{DynamicResource AppBackgroundBrush}" BorderThickness="1">
                                <StackPanel>
                                    <TextBlock Text="Sales" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11"/>
                                    <TextBlock Text="{Binding VerifiedSalesCount}" FontSize="22" FontWeight="SemiBold" Margin="0,5,0,0"/>
                                    <TextBlock Text="Branch-owned records" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                </StackPanel>
                            </Border>
                            <Border Padding="10" Margin="3" CornerRadius="8" BorderBrush="{DynamicResource BorderBrush}"
                                    Background="{DynamicResource AppBackgroundBrush}" BorderThickness="1">
                                <StackPanel>
                                    <TextBlock Text="Journal" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11"/>
                                    <TextBlock Text="{Binding VerifiedJournalCount}" FontSize="22" FontWeight="SemiBold" Margin="0,5,0,0"/>
                                    <TextBlock Text="Branch-owned vouchers" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                </StackPanel>
                            </Border>
                            <Border Padding="10" Margin="3" CornerRadius="8" BorderBrush="{DynamicResource BorderBrush}"
                                    Background="{DynamicResource AppBackgroundBrush}" BorderThickness="1">
                                <StackPanel>
                                    <TextBlock Text="Cash Entries" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11"/>
                                    <TextBlock Text="{Binding VerifiedCashCount}" FontSize="22" FontWeight="SemiBold" Margin="0,5,0,0"/>
                                    <TextBlock Text="Branch-owned entries" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                </StackPanel>
                            </Border>
                            <Border Padding="10" Margin="3" CornerRadius="8" BorderBrush="{DynamicResource BorderBrush}"
                                    Background="{DynamicResource AppBackgroundBrush}" BorderThickness="1">
                                <StackPanel>
                                    <TextBlock Text="Branches" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11"/>
                                    <TextBlock Text="{Binding BranchCount}" FontSize="22" FontWeight="SemiBold" Margin="0,5,0,0"/>
                                    <TextBlock Text="Separate accounting books" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                </StackPanel>
                            </Border>
                        </UniformGrid>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource CardBorderStyle}" Grid.Column="2" VerticalAlignment="Top">
                    <StackPanel>
                        <TextBlock Text="Auto Import Activity" Style="{StaticResource SectionTitleStyle}"/>
                        <TextBlock Text="Automatic and manual imports are tracked within their respective branch dashboards."
                                   Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" FontSize="11"
                                   Margin="0,9,0,10"/>
                        <TextBlock Text="Accounting by branch" FontWeight="SemiBold" FontSize="13"/>
                        <DataGrid ItemsSource="{Binding VerifiedBranches}" IsReadOnly="True" Height="275" Margin="0,8,0,0"
                                  AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                                  HeadersVisibility="Column" GridLinesVisibility="Horizontal">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Branch" Width="2*" Binding="{Binding Name}"/>
                                <DataGridTextColumn Header="Sales" Width="*" Binding="{Binding SalesDisplay}"/>
                                <DataGridTextColumn Header="Purchase" Width="*" Binding="{Binding PurchaseDisplay}"/>
                                <DataGridTextColumn Header="Bank" Width="*" Binding="{Binding BankDisplay}"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Border>
            </Grid>
            <!-- The EXACT same Dashboard Tally Link / Export / Auto Sync card.
                 Never substitute the Tally Import recovery page in its place. -->
            <TextBlock Margin="2,12,0,0" FontSize="10"
                       Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"
                       Text="This Tally panel uses the existing parent Client/FY link and export authority. It does not automatically combine or export unverified branch vouchers."/>
            <views:DashboardView DataContext="{Binding ExistingDashboardWorkspace}"
                                 TallyOnlyMode="True"/>
            <Border Margin="0,14,0,0" Style="{StaticResource CardBorderStyle}">
                <StackPanel>
                    <TextBlock Text="Historical records reconciliation" FontWeight="SemiBold" FontSize="13"/>
                    <TextBlock Text="{Binding HistoricalParentSummary}" FontSize="11" Margin="0,7,0,0"
                               Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding Warning}" FontSize="10" Margin="0,5,0,0"
                               Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>
            <TextBlock Margin="2,9,0,0" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}"
                       Text="Only branch-owned saved records are counted. This page never duplicates parent historical records or issues Tally vouchers."/>
        </StackPanel>
    </ScrollViewer>
</UserControl>