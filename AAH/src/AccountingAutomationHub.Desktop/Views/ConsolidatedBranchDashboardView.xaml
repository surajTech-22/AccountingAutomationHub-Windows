<UserControl x:Class="AccountingAutomationHub.Desktop.Views.ConsolidatedBranchDashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="23">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0">
            <TextBlock Text="Consolidated · Branch Accounting" FontSize="23" FontWeight="SemiBold"/>
            <TextBlock Text="Read-only verified accounting records grouped by durable branch ownership"
                       Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,5,0,0" TextWrapping="Wrap"/>
        </StackPanel>
        <TextBlock Grid.Row="1" Text="{Binding Status}" Margin="0,14,0,14" TextWrapping="Wrap"/>
        <DataGrid Grid.Row="2" ItemsSource="{Binding Branches}" IsReadOnly="True"
                  AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                  HeadersVisibility="Column" GridLinesVisibility="Horizontal">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Branch / historical scope" Width="3*" Binding="{Binding Name}"/>
                <DataGridTextColumn Header="Sales rows" Width="*" Binding="{Binding SalesDisplay}"/>
                <DataGridTextColumn Header="Purchase rows" Width="*" Binding="{Binding PurchaseDisplay}"/>
                <DataGridTextColumn Header="Bank entries" Width="*" Binding="{Binding BankDisplay}"/>
                <DataGridTextColumn Header="Cash entries" Width="*" Binding="{Binding CashDisplay}"/>
                <DataGridTextColumn Header="Journals" Width="*" Binding="{Binding JournalDisplay}"/>
            </DataGrid.Columns>
        </DataGrid>
        <StackPanel Grid.Row="3" Margin="0,13,0,0">
            <TextBlock Text="{Binding Warning}" TextWrapping="Wrap" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextSecondaryBrush}"/>
            <TextBlock Margin="0,7,0,0" TextWrapping="Wrap"
                       Text="These are source-backed record counts, NOT consolidated Tally balances or a final balance sheet. Unassigned historical parent records are shown separately. No automatic intercompany elimination, reassignment, or Tally posting occurs."
                       Foreground="{DynamicResource TextSecondaryBrush}"/>
        </StackPanel>
    </Grid>
</UserControl>