<UserControl x:Class="AccountingAutomationHub.Desktop.Views.ConsolidatedBranchDashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="24">
            <TextBlock Text="Consolidated Dashboard" FontSize="24" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextPrimaryBrush}"/>
            <TextBlock Text="{Binding Status}" Margin="0,5,0,18" FontSize="13"
                       Foreground="{DynamicResource TextSecondaryBrush}"/>

            <!-- Consistent card-based workspace overview. Never total unassigned
                 historical parent rows together with separately imported branches. -->
            <WrapPanel Margin="0,0,0,16">
                <Border Width="208" Margin="0,0,10,10" Padding="16" CornerRadius="9"
                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                        Background="{DynamicResource SurfaceBrush}">
                    <StackPanel>
                        <TextBlock Text="Branch books" Foreground="{DynamicResource TextSecondaryBrush}"/>
                        <TextBlock Text="{Binding BranchCount}" FontSize="26" FontWeight="SemiBold" Margin="0,9,0,0"/>
                    </StackPanel>
                </Border>
                <Border Width="208" Margin="0,0,10,10" Padding="16" CornerRadius="9"
                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                        Background="{DynamicResource SurfaceBrush}">
                    <StackPanel>
                        <TextBlock Text="Sales records" Foreground="{DynamicResource TextSecondaryBrush}"/>
                        <TextBlock Text="{Binding VerifiedSalesCount}" FontSize="26" FontWeight="SemiBold" Margin="0,9,0,0"/>
                    </StackPanel>
                </Border>
                <Border Width="208" Margin="0,0,10,10" Padding="16" CornerRadius="9"
                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                        Background="{DynamicResource SurfaceBrush}">
                    <StackPanel>
                        <TextBlock Text="Purchase records" Foreground="{DynamicResource TextSecondaryBrush}"/>
                        <TextBlock Text="{Binding VerifiedPurchaseCount}" FontSize="26" FontWeight="SemiBold" Margin="0,9,0,0"/>
                    </StackPanel>
                </Border>
                <Border Width="208" Margin="0,0,10,10" Padding="16" CornerRadius="9"
                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                        Background="{DynamicResource SurfaceBrush}">
                    <StackPanel>
                        <TextBlock Text="Bank transactions" Foreground="{DynamicResource TextSecondaryBrush}"/>
                        <TextBlock Text="{Binding VerifiedBankingCount}" FontSize="26" FontWeight="SemiBold" Margin="0,9,0,0"/>
                    </StackPanel>
                </Border>
                <Border Width="208" Margin="0,0,10,10" Padding="16" CornerRadius="9"
                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                        Background="{DynamicResource SurfaceBrush}">
                    <StackPanel>
                        <TextBlock Text="Journal vouchers" Foreground="{DynamicResource TextSecondaryBrush}"/>
                        <TextBlock Text="{Binding VerifiedJournalCount}" FontSize="26" FontWeight="SemiBold" Margin="0,9,0,0"/>
                    </StackPanel>
                </Border>
            </WrapPanel>
            <Border Padding="15" CornerRadius="8" Margin="0,0,0,18"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                    Background="{DynamicResource SurfaceBrush}">
                <StackPanel>
                    <TextBlock Text="Branch reconciliation" FontSize="16" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding ConsolidationNotice}" Margin="0,7,0,0"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                </StackPanel>
            </Border>

            <TextBlock Text="Accounting by branch" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,9"/>
            <DataGrid ItemsSource="{Binding Branches}" IsReadOnly="True" Height="280"
                      AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                      HeadersVisibility="Column" GridLinesVisibility="Horizontal">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Branch / unassigned history" Width="3*" Binding="{Binding Name}"/>
                    <DataGridTextColumn Header="Sales" Width="*" Binding="{Binding SalesDisplay}"/>
                    <DataGridTextColumn Header="Purchase" Width="*" Binding="{Binding PurchaseDisplay}"/>
                    <DataGridTextColumn Header="Banking" Width="*" Binding="{Binding BankDisplay}"/>
                    <DataGridTextColumn Header="Cash" Width="*" Binding="{Binding CashDisplay}"/>
                    <DataGridTextColumn Header="Journal" Width="*" Binding="{Binding JournalDisplay}"/>
                </DataGrid.Columns>
            </DataGrid>
            <TextBlock Text="{Binding Warning}" Margin="0,12,0,0" TextWrapping="Wrap"
                       Foreground="{DynamicResource TextSecondaryBrush}"/>
            <TextBlock Margin="0,7,0,0" TextWrapping="Wrap" FontSize="11"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       Text="These are saved record counts, not verified Tally balances or a final balance sheet. Existing parent records are preserved until source-backed allocation is independently reconciled."/>
        </StackPanel>
    </ScrollViewer>
</UserControl>