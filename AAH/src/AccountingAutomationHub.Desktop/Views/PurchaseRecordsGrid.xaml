<UserControl x:Class="AccountingAutomationHub.Desktop.Views.PurchaseRecordsGrid"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:AccountingAutomationHub.Desktop.Controls"
             xmlns:behaviors="clr-namespace:AccountingAutomationHub.Desktop.Behaviors">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <controls:MultiSearchFilterBar x:Name="SearchFilterBar"
                                       Grid.Row="0"
                                       Margin="0,0,0,6"
                                       SearchText="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
        <WrapPanel Grid.Row="1" Margin="0,0,0,6">
            <Button Content="Delete Selected Rows"
                    Click="DeleteSelectedRows_Click"
                    IsEnabled="{Binding CanDeletePurchase}"
                    Padding="11,6"
                    ToolTip="Delete the selected saved Purchase rows from AAH. Tally and original source files are not deleted."/>
            <Button Content="Include Selected 2B Only"
                    Click="IncludeTwoBOnlyRows_Click"
                    IsEnabled="{Binding CanEditPurchase}"
                    Visibility="{Binding ShowTwoBOnlyAction, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BooleanToVisibilityConverter}}"
                    Margin="7,0,0,0"
                    Padding="11,6"
                    ToolTip="Retain selected 2B-only invoices and include them in the normal Purchase/RCM/Debit Note/Debit Note Reverse accounting tabs according to their source type."/>
            <Button Content="+ Add GST Rate Line"
                    Click="AddTwoBRateLine_Click"
                    IsEnabled="{Binding CanEditPurchase}"
                    Visibility="{Binding ShowTwoBOnlyAction, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BooleanToVisibilityConverter}}"
                    Margin="7,0,0,0"
                    Padding="11,6"
                    ToolTip="For a multi-rate 2B-only invoice, add another line then enter Taxable and Rate %. AAH calculates the tax and validates the complete invoice before inclusion."/>
        </WrapPanel>

        <DataGrid x:Name="RecordsGrid"
              Grid.Row="2"
              ItemsSource="{Binding ItemsSource, RelativeSource={RelativeSource AncestorType=UserControl}}"
              CellEditEnding="RecordsGrid_CellEditEnding"
              PreviewKeyDown="RecordsGrid_PreviewKeyDown"
              PreviewTextInput="RecordsGrid_PreviewTextInput"
              AutoGenerateColumns="False"
              IsReadOnly="{Binding IsPurchaseReadOnly}"
              CanUserAddRows="False"
              CanUserDeleteRows="False"
              CanUserReorderColumns="True"
              CanUserResizeColumns="True"
              CanUserSortColumns="True"
              EnableRowVirtualization="True"
              EnableColumnVirtualization="True"
              FrozenColumnCount="4"
              HeadersVisibility="Column"
              GridLinesVisibility="Horizontal"
              AlternatingRowBackground="#F8FAFC"
              BorderBrush="{DynamicResource BorderBrush}"
              BorderThickness="1"
              RowHeaderWidth="0"
              SelectionMode="Extended"
              SelectionUnit="CellOrRowHeader">
        <DataGrid.Resources>
            <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource GlobalFilterableDataGridColumnHeaderStyle}">
                <Setter Property="Background" Value="#F1F5F9" />
                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Padding" Value="8,8" />
                <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
                <Setter Property="BorderThickness" Value="0,0,1,1" />
            </Style>
            <Style TargetType="DataGridCell">
                <Setter Property="Padding" Value="6,4" />
                <Setter Property="BorderThickness" Value="0" />
            </Style>
            <Style TargetType="TextBox">
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Padding" Value="4,2" />
            </Style>
        </DataGrid.Resources>

        <DataGrid.Columns>
            <DataGridTextColumn Header="Status"
                                Binding="{Binding ReconciliationStatus, Mode=OneWay}"
                                IsReadOnly="True"
                                Width="125" />
            <DataGridTemplateColumn Header="GST Treatment" SortMemberPath="GstApplicability"
                                    Width="175">
                <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate>
                        <Grid>
                            <!-- Accounting tabs: a promoted 2B-only invoice uses the same
                                 GST applicability selector as an ordinary Purchase row. -->
                            <controls:SearchableComboBox x:Name="AccountingGstTreatmentSelector"
                                                         IsEnabled="{Binding DataContext.CanEditPurchase, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                         SourceItems="{Binding AccountingGstTreatmentOptions, Mode=OneWay}"
                                                         Text="{Binding AccountingGstApplicability, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                         AllowCustomText="False"
                                                         OpenOnFocus="True"
                                                         HandleEnterKey="False"
                                                         EnableMouseWheelSelection="False"
                                                         UpdateSourceWhileTyping="False"
                                                         SelectFirstVisibleOnNoMatch="False"
                                                         GotKeyboardFocus="GstTreatment_GotKeyboardFocus"
                                                         DropDownClosed="GstTreatment_DropDownClosed"
                                                         LostKeyboardFocus="GstTreatment_LostKeyboardFocus"
                                                         MinWidth="155"
                                                         Padding="5,2"
                                                         BorderBrush="{DynamicResource BorderBrush}"
                                                         Background="White" />

                            <!-- All / Recon exposes the reconciliation inclusion state as a
                                 working selector. Choosing Included runs the same full invoice
                                 validation as the bulk Include action; choosing Not Included
                                 returns the invoice to retained 2B-only evidence. -->
                            <controls:SearchableComboBox x:Name="ReconciliationGstTreatmentSelector"
                                                         Visibility="Collapsed"
                                                         IsEnabled="{Binding DataContext.CanEditPurchase, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                         SourceItems="{Binding ReconciliationGstTreatmentOptions, Mode=OneWay}"
                                                         Text="{Binding ReconciliationGstApplicability, Mode=OneWay}"
                                                         AllowCustomText="False"
                                                         OpenOnFocus="True"
                                                         HandleEnterKey="False"
                                                         EnableMouseWheelSelection="False"
                                                         UpdateSourceWhileTyping="False"
                                                         SelectFirstVisibleOnNoMatch="False"
                                                         GotKeyboardFocus="TwoBReconciliationTreatment_GotKeyboardFocus"
                                                         DropDownClosed="TwoBReconciliationTreatment_DropDownClosed"
                                                         LostKeyboardFocus="TwoBReconciliationTreatment_LostKeyboardFocus"
                                                         MinWidth="155"
                                                         Padding="5,2"
                                                         BorderBrush="{DynamicResource BorderBrush}"
                                                         Background="White" />

                        </Grid>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding ShowTwoBOnlyAction, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True">
                                <Setter TargetName="AccountingGstTreatmentSelector" Property="Visibility" Value="Collapsed" />
                                <Setter TargetName="ReconciliationGstTreatmentSelector" Property="Visibility" Value="Visible" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding ImportMode}" Value="Manual Import">
                                <Setter TargetName="AccountingGstTreatmentSelector" Property="Visibility" Value="Collapsed" />
                                <Setter TargetName="ReconciliationGstTreatmentSelector" Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTextColumn Header="GSTIN"
                                Binding="{Binding SupplierGstin, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                Width="145" />
            <DataGridTextColumn Header="Supplier"
                                Binding="{Binding SupplierName, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                Width="220" />
            <DataGridTextColumn Header="Document Type"
                                Binding="{Binding DocumentType, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                Width="120" />
            <DataGridTextColumn Header="Document No."
                                Binding="{Binding DocumentNumber, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                Width="155" />

            <DataGridTemplateColumn Header="Document Date" SortMemberPath="DocumentDate"
                                    Width="120">
                <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding DocumentDate, StringFormat={}{0:dd-MM-yyyy}}"
                                   VerticalAlignment="Center" />
                    </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
                <DataGridTemplateColumn.CellEditingTemplate>
                    <DataTemplate>
                        <DatePicker SelectedDate="{Binding DocumentDate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                    SelectedDateFormat="Short" />
                    </DataTemplate>
                </DataGridTemplateColumn.CellEditingTemplate>
            </DataGridTemplateColumn>

            <DataGridTemplateColumn Header="GST Date" SortMemberPath="GstDate"
                                    Width="115">
                <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding GstDate, StringFormat={}{0:dd-MM-yyyy}}"
                                   VerticalAlignment="Center" />
                    </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
                <DataGridTemplateColumn.CellEditingTemplate>
                    <DataTemplate>
                        <DatePicker SelectedDate="{Binding GstDate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                    DisplayDateStart="{Binding FinancialYearStart, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                    DisplayDateEnd="{Binding FinancialYearEnd, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                    SelectedDateFormat="Short" />
                    </DataTemplate>
                </DataGridTemplateColumn.CellEditingTemplate>
            </DataGridTemplateColumn>

            <DataGridTextColumn Header="Source Value"
                                behaviors:DataGridColumnFilterBehavior.TotalPath="SourceDocumentValue"
                                Binding="{Binding SourceDocumentValue, Mode=OneWay, StringFormat=N2}"
                                IsReadOnly="True"
                                Width="105" />
            <DataGridTextColumn Header="Document Value"
                                behaviors:DataGridColumnFilterBehavior.TotalPath="DocumentValue"
                                Binding="{Binding DocumentValue, Mode=TwoWay, UpdateSourceTrigger=LostFocus, StringFormat=N2}"
                                Width="115" />
            <DataGridTextColumn Header="Rate %"
                                Binding="{Binding RateText, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                Width="75" />
            <DataGridTextColumn Header="Taxable"
                                behaviors:DataGridColumnFilterBehavior.TotalPath="TaxableValue"
                                Binding="{Binding TaxableValue, Mode=TwoWay, UpdateSourceTrigger=LostFocus, StringFormat=N2}"
                                Width="105" />
            <DataGridTextColumn Header="Item Name"
                                Binding="{Binding ItemName, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                Width="180" />
            <DataGridTextColumn Header="HSN"
                                Binding="{Binding HsnCode, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                Width="90" />
            <DataGridTextColumn Header="Qty"
                                behaviors:DataGridColumnFilterBehavior.TotalPath="ActualQuantity"
                                Binding="{Binding ActualQuantity, Mode=TwoWay, UpdateSourceTrigger=LostFocus, StringFormat=N4}"
                                Width="85" />
            <DataGridTextColumn Header="Unit"
                                Binding="{Binding Unit, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                Width="85" />
            <DataGridTextColumn Header="Item Rate"
                                Binding="{Binding ItemRate, Mode=OneWay, StringFormat=N4}"
                                IsReadOnly="True"
                                Width="95" />
            <DataGridTextColumn Header="Billed Qty"
                                behaviors:DataGridColumnFilterBehavior.TotalPath="BilledQuantity"
                                Binding="{Binding BilledQuantity, Mode=TwoWay, UpdateSourceTrigger=LostFocus, StringFormat=N4}"
                                Width="95" />
            <DataGridTextColumn Header="Item Amount"
                                behaviors:DataGridColumnFilterBehavior.TotalPath="ItemAmount"
                                Binding="{Binding ItemAmount, Mode=TwoWay, UpdateSourceTrigger=LostFocus, StringFormat=N2}"
                                Width="105" />
            <DataGridTextColumn Header="Item Purchase Ledger"
                                Binding="{Binding ItemPurchaseLedger, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                Width="180" />
            <DataGridTextColumn Header="Godown"
                                Binding="{Binding Godown, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                Width="120" />
            <DataGridTextColumn Header="Batch"
                                Binding="{Binding BatchName, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                Width="115" />
            <DataGridTextColumn Header="IGST"
                                behaviors:DataGridColumnFilterBehavior.TotalPath="Igst"
                                Binding="{Binding Igst, Mode=TwoWay, UpdateSourceTrigger=LostFocus, StringFormat=N2}"
                                Width="90" />
            <DataGridTextColumn Header="CGST"
                                behaviors:DataGridColumnFilterBehavior.TotalPath="Cgst"
                                Binding="{Binding Cgst, Mode=TwoWay, UpdateSourceTrigger=LostFocus, StringFormat=N2}"
                                Width="90" />
            <DataGridTextColumn Header="SGST"
                                behaviors:DataGridColumnFilterBehavior.TotalPath="Sgst"
                                Binding="{Binding Sgst, Mode=TwoWay, UpdateSourceTrigger=LostFocus, StringFormat=N2}"
                                Width="90" />
            <DataGridTextColumn Header="Cess"
                                behaviors:DataGridColumnFilterBehavior.TotalPath="Cess"
                                Binding="{Binding Cess, Mode=TwoWay, UpdateSourceTrigger=LostFocus, StringFormat=N2}"
                                Width="85" />
            <DataGridTextColumn Header="Round Off"
                                behaviors:DataGridColumnFilterBehavior.TotalPath="RoundOff"
                                Binding="{Binding RoundOff, Mode=TwoWay, UpdateSourceTrigger=LostFocus, StringFormat=N2}"
                                Width="90" />
            <DataGridTemplateColumn Header="Purchase / Cost Ledger" SortMemberPath="PurchaseLedger"
                                    Width="215">
                <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate>
                        <controls:SearchableComboBox x:Name="PurchaseLedgerSelector"
                                                     IsEnabled="{Binding DataContext.CanEditPurchase, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                     SourceItems="{Binding DataContext.IndirectExpenseLedgerNames, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                                     Text="{Binding PurchaseLedger, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                     AllowCustomText="True"
                                                     OpenOnFocus="True"
                                                     HandleEnterKey="False"
                                                     EnableMouseWheelSelection="False"
                                                     GotKeyboardFocus="CostLedger_GotKeyboardFocus"
                                                     DropDownClosed="CostLedger_DropDownClosed"
                                                     LostKeyboardFocus="CostLedger_LostKeyboardFocus"
                                                     ToolTip="Choose an Indirect Expenses ledger. Entering a new Purchase / Cost Ledger name creates it under Indirect Expenses."
                                                     MinWidth="190"
                                                     Padding="5,2"
                                                     BorderBrush="{DynamicResource BorderBrush}"
                                                     Background="White" />
                    </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
                <DataGridTemplateColumn.CellEditingTemplate>
                    <DataTemplate>
                        <controls:SearchableComboBox x:Name="PurchaseLedgerEditor"
                                                     IsEnabled="{Binding DataContext.CanEditPurchase, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                     SourceItems="{Binding DataContext.IndirectExpenseLedgerNames, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                                     Text="{Binding PurchaseLedger, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                     AllowCustomText="True"
                                                     OpenOnFocus="True"
                                                     HandleEnterKey="False"
                                                     EnableMouseWheelSelection="False"
                                                     GotKeyboardFocus="CostLedger_GotKeyboardFocus"
                                                     DropDownClosed="CostLedger_DropDownClosed"
                                                     LostKeyboardFocus="CostLedger_LostKeyboardFocus"
                                                     ToolTip="Choose an Indirect Expenses ledger. Entering a new Purchase / Cost Ledger name creates it under Indirect Expenses."
                                                     MinWidth="190"
                                                     Padding="5,2"
                                                     BorderBrush="{DynamicResource BorderBrush}"
                                                     Background="White" />
                    </DataTemplate>
                </DataGridTemplateColumn.CellEditingTemplate>
            </DataGridTemplateColumn>
            <DataGridTextColumn Header="IGST Ledger"
                                Binding="{Binding IgstLedger, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                Width="190" />
            <DataGridTextColumn Header="CGST Ledger"
                                Binding="{Binding CgstLedger, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                Width="190" />
            <DataGridTextColumn Header="SGST Ledger"
                                Binding="{Binding SgstLedger, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                Width="190" />
            <DataGridTextColumn Header="Section"
                                Binding="{Binding SourceSection, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                Width="125" />
            <DataGridCheckBoxColumn Header="Amendment"
                                    Binding="{Binding IsAmendment, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                    Width="85" />
            <DataGridTextColumn Header="Original Document"
                                Binding="{Binding OriginalDocumentNumber, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                Width="145" />
            <DataGridTextColumn Header="Place of Supply"
                                Binding="{Binding PlaceOfSupply, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                Width="135" />
            <DataGridTextColumn Header="Reverse Charge"
                                Binding="{Binding ReverseCharge, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                Width="105" />
            <DataGridTextColumn Header="2B Taxable"
                                behaviors:DataGridColumnFilterBehavior.TotalPath="TwoBTaxableValue"
                                Binding="{Binding TwoBTaxableValue, Mode=OneWay, StringFormat=N2}"
                                IsReadOnly="True"
                                Width="105" />
            <DataGridTextColumn Header="Difference"
                                Binding="{Binding DifferenceDetails, Mode=OneWay}"
                                IsReadOnly="True"
                                Width="320" />
        </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
