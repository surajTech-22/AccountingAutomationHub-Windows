                            <DataGridTextColumn Header="Client Name" Binding="{Binding ClientName, Mode=OneWay}" IsReadOnly="True" Width="150"/>
                            <DataGridTextColumn Header="Account Number" Binding="{Binding AccountNumber, Mode=OneWay}" IsReadOnly="True" Width="220"/>
