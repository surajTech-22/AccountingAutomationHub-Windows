                                    <Border.Effect><DropShadowEffect BlurRadius="22" ShadowDepth="2" Opacity="0.24"/></Border.Effect>
                                    <Grid Margin="18">
                                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                        <DockPanel LastChildFill="False">
                                            <StackPanel DockPanel.Dock="Left">
                                                <TextBlock Text="Balance Review Details" FontSize="20" FontWeight="SemiBold"/>
                                                <TextBlock Text="{Binding SelectedReconciliationRow.AccountName, Mode=OneWay}" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,3,0,0"/>
                                            </StackPanel>
                                            <Button DockPanel.Dock="Right" Content="Close" Command="{Binding CloseBalanceReviewDetailCommand}" Padding="12,6"/>
                                        </DockPanel>

                                        <Border Grid.Row="1" Margin="0,14,0,12" Padding="12" Background="#F5F8FC" CornerRadius="8">
                                            <Grid>
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                                <TextBlock Text="Period" Foreground="{DynamicResource TextSecondaryBrush}"/><TextBlock Grid.Column="1" Text="{Binding SelectedReconciliationRow.PeriodLabel, Mode=OneWay}" FontWeight="SemiBold"/>
                                                <TextBlock Grid.Row="1" Text="Suggested Opening (Books)" Foreground="{DynamicResource TextSecondaryBrush}"/><TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SelectedReconciliationRow.SuggestedOpeningBalanceText, Mode=OneWay}" FontWeight="SemiBold"/>
                                                <TextBlock Grid.Row="2" Text="Expected Closing (Books)" Foreground="{DynamicResource TextSecondaryBrush}"/><TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding SelectedReconciliationRow.ExpectedClosingBalanceText, Mode=OneWay}" FontWeight="SemiBold"/>
                                                <TextBlock Grid.Row="3" Text="Statement Closing (Books)" Foreground="{DynamicResource TextSecondaryBrush}"/><TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding SelectedReconciliationRow.StatementClosingBalanceText, Mode=OneWay}" FontWeight="SemiBold"/>
                                                <TextBlock Grid.Row="4" Text="Difference / Status" Foreground="{DynamicResource TextSecondaryBrush}"/><StackPanel Grid.Row="4" Grid.Column="1" Orientation="Horizontal"><TextBlock Text="{Binding SelectedReconciliationRow.Difference, Mode=OneWay, StringFormat=N2}" FontWeight="SemiBold"/><TextBlock Text="  •  "/><TextBlock Text="{Binding SelectedReconciliationRow.Status, Mode=OneWay}" FontWeight="SemiBold"/></StackPanel>
                                            </Grid>
                                        </Border>

                                        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                                            <StackPanel>
                                                <TextBlock Text="Statement" FontWeight="SemiBold" Margin="0,0,0,6"/>
