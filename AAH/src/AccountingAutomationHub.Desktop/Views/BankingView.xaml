                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Skip" Width="70">
                                <DataGridTemplateColumn.CellTemplate><DataTemplate><Button Content="Skip" Click="ObSkip_Click" Padding="8,3"/></DataTemplate></DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <TextBlock Grid.Row="2" Text="SKIPPED" FontWeight="Bold" Margin="4,8,0,4"/>
