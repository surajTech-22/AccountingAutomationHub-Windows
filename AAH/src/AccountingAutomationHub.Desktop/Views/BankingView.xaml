                                                <TextBlock Text="Opening Balance (Books: positive Dr / negative Cr)" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                <TextBox Text="{Binding SelectedStatement.OpeningBalance, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, StringFormat=N2}" Margin="0,4,0,8"/>
                                                <TextBlock Text="Closing Balance (Books: positive Dr / negative Cr)" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                <TextBox Text="{Binding SelectedStatement.ClosingBalance, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, StringFormat=N2}" Margin="0,4,0,8"/>
                                                <TextBlock Text="Books Debit / Credit movements" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                <TextBlock Margin="0,4,0,0"><Run Text="{Binding SelectedReconciliationRow.BooksDebitMovements, Mode=OneWay, StringFormat=N2}"/><Run Text="  /  "/><Run Text="{Binding SelectedReconciliationRow.BooksCreditMovements, Mode=OneWay, StringFormat=N2}"/></TextBlock>
                                            </StackPanel>
                                        </ScrollViewer>

                                        <WrapPanel Grid.Row="3" Margin="0,14,0,0">
                                            <Button Content="Use Suggested Opening" Command="{Binding UseSuggestedOpeningCommand}" Margin="0,0,8,8" Padding="10,6"/>
                                            <Button Content="Verify &amp; Save" Command="{Binding VerifyStatementCommand}" Margin="0,0,8,8" Padding="10,6"/>
                                            <Button Content="Skip" Command="{Binding SkipStatementCommand}" Margin="0,0,8,8" Padding="10,6"/>
                                            <Button Content="Delete Statement" Command="{Binding DeleteStatementCommand}" Margin="0,0,0,8" Padding="10,6"/>
                                        </WrapPanel>
                                    </Grid>
                                </Border>
                            </Grid>
                        </TabItem>

                        <TabItem Header="Transfer Matches">
                            <Grid Margin="6">
                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                                <Border Padding="10" Margin="0,0,0,8" Background="#F5F8FC" CornerRadius="8" BorderBrush="#D8E0EB" BorderThickness="1">
                                    <DockPanel LastChildFill="False">
                                        <StackPanel DockPanel.Dock="Left"><TextBlock Text="Transfer Reconciliation" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="Exact Inter-Bank pairs from imported statements and converted live Tally Bank/OD/Secured Loan transactions. For Imported↔Tally, the existing Inter-Bank result is applied to the same Tally MASTERID as Contra and live-verified; the imported duplicate is then retired and exact closing-balance reconciliation is the final step. If that final balance gate fails, the imported row is restored." Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/></StackPanel>
                                        <Button DockPanel.Dock="Right" Content="Match Exact Interbank Transfers" Command="{Binding MatchTransfersCommand}" Padding="12,7"/>
                                    </DockPanel>
                                </Border>
                                <DataGrid Grid.Row="1" ItemsSource="{Binding TransferMatches}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False">
