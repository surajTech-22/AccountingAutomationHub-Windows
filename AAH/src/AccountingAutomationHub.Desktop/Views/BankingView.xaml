                                <DataGrid Grid.Row="1" ItemsSource="{Binding ReconciliationRows}" SelectedItem="{Binding SelectedReconciliationRow, Mode=TwoWay}"
                                          AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False" SelectionUnit="FullRow">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Account" Binding="{Binding AccountName, Mode=OneWay}" Width="*" MinWidth="220"/>
                                        <DataGridTextColumn Header="Period" Binding="{Binding PeriodLabel, Mode=OneWay}" Width="190"/>
                                        <DataGridTextColumn Header="Suggested Opening (Books)" Binding="{Binding SuggestedOpeningBalanceText, Mode=OneWay}" Width="150"/>
                                        <DataGridTextColumn Header="Opening (Books)" Binding="{Binding OpeningBalanceText, Mode=OneWay}" Width="135"/>
                                        <DataGridTextColumn Header="Books Debit (Stmt Credit)" Binding="{Binding BooksDebitMovements, Mode=OneWay, StringFormat=N2}" Width="155"/>
                                        <DataGridTextColumn Header="Books Credit (Stmt Debit)" Binding="{Binding BooksCreditMovements, Mode=OneWay, StringFormat=N2}" Width="155"/>
                                        <DataGridTextColumn Header="Expected Closing (Books)" Binding="{Binding ExpectedClosingBalanceText, Mode=OneWay}" Width="165"/>
                                        <DataGridTextColumn Header="Statement Closing (Books)" Binding="{Binding StatementClosingBalanceText, Mode=OneWay}" Width="165"/>
                                        <DataGridTextColumn Header="Difference" Binding="{Binding Difference, Mode=OneWay, StringFormat=N2}" Width="105"/>
                                        <DataGridTextColumn Header="Status" Binding="{Binding Status, Mode=OneWay}" Width="170"/>
