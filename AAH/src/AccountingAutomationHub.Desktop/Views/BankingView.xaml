<UserControl x:Class="AccountingAutomationHub.Desktop.Views.BankingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sys="clr-namespace:System;assembly=System.Runtime"
             xmlns:controls="clr-namespace:AccountingAutomationHub.Desktop.Controls"
             xmlns:behaviors="clr-namespace:AccountingAutomationHub.Desktop.Behaviors"
             MinWidth="900" MinHeight="620">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <Style x:Key="BankingSummaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Stretch"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <!-- Do not let the Windows Button theme paint the summary card blue when
                 it is hovered/pressed/selected. The card itself owns all visuals. -->
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="BankingMappingProgressFillStyle" TargetType="ProgressBar">
            <Setter Property="Background" Value="#ECFDF3"/>
            <Setter Property="Foreground" Value="#86EFAC"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid x:Name="PART_Track" Background="{TemplateBinding Background}">
                            <Border x:Name="PART_Indicator" Background="{TemplateBinding Foreground}" HorizontalAlignment="Left"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Use the normal application ComboBox chrome.  The previous release wrapped a
             custom rounded surface inside a default ToggleButton, which produced the
             double-boxed filter appearance visible on Windows. -->
        <Style x:Key="FlatFilterComboBoxStyle" TargetType="{x:Type ComboBox}">
            <Setter Property="MinHeight" Value="28"/>
            <Setter Property="MinWidth" Value="82"/>
            <Setter Property="Padding" Value="7,2"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#C8D1DE"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="IsEditable" Value="False"/>
            <Setter Property="IsTextSearchEnabled" Value="True"/>
            <Setter Property="MaxDropDownHeight" Value="320"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <EventSetter Event="PreviewMouseWheel" Handler="FilterComboBox_PreviewMouseWheel"/>
            <EventSetter Event="PreviewKeyDown" Handler="FilterComboBox_PreviewKeyDown"/>
        </Style>

        <Style x:Key="FilterableDataGridColumnHeaderStyle" TargetType="DataGridColumnHeader">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="ContentTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <Grid ClipToBounds="True" MinWidth="0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0"
                                       Text="{Binding RelativeSource={RelativeSource AncestorType={x:Type DataGridColumnHeader}}, Path=Column.(behaviors:DataGridColumnFilterBehavior.TotalText)}"
                                       ToolTip="{Binding RelativeSource={RelativeSource AncestorType={x:Type DataGridColumnHeader}}, Path=Column.(behaviors:DataGridColumnFilterBehavior.TotalText)}"
                                       FontSize="10" FontWeight="SemiBold" HorizontalAlignment="Stretch" TextAlignment="Right"
                                       TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"
                                       Foreground="{DynamicResource AccentBrush}" Margin="0,0,0,2">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Visible"/>
                                        <Style.Triggers>
                                            <Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed"/></Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <DockPanel Grid.Row="1" LastChildFill="True" ClipToBounds="True">
                                <Button DockPanel.Dock="Right" Content="▾" Width="19" Height="20" Padding="0" Margin="5,0,0,0"
                                        Background="Transparent" BorderThickness="0" Foreground="{DynamicResource TextSecondaryBrush}"
                                        Focusable="False" Cursor="Hand" Click="GridHeaderFilter_Click" ToolTip="Filter by values in this column"/>
                                <TextBlock Text="{Binding}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                            </DockPanel>
                        </Grid>
                    </DataTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="MappingSelectorStyle" TargetType="{x:Type controls:SuggestTextBox}">
            <Setter Property="MinHeight" Value="31"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="Padding" Value="7,2"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#C9D4E2"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style x:Key="LedgerMappingCellStyle" TargetType="DataGridCell">
            <Setter Property="Padding" Value="2"/>
            <Setter Property="BorderBrush" Value="#E3E9F1"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#EAF2FB"/>
                    <Setter Property="Foreground" Value="#1F2937"/>
                </Trigger>
                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                    <Setter Property="BorderBrush" Value="#4A86C5"/>
                    <Setter Property="BorderThickness" Value="1"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Background="{DynamicResource AppBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Margin="20,16,20,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Banking" FontSize="24" FontWeight="SemiBold"/>
                <TextBlock Text="Excel, CSV, PDF and scanned/image Bank Statements, account balances, transfer reconciliation, ledger mapping and workbook authority reports"
                           Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,0"/>
            </StackPanel>
            <WrapPanel Grid.Column="1" HorizontalAlignment="Right">
                <Button Content="Import Excel / CSV" Command="{Binding ImportBankStatementsCommand}" Margin="5" Padding="14,8"/>
                <Button Content="Import PDF / Images (Advanced OCR)" Command="{Binding ImportPdfStatementsCommand}" Margin="5" Padding="14,8"/>
                <Button Content="Refresh" Command="{Binding RefreshCommand}" Margin="5" Padding="14,8"/>
            </WrapPanel>
        </Grid>

        <UniformGrid Grid.Row="1" Columns="5" Margin="20,0,20,10">
            <Button Command="{Binding OpenBankAccountsCommand}" Style="{StaticResource BankingSummaryButtonStyle}" ToolTip="Open bank rename and Master ledger details">
                <Border Margin="4" Padding="12" BorderBrush="#D8DEE9" BorderThickness="1" CornerRadius="8">
                    <Grid>
                        <StackPanel>
                            <TextBlock Text="{Binding AccountCount, Mode=OneWay}" FontSize="22"/>
                            <TextBlock Text="Bank Accounts" Foreground="{DynamicResource TextSecondaryBrush}"/>
                            <TextBlock Text="{Binding MissingStatementPeriodCount, Mode=OneWay, StringFormat={}{0} missing period(s)}"
                                       FontSize="9" Foreground="#B91C1C" Margin="0,3,0,0"
                                       Visibility="{Binding HasBankAccountPeriodWarnings, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                            <TextBlock Text="{Binding BankAccountPeriodWarningSummaryText, Mode=OneWay}"
                                       FontSize="8" Foreground="#B91C1C" Margin="0,2,24,0" TextWrapping="Wrap" MaxHeight="34"
                                       Visibility="{Binding HasBankAccountPeriodWarnings, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                        </StackPanel>
                        <Border HorizontalAlignment="Right" VerticalAlignment="Top" Width="18" Height="18" CornerRadius="9"
                                Background="#FEE2E2" BorderBrush="#DC2626" BorderThickness="1"
                                ToolTip="{Binding BankAccountPeriodWarningText}"
                                Visibility="{Binding HasBankAccountPeriodWarnings, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBlock Text="!" Foreground="#B91C1C" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </Grid>
                </Border>
            </Button>
            <Button Command="{Binding OpenBankStatementCommand}" Style="{StaticResource BankingSummaryButtonStyle}" ToolTip="Open Bank Statement">
                <Border Margin="4" Padding="12" BorderBrush="#D8DEE9" BorderThickness="1" CornerRadius="8">
                    <StackPanel><TextBlock Text="{Binding TransactionCount, Mode=OneWay}" FontSize="22"/><TextBlock Text="Transactions" Foreground="{DynamicResource TextSecondaryBrush}"/></StackPanel>
                </Border>
            </Button>
            <Button Command="{Binding OpenLedgerMappingCommand}" Style="{StaticResource BankingSummaryButtonStyle}" ToolTip="Open Ledger Mapping - Pending / Completed" Visibility="{Binding CanViewLedgerMapping, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Border Margin="4" Padding="0" BorderBrush="#B7E4C7" BorderThickness="1" CornerRadius="8" ClipToBounds="True" Background="#F1F5F9" ToolTip="Soft neutral = unresolved; light green = Ready; stronger green = completed/mapped transaction coverage.">
                    <Grid>
                        <!-- Three-state mapping progress: soft neutral = unresolved base,
                             light green = Ready (including mapped), stronger green = Mapped.
                             The dark mapped layer sits on top of the ready layer. -->
                        <ProgressBar Minimum="0" Maximum="100" Value="{Binding MappingReadyPercent, Mode=OneWay}"
                                     Style="{StaticResource BankingMappingProgressFillStyle}" IsHitTestVisible="False"
                                     Background="#F1F5F9" Foreground="#DCFCE7"
                                     HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
                        <ProgressBar Minimum="0" Maximum="100" Value="{Binding MappingCompletionPercent, Mode=OneWay}"
                                     Style="{StaticResource BankingMappingProgressFillStyle}" IsHitTestVisible="False"
                                     Background="Transparent" Foreground="#86EFAC"
                                     HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
                        <StackPanel Margin="12">
                            <TextBlock Text="{Binding PendingMappingCount, Mode=OneWay}" FontSize="22" FontWeight="SemiBold"/>
                            <TextBlock Text="Pending Mapping" Foreground="{DynamicResource TextSecondaryBrush}"/>
                            <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                <TextBlock Text="{Binding CompletedMappingCount, Mode=OneWay}" FontWeight="SemiBold"/>
                                <TextBlock Text=" completed" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                <TextBlock Text="  •  "/>
                                <TextBlock Text="{Binding ReadyMappingCount, Mode=OneWay}" FontWeight="SemiBold" Foreground="#15803D"/>
                                <TextBlock Text=" ready" Foreground="#15803D"/>
                            </StackPanel>
                            <TextBlock FontSize="10" Foreground="#15803D">
                                <Run Text="{Binding MappingCompletionPercent, Mode=OneWay, StringFormat={}{0:0}% mapped}"/>
                                <Run Text=" • "/>
                                <Run Text="{Binding MappingReadyPercent, Mode=OneWay, StringFormat={}{0:0}% ready/mapped}"/>
                            </TextBlock>
                        </StackPanel>
                    </Grid>
                </Border>
            </Button>
            <Button Command="{Binding OpenBalanceReviewCommand}" Style="{StaticResource BankingSummaryButtonStyle}" ToolTip="Open Balance Review">
                <Border Margin="4" Padding="12" BorderBrush="#D8DEE9" BorderThickness="1" CornerRadius="8">
                    <StackPanel><TextBlock Text="{Binding ReconciliationIssueCount, Mode=OneWay}" FontSize="22"/><TextBlock Text="Balance Review" Foreground="{DynamicResource TextSecondaryBrush}"/></StackPanel>
                </Border>
            </Button>
            <Border x:Name="BankBalanceSnapshotBorder" Margin="4" Padding="9" BorderBrush="#D8DEE9" BorderThickness="1" CornerRadius="8" Focusable="True"
                    Loaded="BankBalanceSnapshot_Loaded" PreviewKeyDown="BankBalanceSnapshot_PreviewKeyDown" PreviewMouseWheel="BankBalanceSnapshot_PreviewMouseWheel"
                    ToolTip="Balance Snapshot. Use the arrows, mouse wheel, or Left/Right/Home/End keys here to move between bank accounts.">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Button x:Name="BankBalancePreviousButton" Grid.Column="0" Content="&#x25C0;" Width="24" Height="22" Padding="0" Margin="0,0,5,0"
                                Click="BankBalancePrevious_Click" ToolTip="Previous bank account"/>
                        <TextBlock Grid.Column="1" Text="Balance Snapshot" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <TextBlock x:Name="BankBalanceAccountPositionText" Grid.Column="2" MinWidth="34" TextAlignment="Right" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextSecondaryBrush}" FontSize="9" Margin="4,0"/>
                        <Button x:Name="BankBalanceNextButton" Grid.Column="3" Content="&#x25B6;" Width="24" Height="22" Padding="0" Margin="5,0,0,0"
                                Click="BankBalanceNext_Click" ToolTip="Next bank account"/>
                    </Grid>
                    <TextBlock Text="{Binding BankBalanceAccountName}" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis" Margin="0,2,0,4"/>
                    <Grid Margin="0,1,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Padding="5" BorderBrush="#E1E7EF" BorderThickness="1" CornerRadius="4">
                            <StackPanel>
                                <TextBlock Text="BALANCE VERIFICATION" FontSize="8" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                <TextBlock FontSize="9" Margin="0,2,0,0"><Run Text="Tally OB  "/><Run Text="{Binding BankTallyOpeningBalanceText, Mode=OneWay}" FontWeight="SemiBold"/></TextBlock>
                                <TextBlock FontSize="9" Margin="0,1,0,0"><Run Text="Imported Calc CB  "/><Run Text="{Binding BankCalculatedClosingBalanceText, Mode=OneWay}" FontWeight="SemiBold"/></TextBlock>
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="2" Padding="5" BorderBrush="#E1E7EF" BorderThickness="1" CornerRadius="4">
                            <StackPanel>
                                <TextBlock Text="STATEMENT ACTUALS" FontSize="8" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                <TextBlock FontSize="9" Margin="0,2,0,0"><Run Text="Actual OB  "/><Run Text="{Binding BankOriginalOpeningBalanceText, Mode=OneWay}" FontWeight="SemiBold"/></TextBlock>
                                <TextBlock FontSize="9" Margin="0,1,0,0"><Run Text="Actual CB  "/><Run Text="{Binding BankOriginalClosingBalanceText, Mode=OneWay}" FontWeight="SemiBold"/></TextBlock>
                            </StackPanel>
                        </Border>
                    </Grid>
                    <TextBlock FontSize="9" TextTrimming="CharacterEllipsis" Margin="0,3,0,0"><Run Text="Movement  "/><Run Text="{Binding BankMovementSummaryText, Mode=OneWay}"/></TextBlock>
                    <TextBlock Text="{Binding BankBalanceStatus}" FontSize="9" FontWeight="SemiBold" Margin="0,3,0,0" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>
        </UniformGrid>

        <Grid Grid.Row="2" Margin="20,0,20,8">
            <TabControl x:Name="BankingTabs" Margin="0"
                    SelectedIndex="{Binding SelectedBankingTabIndex, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    SelectionChanged="BankingTabs_SelectionChanged">
            <TabItem Header="Bank Statement">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <WrapPanel Margin="0,0,0,8" VerticalAlignment="Center">
                        <Button Content="Save Selected Transaction" Command="{Binding SaveTransactionCommand}" Margin="0,0,8,0" Padding="12,7"/>
                        <Button Content="Manual Cash Contra" Click="ManualCashContra_Click" Margin="0,0,8,0" Padding="12,7"
                                ToolTip="Select one or more Bank Statement rows. Opens a separate review panel before applying Contra."/>
                        <Button Content="Manual Inter-Bank Link" Click="ManualInterbankLink_Click" Margin="0,0,8,0" Padding="12,7"
                                ToolTip="Select exactly two rows from different bank accounts with the same date and amount. Narration is intentionally ignored."/>
                        <Button Content="Advanced Match" Click="AdvancedReconciliation_Click" Margin="0,0,10,0" Padding="12,7"
                                ToolTip="Preview and commit 1→many, many→1, partial or adjusted reconciliation groups using the selected Bank Statement rows."/>
                        <Button Content="Export Suspense" Command="{Binding ExportSuspenseCommand}" Margin="0,0,8,0" Padding="12,7"
                                ToolTip="Export active empty/Suspense Bank rows with permanent transaction IDs for bulk Ledger resolution."/>
                        <Button Content="Import Suspense" Command="{Binding ImportSuspenseCommand}" Margin="0,0,10,0" Padding="12,7"
                                ToolTip="Import only the yellow Ledger values from an AAH Suspense workbook. Transaction values are never overwritten."/>
                        <CheckBox Content="Include archived transfer counterparts" IsChecked="{Binding IncludeArchivedTransfers}" VerticalAlignment="Center" Margin="0,0,18,0"/>
                        <Button Click="EmptyLedgerExport_Click" Margin="0,0,18,0" Padding="12,7"
                                ToolTip="Open the Empty Ledger Export panel. Existing mapped Ledgers are never overwritten.">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Empty Ledger Export"/>
                                <TextBlock Text="  •  "/>
                                <TextBlock Text="{Binding EmptyLedgerFullStatementCount, Mode=OneWay, StringFormat={}{0:N0} empty}" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Button>
                        <TextBlock Text="Dates" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <RadioButton Content="Full Statement" GroupName="BankStatementDateScope" Style="{StaticResource SegmentedRadioButtonStyle}"
                                     IsChecked="{Binding IsBankStatementFullStatement, Mode=TwoWay}" Margin="0,0,3,0"/>
                        <RadioButton Content="Tally Export Dates" GroupName="BankStatementDateScope" Style="{StaticResource SegmentedRadioButtonStyle}"
                                     IsChecked="{Binding IsBankStatementTallyExportDates, Mode=TwoWay}" Margin="0,0,14,0"/>
                        <TextBlock Text="Visible" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding BankStatementVisibleCount, Mode=OneWay}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="6,0,14,0"/>
                        <TextBlock Text="Filter" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <ComboBox ItemsSource="{Binding BankStatementFilterColumns}"
                                  SelectedItem="{Binding BankStatementFilterColumn, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                  Style="{StaticResource FlatFilterComboBoxStyle}" Width="135" Margin="0,0,6,0"/>
                        <TextBox Text="{Binding BankStatementFilterText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 Width="230" MinHeight="28" Padding="7,3" Margin="0,0,6,0"
                                 VerticalContentAlignment="Center" ToolTip="Contains filter for the selected Bank Statement column"/>
                        <Button Content="Clear Filter" Click="BankStatementClearFilter_Click" Padding="10,5" Margin="0,0,6,0"/>
                        <Button Content="Clear Sort" Click="BankStatementClearSort_Click" Padding="10,5" Margin="0,0,6,0"/>
                        <Button Content="Clear Sort &amp; Filter" Click="BankStatementClearSortFilter_Click" Padding="10,5"/>
                    </WrapPanel>
                    <DataGrid x:Name="BankStatementGrid"
                              Grid.Row="1"
                              ItemsSource="{Binding FilteredTransactions}"
                              SelectedItem="{Binding SelectedTransaction}"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              IsReadOnly="False"
                              SelectionUnit="FullRow"
                              SelectionMode="Extended"
                              ColumnHeaderStyle="{StaticResource FilterableDataGridColumnHeaderStyle}"
                              FrozenColumnCount="1"
                              EnableRowVirtualization="True"
                              EnableColumnVirtualization="True"
                              VirtualizingPanel.VirtualizationMode="Recycling"
                              ScrollViewer.CanContentScroll="True"
                              Loaded="BankStatementGrid_Loaded"
                              BeginningEdit="BankStatementGrid_BeginningEdit"
                              RowEditEnding="BankStatementGrid_RowEditEnding">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Date" Binding="{Binding TransactionDate, Mode=OneWay, StringFormat=dd.MM.yyyy}" IsReadOnly="True" Width="Auto" MinWidth="95" MaxWidth="125"/>
                            <DataGridTextColumn Header="Narration" Binding="{Binding Narration, Mode=OneWay}" IsReadOnly="True" Width="*" MinWidth="300"/>
                            <DataGridTextColumn Header="Debit" Binding="{Binding Debit, Mode=OneWay, StringFormat=N2}" IsReadOnly="True" Width="Auto" MinWidth="105" MaxWidth="145"/>
                            <DataGridTextColumn Header="Credit" Binding="{Binding Credit, Mode=OneWay, StringFormat=N2}" IsReadOnly="True" Width="Auto" MinWidth="105" MaxWidth="145"/>
                            <DataGridTextColumn Header="Running Balance" Binding="{Binding RunningBalance, Mode=OneWay, StringFormat=N2}" IsReadOnly="True" Width="Auto" MinWidth="125" MaxWidth="165"/>
                            <DataGridTemplateColumn Header="Mode" IsReadOnly="True" Width="Auto" MinWidth="110" MaxWidth="145">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate><TextBlock Text="{Binding Mode, Mode=OneWay}" Padding="4,2"/></DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                                <DataGridTemplateColumn.CellEditingTemplate>
                                    <DataTemplate>
                                        <ComboBox ItemsSource="{Binding DataContext.BankModes, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                  SelectedItem="{Binding Mode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellEditingTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Ledger" Width="Auto" MinWidth="190" MaxWidth="360">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate><TextBlock Text="{Binding LedgerName, Mode=OneWay}" Padding="4,2"/></DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                                <DataGridTemplateColumn.CellEditingTemplate>
                                    <DataTemplate>
                                        <controls:SearchableComboBox SourceItems="{Binding DataContext.MasterLedgerNames, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                                             Text="{Binding LedgerName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                             AllowCustomText="False" OpenOnFocus="True" EnableMouseWheelSelection="False"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellEditingTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Bank" Binding="{Binding BankAccountName, Mode=OneWay}" IsReadOnly="True" Width="Auto" MinWidth="240" MaxWidth="420"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <StackPanel Grid.Row="2" Margin="2,8,0,0">
                        <TextBlock Text="{Binding BankStatementDateScopeText, Mode=OneWay}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="10" TextWrapping="Wrap" Margin="0,0,0,5"/>
                        <Expander Header="Last Import Review" IsExpanded="False">
                            <DataGrid ItemsSource="{Binding ImportIssues}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" MaxHeight="170" Margin="0,6,0,4">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Code" Binding="{Binding ErrorCodeText, Mode=OneWay}" Width="65"/>
                                    <DataGridTextColumn Header="Source File" Binding="{Binding SourceFile, Mode=OneWay}" Width="210"/>
                                    <DataGridTextColumn Header="Stage" Binding="{Binding Stage, Mode=OneWay}" Width="145"/>
                                    <DataGridTextColumn Header="Friendly Error" Binding="{Binding FriendlyMessage, Mode=OneWay}" Width="180"/>
                                    <DataGridTextColumn Header="Technical Details" Binding="{Binding TechnicalMessage, Mode=OneWay}" Width="*"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Expander>
                        <TextBlock Text="The visible Bank Statement remains Date, Narration, Debit, Credit, Mode, Ledger and Bank. Source evidence stays in the named authority reports."
                                   Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                    </StackPanel>
                </Grid>
            </TabItem>

            <TabItem Header="Accounts &amp; Statements">
                <Grid Margin="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="0.8*" MinWidth="300"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="1.7*" MinWidth="560"/>
                    </Grid.ColumnDefinitions>

                    <GroupBox Header="Bank Accounts">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                            <Border Margin="8" Padding="10" Background="#F5F8FC" CornerRadius="6">
                                <TextBlock Text="Select the Bank Accounts summary card to open the separate rename and Master ledger panel."
                                           Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                            </Border>
                            <DataGrid Grid.Row="1" ItemsSource="{Binding Accounts}" SelectedItem="{Binding SelectedAccount, Mode=TwoWay}"
                                      AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" SelectionUnit="FullRow" Margin="8,0,8,8">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Bank" Binding="{Binding BankName, Mode=OneWay}" Width="*" MinWidth="150"/>
                                    <DataGridTextColumn Header="Type" Binding="{Binding AccountType, Mode=OneWay}" Width="70"/>
                                    <DataGridTextColumn Header="Account" Binding="{Binding AccountNumber, Mode=OneWay}" Width="140"/>
                                    <DataGridTextColumn Header="Master Ledger" Binding="{Binding LedgerName, Mode=OneWay}" Width="220"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </GroupBox>

                    <GroupBox Grid.Column="2" Header="Statement Registry and Opening/Closing Balance Verification">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                            <WrapPanel Margin="8">
                                <Button Content="Use Suggested Opening" Command="{Binding UseSuggestedOpeningCommand}" Margin="0,0,8,0" Padding="10,6"/>
                                <Button Content="Verify &amp; Save Balances" Command="{Binding VerifyStatementCommand}" Margin="0,0,8,0" Padding="10,6"/>
                                <Button Content="Skip Balance Review" Command="{Binding SkipStatementCommand}" Margin="0,0,8,0" Padding="10,6"/>
                                <Button Content="Delete Selected Statement" Command="{Binding DeleteStatementCommand}" Padding="10,6"/>
