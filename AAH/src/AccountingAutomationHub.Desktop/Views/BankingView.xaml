                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Account" Binding="{Binding Account, Mode=OneWay}" Width="220"/>
                                    <DataGridTextColumn Header="Overall OB" Binding="{Binding OverallOb, Mode=OneWay, StringFormat=N2}" Width="125"/>
                                    <DataGridTextColumn Header="Overall CB" Binding="{Binding OverallCb, Mode=OneWay, StringFormat=N2}" Width="125"/>
                                    <DataGridTextColumn Header="Calculated CB" Binding="{Binding CalculatedCb, Mode=OneWay, StringFormat=N2}" Width="125"/>
                                    <DataGridTextColumn Header="Difference" Binding="{Binding Difference, Mode=OneWay, StringFormat=N2}" Width="110"/>
                                    <DataGridTextColumn Header="Missing Periods" Binding="{Binding MissingPeriods, Mode=OneWay}" Width="230"/>
                                    <DataGridTextColumn Header="Overlaps" Binding="{Binding OverlapPeriods, Mode=OneWay}" Width="210"/>
                                    <DataGridTextColumn Header="Statements" Binding="{Binding Statements, Mode=OneWay}" Width="100"/>
                                    <DataGridTextColumn Header="Fail Count" Binding="{Binding FailCount, Mode=OneWay}" Width="100"/>
                                    <DataGridTextColumn Header="Status" Binding="{Binding Status, Mode=OneWay}" Width="100"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </TabItem>

                    <TabItem Header="Duplicate_Report">
                        <DataGrid Margin="6" ItemsSource="{Binding DuplicateReport}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Transaction_ID" Binding="{Binding TransactionId, Mode=OneWay}" Width="160"/>
                                <DataGridTextColumn Header="Account_Number" Binding="{Binding AccountNumber, Mode=OneWay}" Width="230"/>
                                <DataGridTextColumn Header="Duplicate_Of" Binding="{Binding DuplicateOf, Mode=OneWay}" Width="200"/>
                                <DataGridTextColumn Header="Status" Binding="{Binding Status, Mode=OneWay}" Width="120"/>
                                <DataGridTextColumn Header="Account OB" Binding="{Binding AccountOpeningBalance, Mode=OneWay, StringFormat=N2}" Width="115"/>
                                <DataGridTextColumn Header="Account CB" Binding="{Binding AccountClosingBalance, Mode=OneWay, StringFormat=N2}" Width="115"/>
                                <DataGridTextColumn Header="Balance Status" Binding="{Binding AccountBalanceStatus, Mode=OneWay}" Width="170"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </TabItem>

                    <TabItem Header="Registry_Report">
                        <DataGrid Margin="6" ItemsSource="{Binding RegistryReport}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" HorizontalAlignment="Left" Width="520">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Metric" Binding="{Binding Metric, Mode=OneWay}" Width="280"/>
                                <DataGridTextColumn Header="Value" Binding="{Binding Value, Mode=OneWay}" Width="220"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </TabItem>

                    <TabItem Header="Integrity_Report">
                        <DataGrid Margin="6" ItemsSource="{Binding IntegrityReport}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" HorizontalAlignment="Left" Width="620">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Check" Binding="{Binding Check, Mode=OneWay}" Width="360"/>
                                <DataGridTextColumn Header="Result" Binding="{Binding Result, Mode=OneWay}" Width="240"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </TabItem>

                    <TabItem Header="Import_Log">
                        <DataGrid Margin="6" ItemsSource="{Binding ImportLogReport}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Timestamp" Binding="{Binding Timestamp, Mode=OneWay, StringFormat=M/d/yy H:mm}" Width="145"/>
                                <DataGridTextColumn Header="File Name" Binding="{Binding FileName, Mode=OneWay}" Width="250"/>
                                <DataGridTextColumn Header="Bank Name" Binding="{Binding BankName, Mode=OneWay}" Width="170"/>
                                <DataGridTextColumn Header="Account Number" Binding="{Binding AccountNumber, Mode=OneWay}" Width="150"/>
                                <DataGridTextColumn Header="Rows Imported" Binding="{Binding RowsImported, Mode=OneWay}" Width="110"/>
                                <DataGridTextColumn Header="Opening Balance" Binding="{Binding OpeningBalance, Mode=OneWay, StringFormat=N2}" Width="125"/>
                                <DataGridTextColumn Header="Closing Balance" Binding="{Binding ClosingBalance, Mode=OneWay, StringFormat=N2}" Width="125"/>
                                <DataGridTextColumn Header="Balance Status" Binding="{Binding BalanceStatus, Mode=OneWay}" Width="170"/>
                                <DataGridTextColumn Header="Missing Periods" Binding="{Binding MissingPeriods, Mode=OneWay}" Width="230"/>
                                <DataGridTextColumn Header="Status" Binding="{Binding Status, Mode=OneWay}" Width="130"/>
                                <DataGridTextColumn Header="Notes" Binding="{Binding Notes, Mode=OneWay}" Width="*" MinWidth="300"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </TabItem>

                    <TabItem Header="Balance_Authority">
                        <DataGrid Margin="6" ItemsSource="{Binding BalanceAuthorityReport}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Account" Binding="{Binding Account, Mode=OneWay}" Width="240"/>
                                <DataGridTextColumn Header="Opening Balance" Binding="{Binding OpeningBalance, Mode=OneWay, StringFormat=N2}" Width="125"/>
                                <DataGridTextColumn Header="OB Source" Binding="{Binding OpeningSource, Mode=OneWay}" Width="125"/>
                                <DataGridTextColumn Header="Closing Balance" Binding="{Binding ClosingBalance, Mode=OneWay, StringFormat=N2}" Width="125"/>
                                <DataGridTextColumn Header="CB Source" Binding="{Binding ClosingSource, Mode=OneWay}" Width="125"/>
                                <DataGridTextColumn Header="Calculated CB" Binding="{Binding CalculatedClosingBalance, Mode=OneWay, StringFormat=N2}" Width="125"/>
                                <DataGridTextColumn Header="Difference" Binding="{Binding Difference, Mode=OneWay, StringFormat=N2}" Width="110"/>
                                <DataGridTextColumn Header="Total Debits" Binding="{Binding TotalDebits, Mode=OneWay, StringFormat=N2}" Width="120"/>
                                <DataGridTextColumn Header="Total Credits" Binding="{Binding TotalCredits, Mode=OneWay, StringFormat=N2}" Width="120"/>
                                <DataGridTextColumn Header="Statements" Binding="{Binding StatementCount, Mode=OneWay}" Width="95"/>
                                <DataGridTextColumn Header="Missing Periods" Binding="{Binding MissingPeriods, Mode=OneWay}" Width="250"/>
                                <DataGridTextColumn Header="Overlaps" Binding="{Binding OverlapPeriods, Mode=OneWay}" Width="220"/>
                                <DataGridTextColumn Header="Status" Binding="{Binding Status, Mode=OneWay}" Width="190"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </TabItem>

                    <TabItem Header="Import_Performance_Log">
                        <DataGrid Margin="6" ItemsSource="{Binding ImportPerformanceLogReport}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="RecordType" Binding="{Binding RecordType, Mode=OneWay}" Width="120"/>
                                <DataGridTextColumn Header="DateTime" Binding="{Binding DateTime, Mode=OneWay, StringFormat=M/d/yy H:mm}" Width="145"/>
                                <DataGridTextColumn Header="Name" Binding="{Binding Name, Mode=OneWay}" Width="240"/>
                                <DataGridTextColumn Header="Value1" Binding="{Binding Value1, Mode=OneWay}" Width="110"/>
                                <DataGridTextColumn Header="Value2" Binding="{Binding Value2, Mode=OneWay}" Width="110"/>
                                <DataGridTextColumn Header="Value3" Binding="{Binding Value3, Mode=OneWay}" Width="110"/>
                                <DataGridTextColumn Header="Value4" Binding="{Binding Value4, Mode=OneWay}" Width="110"/>
                                <DataGridTextColumn Header="Notes" Binding="{Binding Notes, Mode=OneWay}" Width="*" MinWidth="260"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </TabItem>


                </TabControl>
            </TabItem>
            </TabControl>
        </Grid>

        <Border Grid.Row="3" Margin="20,0,20,14" Padding="10,7" Background="#EEF3F8" CornerRadius="6">
            <TextBlock Text="{Binding StatusText, Mode=OneWay}" TextWrapping="Wrap"/>
        </Border>

        <Grid Grid.RowSpan="4" Panel.ZIndex="100" Background="#70000000"
              Visibility="{Binding IsBankAccountPopupOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Border Width="1080" MaxWidth="1080" MaxHeight="720" Margin="28" HorizontalAlignment="Center" VerticalAlignment="Center"
                    Background="White" BorderBrush="#C9D4E3" BorderThickness="1" CornerRadius="12">
                <Border.Effect><DropShadowEffect BlurRadius="28" ShadowDepth="3" Opacity="0.30"/></Border.Effect>
                <Grid Margin="20">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <DockPanel LastChildFill="False" Margin="0,0,0,14">
                        <StackPanel DockPanel.Dock="Left">
                            <TextBlock Text="Bank Accounts" FontSize="22" FontWeight="SemiBold"/>
                            <TextBlock Text="Rename bank ledgers or review Missing Periods bank-wise." Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,3,0,0"/>
                        </StackPanel>
                        <Button DockPanel.Dock="Right" Content="Close" Command="{Binding CloseBankAccountPopupCommand}" Padding="14,7"/>
                    </DockPanel>

                    <TabControl Grid.Row="1">
                        <TabItem Header="Bank Rename">
                            <Grid Margin="12">
                                <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="0.9*" MinWidth="300"/><ColumnDefinition Width="16"/><ColumnDefinition Width="1.5*" MinWidth="520"/></Grid.ColumnDefinitions>
                                <DataGrid ItemsSource="{Binding Accounts}" SelectedItem="{Binding SelectedAccount, Mode=TwoWay}"
                                          AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False" SelectionUnit="FullRow">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Bank Ledger" Binding="{Binding BankAccountListName, Mode=OneWay}" Width="*" MinWidth="220">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                                    <Setter Property="ToolTip" Value="{Binding RenameHistoryToolTip}"/>
                                                </Style>
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>
                                        <DataGridTextColumn Header="Account" Binding="{Binding AccountNumber, Mode=OneWay}" Width="125"/>
                                        <DataGridTextColumn Header="Opening" Binding="{Binding OpeningBalanceText, Mode=OneWay}" Width="120"/>
                                        <DataGridTextColumn Header="Closing" Binding="{Binding ClosingBalanceText, Mode=OneWay}" Width="120"/>
                                    </DataGrid.Columns>
                                </DataGrid>

                                <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                                    <StackPanel>
                                        <Border Padding="14" Background="#F5F8FC" CornerRadius="8" Margin="0,0,0,12">
                                            <Grid>
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="145"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                                <TextBlock Text="Current Ledger Name" VerticalAlignment="Center" Margin="0,0,8,8"/>
                                                <TextBox Grid.Column="1" Text="{Binding SelectedBankCurrentName, Mode=OneWay}" IsReadOnly="True" Margin="0,0,0,8"/>
                                                <TextBlock Grid.Row="1" Text="Existing Master" VerticalAlignment="Center" Margin="0,0,8,8"/>
                                                <ComboBox Grid.Row="1" Grid.Column="1" ItemsSource="{Binding BankLedgerRenameOptions}"
                                                          SelectedItem="{Binding SelectedBankRenameOption, Mode=TwoWay}" DisplayMemberPath="SuggestionDisplay"
                                                          IsEditable="False" MaxDropDownHeight="360"
                                                          ToolTip="Choose an existing Bank/OD/Cash Credit Ledger. The list shows Ledger Name, authority (Tally or Manual), and Ledger Group."
                                                          Margin="0,0,0,8"/>
                                                <TextBlock Grid.Row="2" Text="Rename To" VerticalAlignment="Center" Margin="0,0,8,8"/>
                                                <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding SelectedBankRename.RenameTo, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                         ToolTip="The selected existing Master is copied here. You can also type a new Bank Ledger name." Margin="0,0,0,8"/>
                                                <Button Grid.Row="3" Grid.Column="1" Content="Apply Rename" Command="{Binding ApplyBankRenameCommand}" HorizontalAlignment="Left" Padding="12,7"/>
                                            </Grid>
                                        </Border>

                                        <TextBlock Text="Bank Account Details" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                        <Grid Margin="0,0,0,14">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="145"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                            <TextBlock Text="Bank Name" VerticalAlignment="Center" Margin="0,0,8,8"/>
                                            <TextBox Grid.Column="1" Text="{Binding SelectedAccount.BankName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8"/>
                                            <TextBlock Grid.Row="1" Text="Account Type" VerticalAlignment="Center" Margin="0,0,8,8"/>
                                            <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding SelectedAccount.AccountType, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8"/>
                                            <TextBlock Grid.Row="2" Text="Account Number" VerticalAlignment="Center" Margin="0,0,8,8"/>
                                            <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding SelectedAccount.AccountNumber, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8"/>
                                            <TextBlock Grid.Row="3" Text="Branch" VerticalAlignment="Center" Margin="0,0,8,8"/>
                                            <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding SelectedAccount.BranchName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8"/>
                                            <TextBlock Grid.Row="4" Text="IFSC" VerticalAlignment="Center" Margin="0,0,8,8"/>
                                            <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding SelectedAccount.IfscCode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8"/>
                                            <TextBlock Grid.Row="5" Text="OD Limit" VerticalAlignment="Center" Margin="0,0,8,8"/>
                                            <TextBox Grid.Row="5" Grid.Column="1" Text="{Binding SelectedAccount.OdLimit, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, StringFormat=N2}" Margin="0,0,0,8"/>
                                            <TextBlock Grid.Row="6" Text="Drawing Power" VerticalAlignment="Center"/>
                                            <TextBox Grid.Row="6" Grid.Column="1" Text="{Binding SelectedAccount.DrawingPower, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, StringFormat=N2}"/>
                                        </Grid>

                                        <TextBlock Text="Master Ledger Details" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="145"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                            <TextBlock Text="Ledger Name" VerticalAlignment="Center" Margin="0,0,8,8"/>
                                            <TextBox Grid.Column="1" Text="{Binding SelectedBankMasterRecord.Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8"/>
                                            <TextBlock Grid.Row="1" Text="Parent Group" VerticalAlignment="Center" Margin="0,0,8,8"/>
                                            <controls:SearchableComboBox Grid.Row="1" Grid.Column="1" SourceItems="{Binding MasterGroupNames}" Text="{Binding SelectedBankMasterRecord.Parent, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                         AllowCustomText="False" OpenOnFocus="True" Margin="0,0,0,8"/>
                                            <TextBlock Grid.Row="2" Text="Master Type" VerticalAlignment="Center" Margin="0,0,8,8"/>
                                            <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding SelectedBankMasterRecord.Type, Mode=OneWay}" IsReadOnly="True" Margin="0,0,0,8"/>
                                            <TextBlock Grid.Row="3" Text="Company" VerticalAlignment="Center" Margin="0,0,8,8"/>
                                            <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding SelectedBankMasterRecord.Company, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8"/>
                                            <TextBlock Grid.Row="4" Text="Master Source" VerticalAlignment="Center"/>
                                            <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding SelectedBankMasterSourceDisplay, Mode=OneWay}" IsReadOnly="True"
                                                     ToolTip="Tally = imported/live Tally master. Manual = master created or maintained inside Accounting Automation Hub."/>
                                        </Grid>
                                    </StackPanel>
                                </ScrollViewer>

                                <DockPanel Grid.Row="1" Grid.ColumnSpan="3" LastChildFill="False" Margin="0,16,0,0">
                                    <TextBlock Text="Changes remain client and Financial Year specific." Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                    <Button DockPanel.Dock="Right" Content="Save Bank Account &amp; Master Ledger" Command="{Binding SaveAccountCommand}" Padding="16,8"/>
                                </DockPanel>
                            </Grid>
                        </TabItem>

                        <TabItem Header="Missing Periods">
                            <Grid Margin="16">
                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="Missing Periods by Bank" FontSize="16" FontWeight="SemiBold"/>
                                    <TextBlock Grid.Column="1" Margin="18,0,0,0" Text="{Binding MissingStatementPeriodCount, Mode=OneWay, StringFormat='{}{0} range(s)'}" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                </Grid>

                                <Grid Grid.Row="1">
                                    <TextBlock Text="No missing statement periods for the current coverage window." Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Top">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasBankAccountPeriodWarnings}" Value="False"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <ScrollViewer VerticalScrollBarVisibility="Auto" Visibility="{Binding HasBankAccountPeriodWarnings, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <ItemsControl ItemsSource="{Binding MissingPeriodBankGroups}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Padding="14" Margin="0,0,0,10" Background="#FFF7E6" BorderBrush="#F0C36D" BorderThickness="1" CornerRadius="8">
                                                        <StackPanel>
                                                            <TextBlock Text="{Binding BankName}" FontWeight="SemiBold" Margin="0,0,0,7"/>
                                                            <ItemsControl ItemsSource="{Binding Periods}">
                                                                <ItemsControl.ItemTemplate>
                                                                    <DataTemplate>
                                                                        <TextBlock Text="{Binding}" Margin="12,2,0,2"/>
                                                                    </DataTemplate>
                                                                </ItemsControl.ItemTemplate>
                                                            </ItemsControl>
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </Grid>
                            </Grid>
                        </TabItem>
                    </TabControl>
                </Grid>
            </Border>
        </Grid>

        <Border Grid.RowSpan="3" Panel.ZIndex="90" Visibility="{Binding IsManualCashContraMode, Converter={StaticResource BooleanToVisibilityConverter}}"
                Background="#66000000" Padding="34">
            <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10"
                    HorizontalAlignment="Center" VerticalAlignment="Center" Width="980" MaxWidth="1180" MaxHeight="720" Padding="18">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Manual Cash Contra" FontSize="20" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding ManualCashContraStepText}" Foreground="#235F9C" FontWeight="SemiBold" Margin="0,4,0,0"/>
                            <TextBlock Text="{Binding ManualCashContraStatusText}" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,3,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                        <Button Grid.Column="1" Content="Close" Command="{Binding CancelManualCashContraCommand}" Padding="12,6" VerticalAlignment="Top"/>
                    </Grid>
                    <Grid Grid.Row="1" Margin="0,14,0,10">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="280"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <TextBlock Text="Cash Ledger" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <ComboBox Grid.Column="1" ItemsSource="{Binding CashInHandLedgerNames}" SelectedItem="{Binding ManualCashContraLedger, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" MinHeight="30"/>
                        <TextBlock Grid.Column="2" Margin="14,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}">
                            <Run Text="Source: "/><Run Text="{Binding ManualCashContraSourceText, Mode=OneWay}" FontWeight="SemiBold"/><Run Text="  ·  Selected: "/><Run Text="{Binding ManualCashContraSelectedCount, Mode=OneWay}" FontWeight="SemiBold"/>
                        </TextBlock>
                    </Grid>
                    <DataGrid Grid.Row="2" ItemsSource="{Binding ManualCashContraPreviewRows}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                              SelectionMode="Extended" SelectionUnit="FullRow" EnableRowVirtualization="True" VirtualizingPanel.VirtualizationMode="Recycling">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Date" Binding="{Binding TransactionDate, StringFormat=dd.MM.yyyy}" Width="105"/>
                            <DataGridTextColumn Header="Bank" Binding="{Binding BankAccountName}" Width="180"/>
                            <DataGridTextColumn Header="Narration" Binding="{Binding Narration}" Width="*" MinWidth="260"/>
                            <DataGridTextColumn Header="Debit" Binding="{Binding Debit, StringFormat=N2}" Width="110"/>
                            <DataGridTextColumn Header="Credit" Binding="{Binding Credit, StringFormat=N2}" Width="110"/>
                            <DataGridTextColumn Header="Current Ledger" Binding="{Binding LedgerName}" Width="180"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                        <Button Content="Cancel" Command="{Binding CancelManualCashContraCommand}" Padding="14,7" Margin="0,0,8,0"/>
                        <Button Content="Apply Contra" Command="{Binding SaveManualCashContraCommand}" Padding="16,7"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Border>
    </Grid>
</UserControl>
