                                        <DataGridTextColumn Header="Date" Binding="{Binding MatchDate, Mode=OneWay, StringFormat=dd.MM.yyyy}" Width="95"/>
                                        <DataGridTextColumn Header="Transfer Amount" Binding="{Binding Amount, Mode=OneWay, StringFormat=N2}" Width="115"/>
                                        <DataGridTextColumn Header="Bank Charge" Binding="{Binding ChargeAmount, Mode=OneWay, StringFormat=N2}" Width="100"/>
                                        <DataGridTextColumn Header="Charge Rule" Binding="{Binding ChargeRule, Mode=OneWay}" Width="220"/>
                                        <DataGridTextColumn Header="Reference" Binding="{Binding ReferenceNumber, Mode=OneWay}" Width="150"/>
                                        <DataGridTextColumn Header="Origin" Binding="{Binding MatchOrigin, Mode=OneWay}" Width="170"/>
                                        <DataGridTextColumn Header="Status" Binding="{Binding Status, Mode=OneWay}" Width="210"/>
                                        <DataGridTextColumn Header="Tally Bank" Binding="{Binding TallyBankLedger, Mode=OneWay}" Width="190"/>
                                        <DataGridTextColumn Header="Reason" Binding="{Binding Reason, Mode=OneWay}" Width="*"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                        </TabItem>

                        <TabItem Header="Tally Bank Conversion">
                            <Grid Margin="6">
                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                                <Border Padding="10" Margin="0,0,0,8" Background="#F5F8FC" CornerRadius="8" BorderBrush="#D8E0EB" BorderThickness="1">
                                    <StackPanel>
                                        <TextBlock Text="Tally Bank Transactions → Inter-Bank Reconciliation" FontSize="18" FontWeight="SemiBold"/>
                                        <TextBlock Text="Live Tally Bank/OD/Secured-Loan postings are synced to the exact Inter-Bank transaction contract: Date, Bank Ledger, Debit, Credit, Narration, Reference and stable Tally source ID. They enter the same Inter-Bank candidate pool as uploaded Bank Statement rows. Tally Bank Debit becomes Bank Statement Credit; Tally Bank Credit becomes Bank Statement Debit. Tally-to-Tally pairs are ignored. For an Imported-to-Tally match, the existing Inter-Bank output is applied to that same Tally voucher as Contra and live-verified; the imported duplicate is retired and exact closing-balance reconciliation runs last. A failed final balance gate restores the imported row." Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                                        <TextBlock Text="{Binding TallyInterbankVerificationStatus, Mode=OneWay}" Margin="0,5,0,0" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>
                                <DataGrid Grid.Row="1" ItemsSource="{Binding TallyInterbankVerificationRows}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False" SelectionUnit="FullRow">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Status" Binding="{Binding Status, Mode=OneWay}" Width="210"/>
                                        <DataGridTextColumn Header="Date" Binding="{Binding TransactionDate, Mode=OneWay, StringFormat=dd.MM.yyyy}" Width="95"/>
                                        <DataGridTextColumn Header="Bank Ledger" Binding="{Binding ConvertedBankLedger, Mode=OneWay}" Width="220"/>
                                        <DataGridTextColumn Header="Debit" Binding="{Binding ConvertedDebitAmount, Mode=OneWay, StringFormat={}{0:N2}}" Width="120"/>
                                        <DataGridTextColumn Header="Credit" Binding="{Binding ConvertedCreditAmount, Mode=OneWay, StringFormat={}{0:N2}}" Width="120"/>
                                        <DataGridTextColumn Header="Narration" Binding="{Binding OriginalNarration, Mode=OneWay}" Width="300"/>
                                        <DataGridTextColumn Header="Reference" Binding="{Binding OriginalReference, Mode=OneWay}" Width="160"/>
                                        <DataGridTextColumn Header="Tally Source ID" Binding="{Binding TransferMatchId, Mode=OneWay}" Width="220"/>
                                        <DataGridTextColumn Header="Tally Master ID" Binding="{Binding TallyMasterId, Mode=OneWay}" Width="110"/>
                                        <DataGridTextColumn Header="Voucher Type" Binding="{Binding OriginalVoucherType, Mode=OneWay}" Width="105"/>
                                        <DataGridTextColumn Header="Conversion / Match Evidence" Binding="{Binding MatchEvidence, Mode=OneWay}" Width="*" MinWidth="340"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                        </TabItem>
                    </TabControl>
                </Grid>
            </TabItem>

            <TabItem Header="OB Verification Dashboard">
