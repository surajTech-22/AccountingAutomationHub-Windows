<UserControl x:Class="AccountingAutomationHub.Desktop.Views.ConsolidatedTallyImportView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:AccountingAutomationHub.Desktop.Views"
             Background="{DynamicResource AppBackgroundBrush}">
    <!-- Reuse the ORIGINAL Tally Link + Export/Auto Sync card. The
         consolidated commands belong at its existing Export position. -->
    <views:DashboardView TallyOnlyMode="True"
                         ConsolidatedImportWorkspace="{Binding DataContext, RelativeSource={RelativeSource AncestorType={x:Type views:ConsolidatedTallyImportView}}}"
                         DataContext="{Binding ExistingDashboardWorkspace}"/>
</UserControl>
