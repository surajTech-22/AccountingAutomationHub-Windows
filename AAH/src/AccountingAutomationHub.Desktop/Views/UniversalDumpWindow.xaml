<Window x:Class="AccountingAutomationHub.Desktop.Views.UniversalDumpWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Dump / Universal Import" Height="570" Width="820"
        MinHeight="480" MinWidth="700" WindowStartupLocation="CenterOwner"
        Background="{DynamicResource AppBackgroundBrush}">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="Dump / Universal Import" FontSize="22" FontWeight="SemiBold"/>
            <TextBlock Text="Add mixed PDF, Excel, CSV, text or supported bank-exchange files. The Hub copies them to the local Document Vault, classifies content, routes high-confidence files to the correct module, and sends ambiguous files to Review Required."
                       Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,5,0,0"/>
        </StackPanel>

        <WrapPanel Grid.Row="1" Margin="0,14,0,10">
            <Button Content="Add Files…" Click="AddFiles_Click" Padding="12,7"/>
            <Button Content="Add Folder…" Click="AddFolder_Click" Padding="12,7" Margin="8,0,0,0"/>
            <Button Content="Remove Selected" Click="RemoveSelected_Click" Padding="12,7" Margin="8,0,0,0"/>
            <Button Content="Clear" Click="Clear_Click" Padding="12,7" Margin="8,0,0,0"/>
            <Button Content="Review in InvoiceVision" Click="OpenInvoiceVision_Click" Padding="12,7" Margin="8,0,0,0"/>
        </WrapPanel>

        <Border Grid.Row="2" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Background="{DynamicResource SurfaceBrush}">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <Grid Grid.Row="0" Margin="12,10,12,8">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBlock Text="Selected sources" FontWeight="SemiBold"/>
                    <TextBlock Grid.Column="1" x:Name="SelectionCountText" Text="0 source(s)" Foreground="{DynamicResource TextSecondaryBrush}"/>
                </Grid>
                <ListBox Grid.Row="1" x:Name="SourceList" SelectionMode="Extended" Margin="8,0,8,8"/>
            </Grid>
        </Border>

        <Border Grid.Row="3" Margin="0,10,0,0" Padding="10" CornerRadius="6" Background="{DynamicResource SurfaceAltBrush}">
            <TextBlock x:Name="StatusText" Text="Nothing has been staged yet." TextWrapping="Wrap"/>
        </Border>

        <Grid Grid.Row="4" Margin="0,12,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock Text="Files remain local. Existing duplicate/content protections still apply." VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}"/>
            <Button Grid.Column="1" x:Name="StartButton" Content="Start Universal Import" Click="Start_Click" Style="{StaticResource PrimaryButtonStyle}" Padding="14,8"/>
            <Button Grid.Column="2" Content="Close" IsCancel="True" Padding="14,8" Margin="8,0,0,0"/>
        </Grid>
    </Grid>
</Window>
