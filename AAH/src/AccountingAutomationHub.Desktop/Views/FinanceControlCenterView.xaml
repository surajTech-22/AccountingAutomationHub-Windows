<UserControl x:Class="AccountingAutomationHub.Desktop.Views.FinanceControlCenterView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinWidth="900" MinHeight="560">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <DockPanel Margin="0,0,0,12">
            <StackPanel DockPanel.Dock="Left">
                <TextBlock Text="Finance Center" FontSize="24" FontWeight="SemiBold"/>
                <TextBlock Text="Close, controls, cash planning, audit, search, assets, bank rules, approvals and backup" Foreground="{DynamicResource TextSecondaryBrush}"/>
            </StackPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button Content="Export Control Pack" Command="{Binding ExportControlPackCommand}" Padding="10,7"/><Button Content="Refresh Finance Center" Command="{Binding RefreshCommand}" Style="{StaticResource PrimaryButtonStyle}" Margin="12,0,0,0"/></StackPanel>
        </DockPanel>

        <TabControl Grid.Row="1">
            <TabItem Header="Overview &amp; Close">
                <Grid Margin="10">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <WrapPanel Margin="0,0,0,10">
                        <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,10,6" Padding="12" MinWidth="160" MaxWidth="220" DataContext="{Binding Kpis[0]}"><StackPanel><TextBlock Text="{Binding Name}" FontWeight="SemiBold"/><TextBlock Text="{Binding Value}" FontSize="24" FontWeight="Bold"/><TextBlock Text="{Binding Detail}" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}"/></StackPanel></Border>
                        <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,10,6" Padding="12" MinWidth="160" MaxWidth="220" DataContext="{Binding Kpis[1]}"><StackPanel><TextBlock Text="{Binding Name}" FontWeight="SemiBold"/><TextBlock Text="{Binding Value}" FontSize="24" FontWeight="Bold"/><TextBlock Text="{Binding Detail}" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}"/></StackPanel></Border>
                        <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,10,6" Padding="12" MinWidth="160" MaxWidth="220" DataContext="{Binding Kpis[2]}"><StackPanel><TextBlock Text="{Binding Name}" FontWeight="SemiBold"/><TextBlock Text="{Binding Value}" FontSize="24" FontWeight="Bold"/><TextBlock Text="{Binding Detail}" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}"/></StackPanel></Border>
                        <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,10,6" Padding="12" MinWidth="160" MaxWidth="220" DataContext="{Binding Kpis[3]}"><StackPanel><TextBlock Text="{Binding Name}" FontWeight="SemiBold"/><TextBlock Text="{Binding Value}" FontSize="24" FontWeight="Bold"/><TextBlock Text="{Binding Detail}" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}"/></StackPanel></Border>
                    </WrapPanel>
                    <Border Grid.Row="1" Style="{StaticResource CardBorderStyle}" Margin="0,0,0,8">
                        <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                            <DockPanel><TextBlock Text="Month-End Close Checklist" Style="{StaticResource SectionTitleStyle}"/><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><TextBlock Text="Check through" VerticalAlignment="Center" Margin="0,0,6,0"/><DatePicker SelectedDate="{Binding CloseThroughDate}" Width="125"/><Button Content="Refresh" Command="{Binding RefreshCommand}" Padding="10,6" Margin="8,0,0,0"/></StackPanel></DockPanel>
                            <DataGrid Grid.Row="1" ItemsSource="{Binding CloseChecks}" AutoGenerateColumns="False" IsReadOnly="True">
                                <DataGrid.Columns><DataGridTextColumn Header="Area" Binding="{Binding Area}" Width="120"/><DataGridTextColumn Header="Check" Binding="{Binding Check}" Width="2*"/><DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="90"/><DataGridTextColumn Header="Count" Binding="{Binding Count}" Width="70"/><DataGridTextColumn Header="Detail" Binding="{Binding Detail}" Width="3*"/></DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>
                    <Border Grid.Row="2" Style="{StaticResource CardBorderStyle}">
                        <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><TextBlock Text="Data Integrity" Style="{StaticResource SectionTitleStyle}"/><DataGrid Grid.Row="1" ItemsSource="{Binding IntegrityChecks}" AutoGenerateColumns="False" IsReadOnly="True"><DataGrid.Columns><DataGridTextColumn Header="Check" Binding="{Binding Check}" Width="2*"/><DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="100"/><DataGridTextColumn Header="Detail" Binding="{Binding Detail}" Width="4*"/></DataGrid.Columns></DataGrid></Grid>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem Header="Search &amp; Inbox">
                <Grid Margin="10"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,8"><DockPanel><TextBlock Text="Global Search" Style="{StaticResource SectionTitleStyle}" DockPanel.Dock="Top"/><TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Padding="8,6" MinWidth="300"/><Button Content="Search" Command="{Binding SearchCommand}" Style="{StaticResource PrimaryButtonStyle}" Margin="8,0,0,0"/><Button Content="Clear" Command="{Binding ClearSearchCommand}" Padding="10,6" Margin="8,0,0,0"/></DockPanel></Border>
                    <DataGrid Grid.Row="1" ItemsSource="{Binding SearchResults}" AutoGenerateColumns="False" IsReadOnly="True" Margin="0,0,0,8"><DataGrid.Columns><DataGridTextColumn Header="Module" Binding="{Binding Module}" Width="100"/><DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="100"/><DataGridTextColumn Header="Date" Binding="{Binding Date, StringFormat={}{0:dd-MMM-yyyy}}" Width="110"/><DataGridTextColumn Header="Name / Narration" Binding="{Binding PrimaryText}" Width="3*"/><DataGridTextColumn Header="Reference" Binding="{Binding Reference}" Width="2*"/><DataGridTextColumn Header="Amount" Binding="{Binding Amount, StringFormat={}{0:N2}}" Width="110"/></DataGrid.Columns></DataGrid>
                    <Border Grid.Row="2" Style="{StaticResource CardBorderStyle}"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><DockPanel><TextBlock Text="Document Inbox / Auto Import History" Style="{StaticResource SectionTitleStyle}"/><Button DockPanel.Dock="Right" Content="Recovery Scan All Folders" Command="{Binding RecoveryScanCommand}" Padding="10,6"/></DockPanel><DataGrid Grid.Row="1" ItemsSource="{Binding DocumentInbox}" AutoGenerateColumns="False" IsReadOnly="True"><DataGrid.Columns><DataGridTextColumn Header="File" Binding="{Binding FileName}" Width="2*"/><DataGridTextColumn Header="Type" Binding="{Binding FileType}" Width="100"/><DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="110"/><DataGridTextColumn Header="Processed" Binding="{Binding ProcessedUtc, StringFormat={}{0:dd-MMM-yyyy HH:mm}}" Width="140"/><DataGridTextColumn Header="Detail" Binding="{Binding Detail}" Width="3*"/></DataGrid.Columns></DataGrid></Grid></Border>
                </Grid>
            </TabItem>

            <TabItem Header="Audit &amp; Locks">
                <Grid Margin="10"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="160"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,8"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="110"/><ColumnDefinition Width="150"/><ColumnDefinition Width="110"/><ColumnDefinition Width="150"/><ColumnDefinition Width="100"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Module" VerticalAlignment="Center"/><ComboBox Grid.Column="1" ItemsSource="{Binding LockModuleOptions}" SelectedItem="{Binding LockModule}"/><TextBlock Grid.Column="2" Text="Lock through" VerticalAlignment="Center" Margin="12,0,0,0"/><DatePicker Grid.Column="3" SelectedDate="{Binding LockDate}"/><TextBlock Grid.Column="4" Text="Reason" VerticalAlignment="Center" Margin="12,0,0,0"/><TextBox Grid.Column="5" Text="{Binding LockReason, UpdateSourceTrigger=PropertyChanged}" Padding="8,6"/><Button Grid.Column="6" Content="Lock Period" Command="{Binding SavePeriodLockCommand}" Style="{StaticResource PrimaryButtonStyle}" Margin="8,0,0,0"/></Grid></Border>
                    <Grid Grid.Row="1" Margin="0,0,0,8"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><DockPanel Margin="0,0,0,4"><TextBlock Text="Select a lock below to reopen that period." VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}"/><Button DockPanel.Dock="Right" Content="Unlock Selected" Command="{Binding UnlockPeriodCommand}" Padding="10,5"/></DockPanel><DataGrid Grid.Row="1" ItemsSource="{Binding PeriodLocks}" SelectedItem="{Binding SelectedPeriodLock}" AutoGenerateColumns="False" IsReadOnly="True"><DataGrid.Columns><DataGridTextColumn Header="Module" Binding="{Binding Module}" Width="140"/><DataGridTextColumn Header="Locked Through" Binding="{Binding LockDate, StringFormat={}{0:dd-MMM-yyyy}}" Width="130"/><DataGridTextColumn Header="Reason" Binding="{Binding Reason}" Width="*"/><DataGridCheckBoxColumn Header="Active" Binding="{Binding IsActive}" Width="70"/></DataGrid.Columns></DataGrid></Grid>
                    <Border Grid.Row="2" Style="{StaticResource CardBorderStyle}"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><TextBlock Text="Audit Trail" Style="{StaticResource SectionTitleStyle}"/><DataGrid Grid.Row="1" ItemsSource="{Binding AuditTrail}" AutoGenerateColumns="False" IsReadOnly="True"><DataGrid.Columns><DataGridTextColumn Header="UTC" Binding="{Binding ChangedUtc, StringFormat={}{0:dd-MMM-yyyy HH:mm:ss}}" Width="150"/><DataGridTextColumn Header="Module" Binding="{Binding Module}" Width="110"/><DataGridTextColumn Header="Operation" Binding="{Binding Operation}" Width="90"/><DataGridTextColumn Header="Key" Binding="{Binding EntityKey}" Width="2*"/><DataGridTextColumn Header="Before" Binding="{Binding OldValue}" Width="2*"/><DataGridTextColumn Header="After" Binding="{Binding NewValue}" Width="2*"/><DataGridTextColumn Header="Source" Binding="{Binding Source}" Width="100"/></DataGrid.Columns></DataGrid></Grid></Border>
                </Grid>
            </TabItem>

            <TabItem Header="Cash Flow &amp; Ageing">
                <Grid Margin="10"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,8"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><TextBlock Text="Cash Flow Forecast" Style="{StaticResource SectionTitleStyle}"/><DataGrid Grid.Row="1" ItemsSource="{Binding CashFlow}" AutoGenerateColumns="False" IsReadOnly="True"><DataGrid.Columns><DataGridTextColumn Header="Period" Binding="{Binding Period}" Width="110"/><DataGridTextColumn Header="Actual In" Binding="{Binding ActualInflow, StringFormat=N2}" Width="110"/><DataGridTextColumn Header="Actual Out" Binding="{Binding ActualOutflow, StringFormat=N2}" Width="110"/><DataGridTextColumn Header="Planned In" Binding="{Binding PlannedInflow, StringFormat=N2}" Width="110"/><DataGridTextColumn Header="Planned Out" Binding="{Binding PlannedOutflow, StringFormat=N2}" Width="110"/><DataGridTextColumn Header="Net" Binding="{Binding Net, StringFormat=N2}" Width="110"/><DataGridTextColumn Header="Projected Closing" Binding="{Binding Closing, StringFormat=N2}" Width="130"/></DataGrid.Columns></DataGrid></Grid></Border>
                    <Border Grid.Row="1" Style="{StaticResource CardBorderStyle}" Margin="0,0,0,8"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><TextBlock Text="Receivables / Payables Ageing" Style="{StaticResource SectionTitleStyle}"/><DataGrid Grid.Row="1" ItemsSource="{Binding Aging}" SelectedItem="{Binding SelectedAging}" AutoGenerateColumns="False" IsReadOnly="True"><DataGrid.Columns><DataGridTextColumn Header="Side" Binding="{Binding Side}" Width="90"/><DataGridTextColumn Header="Party" Binding="{Binding Party}" Width="2*"/><DataGridTextColumn Header="Document" Binding="{Binding DocumentNumber}" Width="130"/><DataGridTextColumn Header="Date" Binding="{Binding DocumentDate, StringFormat={}{0:dd-MMM-yyyy}}" Width="105"/><DataGridTextColumn Header="Original" Binding="{Binding OriginalAmount, StringFormat=N2}" Width="105"/><DataGridTextColumn Header="Settled" Binding="{Binding SettledAmount, StringFormat=N2}" Width="105"/><DataGridTextColumn Header="Outstanding" Binding="{Binding OutstandingAmount, StringFormat=N2}" Width="110"/><DataGridTextColumn Header="Age" Binding="{Binding AgeDays}" Width="60"/><DataGridTextColumn Header="Bucket" Binding="{Binding Bucket}" Width="80"/></DataGrid.Columns></DataGrid></Grid></Border>
                    <Border Grid.Row="2" Style="{StaticResource CardBorderStyle}" Padding="10"><WrapPanel><TextBlock Text="Record settlement for selected row:" VerticalAlignment="Center" Margin="0,0,8,0"/><TextBox Text="{Binding SettlementAmount, UpdateSourceTrigger=PropertyChanged}" Width="110" Padding="7,5"/><DatePicker SelectedDate="{Binding SettlementDate}" Width="125" Margin="8,0,0,0"/><TextBox Text="{Binding SettlementReference}" Width="240" Padding="7,5" Margin="8,0,0,0" ToolTip="Reference / note"/><Button Content="Record Settlement" Command="{Binding SaveSettlementCommand}" Style="{StaticResource PrimaryButtonStyle}" Margin="8,0,0,0"/></WrapPanel></Border>
                </Grid>
            </TabItem>

            <TabItem Header="Bank Rules">
                <Grid Margin="10"><Grid.ColumnDefinitions><ColumnDefinition Width="1.1*"/><ColumnDefinition Width="1.2*"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,8,0"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><DockPanel><TextBlock Text="Saved Bank Rules" Style="{StaticResource SectionTitleStyle}"/><WrapPanel DockPanel.Dock="Right"><Button Content="New" Command="{Binding NewBankRuleCommand}" Padding="8,5"/><Button Content="Edit" Command="{Binding EditBankRuleCommand}" Padding="8,5" Margin="6,0,0,0"/><Button Content="Delete" Command="{Binding DeleteBankRuleCommand}" Padding="8,5" Margin="6,0,0,0"/></WrapPanel></DockPanel><DataGrid Grid.Row="1" ItemsSource="{Binding BankRules}" SelectedItem="{Binding SelectedBankRule}" AutoGenerateColumns="False" IsReadOnly="True"><DataGrid.Columns><DataGridTextColumn Header="Priority" Binding="{Binding Priority}" Width="65"/><DataGridTextColumn Header="Rule" Binding="{Binding RuleName}" Width="*"/><DataGridTextColumn Header="Ledger" Binding="{Binding LedgerName}" Width="*"/><DataGridTextColumn Header="Applied" Binding="{Binding AppliedCount}" Width="70"/><DataGridCheckBoxColumn Header="Active" Binding="{Binding IsActive}" Width="60"/></DataGrid.Columns></DataGrid><Button Grid.Row="2" Content="Apply Active Rules to Unmapped Transactions" Command="{Binding ApplyBankRulesCommand}" Style="{StaticResource PrimaryButtonStyle}" Margin="0,8,0,0" HorizontalAlignment="Left"/></Grid></Border>
                    <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto"><StackPanel><Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,8"><StackPanel><TextBlock Text="Rule Editor" Style="{StaticResource SectionTitleStyle}"/><UniformGrid Columns="2"><TextBlock Text="Rule Name" VerticalAlignment="Center"/><TextBox Text="{Binding EditingBankRule.RuleName}"/><TextBlock Text="Priority" VerticalAlignment="Center"/><TextBox Text="{Binding EditingBankRule.Priority}"/><TextBlock Text="Bank Contains" VerticalAlignment="Center"/><TextBox Text="{Binding EditingBankRule.BankContains}"/><TextBlock Text="Mode" VerticalAlignment="Center"/><TextBox Text="{Binding EditingBankRule.Mode}"/><TextBlock Text="Narration Contains" VerticalAlignment="Center"/><TextBox Text="{Binding EditingBankRule.NarrationContains}"/><TextBlock Text="Narration Starts With" VerticalAlignment="Center"/><TextBox Text="{Binding EditingBankRule.NarrationStartsWith}"/><TextBlock Text="Reference Contains" VerticalAlignment="Center"/><TextBox Text="{Binding EditingBankRule.ReferenceContains}"/><TextBlock Text="Narration Regex" VerticalAlignment="Center"/><TextBox Text="{Binding EditingBankRule.NarrationRegex}"/><TextBlock Text="Minimum Amount" VerticalAlignment="Center"/><TextBox Text="{Binding EditingBankRule.MinAmount}"/><TextBlock Text="Maximum Amount" VerticalAlignment="Center"/><TextBox Text="{Binding EditingBankRule.MaxAmount}"/><TextBlock Text="Final Ledger" VerticalAlignment="Center"/><TextBox Text="{Binding EditingBankRule.LedgerName}"/><TextBlock Text="Ledger Group" VerticalAlignment="Center"/><TextBox Text="{Binding EditingBankRule.LedgerGroup}"/></UniformGrid><CheckBox Content="Active" IsChecked="{Binding EditingBankRule.IsActive}" Margin="0,8,0,0"/><WrapPanel Margin="0,8,0,0"><Button Content="Preview Matches" Command="{Binding PreviewBankRuleCommand}" Padding="10,6"/><Button Content="Save Rule" Command="{Binding SaveBankRuleCommand}" Style="{StaticResource PrimaryButtonStyle}" Margin="8,0,0,0"/></WrapPanel></StackPanel></Border><DataGrid ItemsSource="{Binding BankRulePreview}" AutoGenerateColumns="False" IsReadOnly="True" Height="230"><DataGrid.Columns><DataGridTextColumn Header="Date" Binding="{Binding Date, StringFormat={}{0:dd-MMM-yyyy}}" Width="105"/><DataGridTextColumn Header="Bank" Binding="{Binding Bank}" Width="100"/><DataGridTextColumn Header="Narration" Binding="{Binding Narration}" Width="2*"/><DataGridTextColumn Header="Amount" Binding="{Binding Amount, StringFormat=N2}" Width="95"/><DataGridTextColumn Header="Current" Binding="{Binding CurrentLedger}" Width="*"/><DataGridTextColumn Header="Proposed" Binding="{Binding ProposedLedger}" Width="*"/></DataGrid.Columns></DataGrid></StackPanel></ScrollViewer>
                </Grid>
            </TabItem>

            <TabItem Header="Budgets &amp; Recurring">
                <Grid Margin="10"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,8"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="1.3*"/><ColumnDefinition Width="1*"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><TextBlock Text="Budgets vs Actual" Style="{StaticResource SectionTitleStyle}"/><DataGrid Grid.Row="1" ItemsSource="{Binding Budgets}" SelectedItem="{Binding SelectedBudget}" AutoGenerateColumns="False" IsReadOnly="True"><DataGrid.Columns><DataGridTextColumn Header="Period" Binding="{Binding Period}" Width="95"/><DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="*"/><DataGridTextColumn Header="Budget" Binding="{Binding BudgetAmount, StringFormat=N2}" Width="110"/><DataGridTextColumn Header="Actual" Binding="{Binding ActualAmount, StringFormat=N2}" Width="110"/><DataGridTextColumn Header="Variance" Binding="{Binding Variance, StringFormat=N2}" Width="110"/></DataGrid.Columns></DataGrid><StackPanel Grid.Column="1" Grid.RowSpan="2" Margin="12,0,0,0"><TextBlock Text="Budget Editor" FontWeight="SemiBold"/><TextBlock Text="Period (yyyy-MM)" Margin="0,8,0,2"/><TextBox Text="{Binding EditingBudget.Period}"/><TextBlock Text="Category (Sales, Purchases, Bank Inflow, Bank Outflow)" Margin="0,8,0,2" TextWrapping="Wrap"/><TextBox Text="{Binding EditingBudget.Category}"/><TextBlock Text="Budget Amount" Margin="0,8,0,2"/><TextBox Text="{Binding EditingBudget.BudgetAmount}"/><WrapPanel Margin="0,10,0,0"><Button Content="New" Command="{Binding NewBudgetCommand}" Padding="8,5"/><Button Content="Edit" Command="{Binding EditBudgetCommand}" Padding="8,5" Margin="6,0,0,0"/><Button Content="Save" Command="{Binding SaveBudgetCommand}" Style="{StaticResource PrimaryButtonStyle}" Margin="6,0,0,0"/><Button Content="Delete" Command="{Binding DeleteBudgetCommand}" Padding="8,5" Margin="6,0,0,0"/></WrapPanel></StackPanel></Grid></Border>
                    <Border Grid.Row="1" Style="{StaticResource CardBorderStyle}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="1.3*"/><ColumnDefinition Width="1*"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><TextBlock Text="Recurring Cash-Flow Planner" Style="{StaticResource SectionTitleStyle}"/><DataGrid Grid.Row="1" ItemsSource="{Binding RecurringItems}" SelectedItem="{Binding SelectedRecurring}" AutoGenerateColumns="False" IsReadOnly="True"><DataGrid.Columns><DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*"/><DataGridTextColumn Header="Direction" Binding="{Binding Direction}" Width="90"/><DataGridTextColumn Header="Amount" Binding="{Binding Amount, StringFormat=N2}" Width="100"/><DataGridTextColumn Header="Day" Binding="{Binding DayOfMonth}" Width="50"/><DataGridTextColumn Header="Ledger" Binding="{Binding LedgerName}" Width="*"/><DataGridCheckBoxColumn Header="Active" Binding="{Binding IsActive}" Width="60"/></DataGrid.Columns></DataGrid><StackPanel Grid.Column="1" Grid.RowSpan="2" Margin="12,0,0,0"><TextBlock Text="Recurring Item Editor" FontWeight="SemiBold"/><TextBlock Text="Name" Margin="0,8,0,2"/><TextBox Text="{Binding EditingRecurring.Name}"/><TextBlock Text="Direction" Margin="0,8,0,2"/><ComboBox ItemsSource="{Binding CashDirections}" SelectedItem="{Binding EditingRecurring.Direction}"/><TextBlock Text="Amount" Margin="0,8,0,2"/><TextBox Text="{Binding EditingRecurring.Amount}"/><TextBlock Text="Day of Month (1-28)" Margin="0,8,0,2"/><TextBox Text="{Binding EditingRecurring.DayOfMonth}"/><TextBlock Text="Start / End" Margin="0,8,0,2"/><StackPanel Orientation="Horizontal"><DatePicker SelectedDate="{Binding EditingRecurring.StartDate}" Width="120"/><DatePicker SelectedDate="{Binding EditingRecurring.EndDate}" Width="120" Margin="8,0,0,0"/></StackPanel><TextBlock Text="Ledger" Margin="0,8,0,2"/><TextBox Text="{Binding EditingRecurring.LedgerName}"/><CheckBox Content="Active" IsChecked="{Binding EditingRecurring.IsActive}" Margin="0,8,0,0"/><WrapPanel Margin="0,10,0,0"><Button Content="New" Command="{Binding NewRecurringCommand}" Padding="8,5"/><Button Content="Edit" Command="{Binding EditRecurringCommand}" Padding="8,5" Margin="6,0,0,0"/><Button Content="Save" Command="{Binding SaveRecurringCommand}" Style="{StaticResource PrimaryButtonStyle}" Margin="6,0,0,0"/><Button Content="Delete" Command="{Binding DeleteRecurringCommand}" Padding="8,5" Margin="6,0,0,0"/></WrapPanel></StackPanel></Grid></Border>
                </Grid>
            </TabItem>

            <TabItem Header="Inventory Intelligence">
                <Grid Margin="10"><Grid.RowDefinitions><RowDefinition Height="1.2*"/><RowDefinition Height="1*"/></Grid.RowDefinitions>
                    <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,8"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><TextBlock Text="Reorder / Expiry / Available Stock Intelligence" Style="{StaticResource SectionTitleStyle}"/><DataGrid Grid.Row="1" ItemsSource="{Binding InventoryIntelligence}" AutoGenerateColumns="False" IsReadOnly="True"><DataGrid.Columns><DataGridTextColumn Header="Stock Item" Binding="{Binding StockItemName}" Width="2*"/><DataGridTextColumn Header="Unit" Binding="{Binding Unit}" Width="70"/><DataGridTextColumn Header="Opening" Binding="{Binding OpeningQuantity, StringFormat=N2}" Width="95"/><DataGridTextColumn Header="Sales Qty" Binding="{Binding SalesQuantity, StringFormat=N2}" Width="95"/><DataGridTextColumn Header="Estimated Available" Binding="{Binding EstimatedAvailable, StringFormat=N2}" Width="125"/><DataGridTextColumn Header="Reorder" Binding="{Binding ReorderLevel, StringFormat=N2}" Width="90"/><DataGridTextColumn Header="Nearest Expiry" Binding="{Binding NearestExpiry, StringFormat={}{0:dd-MMM-yyyy}}" Width="110"/><DataGridTextColumn Header="Alert" Binding="{Binding Alert}" Width="130"/></DataGrid.Columns></DataGrid></Grid></Border>
                    <Border Grid.Row="1" Style="{StaticResource CardBorderStyle}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="1.3*"/><ColumnDefinition Width="1*"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><TextBlock Text="Inventory Policies" Style="{StaticResource SectionTitleStyle}"/><DataGrid Grid.Row="1" ItemsSource="{Binding InventoryPolicies}" SelectedItem="{Binding SelectedInventoryPolicy}" AutoGenerateColumns="False" IsReadOnly="True"><DataGrid.Columns><DataGridTextColumn Header="Stock Item" Binding="{Binding StockItemName}" Width="*"/><DataGridTextColumn Header="Opening" Binding="{Binding OpeningQuantity}" Width="85"/><DataGridTextColumn Header="Reorder" Binding="{Binding ReorderLevel}" Width="85"/><DataGridTextColumn Header="Minimum" Binding="{Binding MinimumStock}" Width="85"/><DataGridTextColumn Header="Maximum" Binding="{Binding MaximumStock}" Width="85"/><DataGridTextColumn Header="Expiry Days" Binding="{Binding ExpiryWarningDays}" Width="80"/></DataGrid.Columns></DataGrid><StackPanel Grid.Column="1" Grid.RowSpan="2" Margin="12,0,0,0"><TextBlock Text="Policy Editor" FontWeight="SemiBold"/><TextBlock Text="Stock Item" Margin="0,8,0,2"/><TextBox Text="{Binding EditingInventoryPolicy.StockItemName}"/><UniformGrid Columns="2" Margin="0,8,0,0"><TextBlock Text="Opening" VerticalAlignment="Center"/><TextBox Text="{Binding EditingInventoryPolicy.OpeningQuantity}"/><TextBlock Text="Reorder" VerticalAlignment="Center"/><TextBox Text="{Binding EditingInventoryPolicy.ReorderLevel}"/><TextBlock Text="Minimum" VerticalAlignment="Center"/><TextBox Text="{Binding EditingInventoryPolicy.MinimumStock}"/><TextBlock Text="Maximum" VerticalAlignment="Center"/><TextBox Text="{Binding EditingInventoryPolicy.MaximumStock}"/><TextBlock Text="Expiry Warning Days" VerticalAlignment="Center"/><TextBox Text="{Binding EditingInventoryPolicy.ExpiryWarningDays}"/></UniformGrid><WrapPanel Margin="0,10,0,0"><Button Content="New" Command="{Binding NewInventoryPolicyCommand}" Padding="8,5"/><Button Content="Edit" Command="{Binding EditInventoryPolicyCommand}" Padding="8,5" Margin="6,0,0,0"/><Button Content="Save" Command="{Binding SaveInventoryPolicyCommand}" Style="{StaticResource PrimaryButtonStyle}" Margin="6,0,0,0"/><Button Content="Delete" Command="{Binding DeleteInventoryPolicyCommand}" Padding="8,5" Margin="6,0,0,0"/></WrapPanel></StackPanel></Grid></Border>
                </Grid>
            </TabItem>

            <TabItem Header="Import Jobs &amp; Undo">
                <Grid Margin="10">
                    <Grid.RowDefinitions><RowDefinition Height="0.9*"/><RowDefinition Height="1.2*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,8">
                        <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel><TextBlock Text="Import Runs" Style="{StaticResource SectionTitleStyle}"/><TextBlock Text="Auto Import, Manual import and Universal Dump use one lifecycle and one undo authority." Foreground="{DynamicResource TextSecondaryBrush}"/></StackPanel>
                                <TextBlock Grid.Column="1" Text="{Binding ImportRuns.Count, StringFormat={}{0:N0} run(s)}" VerticalAlignment="Center" FontWeight="SemiBold"/>
                            </Grid>
                            <DataGrid Grid.Row="1" ItemsSource="{Binding ImportRuns}" SelectedItem="{Binding SelectedImportRun}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Started" Binding="{Binding StartedUtc, StringFormat={}{0:dd-MMM HH:mm}}" Width="115"/>
                                    <DataGridTextColumn Header="Source" Binding="{Binding SourceKind}" Width="125"/>
                                    <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="115"/>
                                    <DataGridTextColumn Header="Files" Binding="{Binding TotalFiles}" Width="65"/>
                                    <DataGridTextColumn Header="Imported" Binding="{Binding ImportedFiles}" Width="75"/>
                                    <DataGridTextColumn Header="Review" Binding="{Binding ReviewFiles}" Width="65"/>
                                    <DataGridTextColumn Header="Failed" Binding="{Binding FailedFiles}" Width="65"/>
                                    <DataGridTextColumn Header="Records" Binding="{Binding RecordCount}" Width="80"/>
                                    <DataGridCheckBoxColumn Header="Undoable" Binding="{Binding IsUndoable}" Width="75"/>
                                    <DataGridTextColumn Header="Run ID" Binding="{Binding RunId}" Width="*"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>
                    <Border Grid.Row="1" Style="{StaticResource CardBorderStyle}" Margin="0,0,0,8">
                        <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                            <TextBlock Text="Import Jobs" Style="{StaticResource SectionTitleStyle}"/>
                            <DataGrid Grid.Row="1" ItemsSource="{Binding ImportJobs}" SelectedItem="{Binding SelectedImportJob}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="State" Binding="{Binding State}" Width="110"/>
                                    <DataGridTextColumn Header="Module" Binding="{Binding DetectedModule}" Width="105"/>
                                    <DataGridTextColumn Header="Confidence" Binding="{Binding Confidence, StringFormat=P0}" Width="85"/>
                                    <DataGridTextColumn Header="File" Binding="{Binding FileName}" Width="1.4*"/>
                                    <DataGridTextColumn Header="Records" Binding="{Binding RecordCount}" Width="75"/>
                                    <DataGridTextColumn Header="Attempts" Binding="{Binding AttemptCount}" Width="70"/>
                                    <DataGridTextColumn Header="Detail / Reason" Binding="{Binding Detail}" Width="2*"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>
                    <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal"><TextBlock Text="Undo reason" VerticalAlignment="Center"/><TextBox Text="{Binding UndoReason, UpdateSourceTrigger=PropertyChanged}" Width="320" Margin="8,0,0,0"/></StackPanel>
                        <WrapPanel Grid.Column="1"><Button Content="Preview Undo" Command="{Binding PreviewUndoCommand}" Padding="10,7"/><Button Content="Undo Selected Run" Command="{Binding UndoImportRunCommand}" Padding="10,7" Margin="8,0,0,0"/></WrapPanel>
                    </Grid>
                </Grid>
            </TabItem>

            <TabItem Header="Document Vault &amp; Versions">
                <Grid Margin="10"><Grid.RowDefinitions><RowDefinition Height="1*"/><RowDefinition Height="1*"/></Grid.RowDefinitions>
                    <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,8"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Local Document Vault" Style="{StaticResource SectionTitleStyle}"/><TextBlock Text="Original source evidence remains local and is linked to Import Run / Job IDs." Foreground="{DynamicResource TextSecondaryBrush}"/></StackPanel><Button Grid.Column="1" Content="View Source" Command="{Binding OpenVaultDocumentCommand}" Padding="10,6"/></Grid>
                        <DataGrid Grid.Row="1" ItemsSource="{Binding VaultDocuments}" SelectedItem="{Binding SelectedVaultDocument}" AutoGenerateColumns="False" IsReadOnly="True"><DataGrid.Columns><DataGridTextColumn Header="Added" Binding="{Binding AddedUtc, StringFormat={}{0:dd-MMM HH:mm}}" Width="110"/><DataGridTextColumn Header="Module" Binding="{Binding Module}" Width="100"/><DataGridTextColumn Header="File" Binding="{Binding FileName}" Width="1.5*"/><DataGridTextColumn Header="Original Path" Binding="{Binding OriginalPath}" Width="2*"/><DataGridCheckBoxColumn Header="Available" Binding="{Binding IsAvailable}" Width="75"/><DataGridTextColumn Header="Hash" Binding="{Binding FileHash}" Width="150"/></DataGrid.Columns></DataGrid>
                    </Grid></Border>
                    <Border Grid.Row="1" Style="{StaticResource CardBorderStyle}"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <StackPanel><TextBlock Text="Version History" Style="{StaticResource SectionTitleStyle}"/><TextBlock Text="Before/after snapshots for governed changes, clone/reversal and import rollback operations." Foreground="{DynamicResource TextSecondaryBrush}"/></StackPanel>
                        <DataGrid Grid.Row="1" ItemsSource="{Binding VersionHistory}" SelectedItem="{Binding SelectedVersion}" AutoGenerateColumns="False" IsReadOnly="True"><DataGrid.Columns><DataGridTextColumn Header="Changed" Binding="{Binding ChangedUtc, StringFormat={}{0:dd-MMM HH:mm}}" Width="115"/><DataGridTextColumn Header="Module" Binding="{Binding Module}" Width="95"/><DataGridTextColumn Header="Entity" Binding="{Binding EntityType}" Width="115"/><DataGridTextColumn Header="Operation" Binding="{Binding Operation}" Width="100"/><DataGridTextColumn Header="Changed By" Binding="{Binding ChangedBy}" Width="110"/><DataGridTextColumn Header="Reason" Binding="{Binding Reason}" Width="*"/><DataGridTextColumn Header="Run ID" Binding="{Binding RunId}" Width="150"/></DataGrid.Columns></DataGrid>
                    </Grid></Border>
                </Grid>
            </TabItem>

            <TabItem Header="Transaction Automation">
                <Grid Margin="10"><Grid.RowDefinitions><RowDefinition Height="1.1*"/><RowDefinition Height="1*"/></Grid.RowDefinitions>
                    <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,8"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <StackPanel><TextBlock Text="Recurring Cash &amp; Journal Profiles" Style="{StaticResource SectionTitleStyle}"/><TextBlock Text="Cash and Journal use one shared recurring engine. Due profiles create Draft transactions; originals/templates are retained." Foreground="{DynamicResource TextSecondaryBrush}"/></StackPanel>
                        <DataGrid Grid.Row="1" ItemsSource="{Binding TransactionAutomationProfiles}" AutoGenerateColumns="False" IsReadOnly="True"><DataGrid.Columns><DataGridTextColumn Header="Module" Binding="{Binding Module}" Width="90"/><DataGridTextColumn Header="Profile" Binding="{Binding ProfileName}" Width="*"/><DataGridTextColumn Header="Frequency" Binding="{Binding Frequency}" Width="100"/><DataGridTextColumn Header="Next Run" Binding="{Binding NextRunDate, StringFormat={}{0:dd-MMM-yyyy}}" Width="115"/><DataGridTextColumn Header="End" Binding="{Binding EndDate, StringFormat={}{0:dd-MMM-yyyy}}" Width="115"/><DataGridCheckBoxColumn Header="Active" Binding="{Binding IsActive}" Width="65"/><DataGridTextColumn Header="Created By" Binding="{Binding CreatedBy}" Width="110"/></DataGrid.Columns></DataGrid>
                    </Grid></Border>
                    <Border Grid.Row="1" Style="{StaticResource CardBorderStyle}"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <StackPanel><TextBlock Text="Advanced Bank Reconciliation History" Style="{StaticResource SectionTitleStyle}"/><TextBlock Text="Committed 1→many, many→1 and partial/adjustment groups remain separately auditable without changing Bank Statement source evidence." Foreground="{DynamicResource TextSecondaryBrush}"/></StackPanel>
                        <DataGrid Grid.Row="1" ItemsSource="{Binding AdvancedReconciliations}" AutoGenerateColumns="False" IsReadOnly="True"><DataGrid.Columns><DataGridTextColumn Header="Match ID" Binding="{Binding MatchId}" Width="170"/><DataGridTextColumn Header="Type" Binding="{Binding MatchType}" Width="130"/><DataGridTextColumn Header="Bank Amount" Binding="{Binding BankAmount, StringFormat=N2}" Width="110"/><DataGridTextColumn Header="Book Amount" Binding="{Binding BookAmount, StringFormat=N2}" Width="110"/><DataGridTextColumn Header="Adjustment" Binding="{Binding AdjustmentAmount, StringFormat=N2}" Width="100"/><DataGridTextColumn Header="Ledger" Binding="{Binding AdjustmentLedger}" Width="150"/><DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="90"/><DataGridTextColumn Header="Detail" Binding="{Binding Detail}" Width="*"/></DataGrid.Columns></DataGrid>
                    </Grid></Border>
                </Grid>
            </TabItem>

            <TabItem Header="Users &amp; Security">
                <Grid Margin="10"><Grid.ColumnDefinitions><ColumnDefinition Width="1.4*"/><ColumnDefinition Width="1*"/></Grid.ColumnDefinitions>
                    <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,8,0"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <StackPanel><TextBlock Text="Application Users &amp; Roles" Style="{StaticResource SectionTitleStyle}"/><TextBlock Text="{Binding CurrentApplicationUser, StringFormat=Current user: {0}}" Foreground="{DynamicResource TextSecondaryBrush}"/></StackPanel>
                        <DataGrid Grid.Row="1" ItemsSource="{Binding ApplicationUsers}" SelectedItem="{Binding SelectedApplicationUser}" AutoGenerateColumns="False" IsReadOnly="True"><DataGrid.Columns><DataGridTextColumn Header="Windows User" Binding="{Binding WindowsUserName}" Width="*"/><DataGridTextColumn Header="Display Name" Binding="{Binding DisplayName}" Width="*"/><DataGridTextColumn Header="Role" Binding="{Binding RoleName}" Width="120"/><DataGridCheckBoxColumn Header="Active" Binding="{Binding IsActive}" Width="65"/><DataGridTextColumn Header="Last Seen" Binding="{Binding LastSeenUtc, StringFormat={}{0:dd-MMM HH:mm}}" Width="115"/></DataGrid.Columns></DataGrid>
                        <TextBlock Grid.Row="2" Text="Administrator: full control · User: read/export/upload/import · Import Only: file upload/import · Accountant: accounting/import/undo/Tally · Reviewer: read/export/approval/audit · Data Entry: read/upload/import/edit/mapping · Read Only: read/export/audit. LAN login uses the Administrator-created password plus a one-time Registration OTP generated inside the Main Server application; routine login does not use OTP." TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,8,0,0"/>
                    </Grid></Border>
                    <StackPanel Grid.Column="1">
                        <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,8"><StackPanel><TextBlock Text="User Editor" Style="{StaticResource SectionTitleStyle}"/><TextBlock Text="Windows User Name" Margin="0,6,0,2"/><TextBox Text="{Binding EditingApplicationUser.WindowsUserName, UpdateSourceTrigger=PropertyChanged}"/><TextBlock Text="Display Name" Margin="0,6,0,2"/><TextBox Text="{Binding EditingApplicationUser.DisplayName, UpdateSourceTrigger=PropertyChanged}"/><TextBlock Text="Role" Margin="0,6,0,2"/><ComboBox ItemsSource="{Binding ApplicationRoleOptions}" SelectedItem="{Binding EditingApplicationUser.RoleName}"/><CheckBox Content="Active" IsChecked="{Binding EditingApplicationUser.IsActive}" Margin="0,8,0,0"/><WrapPanel Margin="0,10,0,0"><Button Content="New" Command="{Binding NewApplicationUserCommand}" Padding="8,5"/><Button Content="Edit" Command="{Binding EditApplicationUserCommand}" Padding="8,5" Margin="6,0,0,0"/><Button Content="Save User" Command="{Binding SaveApplicationUserCommand}" Style="{StaticResource PrimaryButtonStyle}" Margin="6,0,0,0"/><Button Content="Set / Reset LAN Login" Command="{Binding ConfigureNetworkMfaCommand}" Padding="8,5" Margin="6,0,0,0"/></WrapPanel></StackPanel></Border>
                        <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,8"><StackPanel><TextBlock Text="Client User Access" Style="{StaticResource SectionTitleStyle}"/><TextBlock Text="Client access is managed only from Client Directory. Turn Remote Available on for the client and use User Access to choose permitted AAH users. The same user scope applies on every trusted PC and phone." TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,6,0,0"/></StackPanel></Border>
                        <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,8"><StackPanel><TextBlock Text="Enrolled Windows / Android Devices" Style="{StaticResource SectionTitleStyle}"/><DataGrid ItemsSource="{Binding LanDevices}" SelectedItem="{Binding SelectedLanDevice}" AutoGenerateColumns="False" IsReadOnly="True" MaxHeight="145" Margin="0,6,0,0"><DataGrid.Columns><DataGridTextColumn Header="Device" Binding="{Binding DeviceName}" Width="*"/><DataGridTextColumn Header="Type" Binding="{Binding DeviceType}" Width="75"/><DataGridTextColumn Header="User" Binding="{Binding UserName}" Width="100"/><DataGridTextColumn Header="Role" Binding="{Binding RoleName}" Width="90"/><DataGridTextColumn Header="Client" Binding="{Binding ClientId}" Width="60"/><DataGridTextColumn Header="FY" Binding="{Binding FinancialYear}" Width="80"/><DataGridTextColumn Header="State" Binding="{Binding EnrollmentState}" Width="80"/><DataGridCheckBoxColumn Header="Active" Binding="{Binding IsActive}" Width="55"/></DataGrid.Columns></DataGrid><Button Content="{Binding ToggleLanDeviceActiveText}" Command="{Binding ToggleLanDeviceActiveCommand}" HorizontalAlignment="Left" Padding="8,5" Margin="0,8,0,0"/><TextBlock Text="Device tokens are stored only as SHA-256 hashes. Windows leases default to 30 days; Android leases default to 15 days. Revoking/expiring a device invalidates its sessions and network authority." TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,6,0,0"/></StackPanel></Border>
                        <Border Style="{StaticResource CardBorderStyle}"><StackPanel><TextBlock Text="Verified Backups" Style="{StaticResource SectionTitleStyle}"/><ItemsControl ItemsSource="{Binding VerifiedBackups}" MaxHeight="150"><ItemsControl.ItemTemplate><DataTemplate><TextBlock><Run Text="{Binding ScheduleClass, Mode=OneWay}"/><Run Text=" · "/><Run Text="{Binding CreatedUtc, Mode=OneWay, StringFormat={}{0:dd-MMM HH:mm}}"/><Run Text=" · Verified: "/><Run Text="{Binding IsVerified, Mode=OneWay}"/></TextBlock></DataTemplate></ItemsControl.ItemTemplate></ItemsControl><WrapPanel Margin="0,8,0,0"><Button Content="Create Verified Backup" Command="{Binding CreateVerifiedBackupCommand}" Style="{StaticResource PrimaryButtonStyle}"/><Button Content="Open Backup Folder" Command="{Binding OpenVerifiedBackupFolderCommand}" Padding="9,6" Margin="8,0,0,0"/></WrapPanel></StackPanel></Border>
                    </StackPanel>
                </Grid>
            </TabItem>

            <TabItem Header="Approvals &amp; Backup">
                <Grid Margin="10"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,8"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="1.4*"/><ColumnDefinition Width="1*"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><TextBlock Text="Maker-Checker Approval Queue" Style="{StaticResource SectionTitleStyle}"/><DataGrid Grid.Row="1" ItemsSource="{Binding Approvals}" SelectedItem="{Binding SelectedApproval}" AutoGenerateColumns="False" IsReadOnly="True"><DataGrid.Columns><DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="85"/><DataGridTextColumn Header="Module" Binding="{Binding Module}" Width="100"/><DataGridTextColumn Header="Action" Binding="{Binding ActionType}" Width="130"/><DataGridTextColumn Header="Reference" Binding="{Binding Reference}" Width="*"/><DataGridTextColumn Header="Amount" Binding="{Binding Amount, StringFormat=N2}" Width="100"/><DataGridTextColumn Header="Requested By" Binding="{Binding RequestedBy}" Width="120"/></DataGrid.Columns></DataGrid><StackPanel Grid.Column="1" Grid.RowSpan="2" Margin="12,0,0,0"><TextBlock Text="Approval Editor" FontWeight="SemiBold"/><TextBlock Text="Module" Margin="0,8,0,2"/><TextBox Text="{Binding EditingApproval.Module}"/><TextBlock Text="Action Type" Margin="0,8,0,2"/><TextBox Text="{Binding EditingApproval.ActionType}"/><TextBlock Text="Reference" Margin="0,8,0,2"/><TextBox Text="{Binding EditingApproval.Reference}"/><TextBlock Text="Amount" Margin="0,8,0,2"/><TextBox Text="{Binding EditingApproval.Amount}"/><TextBlock Text="Requested By" Margin="0,8,0,2"/><TextBox Text="{Binding EditingApproval.RequestedBy}"/><TextBlock Text="Decision Note" Margin="0,8,0,2"/><TextBox Text="{Binding EditingApproval.DecisionNote}" AcceptsReturn="True" Height="55"/><WrapPanel Margin="0,10,0,0"><Button Content="New" Command="{Binding NewApprovalCommand}" Padding="8,5"/><Button Content="Edit" Command="{Binding EditApprovalCommand}" Padding="8,5" Margin="6,0,0,0"/><Button Content="Save" Command="{Binding SaveApprovalCommand}" Padding="8,5" Margin="6,0,0,0"/><Button Content="Approve" Command="{Binding ApproveCommand}" Style="{StaticResource PrimaryButtonStyle}" Margin="6,0,0,0"/><Button Content="Reject" Command="{Binding RejectCommand}" Padding="8,5" Margin="6,0,0,0"/><Button Content="Delete" Command="{Binding DeleteApprovalCommand}" Padding="8,5" Margin="6,0,0,0"/></WrapPanel></StackPanel></Grid></Border>
                    <Border Grid.Row="1" Style="{StaticResource CardBorderStyle}"><DockPanel><StackPanel DockPanel.Dock="Left"><TextBlock Text="Backup &amp; Restore" FontWeight="SemiBold" FontSize="16"/><TextBlock Text="Backup includes Accounting Automation Hub application data only. External Python runtime, Registry and Cache folders are never copied or restored by the app. Restore is staged and applied safely on the next full application start." Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" MaxWidth="700"/></StackPanel><WrapPanel DockPanel.Dock="Right"><Button Content="Create Backup" Command="{Binding CreateBackupCommand}" Style="{StaticResource PrimaryButtonStyle}"/><Button Content="Stage Restore" Command="{Binding RestoreBackupCommand}" Padding="10,7" Margin="8,0,0,0"/></WrapPanel></DockPanel></Border>
                </Grid>
            </TabItem>
        </TabControl>
        <Border Grid.Row="2" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,10,0,0"><TextBlock Text="{Binding StatusText}" TextWrapping="Wrap"/></Border>
    </Grid>
</UserControl>
