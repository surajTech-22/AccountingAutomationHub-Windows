<Window x:Class="AccountingAutomationHub.Desktop.Views.AuditAccountingEntryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Accounting Entry · Audit" Width="760" Height="760" MinWidth="680" MinHeight="620"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource AppBackgroundBrush}">
    <Grid Margin="18">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="{Binding Title}" FontSize="24" FontWeight="SemiBold"/>
            <TextBlock Text="Audit-owned Accounting workbench. This does not select or change any Accounting client." Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>
        </StackPanel>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="160"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="Date" Margin="0,6"/><DatePicker Grid.Row="0" Grid.Column="1" SelectedDate="{Binding Draft.Date}"/>
                <TextBlock Grid.Row="1" Text="Reference" Margin="0,6"/><TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Draft.Reference, UpdateSourceTrigger=PropertyChanged}"/>
                <TextBlock Grid.Row="2" Text="Voucher Type" Margin="0,6"/><ComboBox Grid.Row="2" Grid.Column="1" IsEditable="True" ItemsSource="{Binding VoucherTypes}" Text="{Binding Draft.VoucherType, UpdateSourceTrigger=PropertyChanged}"/>
                <TextBlock Grid.Row="3" Text="Party / Counterparty" Margin="0,6"/><ComboBox Grid.Row="3" Grid.Column="1" IsEditable="True" IsTextSearchEnabled="True" ItemsSource="{Binding Ledgers}" Text="{Binding Draft.PartyOrLedger, UpdateSourceTrigger=PropertyChanged}"/>
                <TextBlock Grid.Row="4" Text="Posting / Business Ledger" Margin="0,6"/><ComboBox Grid.Row="4" Grid.Column="1" IsEditable="True" IsTextSearchEnabled="True" ItemsSource="{Binding Ledgers}" Text="{Binding Draft.BusinessLedger, UpdateSourceTrigger=PropertyChanged}"/>
                <TextBlock Grid.Row="5" Text="Debit" Margin="0,6"/><TextBox Grid.Row="5" Grid.Column="1" Text="{Binding Draft.Debit, UpdateSourceTrigger=PropertyChanged}"/>
                <TextBlock Grid.Row="6" Text="Credit" Margin="0,6"/><TextBox Grid.Row="6" Grid.Column="1" Text="{Binding Draft.Credit, UpdateSourceTrigger=PropertyChanged}"/>
                <TextBlock Grid.Row="7" Text="Amount" Margin="0,6"/><TextBox Grid.Row="7" Grid.Column="1" Text="{Binding Draft.Amount, UpdateSourceTrigger=PropertyChanged}"/>
                <TextBlock Grid.Row="8" Text="Taxable Value" Margin="0,6"/><TextBox Grid.Row="8" Grid.Column="1" Text="{Binding Draft.TaxableValue, UpdateSourceTrigger=PropertyChanged}"/>
                <TextBlock Grid.Row="9" Text="GST Rate %" Margin="0,6"/><TextBox Grid.Row="9" Grid.Column="1" Text="{Binding Draft.GstRate, UpdateSourceTrigger=PropertyChanged}"/>
                <TextBlock Grid.Row="10" Text="IGST" Margin="0,6"/><TextBox Grid.Row="10" Grid.Column="1" Text="{Binding Draft.Igst, UpdateSourceTrigger=PropertyChanged}"/>
                <TextBlock Grid.Row="11" Text="CGST" Margin="0,6"/><TextBox Grid.Row="11" Grid.Column="1" Text="{Binding Draft.Cgst, UpdateSourceTrigger=PropertyChanged}"/>
                <TextBlock Grid.Row="12" Text="SGST" Margin="0,6"/><TextBox Grid.Row="12" Grid.Column="1" Text="{Binding Draft.Sgst, UpdateSourceTrigger=PropertyChanged}"/>
                <TextBlock Grid.Row="13" Text="Cess" Margin="0,6"/><TextBox Grid.Row="13" Grid.Column="1" Text="{Binding Draft.Cess, UpdateSourceTrigger=PropertyChanged}"/>
                <TextBlock Grid.Row="14" Text="Cost Centre" Margin="0,6"/><TextBox Grid.Row="14" Grid.Column="1" Text="{Binding Draft.CostCentre, UpdateSourceTrigger=PropertyChanged}"/>
                <TextBlock Grid.Row="15" Text="Narration" Margin="0,6"/><TextBox Grid.Row="15" Grid.Column="1" MinHeight="70" AcceptsReturn="True" TextWrapping="Wrap" Text="{Binding Draft.Narration, UpdateSourceTrigger=PropertyChanged}"/>
                <TextBlock Grid.Row="16" Grid.ColumnSpan="2" Margin="0,12,0,0" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"
                           Text="Party/counterparty and the exact posting ledger are independent editable fields. Amount, voucher type, date and GST values are also editable. Saving creates/updates only the independent Audit working record; source evidence remains unchanged."/>
            </Grid>
        </ScrollViewer>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="Cancel" Width="90" Padding="12,7" IsCancel="True"/>
            <Button Content="Save Entry" Width="120" Padding="12,7" Margin="8,0,0,0" Click="Save_Click" IsDefault="True"/>
        </StackPanel>
    </Grid>
</Window>
