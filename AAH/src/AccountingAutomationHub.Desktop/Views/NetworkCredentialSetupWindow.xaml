<Window x:Class="AccountingAutomationHub.Desktop.Views.NetworkCredentialSetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AAH User Login" Height="390" Width="620" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource WindowBackgroundBrush}">
    <Grid Margin="20">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <TextBlock Text="AAH User ID &amp; Password" FontSize="22" FontWeight="SemiBold"/>
        <TextBlock Grid.Row="1" Margin="0,8,0,12" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}"
                   Text="The Administrator creates or resets this LAN login on the Main Server. A separate one-time MFA OTP is generated inside the Main Server application whenever this user opens the network app."/>
        <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="130"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="User ID" VerticalAlignment="Center"/><TextBox Grid.Column="1" Text="{Binding UserName}" IsReadOnly="True" Padding="8,6"/></Grid>
        <Grid Grid.Row="3" Margin="0,10,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="130"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="New password" VerticalAlignment="Center"/><PasswordBox Grid.Column="1" x:Name="PasswordBox" Padding="8,6"/></Grid>
        <Grid Grid.Row="4" Margin="0,10,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="130"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="Confirm password" VerticalAlignment="Center"/><PasswordBox Grid.Column="1" x:Name="ConfirmPasswordBox" Padding="8,6"/></Grid>
        <StackPanel Grid.Row="5" Margin="0,12,0,0"><TextBlock Text="Password requirement: at least 12 characters with a letter and number. Existing network sessions are revoked when the password is changed." TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}"/><TextBlock Text="{Binding StatusText}" TextWrapping="Wrap" Margin="0,12,0,0"/></StackPanel>
        <WrapPanel Grid.Row="6" HorizontalAlignment="Right" Margin="0,14,0,0"><Button Content="Cancel" IsCancel="True" Padding="12,7"/><Button Content="Save LAN Login" Click="Save_Click" IsDefault="True" Style="{StaticResource PrimaryButtonStyle}" Padding="12,7" Margin="8,0,0,0"/></WrapPanel>
    </Grid>
</Window>
