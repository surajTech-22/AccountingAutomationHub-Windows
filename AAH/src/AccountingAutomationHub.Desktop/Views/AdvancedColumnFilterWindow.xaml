<Window x:Class="AccountingAutomationHub.Desktop.Views.AdvancedColumnFilterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Advanced Column Filter" Width="480" Height="330" WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{DynamicResource AppBackgroundBrush}">
    <Grid Margin="18">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <TextBlock x:Name="TitleText" FontSize="20" FontWeight="SemiBold"/>
        <TextBlock Grid.Row="1" Text="Choose one condition. Exact value/date menus remain available from the column filter button." Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,14" TextWrapping="Wrap"/>
        <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="130"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <TextBlock Text="Condition" VerticalAlignment="Center"/><ComboBox x:Name="OperatorBox" Grid.Column="1" SelectedIndex="0" SelectionChanged="OperatorBox_SelectionChanged">
                <ComboBoxItem Content="Contains"/><ComboBoxItem Content="Does Not Contain"/><ComboBoxItem Content="Starts With"/><ComboBoxItem Content="Ends With"/>
                <ComboBoxItem Content="Equals"/><ComboBoxItem Content="Not Equal"/><ComboBoxItem Content="Greater Than"/><ComboBoxItem Content="Greater Or Equal"/>
                <ComboBoxItem Content="Less Than"/><ComboBoxItem Content="Less Or Equal"/><ComboBoxItem Content="Between"/>
            </ComboBox>
        </Grid>
        <Grid Grid.Row="3" Margin="0,10,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="130"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <TextBlock Text="Value" VerticalAlignment="Center"/><TextBox x:Name="Value1Box" Grid.Column="1" Padding="8,6"/>
        </Grid>
        <Grid Grid.Row="4" x:Name="SecondValuePanel" Visibility="Collapsed" Margin="0,10,0,0" VerticalAlignment="Top"><Grid.ColumnDefinitions><ColumnDefinition Width="130"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <TextBlock Text="And" VerticalAlignment="Center"/><TextBox x:Name="Value2Box" Grid.Column="1" Padding="8,6"/>
        </Grid>
        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Clear" Click="Clear_Click" Padding="12,7" Margin="0,0,8,0"/><Button Content="Cancel" IsCancel="True" Padding="12,7" Margin="0,0,8,0"/><Button Content="Apply" Click="Apply_Click" IsDefault="True" Style="{StaticResource PrimaryButtonStyle}" Padding="14,7"/>
        </StackPanel>
    </Grid>
</Window>
