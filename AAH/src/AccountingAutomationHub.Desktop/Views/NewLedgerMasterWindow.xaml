<Window x:Class="AccountingAutomationHub.Desktop.Views.NewLedgerMasterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="New Ledger"
        Width="650" Height="500"
        MinWidth="600" MinHeight="460"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        ShowInTaskbar="False"
        PreviewKeyDown="Window_PreviewKeyDown"
        Background="{DynamicResource AppBackgroundBrush}">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock x:Name="HeaderText" Text="New Ledger" FontSize="24" FontWeight="SemiBold"/>
            <TextBlock x:Name="IntroText" Text="Create one accounting Ledger under an existing Group. Type and source are fixed so a Ledger cannot accidentally become another Master type."
                       Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,5,0,0" TextWrapping="Wrap"/>
        </StackPanel>

        <Border Grid.Row="1" Margin="0,16,0,12" Padding="18"
                Background="White" BorderBrush="#D8E0EB" BorderThickness="1" CornerRadius="8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="170"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Text="Ledger Name" VerticalAlignment="Center"/>
                <TextBox x:Name="LedgerNameBox" Grid.Column="1" MinHeight="34" Padding="9,6"/>

                <TextBlock Grid.Row="1" Text="Under / Ledger Group" VerticalAlignment="Center" Margin="0,12,0,0"/>
                <ComboBox x:Name="GroupBox" Grid.Row="1" Grid.Column="1" Margin="0,12,0,0" MinHeight="34"
                          SelectionChanged="GroupBox_SelectionChanged"/>

                <TextBlock Grid.Row="2" Text="Parent Group" VerticalAlignment="Center" Margin="0,12,0,0"/>
                <TextBlock x:Name="ParentGroupText" Grid.Row="2" Grid.Column="1" Margin="0,12,0,0"
                           FontWeight="SemiBold" VerticalAlignment="Center"/>

                <TextBlock Grid.Row="3" Text="Opening Balance" VerticalAlignment="Center" Margin="0,12,0,0"/>
                <StackPanel Grid.Row="3" Grid.Column="1" Margin="0,12,0,0">
                    <TextBox x:Name="OpeningBalanceBox" MinHeight="34" Padding="9,6"/>
                    <TextBlock Text="Optional. Leave blank when no opening balance is required."
                               Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" Margin="0,3,0,0"/>
                </StackPanel>

                <TextBlock Grid.Row="4" Text="Company" VerticalAlignment="Center" Margin="0,12,0,0"/>
                <TextBlock x:Name="CompanyText" Grid.Row="4" Grid.Column="1" Margin="0,12,0,0" VerticalAlignment="Center"/>

                <TextBlock Grid.Row="5" Text="Master Source" VerticalAlignment="Center" Margin="0,12,0,0"/>
                <Border Grid.Row="5" Grid.Column="1" Margin="0,12,0,0" Padding="9,6" Background="#F5F8FC" CornerRadius="5">
                    <TextBlock Text="Manual Ledger" FontWeight="SemiBold"/>
                </Border>
            </Grid>
        </Border>

        <DockPanel Grid.Row="2" LastChildFill="True">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel" Click="Cancel_Click" Padding="15,8" Margin="8,0,0,0"/>
                <Button x:Name="ActionButton" Content="Create Ledger" Click="Create_Click" Style="{StaticResource PrimaryButtonStyle}" Padding="15,8" Margin="8,0,0,0"/>
            </StackPanel>
            <TextBlock x:Name="ValidationText" Foreground="#B42318" VerticalAlignment="Center" TextWrapping="Wrap"/>
        </DockPanel>
    </Grid>
</Window>
