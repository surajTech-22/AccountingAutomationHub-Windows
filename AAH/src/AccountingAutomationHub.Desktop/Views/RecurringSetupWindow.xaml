<Window x:Class="AccountingAutomationHub.Desktop.Views.RecurringSetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Recurring Transaction" Height="390" Width="520"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{DynamicResource AppBackgroundBrush}">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" Text="Recurring Transaction Schedule" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,16"/>
        <Grid Grid.Row="1" Margin="0,0,0,12">
            <Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <TextBlock Text="Profile Name" VerticalAlignment="Center"/>
            <TextBox x:Name="ProfileNameBox" Grid.Column="1" MinWidth="280"/>
        </Grid>
        <Grid Grid.Row="2" Margin="0,0,0,12">
            <Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <TextBlock Text="Frequency" VerticalAlignment="Center"/>
            <ComboBox x:Name="FrequencyBox" Grid.Column="1" SelectedIndex="2">
                <ComboBoxItem Content="Daily"/><ComboBoxItem Content="Weekly"/><ComboBoxItem Content="Monthly"/><ComboBoxItem Content="Quarterly"/><ComboBoxItem Content="Yearly"/>
            </ComboBox>
        </Grid>
        <Grid Grid.Row="3" Margin="0,0,0,12">
            <Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <TextBlock Text="First Run Date" VerticalAlignment="Center"/>
            <DatePicker x:Name="StartDatePicker" Grid.Column="1"/>
        </Grid>
        <Grid Grid.Row="4" Margin="0,0,0,12">
            <Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <TextBlock Text="End Date (optional)" VerticalAlignment="Center"/>
            <DatePicker x:Name="EndDatePicker" Grid.Column="1"/>
        </Grid>
        <TextBlock Grid.Row="5" Text="Each occurrence is created as a Draft so it can be reviewed before approval/export. The original transaction remains unchanged." TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,16"/>
        <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancel" IsCancel="True" MinWidth="90" Margin="0,0,8,0"/>
            <Button Content="Create Schedule" MinWidth="130" IsDefault="True" Click="Create_Click"/>
        </StackPanel>
    </Grid>
</Window>
