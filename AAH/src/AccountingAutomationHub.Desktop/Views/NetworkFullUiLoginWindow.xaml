<Window x:Class="AccountingAutomationHub.Desktop.Views.NetworkFullUiLoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Accounting Automation Hub · Network Login" Width="680" Height="620" MinWidth="560" MinHeight="480" ResizeMode="CanResize" WindowStartupLocation="CenterScreen"
        Background="{DynamicResource AppBackgroundBrush}">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <Grid Margin="24">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <TextBlock Text="Accounting Automation Hub" FontSize="25" FontWeight="SemiBold"/>
        <TextBlock Grid.Row="1" Text="AAH network login · local LAN and routed private/WireGuard access · permission-controlled Windows processing node" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,5,0,18"/>
        <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="145"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="Main Server" VerticalAlignment="Center"/><TextBox Grid.Column="1" x:Name="ServerBox" Padding="8,6"/></Grid>
        <Grid Grid.Row="3" Margin="0,10,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="145"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="User ID" VerticalAlignment="Center"/><TextBox Grid.Column="1" x:Name="UserBox" Padding="8,6"/></Grid>
        <Grid Grid.Row="4" Margin="0,10,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="145"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="Password" VerticalAlignment="Center"/><PasswordBox Grid.Column="1" x:Name="PasswordBox" Padding="8,6"/></Grid>
        <CheckBox Grid.Row="5" x:Name="SaveLoginBox" Content="Save User ID and password securely on this Windows PC" Margin="145,10,0,0"/>
        <Grid x:Name="EnrollmentPanel" Grid.Row="6" Margin="0,10,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="145"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Enrollment code" VerticalAlignment="Center"/><TextBox Grid.Column="1" x:Name="EnrollmentBox" MaxLength="8" Padding="8,6"/><Button x:Name="EnrollButton" Grid.Column="2" Content="Enroll This PC" Click="Enroll_Click" Padding="10,6" Margin="8,0,0,0"/></Grid>
        <Grid x:Name="RegistrationOtpPanel" Grid.Row="7" Margin="0,14,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="145"/><ColumnDefinition Width="160"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel VerticalAlignment="Center"><TextBlock Text="Registration OTP (one time)"/><TextBlock x:Name="OtpTypeText" Text="Auto: LAN / Private Network" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}"/></StackPanel><TextBox Grid.Column="1" x:Name="OtpBox" MaxLength="6" Padding="8,6"/><Button x:Name="RequestOtpButton" Grid.Column="2" Content="Request Registration OTP" Click="RequestOtp_Click" Padding="10,6" Margin="8,0,0,0"/><TextBlock Grid.Column="3" Text="Used only to verify this PC's registration. It is not requested for routine login. Verification is required again only after 30 days without opening AAH or when an Administrator resets this PC's registration trust." TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" Margin="10,0,0,0"/></Grid>
        <Border Grid.Row="8" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,14,0,0">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Main Server Updates" FontWeight="SemiBold"/><TextBlock x:Name="UpdateStatusText" Text="Update status will be checked automatically after this PC is enrolled." TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,8,0"/></StackPanel><Button x:Name="InstallUpdateButton" Grid.Column="1" Content="Update from Main Server" Click="InstallUpdate_Click" Padding="10,6" VerticalAlignment="Center" Visibility="Collapsed"/></Grid>
        </Border>
        <StackPanel Grid.Row="9" Margin="0,16,0,0"><TextBlock Text="{Binding StatusText}" TextWrapping="Wrap"/><TextBlock Text="This Windows node never opens or controls Tally; Tally remains on the validated Main Server/Tally host. After login it receives only the Client/FY data and permissions granted from Client Directory. Authorised import/accounting work may execute locally and synchronized background services keep shared state current when connectivity is available." TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,10,0,0"/></StackPanel>
        <WrapPanel Grid.Row="10" HorizontalAlignment="Right" Margin="0,18,0,0"><Button Content="Exit" IsCancel="True" Padding="12,7"/><Button x:Name="LoginButton" Content="Open AAH" Click="Login_Click" IsDefault="True" Style="{StaticResource PrimaryButtonStyle}" Padding="14,7" Margin="8,0,0,0"/></WrapPanel>
    </Grid>
    </ScrollViewer>
</Window>
