<Window x:Class="AccountingAutomationHub.Desktop.Views.ColumnValueFilterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Choose Filter Values" Width="450" Height="560" WindowStartupLocation="CenterOwner" Background="{DynamicResource AppBackgroundBrush}">
    <Grid Margin="14">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <TextBlock x:Name="TitleText" FontSize="19" FontWeight="SemiBold"/>
        <TextBox x:Name="SearchBox" Grid.Row="1" Margin="0,10,0,8" Padding="8,6" TextChanged="SearchBox_TextChanged" ToolTip="Search values"/>
        <WrapPanel Grid.Row="2" Margin="0,0,0,8"><Button Content="Select All" Click="SelectAll_Click" Padding="9,5" Margin="0,0,8,0"/><Button Content="Clear All" Click="ClearAll_Click" Padding="9,5"/><TextBlock x:Name="CountText" Margin="12,6,0,0" Foreground="{DynamicResource TextSecondaryBrush}"/></WrapPanel>
        <ListBox x:Name="ValuesList" Grid.Row="3" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"><ListBox.ItemTemplate><DataTemplate><CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" Content="{Binding Display}" Margin="4,3"/></DataTemplate></ListBox.ItemTemplate></ListBox>
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0"><Button Content="Cancel" IsCancel="True" Padding="12,7" Margin="0,0,8,0"/><Button Content="Apply" Click="Apply_Click" IsDefault="True" Style="{StaticResource PrimaryButtonStyle}" Padding="14,7"/></StackPanel>
    </Grid>
</Window>
