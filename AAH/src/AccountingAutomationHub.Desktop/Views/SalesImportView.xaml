<UserControl x:Class="AccountingAutomationHub.Desktop.Views.SalesImportView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:AccountingAutomationHub.Desktop.Views">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />

        <Style x:Key="FieldLabelStyle"
               TargetType="TextBlock">
            <Setter Property="FontSize" Value="10" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>

        <Style x:Key="InputTextBoxStyle"
               TargetType="TextBox">
            <Setter Property="MinHeight" Value="31" />
            <Setter Property="Padding" Value="8,5" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Background" Value="White" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <Style x:Key="SecondaryButtonStyle"
               TargetType="Button">
            <Setter Property="Background" Value="#F8FAFC" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>

        <Style x:Key="SummaryValueStyle"
               TargetType="TextBlock">
            <Setter Property="FontSize" Value="20" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style x:Key="SummaryLabelStyle"
               TargetType="TextBlock">
            <Setter Property="FontSize" Value="9" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="Margin" Value="0,2,0,0" />
        </Style>
    </UserControl.Resources>

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Style="{StaticResource CardBorderStyle}"
                Padding="0"
                Margin="0,0,0,8">
            <Expander IsExpanded="{Binding IsImportPanelExpanded, Mode=TwoWay}"
                      HorizontalContentAlignment="Stretch">
                <Expander.Header>
                    <Grid Height="48"
                          Margin="14,0,14,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Sales sync setup"
                                       FontSize="14"
                                       FontWeight="SemiBold" />
                            <TextBlock Text="GSTR-1 imports automatically. Manual Sales Registers can also be imported with the existing Excel-style header mapping and inventory rules."
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       FontSize="10"
                                       Margin="0,2,0,0" />
                        </StackPanel>

                        <StackPanel Grid.Column="1"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center">
                            <Border Background="{DynamicResource AccentSoftBrush}"
                                    CornerRadius="12"
                                    Padding="9,4"
                                    Margin="0,0,8,0">
                                <TextBlock Text="Automatic"
                                           Foreground="{DynamicResource AccentBrush}"
                                           FontSize="10"
                                           FontWeight="SemiBold" />
                            </Border>
                            <TextBlock Text="{Binding FinancialYear, Mode=OneWay, StringFormat={}FY {0}}"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       FontSize="10"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Grid>
                </Expander.Header>

                <Grid Margin="12,0,12,12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2.3*" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="1.1*" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="0.8*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Application E-returns root"
                                       Style="{StaticResource FieldLabelStyle}" />
                            <DockPanel>
                                <Button DockPanel.Dock="Right"
                                        Content="Change Root"
                                        Command="{Binding BrowseEReturnsRootCommand}"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Margin="7,0,0,0" />
                                <TextBox Text="{Binding EReturnsRootPath, Mode=OneWay}"
                                         Style="{StaticResource InputTextBoxStyle}"
                                         IsReadOnly="True" />
                            </DockPanel>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Active client GSTIN"
                                       Style="{StaticResource FieldLabelStyle}" />
                            <TextBox Text="{Binding ClientGstin, Mode=OneWay}"
                                     Style="{StaticResource InputTextBoxStyle}"
                                     IsReadOnly="True" />
                        </StackPanel>

                        <StackPanel Grid.Column="4">
                            <TextBlock Text="Financial year"
                                       Style="{StaticResource FieldLabelStyle}" />
                            <TextBox Text="{Binding FinancialYear, Mode=OneWay}"
                                     Style="{StaticResource InputTextBoxStyle}"
                                     IsReadOnly="True" />
                        </StackPanel>
                    </Grid>

                    <Grid Grid.Row="1"
                          Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel>
                            <CheckBox Content="Save source files (reserved for the future storage plan)"
                                      IsChecked="{Binding SaveSourceFiles}"
                                      IsEnabled="False"
                                      FontSize="10"
                                      Foreground="{DynamicResource TextSecondaryBrush}" />
                            <TextBlock Text="All E-returns and Downloads JSON/ZIP sources are read-only. No source file is moved, copied, renamed, deleted or extracted."
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       FontSize="9"
                                       Margin="0,3,0,0"
                                       TextWrapping="Wrap" />
                        </StackPanel>

                        <Button Grid.Column="1"
                                Content="Cancel"
                                Command="{Binding CancelCommand}"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Margin="12,0,0,0"
                                VerticalAlignment="Center" />
                    </Grid>
                </Grid>
            </Expander>
        </Border>

        <Border Grid.Row="1"
                Style="{StaticResource CardBorderStyle}"
                Padding="12"
                Margin="0,0,0,8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="{Binding StatusText, Mode=OneWay}"
                               FontWeight="SemiBold"
                               FontSize="11"
                               TextWrapping="Wrap" />

                    <TextBlock Grid.Column="1"
                               Text="{Binding ProgressPercent, Mode=OneWay, StringFormat={}{0}%}"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               FontSize="10"
                               Margin="12,0,0,0" />
                </Grid>

                <ProgressBar Grid.Row="1"
                             Minimum="0"
                             Maximum="100"
                             Value="{Binding ProgressPercent, Mode=OneWay}"
                             Height="6"
                             Margin="0,8,0,0"
                             Foreground="{DynamicResource AccentBrush}" />

                <TextBlock Grid.Row="2"
                           Text="{Binding SourceVerificationText, Mode=OneWay}"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           FontSize="9"
                           Margin="0,6,0,0"
                           TextWrapping="Wrap" />
            </Grid>
        </Border>

        <Grid Grid.Row="2"
              Margin="0,0,0,8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <UniformGrid Columns="9">
                <Border Style="{StaticResource CardBorderStyle}" Padding="10" Margin="0,0,6,0" Cursor="Hand" Tag="Sales" MouseLeftButtonUp="SummaryTile_MouseLeftButtonUp" ToolTip="Open Sales rows">
                    <StackPanel><TextBlock Text="{Binding Summary.SalesRows, Mode=OneWay}" Style="{StaticResource SummaryValueStyle}" /><TextBlock Text="SALES" Style="{StaticResource SummaryLabelStyle}" /></StackPanel>
                </Border>
                <Border Style="{StaticResource CardBorderStyle}" Padding="10" Margin="0,0,6,0" Cursor="Hand" Tag="Credit Notes" MouseLeftButtonUp="SummaryTile_MouseLeftButtonUp" ToolTip="Open Credit Note rows">
                    <StackPanel><TextBlock Text="{Binding Summary.CreditNoteRows, Mode=OneWay}" Style="{StaticResource SummaryValueStyle}" /><TextBlock Text="CREDIT NOTES" Style="{StaticResource SummaryLabelStyle}" /></StackPanel>
                </Border>
                <Border Padding="10" Margin="0,0,6,0" Cursor="Hand" Tag="B2B" MouseLeftButtonUp="SummaryTile_MouseLeftButtonUp" ToolTip="Open B2B Customer Names: Matched / Not Matched by GSTIN">
                    <Border.Style>
                        <Style TargetType="Border" BasedOn="{StaticResource CardBorderStyle}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding AreAllB2BCustomersMatched}" Value="True">
                                    <Setter Property="Background" Value="#DCFCE7" />
                                    <Setter Property="BorderBrush" Value="#22C55E" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel>
                        <TextBlock Text="{Binding Summary.B2BRows, Mode=OneWay}" Style="{StaticResource SummaryValueStyle}" />
                        <TextBlock Text="B2B" Style="{StaticResource SummaryLabelStyle}" />
                        <TextBlock Text="{Binding B2BCompletionText}" FontSize="8" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource CardBorderStyle}" Padding="10" Margin="0,0,6,0" Cursor="Hand" Tag="B2C" MouseLeftButtonUp="SummaryTile_MouseLeftButtonUp" ToolTip="Open B2C Customer Names: Matched / Not Matched">
                    <StackPanel><TextBlock Text="{Binding Summary.B2CRows, Mode=OneWay}" Style="{StaticResource SummaryValueStyle}" /><TextBlock Text="B2C" Style="{StaticResource SummaryLabelStyle}" /></StackPanel>
                </Border>
                <Border Style="{StaticResource CardBorderStyle}" Padding="10" Margin="0,0,6,0" Cursor="Hand" Tag="All" MouseLeftButtonUp="SummaryTile_MouseLeftButtonUp" ToolTip="Open all Sales rows; Export rows are included">
                    <StackPanel><TextBlock Text="{Binding Summary.ExportRows, Mode=OneWay}" Style="{StaticResource SummaryValueStyle}" /><TextBlock Text="EXPORT" Style="{StaticResource SummaryLabelStyle}" /></StackPanel>
                </Border>
                <Border Style="{StaticResource CardBorderStyle}" Padding="10" Margin="0,0,6,0" Cursor="Hand" Tag="All" MouseLeftButtonUp="SummaryTile_MouseLeftButtonUp" ToolTip="Open all Sales rows; Amendment rows are included">
                    <StackPanel><TextBlock Text="{Binding Summary.AmendmentRows, Mode=OneWay}" Style="{StaticResource SummaryValueStyle}" /><TextBlock Text="AMENDMENTS" Style="{StaticResource SummaryLabelStyle}" /></StackPanel>
                </Border>
                <Border Style="{StaticResource CardBorderStyle}" Padding="10" Margin="0,0,6,0" Cursor="Hand" Tag="Issues" MouseLeftButtonUp="SummaryTile_MouseLeftButtonUp" ToolTip="Open Sales import issues">
                    <StackPanel><TextBlock Text="{Binding Summary.InvalidRowsSkipped, Mode=OneWay}" Style="{StaticResource SummaryValueStyle}" /><TextBlock Text="INVALID" Style="{StaticResource SummaryLabelStyle}" /></StackPanel>
                </Border>
                <Border Style="{StaticResource CardBorderStyle}" Padding="10" Margin="0,0,6,0" Cursor="Hand" Tag="All" MouseLeftButtonUp="SummaryTile_MouseLeftButtonUp" ToolTip="Open all Sales rows; inventory rows are included">
                    <StackPanel><TextBlock Text="{Binding InventoryRows, Mode=OneWay}" Style="{StaticResource SummaryValueStyle}" /><TextBlock Text="INVENTORY ROWS" Style="{StaticResource SummaryLabelStyle}" /></StackPanel>
                </Border>
                <Border Padding="10" CornerRadius="8" BorderThickness="1" Cursor="Hand" Tag="Issues" MouseLeftButtonUp="SummaryTile_MouseLeftButtonUp" ToolTip="Open Sales issues / action required">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="White"/>
                            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasActionRequired}" Value="True">
                                    <Setter Property="Background" Value="#FEE2E2"/>
                                    <Setter Property="BorderBrush" Value="#EF4444"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel><TextBlock Text="{Binding ActionRequiredCount, Mode=OneWay}" Style="{StaticResource SummaryValueStyle}" /><TextBlock Text="ACTION REQUIRED" Style="{StaticResource SummaryLabelStyle}" /></StackPanel>
                </Border>
            </UniformGrid>

            <StackPanel Grid.Row="1"
                        Margin="0,6,0,0">
                <WrapPanel HorizontalAlignment="Right" Margin="0,0,0,6">
                    <Button Content="Open Journal" Click="OpenJournal_Click" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,6,0" ToolTip="Open the linked Journal Center (Ctrl+6)" />
                    <Button Content="Open GSTR-3B" Click="OpenGstr3b_Click" Style="{StaticResource SecondaryButtonStyle}" ToolTip="Open GSTR-3B Reconciliation (Ctrl+7)" />
                </WrapPanel>
                <Border Background="#FEF3C7"
                        BorderBrush="#FCD34D"
                        BorderThickness="1"
                        CornerRadius="7"
                        Padding="8"
                        Visibility="{Binding HasWarning, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <TextBlock Text="{Binding WarningText, Mode=OneWay}"
                               Foreground="#92400E"
                               FontSize="9"
                               TextWrapping="Wrap" />
                </Border>

                <Border Background="#FEE2E2"
                        BorderBrush="#FCA5A5"
                        BorderThickness="1"
                        CornerRadius="7"
                        Padding="8"
                        Margin="0,5,0,0"
                        Visibility="{Binding HasError, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <TextBlock Text="{Binding ErrorText, Mode=OneWay}"
                               Foreground="#991B1B"
                               FontSize="10"
                               FontWeight="SemiBold"
                               TextWrapping="Wrap" />
                </Border>
            </StackPanel>
        </Grid>

        <Border Grid.Row="3"
                Style="{StaticResource CardBorderStyle}"
                Padding="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0"
                        Background="#F8FAFC"
                        Padding="9"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="0,0,0,1">
                    <DockPanel LastChildFill="True">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Content="Reimport Sales"
                                    Command="{Binding ReimportCommand}"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    ToolTip="For multiple-GSTIN clients, choose which registrations to reimport. Uses the same GSTR-1 Sales importer and retains other GSTIN records."/>
                            <Button x:Name="ReimportSalesMonthButton"
                                    Content="▼"
                                    Click="ReimportSalesMonthButton_Click"
                                    IsEnabled="{Binding CanReimportSales}"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Margin="2,0,6,0"
                                    MinWidth="30"
                                    Padding="7,4"
                                    ToolTip="Reimport one Sales month and choose the GSTINs; other GSTINs and Sales months remain unchanged.">
                                <Button.ContextMenu>
                                    <ContextMenu Placement="Bottom">
                                        <MenuItem Header="April" Tag="4" Click="ReimportSalesMonthMenuItem_Click" />
                                        <MenuItem Header="May" Tag="5" Click="ReimportSalesMonthMenuItem_Click" />
                                        <MenuItem Header="June" Tag="6" Click="ReimportSalesMonthMenuItem_Click" />
                                        <MenuItem Header="July" Tag="7" Click="ReimportSalesMonthMenuItem_Click" />
                                        <MenuItem Header="August" Tag="8" Click="ReimportSalesMonthMenuItem_Click" />
                                        <MenuItem Header="September" Tag="9" Click="ReimportSalesMonthMenuItem_Click" />
                                        <MenuItem Header="October" Tag="10" Click="ReimportSalesMonthMenuItem_Click" />
                                        <MenuItem Header="November" Tag="11" Click="ReimportSalesMonthMenuItem_Click" />
                                        <MenuItem Header="December" Tag="12" Click="ReimportSalesMonthMenuItem_Click" />
                                        <MenuItem Header="January" Tag="1" Click="ReimportSalesMonthMenuItem_Click" />
                                        <MenuItem Header="February" Tag="2" Click="ReimportSalesMonthMenuItem_Click" />
                                        <MenuItem Header="March" Tag="3" Click="ReimportSalesMonthMenuItem_Click" />
                                    </ContextMenu>
                                </Button.ContextMenu>
                            </Button>
                            <Button Content="Import Sales Register" Command="{Binding ManualImportCommand}" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,2,0"/>
                            <Button Content="Remap" Command="{Binding RemapSalesRegisterCommand}" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,6,0" Padding="8,4" MinWidth="54" ToolTip="Open and replace the saved Sales Register mapping without importing rows."/>
                            <Button Content="Item Names" Command="{Binding ItemNameMappingCommand}" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,6,0" ToolTip="Enter/select an Item Name and apply it to all inventory-eligible entries or only selected entries. Blank Item Name rows are included."/>
                            <Button Content="Units" Command="{Binding UnitMappingCommand}" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,6,0"/>
                            <Button Content="Quantity Conversion" Command="{Binding QuantityConversionCommand}" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,6,0"/>
                            <Button Content="Clear Module" Command="{Binding ClearModuleCommand}" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,6,0" ToolTip="Clear only this Client + FY Sales/Credit Note transactions from AAH. Masters, mappings, source links and Tally vouchers are preserved."/>
                            
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="Sales and Credit Note rows are editable"
                                       FontSize="11"
                                       FontWeight="SemiBold" />
                            <TextBlock Text="Sales and Credit Note edits save automatically and refresh the linked Journal and GST/GSTR-3B views. Optional Sales columns appear only when imported data contains them; Item Name, Unit and Quantity Conversion tools remain client-specific."
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       FontSize="9"
                                       Margin="0,2,0,0" />
                            <TextBlock Text="{Binding EditStatusText, Mode=OneWay}"
                                       Foreground="{DynamicResource AccentBrush}"
                                       FontSize="9"
                                       FontWeight="SemiBold"
                                       Margin="0,2,0,0" />
                        </StackPanel>
                    </DockPanel>
                </Border>

                <TabControl x:Name="RecordsTabs" Grid.Row="1">
                    <TabItem Header="Sales">
                        <views:SalesRecordsGrid ItemsSource="{Binding SalesRows, Mode=OneWay}" />
                    </TabItem>
                    <TabItem Header="Credit Notes">
                        <views:SalesRecordsGrid ItemsSource="{Binding CreditNoteRows, Mode=OneWay}" />
                    </TabItem>
                    <TabItem Header="All">
                        <views:SalesRecordsGrid ItemsSource="{Binding AllRows, Mode=OneWay}" />
                    </TabItem>
                    <TabItem Header="Issues">
                        <DataGrid ItemsSource="{Binding Issues, Mode=OneWay}"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  CanUserAddRows="False"
                                  HeadersVisibility="Column"
                                  GridLinesVisibility="Horizontal"
                                  AlternatingRowBackground="#F8FAFC"
                                  BorderThickness="0"
                                  RowHeaderWidth="0">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Source File" Binding="{Binding SourceFile}" Width="220" />
                                <DataGridTextColumn Header="Section" Binding="{Binding Section}" Width="140" />
                                <DataGridTextColumn Header="Row" Binding="{Binding RowNumber}" Width="70" />
                                <DataGridTextColumn Header="Issue" Binding="{Binding Message}" Width="*" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </TabItem>
                </TabControl>
            </Grid>
        </Border>
    </Grid>
</UserControl>
