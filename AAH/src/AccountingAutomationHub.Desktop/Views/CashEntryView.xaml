<UserControl x:Class="AccountingAutomationHub.Desktop.Views.CashEntryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:AccountingAutomationHub.Desktop.Controls"
             MinWidth="900" MinHeight="620">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <DataTemplate x:Key="LedgerPickerItemTemplate">
            <Grid MinWidth="500" Margin="6,4" ToolTip="{Binding HoverText}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="{Binding Name, Mode=OneWay}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding GroupText, Mode=OneWay}" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}"/>
                </StackPanel>
                <StackPanel Grid.Column="1" HorizontalAlignment="Right" Margin="16,0,0,0">
                    <TextBlock Text="{Binding BalanceText, Mode=OneWay}" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                    <TextBlock Text="{Binding ActivityText, Mode=OneWay}" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Right"/>
                </StackPanel>
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Background="{DynamicResource AppBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Margin="20,16,20,10">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Cash Center" FontSize="24" FontWeight="SemiBold"/>
                <TextBlock Text="Cash Book with Payment, Receipt, Contra, recurring, reversal, clone, approval and workbook-equivalent mapping"
                           Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,0"/>
                <TextBlock Text="{Binding Core.AccountingPermissionSummary}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="10" Margin="0,3,0,0"/>
            </StackPanel>
            <Button Grid.Column="1" Content="Refresh" Command="{Binding Core.RefreshCommand}" Margin="5" Padding="14,8"/>
        </Grid>

        <UniformGrid Grid.Row="1" Columns="6" Margin="20,0,20,10" DataContext="{Binding Core}">
            <Border Margin="4" Padding="12" BorderBrush="#D8DEE9" BorderThickness="1" CornerRadius="8"><StackPanel><TextBlock Text="{Binding CashOpeningBalance, Mode=OneWay, StringFormat=N2}" FontSize="20"/><TextBlock Text="Opening Cash" Foreground="{DynamicResource TextSecondaryBrush}"/></StackPanel></Border>
            <Border Margin="4" Padding="12" BorderBrush="#D8DEE9" BorderThickness="1" CornerRadius="8"><StackPanel><TextBlock Text="{Binding CashReceiptTotal, Mode=OneWay, StringFormat=N2}" FontSize="20"/><TextBlock Text="Receipts" Foreground="{DynamicResource TextSecondaryBrush}"/></StackPanel></Border>
            <Border Margin="4" Padding="12" BorderBrush="#D8DEE9" BorderThickness="1" CornerRadius="8"><StackPanel><TextBlock Text="{Binding CashPaymentTotal, Mode=OneWay, StringFormat=N2}" FontSize="20"/><TextBlock Text="Payments" Foreground="{DynamicResource TextSecondaryBrush}"/></StackPanel></Border>
            <Border Margin="4" Padding="12" BorderBrush="#D8DEE9" BorderThickness="1" CornerRadius="8"><StackPanel><TextBlock Text="{Binding CashClosingBalance, Mode=OneWay, StringFormat=N2}" FontSize="20" FontWeight="SemiBold"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/><Style.Triggers><DataTrigger Binding="{Binding IsCashClosingNegative}" Value="True"><Setter Property="Foreground" Value="#B42318"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock><TextBlock Text="Closing Cash" Foreground="{DynamicResource TextSecondaryBrush}"/></StackPanel></Border>
            <Border Margin="4" Padding="12" BorderBrush="#D8DEE9" BorderThickness="1" CornerRadius="8"><StackPanel><TextBlock Text="{Binding CashApprovedCount, Mode=OneWay}" FontSize="22"/><TextBlock Text="Approved" Foreground="{DynamicResource TextSecondaryBrush}"/><TextBlock Text="{Binding CashReadyCount, StringFormat=Ready: {0:N0}}" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}"/></StackPanel></Border>
            <Border Margin="4" Padding="12" BorderBrush="#D8DEE9" BorderThickness="1" CornerRadius="8"><StackPanel><TextBlock Text="{Binding CashAttentionCount, Mode=OneWay}" FontSize="22"/><TextBlock Text="Attention" Foreground="{DynamicResource TextSecondaryBrush}"/><TextBlock Text="{Binding CashContraCount, StringFormat=Contra: {0:N0}}" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}"/></StackPanel></Border>
        </UniformGrid>

        <controls:MultiSearchFilterBar x:Name="CashSearchFilterBar" Grid.Row="2" Margin="20,0,20,8" />

        <TabControl Grid.Row="3" Margin="20,0,20,8" DataContext="{Binding Core}">
            <TabItem Header="Cash Entry">
                <Grid Margin="8">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="310"/></Grid.ColumnDefinitions>

                    <DataGrid x:Name="CashDebitCreditGrid"
                              ItemsSource="{Binding CashEntries}"
                              SelectedItem="{Binding SelectedCashEntry}"
                              Visibility="{Binding IsDebitCreditLayout, Converter={StaticResource BooleanToVisibilityConverter}}"
                              SelectionMode="Extended" SelectionUnit="FullRow"
                              AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="{Binding IsAccountingReadOnly}" RowEditEnding="CashEntryGrid_RowEditEnding"
                              PreviewKeyDown="CashSelectorGrid_PreviewKeyDown" PreviewTextInput="CashSelectorGrid_PreviewTextInput">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Date" Binding="{Binding EntryDate, StringFormat=dd.MM.yyyy}" Width="100"/>
                            <DataGridTemplateColumn Header="Ledger Name" Width="290">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <controls:LedgerPicker IsEnabled="{Binding DataContext.CanEditAccounting, RelativeSource={RelativeSource AncestorType=DataGrid}}" SourceItems="{Binding DataContext.LedgerPickerOptions, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                               Text="{Binding EntryLedger, Mode=TwoWay, UpdateSourceTrigger=Explicit}"
                                                               ItemTemplate="{StaticResource LedgerPickerItemTemplate}"
                                                               HorizontalContentAlignment="Stretch"
                                                               VerticalContentAlignment="Center"
                                                               MinHeight="30" Padding="6,2" Margin="2,1"
                                                               SelectionChanged="CashLedgerPicker_SelectionChanged"
                                                               ToolTip="{Binding ClosingBalanceSuggestionText}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Debit Amount" Width="140">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel>
                                            <TextBox Text="{Binding Debit, Mode=TwoWay, UpdateSourceTrigger=LostFocus, StringFormat=N2}" IsReadOnly="{Binding DataContext.IsAccountingReadOnly, RelativeSource={RelativeSource AncestorType=DataGrid}}" BorderThickness="0" Background="Transparent" Padding="3,1"/>
                                            <TextBlock Text="{Binding SuggestedDebitAmount, Mode=OneWay}" FontSize="9" FontStyle="Italic"
                                                       Foreground="{DynamicResource TextSecondaryBrush}" Margin="3,0,0,1"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Credit Amount" Width="140">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel>
                                            <TextBox Text="{Binding Credit, Mode=TwoWay, UpdateSourceTrigger=LostFocus, StringFormat=N2}" IsReadOnly="{Binding DataContext.IsAccountingReadOnly, RelativeSource={RelativeSource AncestorType=DataGrid}}" BorderThickness="0" Background="Transparent" Padding="3,1"/>
                                            <TextBlock Text="{Binding SuggestedCreditAmount, Mode=OneWay}" FontSize="9" FontStyle="Italic"
                                                       Foreground="{DynamicResource TextSecondaryBrush}" Margin="3,0,0,1"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Reference" Binding="{Binding ReferenceNumber}" Width="130"/>
                            <DataGridTextColumn Header="Narration" Binding="{Binding Narration}" Width="95*" MinWidth="360"/>
                            <DataGridTextColumn Header="Voucher" Binding="{Binding VoucherType, Mode=OneWay}" IsReadOnly="True" Width="90"/>
                            <DataGridTextColumn Header="Workflow" Binding="{Binding WorkflowStatus, Mode=OneWay}" IsReadOnly="True" Width="95"/>
                            <DataGridTextColumn Header="Validation" Binding="{Binding Status, Mode=OneWay}" IsReadOnly="True" Width="150"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <DataGrid x:Name="CashSingleAmountGrid"
                              ItemsSource="{Binding CashEntries}"
                              SelectedItem="{Binding SelectedCashEntry}"
                              Visibility="{Binding IsSingleAmountLayout, Converter={StaticResource BooleanToVisibilityConverter}}"
                              SelectionMode="Extended" SelectionUnit="FullRow"
                              AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="{Binding IsAccountingReadOnly}" RowEditEnding="CashEntryGrid_RowEditEnding"
                              PreviewKeyDown="CashSelectorGrid_PreviewKeyDown" PreviewTextInput="CashSelectorGrid_PreviewTextInput">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Date" Binding="{Binding EntryDate, StringFormat=dd.MM.yyyy}" Width="100"/>
                            <DataGridTemplateColumn Header="Ledger Name" Width="290">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <controls:LedgerPicker IsEnabled="{Binding DataContext.CanEditAccounting, RelativeSource={RelativeSource AncestorType=DataGrid}}" SourceItems="{Binding DataContext.LedgerPickerOptions, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                               Text="{Binding EntryLedger, Mode=TwoWay, UpdateSourceTrigger=Explicit}"
                                                               ItemTemplate="{StaticResource LedgerPickerItemTemplate}"
                                                               HorizontalContentAlignment="Stretch"
                                                               VerticalContentAlignment="Center"
                                                               MinHeight="30" Padding="6,2" Margin="2,1"
                                                               SelectionChanged="CashLedgerPicker_SelectionChanged"
                                                               ToolTip="{Binding ClosingBalanceSuggestionText}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Amount" Width="140">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel>
                                            <TextBox Text="{Binding SingleAmount, Mode=TwoWay, UpdateSourceTrigger=LostFocus, StringFormat=N2}" IsReadOnly="{Binding DataContext.IsAccountingReadOnly, RelativeSource={RelativeSource AncestorType=DataGrid}}" BorderThickness="0" Background="Transparent" Padding="3,1"/>
                                            <TextBlock Text="{Binding SuggestedSingleAmount, Mode=OneWay}" FontSize="9" FontStyle="Italic"
                                                       Foreground="{DynamicResource TextSecondaryBrush}" Margin="3,0,0,1"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Reference" Binding="{Binding ReferenceNumber}" Width="130"/>
                            <DataGridTextColumn Header="Narration" Binding="{Binding Narration}" Width="95*" MinWidth="320"/>
                            <DataGridTemplateColumn Header="Dr/Cr" Width="95">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel>
                                            <TextBox Text="{Binding SingleDrCr, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" IsReadOnly="{Binding DataContext.IsAccountingReadOnly, RelativeSource={RelativeSource AncestorType=DataGrid}}" BorderThickness="0" Background="Transparent" Padding="3,1"/>
                                            <TextBlock Text="{Binding SuggestedSingleDrCr, Mode=OneWay}" FontSize="9" FontStyle="Italic"
                                                       Foreground="{DynamicResource TextSecondaryBrush}" Margin="3,0,0,1"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Voucher" Binding="{Binding VoucherType, Mode=OneWay}" IsReadOnly="True" Width="90"/>
                            <DataGridTextColumn Header="Workflow" Binding="{Binding WorkflowStatus, Mode=OneWay}" IsReadOnly="True" Width="95"/>
                            <DataGridTextColumn Header="Validation" Binding="{Binding Status, Mode=OneWay}" IsReadOnly="True" Width="150"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <Border Grid.Column="2" BorderBrush="#D8DEE9" BorderThickness="1" CornerRadius="6" Padding="4">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                      CanContentScroll="False" Padding="8">
                        <StackPanel>
                            <TextBlock Text="Cash Entry Control" FontWeight="SemiBold" FontSize="16" Margin="0,0,0,8"/>
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <Button Content="Add Voucher" Command="{Binding AddCashEntryCommand}" Padding="10,7"/>
                                <Button Grid.Column="2" Content="Excel Entry Format" Command="{Binding ExportCashExcelFormatCommand}" Padding="10,7"/>
                            </Grid>

                            <Border Background="{DynamicResource SurfaceAltBrush}" BorderBrush="#B9C7D8" BorderThickness="1" CornerRadius="7" Padding="10" Margin="0,0,0,12"
                                    Visibility="{Binding IsCashVoucherEditorOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <StackPanel>
                                    <TextBlock Text="New Cash Voucher" FontWeight="SemiBold" FontSize="14"/>
                                    <TextBlock Text="Complete the voucher here, then Save Voucher. The row is not added to the Cash Book until it passes validation."
                                               FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,2,0,8"/>
                                    <TextBlock Text="Date" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    <DatePicker SelectedDate="{Binding CashVoucherDraft.EntryDate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="0,3,0,7"/>
                                    <TextBlock Text="Ledger" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    <controls:LedgerPicker IsEnabled="{Binding CanEditAccounting}" SourceItems="{Binding LedgerPickerOptions}"
                                                           Text="{Binding CashVoucherDraft.EntryLedger, Mode=TwoWay, UpdateSourceTrigger=Explicit}"
                                                           ItemTemplate="{StaticResource LedgerPickerItemTemplate}"
                                                           SelectionChanged="CashLedgerPicker_SelectionChanged"
                                                           HorizontalContentAlignment="Stretch" MinHeight="32" Padding="6,2" Margin="0,3,0,7"
                                                           ToolTip="{Binding CashVoucherDraft.ClosingBalanceSuggestionText}"/>

                                    <Grid Visibility="{Binding IsDebitCreditLayout, Converter={StaticResource BooleanToVisibilityConverter}}" Margin="0,0,0,7">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="Debit" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                            <TextBox Text="{Binding CashVoucherDraft.Debit, Mode=TwoWay, UpdateSourceTrigger=LostFocus, StringFormat=N2}" IsReadOnly="{Binding IsAccountingReadOnly}" Padding="7,4" Margin="0,3,0,0"/>
                                            <TextBlock Text="{Binding CashVoucherDraft.SuggestedDebitAmount, Mode=OneWay}" FontSize="9" FontStyle="Italic" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="Credit" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                            <TextBox Text="{Binding CashVoucherDraft.Credit, Mode=TwoWay, UpdateSourceTrigger=LostFocus, StringFormat=N2}" IsReadOnly="{Binding IsAccountingReadOnly}" Padding="7,4" Margin="0,3,0,0"/>
                                            <TextBlock Text="{Binding CashVoucherDraft.SuggestedCreditAmount, Mode=OneWay}" FontSize="9" FontStyle="Italic" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                        </StackPanel>
                                    </Grid>

                                    <Grid Visibility="{Binding IsSingleAmountLayout, Converter={StaticResource BooleanToVisibilityConverter}}" Margin="0,0,0,7">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="96"/></Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="Amount" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                            <TextBox Text="{Binding CashVoucherDraft.SingleAmount, Mode=TwoWay, UpdateSourceTrigger=LostFocus, StringFormat=N2}" IsReadOnly="{Binding IsAccountingReadOnly}" Padding="7,4" Margin="0,3,0,0"/>
                                            <TextBlock Text="{Binding CashVoucherDraft.SuggestedSingleAmount, Mode=OneWay}" FontSize="9" FontStyle="Italic" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="Dr / Cr" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                            <ComboBox IsEnabled="{Binding CanEditAccounting}" SelectedValue="{Binding CashVoucherDraft.SingleDrCr, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" SelectedValuePath="Content" Padding="6,3" Margin="0,3,0,0">
                                                <ComboBoxItem Content="Dr"/><ComboBoxItem Content="Cr"/>
                                            </ComboBox>
                                            <TextBlock Text="{Binding CashVoucherDraft.SuggestedSingleDrCr, Mode=OneWay}" FontSize="9" FontStyle="Italic" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                        </StackPanel>
                                    </Grid>

                                    <TextBlock Text="Common Ledger" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    <controls:SearchableComboBox IsEnabled="{Binding CanEditAccounting}" SourceItems="{Binding CashInHandLedgerNames}" Text="{Binding CashVoucherDraft.CommonLedger, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                         AllowCustomText="False" OpenOnFocus="True" Margin="0,3,0,7"/>
                                    <TextBlock Text="Reference" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    <TextBox Text="{Binding CashVoucherDraft.ReferenceNumber, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{Binding IsAccountingReadOnly}" Padding="7,4" Margin="0,3,0,7"/>
                                    <TextBlock Text="Narration" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    <TextBox Text="{Binding CashVoucherDraft.Narration, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{Binding IsAccountingReadOnly}" Padding="7,5" MinHeight="54" TextWrapping="Wrap" AcceptsReturn="True" Margin="0,3,0,8"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <Button Content="Save Voucher" Command="{Binding SaveCashVoucherCommand}" Padding="10,7"/>
                                        <Button Grid.Column="2" Content="Cancel" Command="{Binding CancelCashVoucherCommand}" Padding="10,7"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Border Background="{DynamicResource SurfaceAltBrush}" CornerRadius="6" Padding="10" Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Text="Selected Ledger Total" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    <TextBlock Text="{Binding SelectedCashLedgerName, Mode=OneWay}" FontWeight="SemiBold" FontSize="14" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding SelectedCashLedgerGroup, Mode=OneWay}" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,1,0,8" TextTrimming="CharacterEllipsis"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                        <TextBlock Text="Opening" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                        <TextBlock Grid.Column="1" Text="{Binding SelectedCashLedgerOpeningText, Mode=OneWay}" FontWeight="SemiBold"/>
                                        <TextBlock Grid.Row="1" Text="Debit to date" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,3,0,0"/>
                                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SelectedCashLedgerDebitText, Mode=OneWay}" Margin="8,3,0,0"/>
                                        <TextBlock Grid.Row="2" Text="Credit to date" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,3,0,0"/>
                                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding SelectedCashLedgerCreditText, Mode=OneWay}" Margin="8,3,0,0"/>
                                        <TextBlock Grid.Row="3" Text="{Binding SelectedCashLedgerAsOnLabel, Mode=OneWay}" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,5,0,0"/>
                                        <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding SelectedCashLedgerAsOnText, Mode=OneWay}" FontWeight="SemiBold" Margin="8,5,0,0"/>
                                        <TextBlock Grid.Row="4" Text="FY Closing" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,3,0,0"/>
                                        <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding SelectedCashLedgerClosingText, Mode=OneWay}" FontWeight="SemiBold" Margin="8,3,0,0"/>
                                    </Grid>
                                    <TextBlock Text="{Binding SelectedCashLedgerActivityText, Mode=OneWay}" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,7,0,0" TextWrapping="Wrap"/>
                                    <TextBlock Text="{Binding SelectedCashLedgerTotalStatus, Mode=OneWay}" FontSize="9" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>
                            <TextBlock Text="Opening Cash Balance" Foreground="{DynamicResource TextSecondaryBrush}"/>
                            <TextBox Text="{Binding CashSettings.OpeningBalance, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{Binding IsAccountingReadOnly}" Margin="0,4,0,10" Padding="8,5"/>
                            <TextBlock Text="Default Common Ledger" Foreground="{DynamicResource TextSecondaryBrush}"/>
                            <controls:SearchableComboBox IsEnabled="{Binding CanEditAccounting}" SourceItems="{Binding CashInHandLedgerNames}" Text="{Binding CashSettings.DefaultCommonLedger, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                         AllowCustomText="False" OpenOnFocus="True" Margin="0,4,0,10"/>
                            <TextBlock Text="Layout" Foreground="{DynamicResource TextSecondaryBrush}"/>
                            <StackPanel Orientation="Horizontal" Margin="0,4,0,10" IsEnabled="{Binding CanEditAccounting}">
                                <RadioButton Content="Debit / Credit" GroupName="CashLayoutMode" Style="{StaticResource SegmentedRadioButtonStyle}" IsChecked="{Binding IsDebitCreditLayout, Mode=TwoWay}"/>
                                <RadioButton Content="Single Amount" GroupName="CashLayoutMode" Style="{StaticResource SegmentedRadioButtonStyle}" IsChecked="{Binding IsSingleAmountLayout, Mode=TwoWay}"/>
                            </StackPanel>
                            <Button Content="Save Cash Entry Control" Command="{Binding SaveCashSettingsCommand}" Padding="10,7" Margin="0,0,0,14"/>
                            <Button Content="Save Selected Row" Command="{Binding SaveCashEntryCommand}" Padding="10,7" Margin="0,0,0,6"/>
                            <Separator Margin="0,4,0,8"/>
                            <TextBlock Text="Transaction Automation" FontWeight="SemiBold" Margin="0,0,0,6"/>
                            <UniformGrid Columns="2" Margin="0,0,0,6">
                                <Button Content="Clone" Click="AdvancedCloneCash_Click" IsEnabled="{Binding CanEditAccounting}" Padding="8,6" Margin="0,0,4,4" ToolTip="Specific Amount Clone or Bulk Amount Divide with working-day scheduling"/>
                                <Button Content="Reverse" Command="{Binding ReverseCashEntryCommand}" Padding="8,6" Margin="4,0,0,4"/>
                                <Button Content="Recurring" Click="RecurringCash_Click" IsEnabled="{Binding CanEditAccounting}" Padding="8,6" Margin="0,4,4,0"/>
                                <Button Content="Approve" Command="{Binding ApproveCashEntryCommand}" Padding="8,6" Margin="4,4,0,0"/>
                            </UniformGrid>
                            <TextBlock Text="Clone/Reverse create linked Drafts. Recurring opens a schedule with frequency and start/end dates; profiles are visible in Finance Center." TextWrapping="Wrap" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,8"/>
                            <Button Content="Repair Existing Closure Entries" Command="{Binding RepairAdvancedClosureCashCommand}" Padding="10,7" Margin="0,0,0,6" ToolTip="Recalculate previously generated AAH Advanced Closure Cash rows using the corrected transaction amount + date authority."/>
                            <Button Content="Delete Selected Row" Command="{Binding DeleteCashEntryCommand}" Padding="10,7" Margin="0,0,0,6"/>
                            <Button Content="Bulk Delete Selected Entries" Click="BulkDeleteCashEntries_Click" IsEnabled="{Binding CanDeleteAccounting}" Padding="10,7" ToolTip="Use Ctrl/Shift or Ctrl+A in the Cash grid, then delete only those selected rows."/>
                        </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem Header="Cash Entry Mapping">
                <Grid Margin="8">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <Grid Margin="0,0,0,8" IsEnabled="{Binding CanEditAccounting}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="24"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="220"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBlock Text="Mapping Mode" VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="8,0,0,0">
                            <RadioButton Content="Update Masters" GroupName="CashMappingMode" Style="{StaticResource SegmentedRadioButtonStyle}" IsChecked="{Binding IsCashMasterUpdateMode, Mode=TwoWay}"/>
                            <RadioButton Content="Common Ledger" GroupName="CashMappingMode" Style="{StaticResource SegmentedRadioButtonStyle}" IsChecked="{Binding IsCashCommonLedgerMode, Mode=TwoWay}"/>
                        </StackPanel>
                        <TextBlock Grid.Column="3" Text="Selected Common Ledger" VerticalAlignment="Center"
                                   Visibility="{Binding IsCashCommonLedgerMode, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                        <controls:SearchableComboBox Grid.Column="4" IsEnabled="{Binding CanEditAccounting}" SourceItems="{Binding CashInHandLedgerNames}" Text="{Binding SelectedCashCommonLedger, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                     AllowCustomText="False" OpenOnFocus="True" Margin="8,0,0,0"
                                                     Visibility="{Binding IsCashCommonLedgerMode, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                        <StackPanel Grid.Column="6" Orientation="Horizontal">
                            <CheckBox Content="Create missing Master ledger" IsChecked="{Binding CreateLedgerWhenApplying}" VerticalAlignment="Center" Margin="0,0,8,0"
                                      Visibility="{Binding IsCashMasterUpdateMode, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                            <Button Content="Apply Selected" Command="{Binding ApplyCashMappingCommand}" Padding="12,7"/>
                        </StackPanel>
                    </Grid>

                    <DataGrid x:Name="CashMasterMappingGrid" Grid.Row="1" ItemsSource="{Binding CashEntryMasterMappings}" SelectedItem="{Binding SelectedCashMasterMapping}"
                              Visibility="{Binding IsCashMasterUpdateMode, Converter={StaticResource BooleanToVisibilityConverter}}"
                              AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="{Binding IsAccountingReadOnly}"
                              PreviewKeyDown="CashSelectorGrid_PreviewKeyDown" PreviewTextInput="CashSelectorGrid_PreviewTextInput">
                        <DataGrid.Columns>
                            <DataGridCheckBoxColumn Header="Select" Binding="{Binding IsSelected, Mode=TwoWay}" Width="70"/>
                            <DataGridTextColumn Header="Entry Ledger" Binding="{Binding EntryLedger, Mode=OneWay}" IsReadOnly="True" Width="220"/>
                            <DataGridTextColumn Header="Entry Count" Binding="{Binding EntryCount, Mode=OneWay}" IsReadOnly="True" Width="100"/>
                            <DataGridTextColumn Header="Master Status" Binding="{Binding MasterStatus, Mode=OneWay}" IsReadOnly="True" Width="120"/>
                            <DataGridTemplateColumn Header="Map / Create As" Width="230">
                                <DataGridTemplateColumn.CellTemplate><DataTemplate>
                                    <controls:SearchableComboBox IsEnabled="{Binding DataContext.CanEditAccounting, RelativeSource={RelativeSource AncestorType=DataGrid}}" SourceItems="{Binding DataContext.MasterLedgerNames, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                                 Text="{Binding MapCreateAs, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                 AllowCustomText="True" OpenOnFocus="True" HandleEnterKey="False" EnableMouseWheelSelection="False"
                                                                 BorderThickness="0" Background="Transparent"/>
                                </DataTemplate></DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Parent Group" Width="190">
                                <DataGridTemplateColumn.CellTemplate><DataTemplate>
                                    <controls:SearchableComboBox IsEnabled="{Binding DataContext.CanEditAccounting, RelativeSource={RelativeSource AncestorType=DataGrid}}" SourceItems="{Binding DataContext.MasterGroupNames, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                                 Text="{Binding ParentGroup, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                 AllowCustomText="False" OpenOnFocus="True" HandleEnterKey="False" EnableMouseWheelSelection="False"
                                                                 BorderThickness="0" Background="Transparent"/>
                                </DataTemplate></DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Result" Binding="{Binding Result, Mode=OneWay}" IsReadOnly="True" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <DataGrid Grid.Row="1" ItemsSource="{Binding CashEntryCommonMappings}" SelectedItem="{Binding SelectedCashCommonMapping}"
                              Visibility="{Binding IsCashCommonLedgerMode, Converter={StaticResource BooleanToVisibilityConverter}}"
                              AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="{Binding IsAccountingReadOnly}">
                        <DataGrid.Columns>
                            <DataGridCheckBoxColumn Header="Select" Binding="{Binding IsSelected, Mode=TwoWay}" Width="70"/>
                            <DataGridTextColumn Header="Entry ID" Binding="{Binding EntryId, Mode=OneWay}" IsReadOnly="True" Width="135"/>
                            <DataGridTextColumn Header="Date" Binding="{Binding Date, Mode=OneWay, StringFormat=dd.MM.yyyy}" IsReadOnly="True" Width="100"/>
                            <DataGridTextColumn Header="Ledger Name" Binding="{Binding LedgerName, Mode=OneWay}" IsReadOnly="True" Width="210"/>
                            <DataGridTextColumn Header="Amount" Binding="{Binding Amount, Mode=OneWay, StringFormat=N2}" IsReadOnly="True" Width="110"/>
                            <DataGridTextColumn Header="Narration" Binding="{Binding Narration, Mode=OneWay}" IsReadOnly="True" Width="*" MinWidth="280"/>
                            <DataGridTextColumn Header="Dr/Cr" Binding="{Binding DrCr, Mode=OneWay}" IsReadOnly="True" Width="80"/>
                            <DataGridTextColumn Header="Current Common Ledger" Binding="{Binding CurrentCommonLedger, Mode=OneWay}" IsReadOnly="True" Width="210"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

        </TabControl>

        <Border Grid.Row="4" Margin="20,0,20,14" Padding="10,7" Background="#EEF3F8" CornerRadius="6">
            <TextBlock Text="{Binding Core.CashStatusText, Mode=OneWay}" TextWrapping="Wrap"/>
        </Border>
    </Grid>
</UserControl>
