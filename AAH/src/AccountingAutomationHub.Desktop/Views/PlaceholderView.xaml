<UserControl x:Class="AccountingAutomationHub.Desktop.Views.PlaceholderView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="28">
        <Border Style="{StaticResource CardBorderStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            MaxWidth="600">
                    <Grid Width="112" Height="96">
                        <Ellipse Width="92" Height="92" Fill="{DynamicResource AccentSoftBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <Border Width="58" Height="58" CornerRadius="17" Background="{DynamicResource SurfaceBrush}" BorderBrush="#93C5FD" BorderThickness="1.5" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Icon}" Foreground="{DynamicResource AccentBrush}" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <Ellipse Width="11" Height="11" Fill="#22C55E" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,14,7,0">
                            <Ellipse.Triggers>
                                <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                                    <BeginStoryboard><Storyboard RepeatBehavior="Forever" AutoReverse="True" Timeline.DesiredFrameRate="12"><DoubleAnimation Storyboard.TargetProperty="Opacity" From="1" To="0.35" Duration="0:0:1.2"/></Storyboard></BeginStoryboard>
                                </EventTrigger>
                            </Ellipse.Triggers>
                        </Ellipse>
                    </Grid>

                    <TextBlock Text="{Binding Title}"
                               FontSize="28"
                               FontWeight="SemiBold"
                               HorizontalAlignment="Center"
                               Margin="0,20,0,0" />

                    <TextBlock Text="{Binding StateText}"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               FontSize="13"
                               HorizontalAlignment="Center"
                               Margin="0,7,0,0" />

                    <Border Background="#F8FAFC"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="18"
                            Margin="0,24,0,0">
                        <StackPanel>
                            <TextBlock Text="Planned scope"
                                       FontWeight="SemiBold"
                                       FontSize="12" />
                            <TextBlock Text="{Binding PlannedScope}"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       TextWrapping="Wrap"
                                       FontSize="12"
                                       LineHeight="19"
                                       Margin="0,7,0,0" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <TextBlock Grid.Row="1"
                           Text="No buttons on this page execute business operations."
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           FontSize="10"
                           HorizontalAlignment="Center"
                           Margin="0,18,0,0" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
