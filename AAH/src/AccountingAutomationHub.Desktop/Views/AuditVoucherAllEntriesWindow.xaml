<Window x:Class="AccountingAutomationHub.Desktop.Views.AuditVoucherAllEntriesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="View All Entries · Advanced Audit Voucher Workbench" Width="1480" Height="900" MinWidth="1050" MinHeight="650"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource AppBackgroundBrush}">
    <Grid Margin="16">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Margin="0,0,0,8">
            <TextBlock Text="View All Entries" FontSize="26" FontWeight="SemiBold"/>
            <TextBlock Text="Every selected voucher is shown full-width at normal readable size. Nothing is compacted side-by-side. Scroll vertically to verify the whole selected set." Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,3,0,0"/>
        </StackPanel>
        <Border Grid.Row="1" Padding="8" Margin="0,0,0,8" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8">
            <TextBlock Text="{Binding SummaryText}" FontWeight="SemiBold"/>
        </Border>
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <ItemsControl ItemsSource="{Binding Vouchers}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="0,0,0,16" Padding="14" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Background="{DynamicResource SurfaceBrush}">
                            <Grid>
                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                <Grid Grid.Row="0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal"><TextBlock Text="Voucher: " FontSize="18" FontWeight="SemiBold"/><TextBlock Text="{Binding VoucherNumberDisplay}" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="   Date: " Margin="14,0,0,0" FontWeight="SemiBold"/><TextBlock Text="{Binding Date, StringFormat=dd-MM-yyyy}"/><TextBlock Text="   Type: " Margin="14,0,0,0" FontWeight="SemiBold"/><TextBlock Text="{Binding VoucherType}"/></StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal"><TextBlock Text="{Binding ChangeStatus}" Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold"/><TextBlock Text=" · "/><TextBlock Text="{Binding ValidationStatus}" FontWeight="SemiBold"/></StackPanel>
                                </Grid>
                                <Grid Grid.Row="1" Margin="0,8,0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="120"/><ColumnDefinition Width="*"/><ColumnDefinition Width="120"/><ColumnDefinition Width="*"/><ColumnDefinition Width="90"/><ColumnDefinition Width="130"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="Party"/><TextBlock Grid.Column="1" Text="{Binding PartyOrLedger}" FontWeight="SemiBold"/><TextBlock Grid.Column="2" Text="Posting Ledger"/><TextBlock Grid.Column="3" Text="{Binding BusinessLedger}" FontWeight="SemiBold"/><TextBlock Grid.Column="4" Text="Amount"/><TextBlock Grid.Column="5" Text="{Binding Amount, StringFormat=N2}" FontWeight="SemiBold"/>
                                </Grid>
                                <GroupBox Grid.Row="2" Header="Accounting Lines" Margin="0,0,0,8"><DataGrid ItemsSource="{Binding LedgerLines}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" Height="155" HorizontalScrollBarVisibility="Auto"><DataGrid.Columns><DataGridTextColumn Header="Ledger" Binding="{Binding Ledger}" Width="220"/><DataGridTextColumn Header="Group" Binding="{Binding Group}" Width="170"/><DataGridTextColumn Header="Dr/Cr" Binding="{Binding Direction}" Width="70"/><DataGridTextColumn Header="Amount" Binding="{Binding Amount, StringFormat=N2}" Width="105"/><DataGridTextColumn Header="GST Treatment" Binding="{Binding GstTreatment}" Width="130"/><DataGridTextColumn Header="Cost Centre" Binding="{Binding CostCentre}" Width="140"/><DataGridTextColumn Header="Role" Binding="{Binding Role}" Width="100"/><DataGridTextColumn Header="Narration" Binding="{Binding Narration}" Width="*"/></DataGrid.Columns></DataGrid></GroupBox>
                                <GroupBox Grid.Row="3" Header="Inventory / GST Lines" Margin="0,0,0,8"><DataGrid ItemsSource="{Binding InventoryLines}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" Height="155" HorizontalScrollBarVisibility="Auto"><DataGrid.Columns><DataGridTextColumn Header="Stock Item" Binding="{Binding StockItem}" Width="190"/><DataGridTextColumn Header="HSN/SAC" Binding="{Binding HsnSac}" Width="95"/><DataGridTextColumn Header="Qty" Binding="{Binding Quantity}" Width="75"/><DataGridTextColumn Header="Unit" Binding="{Binding Unit}" Width="75"/><DataGridTextColumn Header="Rate" Binding="{Binding Rate, StringFormat=N2}" Width="90"/><DataGridTextColumn Header="Taxable" Binding="{Binding TaxableValue, StringFormat=N2}" Width="100"/><DataGridTextColumn Header="GST %" Binding="{Binding GstRate}" Width="70"/><DataGridTextColumn Header="IGST" Binding="{Binding Igst, StringFormat=N2}" Width="85"/><DataGridTextColumn Header="CGST" Binding="{Binding Cgst, StringFormat=N2}" Width="85"/><DataGridTextColumn Header="SGST" Binding="{Binding Sgst, StringFormat=N2}" Width="85"/><DataGridTextColumn Header="Cess" Binding="{Binding Cess, StringFormat=N2}" Width="75"/><DataGridTextColumn Header="Total" Binding="{Binding LineTotal, StringFormat=N2}" Width="100"/></DataGrid.Columns></DataGrid></GroupBox>
                                <Grid Grid.Row="4"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{Binding ValidationMessage}" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/><Button Grid.Column="1" Content="Edit This Voucher" Padding="12,6" Margin="12,0,0,0" Tag="{Binding SessionId}" Click="EditVoucher_Click"/></Grid>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0"><Button Content="Close" Padding="14,7" Click="Close_Click" IsDefault="True"/></StackPanel>
    </Grid>
</Window>
