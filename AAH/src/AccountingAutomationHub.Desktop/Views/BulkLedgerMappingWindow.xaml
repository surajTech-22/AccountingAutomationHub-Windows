<Window x:Class="AccountingAutomationHub.Desktop.Views.BulkLedgerMappingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:AccountingAutomationHub.Desktop.Controls"
        Title="Bulk Ledger Mapping"
        Width="1040" Height="680"
        MinWidth="760" MinHeight="460"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        ShowInTaskbar="False"
        PreviewKeyDown="Window_PreviewKeyDown"
        Background="{DynamicResource AppBackgroundBrush}">
    <Window.Resources>
        <Style x:Key="BulkMappingSelectorStyle" TargetType="{x:Type controls:SuggestTextBox}">
            <Setter Property="MinHeight" Value="34"/>
            <Setter Property="Padding" Value="8,3"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#C9D4E2"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <DockPanel LastChildFill="True">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top" Margin="12,0,0,0">
                <Button x:Name="BulkMappingHeaderAction"
                        Content="{Binding BulkMappingActionLabel, Mode=OneWay}"
                        Command="{Binding ApplyBulkSelectedMappingsCommand}"
                        Click="BulkMappingHeaderAction_Click"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Padding="16,8" MinWidth="170" Margin="0,0,8,0"
                        ToolTip="Same Map All action as Ledger Mapping: commit the exact frozen selected transactions currently represented by this Bank/Voucher/Amount filter scope."/>
                <Button Content="Remove Final Ledger"
                        Command="{Binding RemoveBulkSelectedFinalLedgersCommand}"
                        Click="BulkMappingHeaderAction_Click"
                        Padding="14,8" MinWidth="155" Margin="0,0,8,0"
                        ToolTip="Clears Final Ledger + Ledger Group from the current selected Bulk Mapping scope without deleting Bank Statement transactions. Live Bank/Voucher/Amount filters are honored."/>
                <Button Content="Close" Command="{Binding CloseBulkSelectedMappingCommand}" Padding="14,7"/>
            </StackPanel>
            <StackPanel DockPanel.Dock="Left">
                <TextBlock Text="Bulk Ledger Mapping" FontSize="22" FontWeight="SemiBold"/>
                <TextBlock Text="{Binding BulkMappingCaption, Mode=OneWay}"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           Margin="0,5,0,0" TextWrapping="Wrap" MaxWidth="620"/>
            </StackPanel>
        </DockPanel>

        <Border Grid.Row="1" Margin="0,12,0,8" Padding="10" Background="#EEF5FF" CornerRadius="8" BorderBrush="#B9D4F4" BorderThickness="1">
            <StackPanel>
                <WrapPanel VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Margin="0,0,14,6" VerticalAlignment="Center">
                        <TextBlock Text="Bank" VerticalAlignment="Center" Margin="0,0,7,0"/>
                        <ComboBox ItemsSource="{Binding BulkMappingBankOptions}"
                                  SelectedItem="{Binding BulkMappingBankFilter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                  Width="250" MinHeight="34" VerticalContentAlignment="Center"
                                  ToolTip="Limit the frozen Bulk Mapping selection to one Bank Account without changing the underlying Ledger Mapping selection."/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,14,6" VerticalAlignment="Center">
                        <TextBlock Text="Voucher Type" VerticalAlignment="Center" Margin="0,0,7,0"/>
                        <ComboBox ItemsSource="{Binding BulkMappingVoucherTypeOptions}"
                                  SelectedItem="{Binding BulkMappingVoucherTypeFilter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                  Width="130" MinHeight="34" VerticalContentAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,14,6" VerticalAlignment="Center">
                        <TextBlock Text="Amount Filter" VerticalAlignment="Center" Margin="0,0,7,0"/>
                        <controls:MultiSearchFilterBar x:Name="BulkAmountSearchBar" Width="310"
                                                       SearchText="{Binding BulkMappingAmountSearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                       ToolTip="Use amount expressions such as &gt;5000, &lt;=25000; comma = AND for multiple amount conditions."/>
                    </StackPanel>
                    <Border Padding="9,4" Margin="0,0,7,6" CornerRadius="10" Background="#E7F6EC" BorderBrush="#A7D8B5" BorderThickness="1" VerticalAlignment="Center">
                        <TextBlock Text="LIVE" FontWeight="SemiBold" Foreground="#24713A"/>
                    </Border>
                    <Button Content="Clear" Command="{Binding ClearBulkMappingFiltersCommand}" Padding="12,6" Margin="0,0,0,6"/>
                </WrapPanel>
                <TextBlock Text="{Binding BulkMappingFilterSummary, Mode=OneWay}"
                           Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <Border Grid.Row="2" Margin="0,0,0,12" Padding="14"
                Background="#F5F8FC" CornerRadius="8"
                BorderBrush="#D8E0EB" BorderThickness="1"
                Visibility="{Binding BulkMappingIsSimple, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="115"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="22"/>
                    <ColumnDefinition Width="110"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Text="Type" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" Text="{Binding BulkMappingSelectionType, Mode=OneWay}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="3" Text="Transactions" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="4" Text="{Binding BulkMappingTransactionCount, Mode=OneWay}" FontWeight="SemiBold" VerticalAlignment="Center"/>

                <TextBlock Grid.Row="1" Text="Final Ledger" VerticalAlignment="Center" Margin="0,12,0,0"/>
                <controls:SuggestTextBox Grid.Row="1" Grid.Column="1"
                                         Style="{StaticResource BulkMappingSelectorStyle}"
                                         SourceItems="{Binding MasterLedgerNames}"
                                         Text="{Binding BulkMappingFinalLedger, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         Margin="0,12,0,0"
                                         ToolTip="One Final Ledger will be applied to only the checked selected rows."/>
                <TextBlock Grid.Row="1" Grid.Column="3" Text="Ledger Group" VerticalAlignment="Center" Margin="0,12,0,0"/>
                <controls:SuggestTextBox Grid.Row="1" Grid.Column="4"
                                         Style="{StaticResource BulkMappingSelectorStyle}"
                                         SourceItems="{Binding BulkLedgerGroupNames}"
                                         Text="{Binding BulkMappingLedgerGroup, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         Margin="0,12,0,0"
                                         ToolTip="Type to search or enter a Ledger Group. Tally prebuilt Groups are suggested first, followed by current live/custom Groups."/>
            </Grid>
        </Border>

        <Border Grid.Row="2" Margin="0,0,0,12" Padding="12"
                Background="#FFF8E8" CornerRadius="8"
                BorderBrush="#E8C86D" BorderThickness="1"
                Visibility="{Binding BulkMappingIsMixed, Converter={StaticResource BooleanToVisibilityConverter}}">
            <TextBlock Text="Filter by Bank, Voucher Type and Amount inside this same Payment / Receipt panel. A completely blank voucher side is skipped, so Payment can be mapped without filling Receipt (and vice versa). Live filters only hide/show rows here; they do not switch to another mapping panel."
                       TextWrapping="Wrap" Foreground="#6B5512"/>
        </Border>

        <DataGrid Grid.Row="3"
                  ItemsSource="{Binding BulkVoucherTypeMappingRows}"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False" CanUserDeleteRows="False"
                  IsReadOnly="False"
                  Visibility="{Binding BulkMappingIsMixed, Converter={StaticResource BooleanToVisibilityConverter}}"
                  RowHeight="42" ColumnHeaderHeight="38"
                  GridLinesVisibility="Horizontal"
                  HorizontalGridLinesBrush="#E3E9F1">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Voucher Type" Binding="{Binding VoucherType, Mode=OneWay}" IsReadOnly="True" Width="160"/>
                <DataGridTextColumn Header="Transactions" Binding="{Binding TransactionCount, Mode=OneWay}" IsReadOnly="True" Width="110"/>
                <DataGridTemplateColumn Header="Final Ledger" Width="*" MinWidth="240">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <controls:SuggestTextBox Style="{StaticResource BulkMappingSelectorStyle}"
                                                     SourceItems="{Binding DataContext.MasterLedgerNames, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                                     Text="{Binding FinalLedger, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                     SuggestionChosen="VoucherTypeMappingSelector_SuggestionChosen"
                                                     LostKeyboardFocus="VoucherTypeMappingSelector_LostKeyboardFocus"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Ledger Group" Width="220">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <controls:SuggestTextBox Style="{StaticResource BulkMappingSelectorStyle}"
                                                     SourceItems="{Binding DataContext.BulkLedgerGroupNames, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                                     Text="{Binding LedgerGroup, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                     SuggestionChosen="VoucherTypeMappingSelector_SuggestionChosen"
                                                     LostKeyboardFocus="VoucherTypeMappingSelector_LostKeyboardFocus"
                                                     ToolTip="Type to search or enter a Ledger Group. Tally prebuilt Groups are suggested first, followed by current live/custom Groups."/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Status" Binding="{Binding Status, Mode=OneWay}" IsReadOnly="True" Width="170"/>
            </DataGrid.Columns>
        </DataGrid>

        <DockPanel Grid.Row="4" Margin="0,10,0,0" LastChildFill="True">
            <CheckBox DockPanel.Dock="Left" Content="Create missing Master ledger" IsChecked="{Binding CreateLedgerWhenApplying}" VerticalAlignment="Center" Margin="0,0,14,0"/>
            <TextBlock Text="Only the checked selection captured when this panel opened is included. Voucher Type and Amount filters update live inside the existing panel; unselected or filtered-out transactions are never changed. Map applies/changes Final Ledger; Remove Final Ledger clears Final Ledger + Ledger Group for the same live scope without deleting transactions."
                       Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" TextWrapping="Wrap"/>
        </DockPanel>
    </Grid>
</Window>
