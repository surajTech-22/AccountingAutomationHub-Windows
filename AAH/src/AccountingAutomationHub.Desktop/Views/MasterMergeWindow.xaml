<Window x:Class="AccountingAutomationHub.Desktop.Views.MasterMergeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Merge + Update Masters" Width="650" Height="330"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{DynamicResource AppBackgroundBrush}">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Merge direction" FontSize="19" FontWeight="SemiBold" Margin="0,0,0,14"/>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="95"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="56"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="10"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Text="Merge FROM" FontWeight="SemiBold" VerticalAlignment="Center"/>
            <ComboBox x:Name="FromBox" Grid.Column="1" MinHeight="38" SelectionChanged="Selection_Changed">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel>
                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                            <TextBlock FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}">
                                <Run Text="Usage: "/><Run Text="{Binding UsageCount, Mode=OneWay}"/>
                                <Run Text="  Source: "/><Run Text="{Binding Source, Mode=OneWay}"/>
                                <Run Text="  Parent: "/><Run Text="{Binding Parent, Mode=OneWay}"/>
                            </TextBlock>
                        </StackPanel>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>

            <Button x:Name="SwapButton" Grid.Column="2" Grid.Row="0" Grid.RowSpan="3"
                    Width="42" Height="42" Padding="0" HorizontalAlignment="Center" VerticalAlignment="Center"
                    Click="Interchange_Click" ToolTip="Swap FROM and INTO" Cursor="Hand">
                <Grid Width="24" Height="24">
                    <Path Stroke="{DynamicResource TextPrimaryBrush}" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                          Data="M 6,8 L 12,2 L 18,8 M 12,2 L 12,22 M 6,16 L 12,22 L 18,16"/>
                </Grid>
            </Button>

            <TextBlock Grid.Row="2" Text="Merge INTO" FontWeight="SemiBold" VerticalAlignment="Center"/>
            <ComboBox x:Name="IntoBox" Grid.Row="2" Grid.Column="1" MinHeight="38" SelectionChanged="Selection_Changed">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel>
                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                            <TextBlock FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}">
                                <Run Text="Usage: "/><Run Text="{Binding UsageCount, Mode=OneWay}"/>
                                <Run Text="  Source: "/><Run Text="{Binding Source, Mode=OneWay}"/>
                                <Run Text="  Parent: "/><Run Text="{Binding Parent, Mode=OneWay}"/>
                            </TextBlock>
                        </StackPanel>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
        </Grid>

        <Border Grid.Row="2" Margin="0,14,0,0" Padding="10" CornerRadius="7"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                Background="{DynamicResource SurfaceBrush}">
            <TextBlock x:Name="ReviewText" Text="Choose FROM and INTO." TextWrapping="Wrap"/>
        </Border>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="Cancel" IsCancel="True" Padding="12,7" Margin="0,0,8,0"/>
            <Button Content="Merge + Update" Click="Merge_Click" Style="{StaticResource PrimaryButtonStyle}" Padding="14,7"/>
        </StackPanel>
    </Grid>
</Window>
