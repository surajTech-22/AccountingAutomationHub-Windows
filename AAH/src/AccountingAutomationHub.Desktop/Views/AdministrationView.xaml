<UserControl x:Class="AccountingAutomationHub.Desktop.Views.AdministrationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinWidth="720" MinHeight="480">
    <Grid Margin="16">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <DockPanel Margin="0,0,0,8">
            <StackPanel DockPanel.Dock="Left"><TextBlock Text="Administration" FontSize="26" FontWeight="SemiBold"/><TextBlock Text="Main Server control plane · users · active sessions · devices · access · policy · Remote AAH · deployments · audit" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/></StackPanel>
            <Button DockPanel.Dock="Right" Content="Refresh" Command="{Binding RefreshCommand}" Style="{StaticResource SecondaryButtonStyle}" Padding="16,7"/>
        </DockPanel>
        <Border Grid.Row="1" Style="{StaticResource CardBorderStyle}" Padding="10" Margin="0,0,0,10"><StackPanel><TextBlock Text="{Binding Status}" TextWrapping="Wrap"/><TextBlock Text="{Binding PolicySummary}" TextWrapping="Wrap" Margin="0,4,0,0" Foreground="{DynamicResource TextSecondaryBrush}"/></StackPanel></Border>

        <TabControl Grid.Row="2">
            <TabItem Header="Overview">
                <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="12">
                    <TextBlock Text="{Binding ServerSummary}" TextWrapping="Wrap" Margin="0,0,0,12"/>
                    <WrapPanel>
                        <Border Style="{StaticResource CardBorderStyle}" Width="300" Margin="0,0,12,12"><StackPanel><TextBlock Text="Users" FontWeight="Bold" FontSize="16"/><TextBlock Text="{Binding Users.Count, StringFormat={}{0:N0} configured identity(s)}" Margin="0,6,0,2"/><TextBlock Text="{Binding OnlineUserCount, StringFormat={}{0:N0} online now}" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,10"/><Button Content="Create / Reset AAH User" Command="{Binding CreateUserCommand}" Style="{StaticResource PrimaryButtonStyle}"/></StackPanel></Border>
                        <Border Style="{StaticResource CardBorderStyle}" Width="300" Margin="0,0,12,12"><StackPanel><TextBlock Text="Device Enrollment" FontWeight="Bold" FontSize="16"/><TextBlock Text="{Binding PairingCode}" TextWrapping="Wrap" Margin="0,6,0,10"/><Button Content="Generate Enrollment Code" Command="{Binding GeneratePairingCommand}" Style="{StaticResource PrimaryButtonStyle}"/></StackPanel></Border>
                        <Border Style="{StaticResource CardBorderStyle}" Width="300" Margin="0,0,12,12"><StackPanel><TextBlock Text="Tamper-evident Audit" FontWeight="Bold" FontSize="16"/><TextBlock Text="{Binding AuditSummary}" TextWrapping="Wrap" Margin="0,6,0,10"/><Button Content="Verify Audit Chain" Command="{Binding VerifyAuditCommand}" Style="{StaticResource SecondaryButtonStyle}"/></StackPanel></Border>
                        <Border Style="{StaticResource CardBorderStyle}" Width="300" Margin="0,0,12,12"><StackPanel><TextBlock Text="Emergency Lockdown" FontWeight="Bold" FontSize="16"/><TextBlock Text="{Binding EmergencyLockdownSummary}" TextWrapping="Wrap" Margin="0,6,0,8"/><TextBox Text="{Binding LockdownReason, UpdateSourceTrigger=PropertyChanged}" ToolTip="Reason is mandatory" Margin="0,0,0,8"/><WrapPanel><Button Content="Enable" Command="{Binding EnableLockdownCommand}" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,0"/><Button Content="Disable" Command="{Binding DisableLockdownCommand}" Style="{StaticResource SecondaryButtonStyle}"/></WrapPanel></StackPanel></Border>
                    </WrapPanel>
                    <TextBlock Text="Pending Registration OTP" FontSize="18" FontWeight="SemiBold" Margin="0,12,0,6"/>
                    <TextBlock Text="Registration OTPs are shown only here. They do not open a popup or steal focus on the Main Server." TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,6"/>
                    <DataGrid ItemsSource="{Binding RegistrationOtps}" AutoGenerateColumns="False" IsReadOnly="True" MaxHeight="230" HorizontalScrollBarVisibility="Auto"><DataGrid.Columns><DataGridTextColumn Header="User" Binding="{Binding UserName}" Width="150"/><DataGridTextColumn Header="Device" Binding="{Binding DeviceName}" Width="*" MinWidth="170"/><DataGridTextColumn Header="Route" Binding="{Binding NetworkScope}" Width="120"/><DataGridTextColumn Header="Registration OTP" Binding="{Binding Code}" Width="140"/><DataGridTextColumn Header="Expires" Binding="{Binding ExpiresUtc, StringFormat={}{0:G}}" Width="165"/></DataGrid.Columns></DataGrid>
                </StackPanel></ScrollViewer>
            </TabItem>

            <TabItem Header="Users">
                <Grid Margin="12"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <WrapPanel Margin="0,0,0,8"><Button Content="Create / Reset User" Command="{Binding CreateUserCommand}" Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,8,0"/><Button Content="Edit Selected User" Command="{Binding EditUserCommand}" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,0"/><Button Content="Enable" Command="{Binding EnableUserCommand}" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,0"/><Button Content="Disable" Command="{Binding DisableUserCommand}" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,0"/><Button Content="Revoke All Sessions" Command="{Binding RevokeUserSessionsCommand}" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,0"/><Button Content="Unlock Login" Command="{Binding UnlockUserCommand}" Style="{StaticResource SecondaryButtonStyle}"/></WrapPanel>
                    <DataGrid Grid.Row="1" ItemsSource="{Binding Users}" SelectedItem="{Binding SelectedUser}" AutoGenerateColumns="False" IsReadOnly="True" HorizontalScrollBarVisibility="Auto"><DataGrid.Columns><DataGridTextColumn Header="User ID" Binding="{Binding WindowsUserName}" Width="160"/><DataGridTextColumn Header="Display Name" Binding="{Binding DisplayName}" Width="*" MinWidth="180"/><DataGridTextColumn Header="Role" Binding="{Binding RoleName}" Width="190"/><DataGridCheckBoxColumn Header="Account Active" Binding="{Binding IsActive}" Width="105"/><DataGridTextColumn Header="Last Seen" Binding="{Binding LastSeenUtc, StringFormat={}{0:G}}" Width="165"/></DataGrid.Columns></DataGrid>
                    <Border Grid.Row="2" Style="{StaticResource CardBorderStyle}" Margin="0,8,0,0"><StackPanel><TextBlock Text="{Binding SelectedUserSummary}" TextWrapping="Wrap" Margin="0,0,0,4"/><TextBlock Text="{Binding SelectedUserLoginSummary}" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,8"/><WrapPanel><ComboBox ItemsSource="{Binding RoleNames}" SelectedItem="{Binding SelectedRole}" MinWidth="230" Margin="0,0,8,0"/><Button Content="Apply Role" Command="{Binding ApplyUserRoleCommand}" Style="{StaticResource SecondaryButtonStyle}"/></WrapPanel></StackPanel></Border>
                </Grid>
            </TabItem>

            <TabItem Header="Active Users">
                <Grid Margin="12"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <WrapPanel Margin="0,0,0,8"><TextBlock Text="Online " FontWeight="SemiBold"/><TextBlock Text="{Binding OnlineUserCount}" FontWeight="Bold" Margin="0,0,16,0"/><TextBlock Text="Away " FontWeight="SemiBold"/><TextBlock Text="{Binding AwayUserCount}" FontWeight="Bold" Margin="0,0,16,0"/><TextBlock Text="Offline " FontWeight="SemiBold"/><TextBlock Text="{Binding OfflineUserCount}" FontWeight="Bold" Margin="0,0,16,0"/><TextBlock Text="Disabled " FontWeight="SemiBold"/><TextBlock Text="{Binding DisabledUserCount}" FontWeight="Bold"/><Button Content="Refresh Presence" Command="{Binding RefreshCommand}" Style="{StaticResource SecondaryButtonStyle}" Margin="20,0,0,0"/></WrapPanel>
                    <DataGrid Grid.Row="1" ItemsSource="{Binding ActiveUsers}" SelectedItem="{Binding SelectedActiveUser}" AutoGenerateColumns="False" IsReadOnly="True" HorizontalScrollBarVisibility="Auto"><DataGrid.Columns><DataGridTextColumn Header="Status" Binding="{Binding ActiveStatus}" Width="90"/><DataGridTextColumn Header="User" Binding="{Binding UserName}" Width="150"/><DataGridTextColumn Header="Display Name" Binding="{Binding DisplayName}" Width="170"/><DataGridTextColumn Header="Role" Binding="{Binding RoleName}" Width="180"/><DataGridTextColumn Header="Sessions" Binding="{Binding SessionCount}" Width="80"/><DataGridTextColumn Header="Devices" Binding="{Binding DeviceNames}" Width="190"/><DataGridTextColumn Header="Current Client" Binding="{Binding CurrentClient}" Width="200"/><DataGridTextColumn Header="FY" Binding="{Binding CurrentFinancialYear}" Width="95"/><DataGridTextColumn Header="Current Module" Binding="{Binding CurrentModule}" Width="145"/><DataGridTextColumn Header="Version" Binding="{Binding AppVersions}" Width="120"/><DataGridTextColumn Header="Last Activity" Binding="{Binding LastSeenUtc, StringFormat={}{0:G}}" Width="165"/><DataGridTextColumn Header="Signed In Since" Binding="{Binding SessionSinceUtc, StringFormat={}{0:G}}" Width="165"/></DataGrid.Columns></DataGrid>
                    <WrapPanel Grid.Row="2" Margin="0,8,0,0"><Button Content="Logout User From All Devices" Command="{Binding RevokeActiveUserSessionsCommand}" Style="{StaticResource SecondaryButtonStyle}"/><TextBlock Text="  Presence is based on Main Server session heartbeat; Away means the session exists but has not checked in recently." VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}"/></WrapPanel>
                </Grid>
            </TabItem>

            <TabItem Header="Roles &amp; Permissions">
                <Grid Margin="12"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <StackPanel><TextBlock Text="Role Permission Matrix" FontWeight="SemiBold" FontSize="17"/><WrapPanel Margin="0,6,0,4"><TextBlock Text="Role" VerticalAlignment="Center" Margin="0,0,8,0"/><ComboBox ItemsSource="{Binding RoleNames}" SelectedItem="{Binding SelectedRole}" MinWidth="240"/></WrapPanel><TextBlock Text="{Binding SelectedRoleDescription}" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}"/><TextBlock Text="Built-in roles are fixed and definitive. Choose Custom when a user needs a different permission mix." TextWrapping="Wrap" Foreground="#7A4E00" FontWeight="SemiBold" Margin="0,4,0,8"/></StackPanel>
                    <DataGrid Grid.Row="1" ItemsSource="{Binding RolePermissions}" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" IsReadOnly="False"><DataGrid.Columns><DataGridTextColumn Header="Category" Binding="{Binding Category}" IsReadOnly="True" Width="150"/><DataGridTextColumn Header="Permission" Binding="{Binding PermissionName}" IsReadOnly="True" Width="190"/><DataGridTextColumn Header="Meaning" Binding="{Binding Description}" IsReadOnly="True" Width="*"/><DataGridTextColumn Header="Risk" Binding="{Binding Risk}" IsReadOnly="True" Width="85"/><DataGridTemplateColumn Header="Allowed" Width="90"><DataGridTemplateColumn.CellTemplate><DataTemplate><CheckBox IsChecked="{Binding IsAllowed, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding IsEditable}" HorizontalAlignment="Center" ToolTip="{Binding LockReason}"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn></DataGrid.Columns></DataGrid>
                    <Button Grid.Row="2" Content="Save Custom Permission Matrix" Command="{Binding SaveRolePermissionsCommand}" Style="{StaticResource PrimaryButtonStyle}" HorizontalAlignment="Left" Margin="0,8,0,0"/>
                </Grid>
            </TabItem>

            <TabItem Header="Devices">
                <Grid Margin="12"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"><WrapPanel Margin="0,0,0,8"><Button Content="Enable" Command="{Binding EnableDeviceCommand}" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,6,0"/><Button Content="Disable" Command="{Binding DisableDeviceCommand}" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,6,0"/><Button Content="Reset Registration Trust" Command="{Binding ResetTrustCommand}" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,6,0"/><Button Content="Quarantine" Command="{Binding QuarantineCommand}" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,6,0"/><Button Content="Clear Quarantine" Command="{Binding ClearQuarantineCommand}" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,6,0"/><Button Content="Revoke" Command="{Binding RevokeDeviceCommand}" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,6,0"/><Button Content="Retire" Command="{Binding RetireDeviceCommand}" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,6,0"/><Button Content="Lost / Stolen" Command="{Binding MarkLostDeviceCommand}" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,6,0"/><Button Content="Permanently Delete Registration" Command="{Binding DeleteDeviceCommand}" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,6,0"/><Button Content="Delete All Android Registrations" Command="{Binding DeleteAllAndroidDevicesCommand}" Style="{StaticResource SecondaryButtonStyle}"/></WrapPanel></ScrollViewer>
                    <DataGrid Grid.Row="1" ItemsSource="{Binding Devices}" SelectedItem="{Binding SelectedDevice}" AutoGenerateColumns="False" IsReadOnly="True" HorizontalScrollBarVisibility="Auto">
                        <DataGrid.Columns>
                            <DataGridCheckBoxColumn Header="Active" Binding="{Binding IsActive}" Width="70"/>
                            <DataGridTextColumn Header="Device" Binding="{Binding DeviceName}" Width="*" MinWidth="170"/>
                            <DataGridTextColumn Header="User" Binding="{Binding UserName}" Width="150"/>
                            <DataGridTextColumn Header="Type" Binding="{Binding DeviceType}" Width="90"/>
                            <DataGridTextColumn Header="Version" Binding="{Binding AppVersion}" Width="110"/>
                            <DataGridTextColumn Header="Update Ring" Binding="{Binding UpdateRing}" Width="110"/>
                            <DataGridTextColumn Header="Health" Binding="{Binding HealthState}" Width="120"/>
                            <DataGridTextColumn Header="Risk" Binding="{Binding RiskScore}" Width="70"/>
                            <DataGridTextColumn Header="Enrollment" Binding="{Binding EnrollmentState}" Width="150"/>
                            <DataGridTextColumn Header="Last Seen" Binding="{Binding LastSeenUtc, StringFormat={}{0:G}}" Width="165"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <Border Grid.Row="2" Style="{StaticResource CardBorderStyle}" Margin="0,8,0,0">
                        <StackPanel>
                            <TextBlock Text="{Binding SelectedDeviceSummary}" TextWrapping="Wrap"/>
                            <TextBlock Text="{Binding SelectedDeviceTags}" TextWrapping="Wrap" Margin="0,4,0,8" Foreground="{DynamicResource TextSecondaryBrush}"/>
                            <WrapPanel Margin="0,0,0,8">
                                <TextBlock Text="Update Ring" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <ComboBox ItemsSource="{Binding DeploymentRings}" DisplayMemberPath="RingName" SelectedValuePath="RingName" SelectedValue="{Binding SelectedDeviceUpdateRing}" Width="140" Margin="0,0,6,0"/>
                                <Button Content="Assign Ring" Command="{Binding AssignDeviceRingCommand}" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,16,0"/>
                                <TextBlock Text="A paused ring keeps the selected device on its currently installed version unless a global mandatory update is issued." VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                            </WrapPanel>
                            <WrapPanel>
                                <TextBox Text="{Binding DeviceTag, UpdateSourceTrigger=PropertyChanged}" Width="180" Margin="0,0,6,0" ToolTip="Device tag"/>
                                <Button Content="Add Tag" Command="{Binding AddDeviceTagCommand}" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,6,0"/>
                                <Button Content="Remove Tag" Command="{Binding RemoveDeviceTagCommand}" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,16,0"/>
                                <TextBox Text="{Binding NewDeviceGroup, UpdateSourceTrigger=PropertyChanged}" Width="170" Margin="0,0,6,0" ToolTip="New device group"/>
                                <Button Content="Create Group" Command="{Binding CreateDeviceGroupCommand}" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,6,0"/>
                                <ComboBox ItemsSource="{Binding DeviceGroups}" SelectedItem="{Binding SelectedDeviceGroup}" Width="170" Margin="0,0,6,0"/>
                                <Button Content="Add to Group" Command="{Binding AddToDeviceGroupCommand}" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,6,0"/>
                                <Button Content="Remove from Group" Command="{Binding RemoveFromDeviceGroupCommand}" Style="{StaticResource SecondaryButtonStyle}"/>
                            </WrapPanel>
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem Header="Client Access">
                <Grid Margin="12"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <WrapPanel Margin="0,0,0,8"><TextBlock Text="Grant duration" VerticalAlignment="Center" Margin="0,0,6,0"/><ComboBox ItemsSource="{Binding AccessDurations}" SelectedItem="{Binding SelectedAccessDuration}" Width="130" Margin="0,0,8,0"/><Button Content="Grant Selected User" Command="{Binding GrantAccessCommand}" Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,8,0"/><Button Content="Revoke Selected User" Command="{Binding RevokeAccessCommand}" Style="{StaticResource SecondaryButtonStyle}"/><TextBlock Text="  Access belongs to the AAH user and applies on every trusted PC/phone. Temporary grants expire on the Main Server." VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}"/></WrapPanel>
                    <DataGrid Grid.Row="1" ItemsSource="{Binding ClientAccess}" SelectedItem="{Binding SelectedAccess}" AutoGenerateColumns="False" IsReadOnly="True" HorizontalScrollBarVisibility="Auto"><DataGrid.Columns><DataGridTextColumn Header="Client" Binding="{Binding ClientCode}" Width="105"/><DataGridTextColumn Header="Name" Binding="{Binding ClientName}" Width="*" MinWidth="170"/><DataGridTextColumn Header="FY" Binding="{Binding FinancialYear}" Width="95"/><DataGridTextColumn Header="User ID" Binding="{Binding UserName}" Width="140"/><DataGridTextColumn Header="Display Name" Binding="{Binding DisplayName}" Width="160"/><DataGridTextColumn Header="Role" Binding="{Binding RoleName}" Width="160"/><DataGridCheckBoxColumn Header="Remote Available" Binding="{Binding LanAvailable}" Width="115"/><DataGridCheckBoxColumn Header="Allowed" Binding="{Binding IsAllowed}" Width="80"/><DataGridTextColumn Header="Access Expires" Binding="{Binding AccessExpiryText}" Width="165"/></DataGrid.Columns></DataGrid>
                    <Border Grid.Row="2" Style="{StaticResource CardBorderStyle}" Margin="0,8,0,0"><StackPanel><TextBlock Text="Access Simulator / Explain Access" FontWeight="SemiBold"/><WrapPanel Margin="0,7,0,7"><ComboBox ItemsSource="{Binding SimulationActions}" SelectedItem="{Binding SelectedSimulationAction}" Width="240" Margin="0,0,8,0"/><CheckBox Content="WireGuard/private remote route" IsChecked="{Binding SimulationRemoteRoute}" VerticalAlignment="Center" Margin="0,0,8,0"/><Button Content="Simulate" Command="{Binding SimulateAccessCommand}" Style="{StaticResource SecondaryButtonStyle}"/></WrapPanel><TextBlock Text="{Binding AccessSimulationResult}" TextWrapping="Wrap"/></StackPanel></Border>
                </Grid>
            </TabItem>

            <TabItem Header="Remote AAH">
                <Grid Margin="12">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="112"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <TextBlock Text="Live AAH Remote Assist · select an enrolled Windows LAN target, connect, then view/control only the Accounting Automation Hub window. No Windows desktop, shell, PowerShell or other application is exposed." TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}"/>
                    <DataGrid Grid.Row="1" ItemsSource="{Binding RemoteTargets}" SelectedItem="{Binding SelectedDevice}" AutoGenerateColumns="False" IsReadOnly="True" Margin="0,8" HorizontalScrollBarVisibility="Auto" SelectionMode="Single">
                        <DataGrid.Columns><DataGridTextColumn Header="Status" Binding="{Binding PresenceStatus}" Width="80"/><DataGridTextColumn Header="User" Binding="{Binding UserName}" Width="125"/><DataGridTextColumn Header="Device" Binding="{Binding DeviceName}" Width="150"/><DataGridTextColumn Header="Role" Binding="{Binding RoleName}" Width="135"/><DataGridTextColumn Header="Client" Binding="{Binding CurrentClient}" Width="180"/><DataGridTextColumn Header="FY" Binding="{Binding CurrentFinancialYear}" Width="90"/><DataGridTextColumn Header="Module" Binding="{Binding CurrentModule}" Width="125"/><DataGridTextColumn Header="Version" Binding="{Binding AppVersion}" Width="100"/><DataGridTextColumn Header="Remote Status" Binding="{Binding RemoteReadyStatus}" Width="240"/></DataGrid.Columns>
                    </DataGrid>
                    <Border Grid.Row="2" Style="{StaticResource CardBorderStyle}" Margin="0,0,0,8" Padding="10">
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel><TextBlock Text="{Binding RemoteTargetSummary, Mode=OneWay}" TextWrapping="Wrap"/><TextBlock Text="{Binding RemoteAssistAccessSummary, Mode=OneWay}" TextWrapping="Wrap" FontWeight="SemiBold" Margin="0,3,0,0"/><TextBlock Text="{Binding RemoteAssistDeliverySummary, Mode=OneWay}" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,3,0,0"/><TextBlock Text="{Binding RemoteAssistTransportSummary, Mode=OneWay}" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,3,0,0"/><TextBlock Text="{Binding RemoteAssistStreamStatus, Mode=OneWay}" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,3,0,0"/></StackPanel>
                            <StackPanel Grid.Column="1" Margin="12,0,0,0"><WrapPanel><Button Content="Connect / Request Control" Command="{Binding StartRemoteAssistCommand}" Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,8,0"/><Button Content="Open Large Viewer" Command="{Binding OpenRemoteAssistViewerCommand}" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,0"/><Button Content="End Access" Command="{Binding EndRemoteAssistCommand}" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,0" Visibility="{Binding HasSelectedActiveRemoteAssist, Converter={StaticResource BooleanToVisibilityConverter}}"/><Button Content="Force Open AAH" Command="{Binding ForceOpenAahCommand}" Style="{StaticResource SecondaryButtonStyle}"/></WrapPanel><WrapPanel Margin="0,7,0,0"><CheckBox Content="Auto Accept from Main Server Administrator" IsChecked="{Binding RemoteAssistAutoAccept}" IsEnabled="{Binding IsPrimaryAdministrator}" VerticalAlignment="Center" Margin="0,0,8,0" ToolTip="Per-device policy. Only the Main Server Administrator can enable it. The AAH user still sees an active Remote Assist banner and can end the session."/><Button Content="Save Auto Accept" Command="{Binding SaveRemoteAssistAutoAcceptCommand}" Style="{StaticResource SecondaryButtonStyle}"/></WrapPanel></StackPanel>
                        </Grid>
                    </Border>
                    <TabControl Grid.Row="3">
                        <TabItem Header="Live Screen &amp; Control">
                            <Grid Margin="8"><Grid.ColumnDefinitions><ColumnDefinition Width="3.2*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="1*"/></Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Background="#111827" CornerRadius="6" BorderBrush="#374151" BorderThickness="1" MinHeight="360" Focusable="True" x:Name="RemoteViewer" PreviewMouseDown="RemoteViewer_PreviewMouseDown" PreviewMouseUp="RemoteViewer_PreviewMouseUp" MouseMove="RemoteViewer_MouseMove" MouseWheel="RemoteViewer_MouseWheel" PreviewKeyDown="RemoteViewer_PreviewKeyDown" PreviewKeyUp="RemoteViewer_PreviewKeyUp" PreviewTextInput="RemoteViewer_PreviewTextInput">
                                    <Grid><Image x:Name="RemoteFrameImage" Source="{Binding RemoteAssistRemoteFrame, Mode=OneWay}" Stretch="Uniform" SnapsToDevicePixels="True"/><Border VerticalAlignment="Top" HorizontalAlignment="Left" Background="#99111827" CornerRadius="4" Padding="7,4" Margin="8" IsHitTestVisible="False"><TextBlock Text="REMOTE AAH · LIVE · click inside to control when allowed" Foreground="White" FontSize="11"/></Border><Border VerticalAlignment="Bottom" HorizontalAlignment="Stretch" Background="#AA111827" Padding="8,5" Margin="8" IsHitTestVisible="False"><TextBlock Text="{Binding RemoteAssistStreamStatus, Mode=OneWay}" Foreground="White" FontSize="10" TextWrapping="Wrap"/></Border></Grid>
                                </Border>
                                <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto"><StackPanel>
                                    <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,8"><StackPanel><TextBlock Text="Session" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="Permission mode" Margin="0,8,0,3"/><ComboBox ItemsSource="{Binding RemoteAssistModes}" SelectedItem="{Binding RemoteAssistMode}"/><WrapPanel Margin="0,7,0,0"><TextBlock Text="Minutes" VerticalAlignment="Center" Margin="0,0,5,0"/><ComboBox ItemsSource="{Binding RemoteAssistDurations}" SelectedItem="{Binding RemoteAssistDurationMinutes}" Width="80"/></WrapPanel><TextBox Text="{Binding RemoteAssistReason, UpdateSourceTrigger=PropertyChanged}" Margin="0,7,0,0" ToolTip="Support reason"/><TextBlock Text="Click the live screen to send AAH-only mouse/keyboard input when control is allowed." TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,7,0,0"/></StackPanel></Border>
                                    <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,8"><StackPanel><TextBlock Text="Two-way Screen Share" FontSize="17" FontWeight="SemiBold"/><CheckBox Content="Share my Main Server AAH window" IsChecked="{Binding ShareAdministratorAah}" Margin="0,8,0,0"/><CheckBox Content="Allow AAH user to control my Main Server AAH (Administrator only)" IsChecked="{Binding AllowRemoteControlOfAdministrator}" IsEnabled="{Binding IsPrimaryAdministrator}" Margin="0,7,0,0"/><TextBlock Text="Sharing is AAH-window-only. Remote control of the Main Server AAH is off by default, can be enabled only by the Main Server Administrator, is audited, and can be turned off immediately." TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,7,0,0"/></StackPanel></Border>
                                    <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,8"><StackPanel><TextBlock Text="Message / Notification" FontSize="17" FontWeight="SemiBold"/><TextBox Text="{Binding RemoteMessage, UpdateSourceTrigger=PropertyChanged}" Height="60" TextWrapping="Wrap" AcceptsReturn="True" Margin="0,7,0,0"/><WrapPanel Margin="0,7,0,0"><CheckBox Content="Urgent" IsChecked="{Binding RemoteNotificationUrgent}" Margin="0,0,8,0"/><Button Content="Send Notification" Command="{Binding SendRemoteNotificationCommand}" Style="{StaticResource PrimaryButtonStyle}"/></WrapPanel></StackPanel></Border>
                                    <Border Style="{StaticResource CardBorderStyle}"><StackPanel><TextBlock Text="AAH Controls" FontSize="17" FontWeight="SemiBold"/><WrapPanel Margin="0,7,0,0"><TextBox Text="{Binding RemoteAssistPage, UpdateSourceTrigger=PropertyChanged}" Width="125" Margin="0,0,6,0"/><Button Content="Navigate" Command="{Binding RemoteAssistNavigateCommand}" Style="{StaticResource SecondaryButtonStyle}"/></WrapPanel><WrapPanel Margin="0,7,0,0"><Button Content="Refresh Snapshot" Command="{Binding QueueRefreshCommand}" Margin="0,0,6,0"/><Button Content="Diagnostics" Command="{Binding QueueDiagnosticsCommand}"/></WrapPanel></StackPanel></Border>
                                </StackPanel></ScrollViewer>
                            </Grid>
                        </TabItem>
                        <TabItem Header="Tools &amp; Device Actions">
                            <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="8">
                                <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,8"><StackPanel><TextBlock Text="Remote Assist Session Tools" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="These commands remain consent/session-bound and do not replace the live screen controls." Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,4,0,8"/><WrapPanel><TextBlock Text="Scope" VerticalAlignment="Center" Margin="0,0,5,0"/><TextBox Text="{Binding RemoteAssistScope, UpdateSourceTrigger=PropertyChanged}" Width="160" Margin="0,0,12,0"/><TextBlock Text="Navigate to" VerticalAlignment="Center" Margin="0,0,5,0"/><TextBox Text="{Binding RemoteAssistPage, UpdateSourceTrigger=PropertyChanged}" Width="150" Margin="0,0,6,0"/><Button Content="Navigate Remote AAH" Command="{Binding RemoteAssistNavigateCommand}" Style="{StaticResource SecondaryButtonStyle}"/></WrapPanel><WrapPanel Margin="0,8,0,0"><ComboBox ItemsSource="{Binding RemotePreferenceKeys}" SelectedItem="{Binding RemotePreferenceKey}" Width="220" Margin="0,0,6,0"/><TextBox Text="{Binding RemotePreferenceValue, UpdateSourceTrigger=PropertyChanged}" Width="130" Margin="0,0,6,0"/><CheckBox Content="Use helper permission for this action" IsChecked="{Binding RemotePerActionUseHelperPermission}" VerticalAlignment="Center" Margin="0,0,6,0"/><Button Content="Apply AAH Preference" Command="{Binding RemoteAssistPreferenceCommand}" Style="{StaticResource SecondaryButtonStyle}"/></WrapPanel></StackPanel></Border>
                                <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,8"><StackPanel><TextBlock Text="Allow-listed Device Actions" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="Only the built-in Remote AAH action allow-list is available; no arbitrary shell or process execution is exposed." Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,4,0,8"/><WrapPanel><ComboBox ItemsSource="{Binding RemoteActions}" SelectedItem="{Binding SelectedRemoteAction}" Width="230" Margin="0,0,8,0"/><Button Content="Queue Device Action" Command="{Binding QueueRemoteCommand}" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,14,0"/><ComboBox ItemsSource="{Binding DeviceGroups}" SelectedItem="{Binding SelectedDeviceGroup}" Width="180" Margin="0,0,8,0"/><Button Content="Queue to Group" Command="{Binding QueueGroupRemoteCommand}" Style="{StaticResource SecondaryButtonStyle}"/></WrapPanel></StackPanel></Border>
                                <Border Style="{StaticResource CardBorderStyle}"><StackPanel><TextBlock Text="Quick Troubleshooting" FontSize="17" FontWeight="SemiBold"/><WrapPanel Margin="0,8,0,0"><Button Content="Force Open AAH" Command="{Binding ForceOpenAahCommand}" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,0"/><Button Content="Refresh Snapshot" Command="{Binding QueueRefreshCommand}" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,0"/><Button Content="Collect Diagnostics" Command="{Binding QueueDiagnosticsCommand}" Style="{StaticResource SecondaryButtonStyle}"/></WrapPanel></StackPanel></Border>
                            </StackPanel></ScrollViewer>
                        </TabItem>
                        <TabItem Header="Remote History">
                            <Grid Margin="8"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="8"/><RowDefinition Height="*"/></Grid.RowDefinitions><DataGrid ItemsSource="{Binding RemoteAssistSessions}" SelectedItem="{Binding SelectedRemoteAssistSession}" AutoGenerateColumns="False" IsReadOnly="True" MinHeight="110"><DataGrid.Columns><DataGridTextColumn Header="Session" Binding="{Binding SessionId}" Width="150"/><DataGridTextColumn Header="Device" Binding="{Binding DeviceId}" Width="*"/><DataGridTextColumn Header="Remote User" Binding="{Binding RemoteUserName}" Width="130"/><DataGridTextColumn Header="Helper" Binding="{Binding HelperUserName}" Width="130"/><DataGridTextColumn Header="Mode" Binding="{Binding PermissionMode}" Width="220"/><DataGridCheckBoxColumn Header="Consent" Binding="{Binding UserConsented}" Width="75"/><DataGridCheckBoxColumn Header="Active" Binding="{Binding IsActive}" Width="65"/><DataGridTextColumn Header="Expires" Binding="{Binding ExpiresUtc, StringFormat={}{0:G}}" Width="165"/></DataGrid.Columns></DataGrid><DataGrid Grid.Row="2" ItemsSource="{Binding RemoteCommands}" AutoGenerateColumns="False" IsReadOnly="True" MinHeight="100"><DataGrid.Columns><DataGridTextColumn Header="Created" Binding="{Binding CreatedUtc, StringFormat={}{0:G}}" Width="155"/><DataGridTextColumn Header="Device" Binding="{Binding DeviceId}" Width="*"/><DataGridTextColumn Header="Action" Binding="{Binding Action}" Width="190"/><DataGridTextColumn Header="State" Binding="{Binding State}" Width="100"/><DataGridTextColumn Header="Requested By" Binding="{Binding RequestedBy}" Width="130"/><DataGridTextColumn Header="Result" Binding="{Binding ResultDetail}" Width="2*"/></DataGrid.Columns></DataGrid></Grid>
                        </TabItem>
                    </TabControl>
                </Grid>
            </TabItem>

            <TabItem Header="Deployments &amp; Recovery">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="12">
                        <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock Text="LAN Deployment" FontSize="18" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding DeploymentSummary}" TextWrapping="Wrap" Margin="0,6,0,10"/>
                                <WrapPanel>
                                    <Button Content="Publish LAN Update" Command="{Binding PublishUpdateCommand}" Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,8,0"/>
                                    <Button Content="Force Update All Outdated LAN Apps" Command="{Binding ForceUpdateCommand}" Style="{StaticResource SecondaryButtonStyle}"/>
                                </WrapPanel>
                                <TextBlock Text="Per-user installation target: %LOCALAPPDATA%\Programs\Accounting Automation Hub LAN\Application. This is normally on C: but does not require routine UAC elevation. The Main Server package remains the update authority." Margin="0,8,0,0" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock Text="Update Rings" FontSize="18" FontWeight="SemiBold"/>
                                <TextBlock Text="Stage the currently approved LAN package through Test, Pilot and Production. Pause a ring to stop offering normal updates to its devices; an explicit global Force Update still overrides a paused ring." TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,5,0,8"/>
                                <DataGrid ItemsSource="{Binding DeploymentRings}" SelectedItem="{Binding SelectedDeploymentRing}" AutoGenerateColumns="False" IsReadOnly="True" MaxHeight="180" HorizontalScrollBarVisibility="Auto">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Ring" Binding="{Binding RingName}" Width="130"/>
                                        <DataGridCheckBoxColumn Header="Active" Binding="{Binding IsEnabled}" Width="75"/>
                                        <DataGridTextColumn Header="Force After" Binding="{Binding ForceAfterUtc, StringFormat={}{0:G}}" Width="165"/>
                                        <DataGridTextColumn Header="Updated By" Binding="{Binding UpdatedBy}" Width="140"/>
                                        <DataGridTextColumn Header="Updated" Binding="{Binding UpdatedUtc, StringFormat={}{0:G}}" Width="165"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                                <WrapPanel Margin="0,8,0,0">
                                    <CheckBox Content="Ring Active" IsChecked="{Binding DeploymentRingEnabled}" VerticalAlignment="Center" Margin="0,0,14,0"/>
                                    <TextBlock Text="Force current approved package after" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <DatePicker SelectedDate="{Binding DeploymentRingForceAfterDate}" Width="150" Margin="0,0,8,0"/>
                                    <Button Content="Save Ring Policy" Command="{Binding SaveDeploymentRingCommand}" Style="{StaticResource PrimaryButtonStyle}"/>
                                </WrapPanel>
                                <TextBlock Text="Leave Force After blank for an optional ring. Test/Pilot/Production here stage the current approved package; package-version rollback remains a separate recovery operation." TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,6,0,0"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,10">
                            <StackPanel><TextBlock Text="Snapshot Diagnostics" FontSize="18" FontWeight="SemiBold"/><Button Content="Run Snapshot Diagnostic" Command="{Binding RunSnapshotDiagnosticCommand}" Style="{StaticResource SecondaryButtonStyle}" HorizontalAlignment="Left" Margin="0,8,0,8"/><TextBox Text="{Binding SnapshotDiagnostic, Mode=OneWay}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" MinHeight="170"/></StackPanel>
                        </Border>
                        <Border Style="{StaticResource CardBorderStyle}">
                            <StackPanel><TextBlock Text="Backup &amp; Retention" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="Runs the existing verified Main Server replication/backup path." TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,6,0,8"/><Button Content="Run Verified Replication / Backup" Command="{Binding RunBackupCommand}" Style="{StaticResource PrimaryButtonStyle}" HorizontalAlignment="Left"/></StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Audit &amp; Troubleshooting">
                <Grid Margin="12"><Grid.ColumnDefinitions><ColumnDefinition Width="1.4*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="1*"/></Grid.ColumnDefinitions>
                    <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><WrapPanel Margin="0,0,0,8"><Button Content="Verify Audit Chain" Command="{Binding VerifyAuditCommand}" Style="{StaticResource SecondaryButtonStyle}"/><TextBlock Text="  Every privileged device/user/remote action keeps a tamper-evident audit record." VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}"/></WrapPanel><DataGrid Grid.Row="1" ItemsSource="{Binding AuditRecords}" AutoGenerateColumns="False" IsReadOnly="True" HorizontalScrollBarVisibility="Auto"><DataGrid.Columns><DataGridTextColumn Header="Time" Binding="{Binding CreatedUtc, StringFormat={}{0:G}}" Width="160"/><DataGridTextColumn Header="Actor" Binding="{Binding UserName}" Width="120"/><DataGridTextColumn Header="Action" Binding="{Binding Action}" Width="190"/><DataGridTextColumn Header="Resource" Binding="{Binding Resource}" Width="180"/><DataGridTextColumn Header="Reason" Binding="{Binding ReasonCode}" Width="150"/><DataGridTextColumn Header="Detail" Binding="{Binding Detail}" Width="2*"/><DataGridCheckBoxColumn Header="OK" Binding="{Binding Success}" Width="55"/></DataGrid.Columns></DataGrid></Grid>
                    <Border Grid.Column="2" Style="{StaticResource CardBorderStyle}"><StackPanel><TextBlock Text="Troubleshooting Center" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="Select a device on the Devices tab, then return here." Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,8"/><TextBox Text="{Binding TroubleshootingSummary, Mode=OneWay}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="180" VerticalScrollBarVisibility="Auto"/><TextBlock Text="Selected Device Timeline" FontWeight="SemiBold" Margin="0,10,0,5"/><DataGrid ItemsSource="{Binding SelectedDeviceAudit}" AutoGenerateColumns="False" IsReadOnly="True" MaxHeight="220" HorizontalScrollBarVisibility="Auto"><DataGrid.Columns><DataGridTextColumn Header="Time" Binding="{Binding CreatedUtc, StringFormat={}{0:G}}" Width="145"/><DataGridTextColumn Header="Action" Binding="{Binding Action}" Width="155"/><DataGridTextColumn Header="Detail" Binding="{Binding Detail}" Width="240"/><DataGridCheckBoxColumn Header="OK" Binding="{Binding Success}" Width="55"/></DataGrid.Columns></DataGrid><WrapPanel Margin="0,8,0,0"><Button Content="Remote Refresh" Command="{Binding QueueRefreshCommand}" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,0"/><Button Content="Collect Diagnostics" Command="{Binding QueueDiagnosticsCommand}" Style="{StaticResource PrimaryButtonStyle}"/></WrapPanel></StackPanel></Border>
                </Grid>
            </TabItem>

            <TabItem Header="Sessions &amp; Security">
                <Grid Margin="12"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><WrapPanel Margin="0,0,0,8"><Button Content="Revoke Selected Session" Command="{Binding RevokeSessionCommand}" Style="{StaticResource SecondaryButtonStyle}"/><TextBlock Text="  Session revocation does not reset 30-day device registration trust." VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}"/></WrapPanel><DataGrid Grid.Row="1" ItemsSource="{Binding Sessions}" SelectedItem="{Binding SelectedSession}" AutoGenerateColumns="False" IsReadOnly="True" Margin="0,0,0,8" HorizontalScrollBarVisibility="Auto"><DataGrid.Columns><DataGridTextColumn Header="User" Binding="{Binding UserName}" Width="*"/><DataGridTextColumn Header="Device" Binding="{Binding DeviceId}" Width="*"/><DataGridTextColumn Header="Created" Binding="{Binding CreatedUtc, StringFormat={}{0:G}}" Width="160"/><DataGridTextColumn Header="Last Seen" Binding="{Binding LastSeenUtc, StringFormat={}{0:G}}" Width="160"/><DataGridTextColumn Header="Expires" Binding="{Binding ExpiresUtc, StringFormat={}{0:G}}" Width="160"/></DataGrid.Columns></DataGrid><TextBlock Grid.Row="2" Text="Security / LAN activity" FontWeight="SemiBold" FontSize="17" Margin="0,4,0,6"/><DataGrid Grid.Row="3" ItemsSource="{Binding SecurityEvents}" AutoGenerateColumns="False" IsReadOnly="True" HorizontalScrollBarVisibility="Auto"><DataGrid.Columns><DataGridTextColumn Header="Time" Binding="{Binding CreatedUtc, StringFormat={}{0:G}}" Width="155"/><DataGridTextColumn Header="Event" Binding="{Binding EventType}" Width="180"/><DataGridTextColumn Header="User" Binding="{Binding UserName}" Width="130"/><DataGridTextColumn Header="Device" Binding="{Binding DeviceId}" Width="*"/><DataGridCheckBoxColumn Header="OK" Binding="{Binding Success}" Width="55"/><DataGridTextColumn Header="Detail" Binding="{Binding Detail}" Width="2*"/></DataGrid.Columns></DataGrid></Grid>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
