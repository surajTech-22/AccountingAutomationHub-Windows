<UserControl x:Class="AccountingAutomationHub.Desktop.Views.MasterCentreView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:viewModels="clr-namespace:AccountingAutomationHub.Desktop.ViewModels"
>
    <UserControl.Resources>
        <HierarchicalDataTemplate DataType="{x:Type viewModels:MasterTreeNode}"
                                  ItemsSource="{Binding Children}">
            <TextBlock Text="{Binding DisplayTitle}" />
        </HierarchicalDataTemplate>
    </UserControl.Resources>

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Style="{StaticResource CardBorderStyle}"
                Padding="12"
                Margin="0,0,0,8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <WrapPanel Grid.Row="0">
                    <TextBox Width="280"
                             MinHeight="34"
                             Padding="9,6"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="Search name, parent, AAH Master ID, Tally Master ID, GUID or ALTERID"
                             Margin="0,0,8,6" />
                    <CheckBox Content="Include archived"
                              IsChecked="{Binding IncludeArchived}"
                              VerticalAlignment="Center"
                              Margin="6,0,12,6" />
                    <CheckBox Content="Show duplicate Masters only"
                              IsChecked="{Binding ShowDuplicatesOnly}"
                              VerticalAlignment="Center"
                              ToolTip="Duplicates mean the same Master type plus the same normalized name. Ledger and Group may share display text and are reviewed separately."
                              Margin="6,0,12,6" />
                </WrapPanel>

                <TextBlock Grid.Row="1" Text="{Binding MasterPermissionSummary}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="10" Margin="0,0,0,4" VerticalAlignment="Top" />

                <WrapPanel Grid.Row="1" Margin="0,18,0,0">
                    <Button Content="Import Ledger Masters"
                            Command="{Binding ImportCommand}"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Margin="0,0,8,6" />
                    <Button Content="Import Masters + Related Data from PY"
                            Command="{Binding ImportPreviousFyCommand}"
                            Padding="14,8"
                            Margin="0,0,8,6"
                            ToolTip="Carry reusable accounting/Stock Master structure and mappings from the immediate Previous FY. Transactions, opening balances and old live-Tally bindings are not copied." />
                    <Button Content="Force Sync Ledgers"
                            Command="{Binding SynchronizeCommand}"
                            Padding="14,8"
                            Margin="0,0,8,6"
                            ToolTip="Normal Tally Ledger MASTERID/name/parent changes synchronize automatically in the background. Use this only to force an immediate accounting/master refresh." />
                    <Button Content="New Ledger"
                            Command="{Binding NewLedgerCommand}"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Padding="14,8"
                            Margin="0,0,8,6"
                            ToolTip="Open the dedicated New Ledger interface." />
                    <Button Content="New Group"
                            Command="{Binding NewGroupCommand}"
                            Padding="14,8"
                            Margin="0,0,8,6"
                            ToolTip="Open the dedicated New Group interface." />
                    <Button Content="Edit / Update Local"
                            Command="{Binding EditManualMasterCommand}"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Padding="14,8"
                            Margin="0,0,8,6"
                            ToolTip="Edit the selected local Ledger or Group, including Purchase sync and Sales sync Masters. Tally-origin and system hierarchy Masters remain protected." />
                    <Button Content="Merge + Update"
                            Command="{Binding MergeUpdateCommand}"
                            Padding="14,8"
                            Margin="0,0,8,6"
                            ToolTip="Merge the selected Masters and update linked Tally when applicable." />
                    <Button Content="Archive / Restore"
                            Command="{Binding ArchiveCommand}"
                            Padding="14,8"
                            Margin="0,0,8,6" />
                    <Button Content="Make Active"
                            Command="{Binding MakeActiveCommand}"
                            Padding="14,8"
                            Margin="0,0,8,6"
                            ToolTip="Make the selected archived Ledger/Group active in AAH so it can be selected for Merge + Update. Tally is not changed by this action." />
                    <Button Content="Delete Master"
                            Command="{Binding DeleteCommand}"
                            Padding="14,8"
                            Margin="0,0,8,6"
                            ToolTip="Permanently deletes local/non-Tally Masters only. Tally-origin and system hierarchy Masters are protected." />
                    <Button Content="Refresh"
                            Command="{Binding RefreshCommand}"
                            Padding="14,8"
                            Margin="0,0,8,6" />
                </WrapPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource CardBorderStyle}" Padding="12" Cursor="Hand" Tag="Active" MouseLeftButtonUp="MetricTile_MouseLeftButtonUp">
                <StackPanel>
                    <TextBlock Text="{Binding ActiveCount}" FontSize="22" FontWeight="SemiBold" />
                    <TextBlock Text="Active Ledger Masters" Foreground="{DynamicResource TextSecondaryBrush}" />
                </StackPanel>
            </Border>
            <Border Grid.Column="2" Style="{StaticResource CardBorderStyle}" Padding="12" Cursor="Hand" Tag="Groups" MouseLeftButtonUp="MetricTile_MouseLeftButtonUp">
                <StackPanel>
                    <TextBlock Text="{Binding GroupCount}" FontSize="22" FontWeight="SemiBold" />
                    <TextBlock Text="Groups" Foreground="{DynamicResource TextSecondaryBrush}" />
                </StackPanel>
            </Border>
            <Border Grid.Column="4" Style="{StaticResource CardBorderStyle}" Padding="12" Cursor="Hand" Tag="Ledgers" MouseLeftButtonUp="MetricTile_MouseLeftButtonUp">
                <StackPanel>
                    <TextBlock Text="{Binding LedgerCount}" FontSize="22" FontWeight="SemiBold" />
                    <TextBlock Text="Ledgers" Foreground="{DynamicResource TextSecondaryBrush}" />
                </StackPanel>
            </Border>
            <Border Grid.Column="6" Style="{StaticResource CardBorderStyle}" Padding="12" Cursor="Hand" Tag="Duplicates" MouseLeftButtonUp="MetricTile_MouseLeftButtonUp">
                <StackPanel>
                    <TextBlock Text="{Binding DuplicateMasterCount}" FontSize="22" FontWeight="SemiBold" />
                    <TextBlock Text="Duplicate Masters" Foreground="{DynamicResource TextSecondaryBrush}" />
                </StackPanel>
            </Border>
        </Grid>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="285" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Style="{StaticResource CardBorderStyle}"
                    Padding="8">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top"
                               Text="Ledger Master — Tally Chart of Accounts"
                               FontWeight="SemiBold"
                               Margin="4,2,4,8" />
                    <TreeView ItemsSource="{Binding MasterTree}"
                              SelectedItemChanged="MasterTree_SelectedItemChanged"
                              BorderThickness="0"
                              Background="Transparent">
                        <TreeView.ItemContainerStyle>
                            <Style TargetType="TreeViewItem">
                                <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                                <Setter Property="Padding" Value="2" />
                            </Style>
                        </TreeView.ItemContainerStyle>
                    </TreeView>
                </DockPanel>
            </Border>

            <Border Grid.Column="2"
                    Style="{StaticResource CardBorderStyle}"
                    Padding="0">
                <DataGrid x:Name="MasterGrid"
                          ItemsSource="{Binding Records}"
                          SelectedItem="{Binding SelectedRecord}"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          IsReadOnly="True"
                          SelectionMode="Extended"
                          SelectionUnit="FullRow"
                          SelectionChanged="MasterGrid_SelectionChanged"
                          GridLinesVisibility="Horizontal"
                          RowHeaderWidth="0">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Name"
                                            Binding="{Binding NameWithUsage}"
                                            Width="2.2*" />
                        <DataGridTextColumn Header="Type"
                                            Binding="{Binding Type}"
                                            Width="130" />
                        <DataGridTextColumn Header="Under / Parent"
                                            Binding="{Binding Parent}"
                                            Width="1.5*" />
                        <DataGridTextColumn Header="Opening Balance"
                                            Binding="{Binding OpeningBalance, StringFormat=N2}"
                                            Width="125" />
                        <DataGridTextColumn Header="Company"
                                            Binding="{Binding Company}"
                                            Width="1.3*" />
                        <DataGridTextColumn Header="Source"
                                            Binding="{Binding Source}"
                                            Width="140" />
                        <DataGridTextColumn Header="Duplicate Review"
                                            Binding="{Binding DuplicateStatus}"
                                            IsReadOnly="True"
                                            Width="190" />
                        <DataGridTextColumn Header="Edit Authority"
                                            Binding="{Binding EditAuthorityStatus}"
                                            IsReadOnly="True"
                                            Width="180" />
                        <DataGridCheckBoxColumn Header="User Edited"
                                                Binding="{Binding IsUserEdited}"
                                                IsReadOnly="True"
                                                Width="95" />
                        <DataGridCheckBoxColumn Header="Archived"
                                                Binding="{Binding IsArchived}"
                                                IsReadOnly="True"
                                                Width="80" />
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
        </Grid>

        <TextBlock Grid.Row="3"
                   Text="{Binding StatusText}"
                   Foreground="{DynamicResource TextSecondaryBrush}"
                   Margin="4,8,4,0"
                   TextWrapping="Wrap" />
    </Grid>
</UserControl>
