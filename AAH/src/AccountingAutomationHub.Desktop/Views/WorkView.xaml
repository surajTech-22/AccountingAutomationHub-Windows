<UserControl x:Class="AccountingAutomationHub.Desktop.Views.WorkView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
<Grid Margin="24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<DockPanel><StackPanel><TextBlock Text="Work" FontSize="28" FontWeight="Bold"/><TextBlock Text="Tasks, Queries, Access Requests and maker-checker Approvals" Foreground="{DynamicResource TextSecondaryBrush}"/></StackPanel><Button DockPanel.Dock="Right" Content="Refresh" Command="{Binding RefreshCommand}" Style="{StaticResource SecondaryButtonStyle}" Width="95"/></DockPanel>
<Border Grid.Row="1" Style="{StaticResource CardBorderStyle}" Padding="12" Margin="0,12,0,12"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="120"/><ColumnDefinition Width="190"/><ColumnDefinition Width="155"/><ColumnDefinition Width="110"/><ColumnDefinition Width="145"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
<ComboBox ItemsSource="{Binding ItemTypes}" SelectedItem="{Binding NewType}"/>
<TextBox Grid.Column="1" Text="{Binding NewTitle, UpdateSourceTrigger=PropertyChanged}" Margin="8,0" ToolTip="Title"/>
<ComboBox Grid.Column="2" ItemsSource="{Binding AssignableUsers}" IsEditable="True" Text="{Binding AssignedTo, UpdateSourceTrigger=PropertyChanged}" ToolTip="Assign to user"/>
<ComboBox Grid.Column="3" ItemsSource="{Binding Priorities}" SelectedItem="{Binding Priority}" Margin="8,0"/>
<DatePicker Grid.Column="4" SelectedDate="{Binding NewDueDate}" ToolTip="Due date"/>
<TextBox Grid.Column="5" Text="{Binding NewDescription, UpdateSourceTrigger=PropertyChanged}" Margin="8,0" ToolTip="Description / query / access reason"/>
<Button Grid.Column="6" Content="Create Work Item" Command="{Binding CreateTaskCommand}" Style="{StaticResource PrimaryButtonStyle}"/>
<Button Grid.Column="7" Content="Request Approval" Command="{Binding CreateApprovalCommand}" Style="{StaticResource SecondaryButtonStyle}" Margin="8,0,0,0"/></Grid></Border>
<Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="3*"/><ColumnDefinition Width="2*"/></Grid.ColumnDefinitions>
<Grid Margin="0,0,8,0"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<DataGrid ItemsSource="{Binding Tasks}" SelectedItem="{Binding SelectedTask}" AutoGenerateColumns="False" IsReadOnly="True" HorizontalScrollBarVisibility="Auto"><DataGrid.Columns><DataGridTextColumn Header="Type" Binding="{Binding ItemType}" Width="105"/><DataGridTextColumn Header="Title" Binding="{Binding Title}" Width="220"/><DataGridTextColumn Header="Assigned" Binding="{Binding AssignedTo}" Width="120"/><DataGridTextColumn Header="Priority" Binding="{Binding Priority}" Width="85"/><DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="105"/><DataGridTextColumn Header="Due" Binding="{Binding DueUtc, StringFormat={}{0:d}}" Width="100"/><DataGridTextColumn Header="Client" Binding="{Binding ClientId}" Width="65"/><DataGridTextColumn Header="Updated" Binding="{Binding UpdatedUtc, StringFormat={}{0:g}}" Width="135"/></DataGrid.Columns></DataGrid>
<Border Grid.Row="1" Style="{StaticResource CardBorderStyle}" Padding="10" Margin="0,8,0,0"><StackPanel><TextBlock Text="Selected Work Item" FontWeight="SemiBold"/><WrapPanel Margin="0,8,0,0"><ComboBox Width="150" ItemsSource="{Binding AssignableUsers}" IsEditable="True" Text="{Binding EditAssignedTo, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanReassignSelectedTask}" ToolTip="Assigned user"/><ComboBox Width="120" ItemsSource="{Binding Statuses}" SelectedItem="{Binding EditStatus}" Margin="8,0"/><ComboBox Width="100" ItemsSource="{Binding Priorities}" SelectedItem="{Binding EditPriority}"/><DatePicker Width="135" SelectedDate="{Binding EditDueDate}" Margin="8,0"/><Button Content="Save" Command="{Binding SaveTaskCommand}" Style="{StaticResource PrimaryButtonStyle}"/><Button Content="Complete" Command="{Binding CompleteTaskCommand}" Style="{StaticResource SecondaryButtonStyle}" Margin="8,0,0,0"/><Button Content="Reopen" Command="{Binding ReopenTaskCommand}" Style="{StaticResource SecondaryButtonStyle}" Margin="8,0,0,0"/><Button Content="Escalate" Command="{Binding EscalateTaskCommand}" Style="{StaticResource SecondaryButtonStyle}" Margin="8,0,0,0"/></WrapPanel><TextBox Text="{Binding EditDescription, UpdateSourceTrigger=PropertyChanged}" Margin="0,8,0,0" MinHeight="54" TextWrapping="Wrap" AcceptsReturn="True" ToolTip="Description / resolution notes"/></StackPanel></Border>
</Grid>
<Grid Grid.Column="1"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><DataGrid ItemsSource="{Binding Approvals}" SelectedItem="{Binding SelectedApproval}" AutoGenerateColumns="False" IsReadOnly="True" HorizontalScrollBarVisibility="Auto"><DataGrid.Columns><DataGridTextColumn Header="Request" Binding="{Binding RequestType}" Width="170"/><DataGridTextColumn Header="By" Binding="{Binding RequestedBy}" Width="100"/><DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="90"/><DataGridTextColumn Header="Reason" Binding="{Binding Reason}" Width="220"/></DataGrid.Columns></DataGrid><WrapPanel Grid.Row="1" Margin="0,8,0,0"><TextBox Text="{Binding ApprovalReason, UpdateSourceTrigger=PropertyChanged}" Width="220" ToolTip="Approval decision reason"/><Button Content="Approve" Command="{Binding ApproveCommand}" Style="{StaticResource PrimaryButtonStyle}" Margin="8,0"/><Button Content="Reject" Command="{Binding RejectCommand}" Style="{StaticResource SecondaryButtonStyle}"/></WrapPanel></Grid></Grid>
<TextBlock Grid.Row="3" Text="{Binding Status}" Margin="0,10,0,0" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}"/>
</Grid></UserControl>
