<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>disable</ImplicitUsings>
    <Version>4.0.0.502</Version>
    <AssemblyVersion>4.0.0.502</AssemblyVersion>
    <FileVersion>4.0.0.502</FileVersion>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <RootNamespace>AccountingAutomationHub.Desktop</RootNamespace>
    <AssemblyName>AccountingAutomationHub</AssemblyName>
    <ApplicationIcon>Assets\AppIcon.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="LiveChartsCore.SkiaSharpView.WPF" Version="2.0.5" />
    <PackageReference Include="MahApps.Metro.IconPacks" Version="6.2.1" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\AccountingAutomationHub.Domain\AccountingAutomationHub.Domain.csproj" />
    <ProjectReference Include="..\AccountingAutomationHub.Application\AccountingAutomationHub.Application.csproj" />
    <ProjectReference Include="..\AccountingAutomationHub.Infrastructure\AccountingAutomationHub.Infrastructure.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Update="Assets\AAH_FS_Final_Complete_Library.xlsx">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </None>
    <None Update="Assets\AAH_FS_Presentation_Master.xlsx">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </None>
    <None Update="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </None>
    <None Update="Tools\AAH_LAG_MONITOR.ps1">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </None>
    <None Update="Tools\RUN_LAG_MONITOR.bat">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </None>
  </ItemGroup>
</Project>
