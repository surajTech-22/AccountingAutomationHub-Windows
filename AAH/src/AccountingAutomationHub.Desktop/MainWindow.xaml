<Window x:Class="AccountingAutomationHub.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:controls="clr-namespace:AccountingAutomationHub.Desktop.Controls"
        Title="Accounting Automation Hub"
        Width="1440"
        Height="900"
        MinWidth="1100"
        MinHeight="700"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResize"
        Background="{DynamicResource AppBackgroundBrush}"
        PreviewKeyDown="MainWindow_PreviewKeyDown">
    <!-- Inherited Fix95 source-gate marker only: Return to the Accounting / Audit workspace selector -->


    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="42"
                            ResizeBorderThickness="6"
                            GlassFrameThickness="0"
                            CornerRadius="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="42" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,0,1"
                MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="TitleBrandColumn" Width="260" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition x:Name="TopToolColumn" Width="590" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                    <ContentControl Content="AAH" ContentTemplate="{StaticResource AahBrandMarkTemplate}" Width="30" Height="30"/>
                    <StackPanel Margin="9,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Accounting Automation Hub" FontWeight="SemiBold" FontSize="12.5"/>
                        <TextBlock Text="Accounts • Audit • Automation" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="8.5"/>
                    </StackPanel>
                </StackPanel>

                <Grid Grid.Column="1"
                      Margin="12,5"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center"
                      shell:WindowChrome.IsHitTestVisibleInChrome="True"
                      ToolTip="{Binding ApplicationState}">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Client"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   FontSize="9"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"
                                   Margin="0,0,5,0" />
                        <ComboBox Width="180"
                                  Height="29"
                                  ItemsSource="{Binding TopClientChoices}"
                                  SelectedItem="{Binding SelectedTopClientChoice, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                  DisplayMemberPath="DisplayName"
                                  VerticalContentAlignment="Center"
                                  ToolTip="Change the active Accounting client. AAH paints the prepared Client/FY cache first and refreshes authority in the background." />
                        <TextBlock Text="FY"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   FontSize="9"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"
                                   Margin="10,0,5,0" />
                        <ComboBox Width="98"
                                  Height="29"
                                  ItemsSource="{Binding TopFinancialYearChoices}"
                                  SelectedItem="{Binding SelectedTopFinancialYearChoice, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                  DisplayMemberPath="DisplayText"
                                  VerticalContentAlignment="Center"
                                  ToolTip="Change the Financial Year for the selected client." />
                    </StackPanel>
                </Grid>

                <Grid x:Name="TallyTopPanel" Grid.Column="2"
                      Margin="8,5,8,5"
                      VerticalAlignment="Center"
                      shell:WindowChrome.IsHitTestVisibleInChrome="True"
                      ToolTip="{Binding TallyConnectionStatus}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="18" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="32" />
                    </Grid.ColumnDefinitions>
                    <Grid Width="14" Height="14" VerticalAlignment="Center" Margin="0,0,4,0">
                        <Ellipse Width="8" Height="8" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Setter Property="Fill" Value="#94A3B8"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsTallyConnected}" Value="True"><Setter Property="Fill" Value="#22C55E"/></DataTrigger>
                                        <DataTrigger Binding="{Binding IsTallyBusy}" Value="True">
                                            <Setter Property="Fill" Value="#2563EB"/>
                                            <DataTrigger.EnterActions>
                                                <BeginStoryboard Name="BusyPulse">
                                                    <Storyboard RepeatBehavior="Forever" AutoReverse="True" Timeline.DesiredFrameRate="12">
                                                        <DoubleAnimation Storyboard.TargetProperty="Opacity" From="1" To="0.25" Duration="0:0:0.55"/>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </DataTrigger.EnterActions>
                                            <DataTrigger.ExitActions><StopStoryboard BeginStoryboardName="BusyPulse"/></DataTrigger.ExitActions>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                    </Grid>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,8,0">
                        <TextBlock Text="TALLY"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   FontSize="8"
                                   FontWeight="SemiBold" />
                        <TextBlock Text="{Binding TallyConnectionStatus}"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   FontSize="9"
                                   MaxWidth="170"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <ComboBox Grid.Column="2"
                              Height="29"
                              MinWidth="245"
                              ItemsSource="{Binding TallyCompanies}"
                              SelectedItem="{Binding SelectedTallyCompany, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                              DisplayMemberPath="DisplayText"
                              ToolTip="Select an open Tally company. It is not authority for this client until Link is confirmed."
                              VerticalContentAlignment="Center" />
                    <Button Grid.Column="3"
                            Content="Link"
                            Command="{Binding ConfirmTopTallyLinkCommand}"
                            Height="29"
                            Margin="4,0,0,0"
                            Padding="8,0"
                            ToolTip="Explicitly link the selected Tally CompanyKey to this Accounting client. Any explicitly linked Audit client shares the same CompanyKey." />
                    <Button Grid.Column="4"
                            Width="29"
                            Height="29"
                            Margin="4,0,0,0"
                            Command="{Binding RefreshTallyCommand}"
                            Content="↻"
                            FontSize="15"
                            Padding="0"
                            ToolTip="Refresh open Tally companies" />
                </Grid>
                <Border x:Name="NetworkModeBanner" Grid.Column="2" Visibility="Collapsed" Margin="6,5" Padding="7,3" CornerRadius="6" Background="#FFF3CD" BorderBrush="#FFE69C" BorderThickness="1" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <TextBlock x:Name="NetworkIdentityText" Text="LAN · Read only" Foreground="#664D03" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="190"/>
                        <TextBlock x:Name="RemoteAssistText" Text="REMOTE ASSIST" Visibility="Collapsed" Foreground="#842029" FontWeight="Bold" VerticalAlignment="Center" Margin="8,0,0,0" MaxWidth="310" TextTrimming="CharacterEllipsis" ToolTip="Remote Assist is active. Helper elevation never changes the signed-in AAH user permissions."/>
                        <Button x:Name="RemoteAssistReviewButton" Content="Review Request" Visibility="Collapsed" Click="RemoteAssistReview_Click" Padding="7,3" Margin="8,0,0,0" ToolTip="Open the persistent Remote Assist consent workspace"/>
                        <Button Content="Refresh" Click="NetworkRefresh_Click" Padding="7,3" Margin="8,0,0,0" ToolTip="Refresh authorised data from the Main Server"/>
                        <Button x:Name="NetworkUploadButton" Content="Upload" Click="NetworkUpload_Click" Padding="7,3" Margin="5,0,0,0" ToolTip="Upload a source file for the current authorised client"/>
                        <Button x:Name="NetworkUpdateButton" Content="Update" Click="NetworkUpdate_Click" Padding="7,3" Margin="5,0,0,0" Visibility="Collapsed" ToolTip="Install the approved LAN update from the Main Server"/>
                    </StackPanel>
                </Border>

                <StackPanel Grid.Column="3"
                            Orientation="Horizontal"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button Style="{StaticResource WindowCommandButtonStyle}"
                            ToolTip="Minimize"
                            AutomationProperties.Name="Minimize"
                            Click="Minimize_Click">
                        <Path Width="12"
                              Height="2"
                              Data="M 0,1 L 12,1"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeThickness="1.5"
                              Stretch="Fill" />
                    </Button>
                    <Button Style="{StaticResource WindowCommandButtonStyle}"
                            ToolTip="Maximize or restore"
                            AutomationProperties.Name="Maximize or restore"
                            Click="MaximizeRestore_Click">
                        <Rectangle Width="11"
                                   Height="11"
                                   Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                   StrokeThickness="1.3"
                                   Fill="Transparent" />
                    </Button>
                    <Button Style="{StaticResource CloseWindowButtonStyle}"
                            ToolTip="Close"
                            AutomationProperties.Name="Close"
                            Click="Close_Click">
                        <Path Width="12"
                              Height="12"
                              Data="M 0,0 L 12,12 M 12,0 L 0,12"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeThickness="1.5"
                              Stretch="Fill" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <Border x:Name="RemoteAssistActiveBar" Grid.Row="1" Visibility="Collapsed" Background="#B42318" BorderBrush="#7A1A12" BorderThickness="0,0,0,2" Padding="12,9">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock x:Name="RemoteAssistActiveBarTitle" Text="REMOTE ASSIST ACTIVE" Foreground="White" FontWeight="Bold" FontSize="14"/>
                    <TextBlock x:Name="RemoteAssistActiveBarText" Text="Administrator is connected to this AAH window." Foreground="White" FontSize="12" TextWrapping="Wrap" Margin="0,2,8,0"/>
                </StackPanel>
                <WrapPanel Grid.Column="1" VerticalAlignment="Center">
                    <Button Content="Open Remote Assist" Click="RemoteAssistOpen_Click" Padding="9,5" Margin="0,0,6,0"/>
                    <Button Content="End Access Now" Click="RemoteAssistEndNow_Click" Padding="9,5"/>
                </WrapPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="{Binding SidebarWidth}" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Background="{DynamicResource SidebarBrush}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="92" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="58" />
                        <RowDefinition Height="72" />
                    </Grid.RowDefinitions>

                    <Button Command="{Binding CloseWorkspaceCommand}"
                            Margin="10,10,10,8"
                            Padding="10,8"
                            Background="Transparent"
                            BorderThickness="0"
                            Cursor="Hand"
                            HorizontalContentAlignment="Stretch"
                            ToolTip="Close this client workspace and return to the Client Directory">
                        <StackPanel>
                            <TextBlock Text="WORKSPACE"
                                       Foreground="#94A3B8"
                                       FontWeight="SemiBold"
                                       FontSize="10" />
                            <TextBlock Text="{Binding WorkspaceButtonText}"
                                       Foreground="White"
                                       FontWeight="SemiBold"
                                       FontSize="14"
                                       Margin="0,6,0,0"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding CurrentClientDetail}"
                                       Foreground="#94A3B8"
                                       FontSize="11"
                                       Margin="0,3,0,0"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Button>

                    <ListBox Grid.Row="1"
                             ItemsSource="{Binding NavigationItems}"
                             SelectedItem="{Binding SelectedNavigationItem, Mode=TwoWay}"
                             Style="{StaticResource NavigationListStyle}"
                             ItemContainerStyle="{StaticResource NavigationItemStyle}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="32" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="25"
                                            Height="25"
                                            CornerRadius="7"
                                            Background="#26FFFFFF"
                                            VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Icon}"
                                                   Foreground="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=Foreground}"
                                                   FontWeight="Bold"
                                                   FontSize="12"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center" />
                                    </Border>
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding Title}"
                                               Foreground="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=Foreground}"
                                               FontSize="13"
                                               FontWeight="SemiBold"
                                               VerticalAlignment="Center" />
                                    <ToggleButton Grid.Column="2"
                                                  IsChecked="{Binding ToggleValue, Mode=TwoWay}"
                                                  Visibility="{Binding ShowToggle, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                  PreviewMouseLeftButtonDown="NavigationToggle_PreviewMouseLeftButtonDown"
                                                  Width="38" Height="20" Margin="6,0,0,0" Padding="0"
                                                  Content="{Binding ToggleText}" FontSize="9" FontWeight="SemiBold"
                                                  ToolTip="Enable or disable Financial Statements for this Client/FY"/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <Button Grid.Row="2"
                            Command="{Binding OpenSettingsCommand}"
                            Margin="10,5,10,5"
                            Padding="10,7"
                            Background="Transparent"
                            BorderThickness="0"
                            Foreground="#CBD5E1"
                            Cursor="Hand"
                            HorizontalContentAlignment="Stretch"
                            ToolTip="Application Settings">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="32" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Width="25" Height="25" CornerRadius="7" Background="#26FFFFFF" VerticalAlignment="Center">
                                <TextBlock Text="⚙" Foreground="#CBD5E1" FontWeight="Bold" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Grid.Column="1" Text="Settings" Foreground="#CBD5E1" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
                        </Grid>
                    </Button>

                    <Border Grid.Row="3"
                            BorderBrush="#334155"
                            BorderThickness="0,1,0,0"
                            Padding="20,13">
                        <StackPanel>
                            <TextBlock Text="VERSION"
                                       Foreground="#64748B"
                                       FontWeight="SemiBold"
                                       FontSize="9" />
                            <TextBlock Text="4.0.0"
                                       Foreground="#CBD5E1"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       Margin="0,4,0,0" />
                            <TextBlock Text="Fast Cache • Review Sync • Auto Import • Excel Parity • Tally"
                                       Foreground="#94A3B8"
                                       FontSize="9"
                                       TextWrapping="Wrap"
                                       ToolTip="Accounting Automation Hub v4.0.0 — Governance, Universal Dump, Import Jobs/Undo, Cash &amp; Journal Automation, Excel VBA Parity &amp; Tally Integration"
                                       Margin="0,2,0,0" />
                            <TextBlock Text="F1  Keyboard shortcuts"
                                       Foreground="#64748B"
                                       FontSize="9"
                                       Margin="0,4,0,0" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="64" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0"
                        Background="{DynamicResource SurfaceBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="0,0,0,1"
                        Padding="20,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0"
                                    VerticalAlignment="Center"
                                    Margin="0,0,14,0">
                            <TextBlock Text="{Binding CurrentPage.Title}"
                                       FontSize="20"
                                       FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding CurrentPage.Subtitle}"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       FontSize="12"
                                       TextTrimming="CharacterEllipsis"
                                       Margin="0,4,0,0" />
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Button Content="WORKSPACE" Click="AuditWorkspace_Click" Focusable="False" Padding="11,6" Margin="0,0,8,0" ToolTip="Return to the Accounting / Audit / Income Tax workspace selector" />
                            <Button Content="LOGOUT" Click="WorkspaceLogout_Click" Focusable="False" Padding="11,6" Margin="0,0,8,0" ToolTip="Return to the Accounting / Audit / Income Tax workspace chooser" />
                            <Button x:Name="UndoButton" Content="Undo" Click="Undo_Click" Focusable="False" Padding="11,6" Margin="0,0,8,0" ToolTip="Undo the current editor/grid change (Ctrl+Z)" />
                            <Button Content="Calculator" Click="Calculator_Click" Focusable="False" Padding="11,6" Margin="0,0,8,0" ToolTip="Open the universal calculator (Ctrl+Alt+C)" />
                            <Button Content="Chat" Click="Chat_Click" Focusable="False" Padding="11,6" Margin="0,0,8,0" ToolTip="Open Team &amp; Chat" />
                            <Border x:Name="AutomaticGstSyncBadge" Background="{DynamicResource AccentSoftBrush}" CornerRadius="15" Padding="11,5" Visibility="{Binding HasActiveWorkspace, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <StackPanel Orientation="Horizontal"><Ellipse Width="7" Height="7" Fill="{DynamicResource AccentBrush}" Margin="0,0,7,0"/><TextBlock Text="Automatic GST sync enabled" Foreground="{DynamicResource AccentBrush}" FontSize="11" FontWeight="SemiBold"/></StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                </Border>

                <controls:CachedPageHost x:Name="PageContent"
                                         Grid.Row="1"
                                         Focusable="True"
                                         Content="{Binding CurrentPage}" />
            </Grid>
        </Grid>
        <ContentControl x:Name="WorkspaceOverlayHost"
                        Grid.Row="0"
                        Grid.RowSpan="3"
                        Panel.ZIndex="1000"
                        Visibility="Collapsed"
                        HorizontalContentAlignment="Stretch"
                        VerticalContentAlignment="Stretch"/>
    </Grid>
</Window>
