<UserControl x:Class="AccountingAutomationHub.Desktop.Controls.MultiSearchFilterBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinHeight="38">
    <Border Background="#F8FAFC" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="7" Padding="7">
        <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <Grid>
                <TextBox x:Name="SearchBox" MinHeight="32" Padding="10,6" VerticalContentAlignment="Center"
                         Text="{Binding SearchText, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         TextChanged="SearchBox_TextChanged" PreviewKeyDown="SearchBox_PreviewKeyDown"
                         ToolTip="Search all columns. Comma = AND. Numeric symbols work with field names, for example Debit &gt; 50000, Closing &lt;= 20000, Source Entries &gt;= 5. Sort commands also work, for example sort Closing desc. Field names are suggested while typing."/>
                <Popup x:Name="SuggestionsPopup" Placement="Bottom" PlacementTarget="{Binding ElementName=SearchBox}"
                       StaysOpen="False" AllowsTransparency="True">
                    <Border Background="White" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" Padding="4" MinWidth="240" MaxWidth="520">
                        <ListBox x:Name="SuggestionsList" MouseDoubleClick="Suggestion_MouseDoubleClick" SelectionChanged="Suggestion_SelectionChanged" MaxHeight="220"/>
                    </Border>
                </Popup>
            </Grid>
            <Button Grid.Column="1" Content="Clear Sort &amp; Filter" Height="32" Margin="8,0,0,0" Padding="10,4" Click="ClearSearch_Click" ToolTip="Clear this search, every column filter, and every grid sort for the attached module view."/>
        </Grid>
    </Border>
</UserControl>