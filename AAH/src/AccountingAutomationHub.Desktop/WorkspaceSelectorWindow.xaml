<Window x:Class="AccountingAutomationHub.Desktop.WorkspaceSelectorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Accounting Automation Hub"
        Width="1440" Height="900" MinWidth="1100" MinHeight="700"
        WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanResize"
        Background="{DynamicResource AppBackgroundBrush}">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="42" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="42"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Border Grid.Row="0" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="300"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
                    <ContentControl Content="AAH" ContentTemplate="{StaticResource AahBrandMarkTemplate}" Width="28" Height="28"/>
                    <StackPanel Margin="9,0,0,0" VerticalAlignment="Center"><TextBlock Text="Accounting Automation Hub" FontWeight="SemiBold" FontSize="12.5"/><TextBlock Text="Accounts • Audit • Automation" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="8.5"/></StackPanel>
                </StackPanel>
                <TextBlock Grid.Column="1" Text="WORKSPACE" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="11" FontWeight="SemiBold"/>
                <StackPanel Grid.Column="2" Orientation="Horizontal" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button Style="{StaticResource WindowCommandButtonStyle}" ToolTip="Minimize" Click="Minimize_Click"><Path Width="12" Height="2" Data="M 0,1 L 12,1" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.5"/></Button>
                    <Button Style="{StaticResource WindowCommandButtonStyle}" ToolTip="Maximize or restore" Click="MaximizeRestore_Click"><Rectangle Width="11" Height="11" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.3" Fill="Transparent"/></Button>
                    <Button Style="{StaticResource CloseWindowButtonStyle}" ToolTip="Close" Click="Close_Click"><Path Width="12" Height="12" Data="M 0,0 L 12,12 M 12,0 L 0,12" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.5"/></Button>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <StackPanel Grid.Row="0" HorizontalAlignment="Center" VerticalAlignment="Center" Width="980">
                <Grid Width="76" Height="76" HorizontalAlignment="Center" Opacity="1">
                    <ContentControl Content="AAH" ContentTemplate="{StaticResource AahBrandMarkTemplate}" Width="68" Height="68" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    <Ellipse Width="74" Height="74" Stroke="#BFDBFE" StrokeThickness="1" StrokeDashArray="2,3" Opacity="0.9"/>
                    <Grid.Triggers>
                        <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0.55" To="1" Duration="0:0:0.4"/>
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                    </Grid.Triggers>
                </Grid>
                <TextBlock Text="Accounting Automation Hub" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" Margin="0,13,0,0"/>
                <TextBlock Text="Choose your workspace" FontSize="28" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,5,0,0"/>
                <TextBlock Text="Professional accounting grids with automation-first status, audit separation and a single AAH workspace shell." Foreground="{DynamicResource TextSecondaryBrush}" FontSize="13" HorizontalAlignment="Center" TextAlignment="Center" Margin="0,7,0,28"/>

                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="22"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Click="Accounting_Click" Padding="0" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
                        <Border Padding="26" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12">
                            <Grid>
                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Border Width="48" Height="48" Background="#E8F0FF" CornerRadius="12"><TextBlock Text="A" Foreground="#2458C6" FontWeight="Bold" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center"><TextBlock Text="ACCOUNTING" FontWeight="Bold" FontSize="19"/><TextBlock Text="Books &amp; compliance" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11"/></StackPanel><Border Grid.Column="2" Background="#EEF7EE" CornerRadius="8" Padding="8,3" VerticalAlignment="Top"><TextBlock Text="OWN CLIENTS" Foreground="#277A35" FontSize="9" FontWeight="Bold"/></Border></Grid>
                                <TextBlock Grid.Row="1" Margin="0,20,0,10" Text="Open Accounting Clients first, then work inside that client's modules." FontWeight="SemiBold" FontSize="13" TextWrapping="Wrap"/>
                                <StackPanel Grid.Row="2"><TextBlock Text="• Dashboard, Banking, Sales, Purchase, Journal and Cash" Margin="0,5,0,0"/><TextBlock Text="• GST, GSTR-3B, 26AS, Masters and Finance Center" Margin="0,5,0,0"/><TextBlock Text="• Tally sync and accounting automation" Margin="0,5,0,0"/><TextBlock Text="• Calculator, Undo, Team/Chat and common AAH utilities" Margin="0,5,0,0" Foreground="{DynamicResource TextSecondaryBrush}"/></StackPanel>
                                <Grid Grid.Row="3" Margin="0,24,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Enter Accounting" FontWeight="SemiBold"/><TextBlock Grid.Column="1" Text="→" FontSize="20" FontWeight="SemiBold"/></Grid>
                            </Grid>
                        </Border>
                    </Button>
                    <Button Grid.Column="2" Click="Audit_Click" Padding="0" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
                        <Border Padding="26" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12">
                            <Grid>
                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Border Width="48" Height="48" Background="#F0EAFE" CornerRadius="12"><TextBlock Text="AU" Foreground="#6A45B8" FontWeight="Bold" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center"><TextBlock Text="AUDIT" FontWeight="Bold" FontSize="19"/><TextBlock Text="Independent Audit workspace" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11"/></StackPanel><Border Grid.Column="2" Background="#F4EEFF" CornerRadius="8" Padding="8,3" VerticalAlignment="Top"><TextBlock Text="OWN CLIENTS" Foreground="#6A45B8" FontSize="9" FontWeight="Bold"/></Border></Grid>
                                <TextBlock Grid.Row="1" Margin="0,20,0,10" Text="Open Audit Clients first, then use the same shell/module navigation pattern." FontWeight="SemiBold" FontSize="13" TextWrapping="Wrap"/>
                                <StackPanel Grid.Row="2"><TextBlock Text="• Dashboard, Banking, Sales, Purchase, Cash/Credit and Journal shell" Margin="0,5,0,0"/><TextBlock Text="• Tally Books, GST/GSTR-3B, 26AS and Client Reconciliation shell" Margin="0,5,0,0"/><TextBlock Text="• Live Tally can be explicitly linked per Audit client" Margin="0,5,0,0"/><TextBlock Text="• Audit module internals remain independent and can be redesigned next" Margin="0,5,0,0" Foreground="{DynamicResource TextSecondaryBrush}"/></StackPanel>
                                <Grid Grid.Row="3" Margin="0,24,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Enter Audit" FontWeight="SemiBold"/><TextBlock Grid.Column="1" Text="→" FontSize="20" FontWeight="SemiBold"/></Grid>
                            </Grid>
                        </Border>
                    </Button>
                </Grid>
            </StackPanel>

            <Border Grid.Row="1" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="18,11"><TextBlock Text="WORKSPACE returns here without merging the Accounting and Audit client selections." Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center" FontSize="11"/></Border>
        </Grid>
    </Grid>
</Window>
