<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <AssemblyName>AAH_Update</AssemblyName>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <Version>4.0.0.506</Version>
  </PropertyGroup>
  <ItemGroup>
    <!-- EXACT source of original CL017 manual Install-AAHPublish routine.
         Embedded in the updater so GitHub downloads cannot substitute code. -->
    <EmbeddedResource Include="../../../ci/legacy/TransactionalPublish.ps1"
                      LogicalName="AAH.NativeTransactionalPublish.ps1" />
  </ItemGroup>
</Project>
